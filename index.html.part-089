াইল তৈরি করলেও এগুলো থাকবে।</p>' +
        BOOKMARKS.map(function(b, i){
          return '<button class="bmk" data-open-bmk="' + i + '"><span>🔖</span><span>' + esc(b.label) + '<small>' + esc(b.sub) + '</small></span><span class="del" data-del-bmk="' + i + '" role="button" aria-label="বুকমার্ক সরান">✕</span></button>';
        }).join('') + '</div>';
    }
    $('pfCreate').addEventListener('click', function(){
      var name = $('pfName').value.trim();
      if (!name){ toast('আগে আপনার নাম লিখুন'); $('pfName').focus(); return; }
      PROFILE = { name: name };
      try { localStorage.setItem('di_profile', JSON.stringify(PROFILE)); } catch(e){}
      renderProfileChip(); renderProfile();
      toast('স্বাগতম, ' + name + '! আপনার প্রোফাইল তৈরি হয়েছে');
    });
    return;
  }
  var initial = PROFILE.name.trim().charAt(0) || 'ম';
  var bmkHtml = BOOKMARKS.length ? BOOKMARKS.map(function(b, i){
    return '<button class="bmk" data-open-bmk="' + i + '"><span>🔖</span><span>' + esc(b.label) + '<small>' + esc(b.sub) + '</small></span><span class="del" data-del-bmk="' + i + '" role="button" aria-label="বুকমার্ক সরান">✕</span></button>';
  }).join('') : '<p class="sub" style="margin:0">এখনো কোনো বুকমার্ক নেই। কুরআন পড়ার সময় "বুকমার্ক করুন" বা হাদিস কার্ডের "বুকমার্ক" বোতামে চাপ দিলে এখানে জমা হবে।</p>';
  box.innerHTML = '<div class="card" style="text-align:center; padding:24px 20px">' +
    '<div class="avatar">' + esc(initial) + '</div>' +
    '<h3 style="margin:10px 0 2px; font-size:22px">' + esc(PROFILE.name) + '</h3>' +
    '<p class="sub" style="margin:0">' + (PROFILE.google ? ('Google অ্যাকাউন্ট' + (PROFILE.email ? ' • ' + esc(PROFILE.email) : '')) : 'সেশন প্রোফাইল • গেস্ট অ্যাকাউন্ট') + '</p>' +
    (PROFILE.google ? '' : '<div style="max-width:400px; margin:14px auto 0"><button class="gbtn" id="googleBtn2">' + GOOGLE_G + 'Google দিয়ে সাইন ইন</button><p id="googleNote2" class="sub" style="margin:10px 0 0; display:none"></p></div>') +
    '<div class="pstats">' +
    '<div class="st"><b>' + bn(trackerDoneCount()) + '/৫</b><span>আজকের নামাজ</span></div>' +
    '<div class="st"><b>' + bn(tasbih.total) + '</b><span>মোট যিকির</span></div>' +
    '<div class="st"><b>' + bn(BOOKMARKS.length) + '</b><span>বুকমার্ক</span></div>' +
    '</div>' +
    '<p class="sub" style="margin:12px 0 0">অ্যাপ সংস্করণ: v2.8</p>' +
      '<p style="margin:10px 0 0"><a class="btn" href="https://github.com/Kholil-143/Daily-Islam/releases/latest/download/Daily-Islam.apk">⬇ সর্বশেষ আপডেট ডাউনলোড / ইনস্টল করুন</a></p>' +
    '<p style="margin:16px 0 0"><button class="btn ghost" id="pfOut">প্রোফাইল থেকে বের হয়ে যান</button></p>' +
    '</div>' +
    '<div class="card" style="margin-top:12px"><h3 style="margin-top:0">আমার বুকমার্ক</h3>' + bmkHtml + '</div>';
  var gb2 = $('googleBtn2'); if (gb2) gb2.addEventListener('click', googleSignInFn);
  $('pfOut').addEventListener('click', function(){
      if (PROFILE && PROFILE.google && window.Capacitor){
        faCall('signOut').catch(function(){});
      }
      try { localStorage.removeItem('di_profile'); } catch(e){}
    PROFILE = null;
    renderProfileChip(); renderProfile();
    toast('আপনি গেস্ট হিসেবে আছেন');
  });
}
$('profileChip').addEventListener('click', function(){ showView('profile'); renderProfile(); });
(function profileTile(){
  var grid = $('featureGridSeba');
  var b = document.createElement('button');
  b.className = 'htile';
  b.innerHTML = '<span class="hic c8"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="8" r="4"/><path d="M4.5 20.5c1.4-3.4 4.2-5 7.5-5s6.1 1.6 7.5 5"/></svg></span><span>আমার প্রোফাইল</span>';
  b.addEventListener('click', function(){ showView('profile'); renderProfile(); });
  grid.appendChild(b);
})();
renderProfileChip();
renderProfile();
if (window.Capacitor){
  faCall('getCurrentUser').then(function(r){
    var u = r && r.user;
    if (u){
      PROFILE = { name: u.displayName || (u.email ? u.email.split('@')[0] : 'ব্যবহারকারী'), email: u.email || '', photo: u.photoUrl || '', google: true };
      try { localStorage.setItem('di_profile', JSON.stringify(PROFILE)); } catch(e){}
      renderProfileChip(); renderProfile();
    }
  }).catch(function(){});
}
</script>
<script>
/* ================= Per-ayah tafsir ================= */
var TAFSIR_AYAH = {
 '1:1': 'প্রতিটি ভালো কাজ আল্লাহর নামে শুরু করাই সুন্নাত। "রহমান" অর্থ যাঁর দয়া দুনিয়ায় সব সৃষ্টিকে বেষ্টন করে আছে; "রহিম" অর্থ যিনি আখিরাতে বিশেষভাবে মুমিনদের প্রতি দয়ালু। (তাফসিরে ইবনে কাসির)',
 '1:2': 'সব ধরনের প্রশংসা ও কৃতজ্ঞতা একমাত্র আল্লাহরই প্রাপ্য, কারণ তিনি সমগ্র বিশ্বজগতের সৃষ্টিকর্তা, মালিক ও প্রতিপালক — ধীরে ধীরে সবকিছুকে পূর্ণতার দিকে নিয়ে যান।',
 '1:3': 'আল্লাহর রহমতের বিশালতা আবার স্মরণ করানো হয়েছে, যাতে বান্দা ভয়ের পাশাপাশি আশা নিয়েও তাঁর দিকে এগিয়ে যায়।',
 '1:4': 'প্রতিদান দিবস (কিয়ামত) এর একচ্ছত্র মালিক আল্লাহ; সেদিন কারো কোনো কর্তৃত্ব থাকবে না। এই আয়াত মানুষকে জবাবদিহিতার ভয়ে সৎকর্মে উদ্বুদ্ধ করে।',
 '1:5': 'তাওহিদের সারকথা: ইবাদত (নামাজ, রোজা, দোয়া, মানত ইত্যাদি) শুধু আল্লাহর জন্যই এবং সাহায্যও চাইতে হবে শুধু তাঁর কাছেই। প্রথমে ইবাদতের কথা, পরে সাহায্য চাওয়ার কথা — কারণ ইবাদতই উদ্দেশ্য, সাহায্য তার উপায়।',
 '1:6': 'সিরাতুল মুস্তাকিম অর্থাৎ সরল পথ — যা আল্লাহর সন্তুষ্টি ও জান্নাত পর্যন্ত পৌঁছে দেয়। এটাই সূরা ফাতিহার প্রধান দোয়া; তাই এই সূরা ছাড়া নামাজ হয় না।',
 '1:7': 'নেয়ামতপ্রাপ্তরা হলেন নবী, সিদ্দিক, শহীদ ও সালেহিন (সূরা আন-নিসা: ৬৯)। "মাগদুব" অর্থ যারা জেনে-বুঝে সত্য প্রত্যাখ্যান করে আল্লাহর গজবের পাত্র হয়েছে; "দাল্লিন" অর্থ যারা অজ্ঞতায় পথভ্রষ্ট হয়েছে। মুসলিম প্রতিদিন নামাজে এই দুই পথ থেকে বাঁচার দোয়া করে।',
 '2:45': 'সবর (ধৈর্য) ও নামাজ — এই দুটিকে আল্লাহ সাহায্য লাভের মাধ্যম বানিয়েছেন। নামাজে মনোযোগী (খাশিয়িন) ছাড়া অন্যদের কাছে এটি ভারী মনে হয়।',
 '2:152': 'আল্লাহকে স্মরণ (যিকির, নামাজ, কুরআন তিলাওয়াত) করলে আল্লাহও বান্দাকে স্মরণ করেন — অর্থাৎ রহমত ও মাগফিরাত দান করেন। নেয়ামতের কৃতজ্ঞতা করা ওয়াজিব; অকৃতজ্ঞতা গুনাহ।',
 '2:153': 'বিপদে ধৈর্য ও নামাজের মাধ্যমে সাহায্য চাওয়ার নির্দেশ। "আল্লাহ ধৈর্যশীলদের সঙ্গে আছেন" — অর্থাৎ তাঁর সাহায্য, তাওফিক ও রহমত তাদের সঙ্গে থাকে।',
 '2:155': 'ভয়, ক্ষুধা, জান-মাল ও ফল-ফসলের ক্ষতি দিয়ে পরীক্ষা অবশ্যম্ভাবী — এটি মুমিনের জীবনের নিয়ম। সুসংবাদ কেবল ধৈর্যশীলদের জন্য।',
 '2:156': 'ধৈর্যশীলদের পরিচয়: বিপদে তারা বলে "ইন্না লিল্লাহি ওয়া ইন্না ইলাইহি রাজিউন" — আমরা আল্লাহরই এবং তাঁর দিকেই ফিরে যাব। এই বাক্যে তাওহিদ, আত্মসমর্পণ ও আখিরাতের বিশ্বাস নিহিত।',
 '2:185': 'রমজান মাসেই কুরআন নাজিল শুরু হয়; এই মাসে রোজা ফরজ। অসুস্থ ও মুসাফিরের জন্য ছাড় রয়েছে — পরে কাজা করতে হবে। "আল্লাহ তোমাদের জন্য সহজতা চান, কঠিনতা চান না" — শরিয়তের একটি মৌলিক নীতি।',
 '2:186': 'আল্লাহ বান্দার অতি নিকটে; দোয়াকারীর দোয়া তিনি কবুল করেন। শর্ত হলো তাঁর ডাকে সাড়া দেওয়া ও ঈমান রাখা — তাহলেই সঠিক পথ পাওয়া যায়।',
 '2:201': 'এটি সবচেয়ে সর্বাঙ্গীণ দোয়া: দুনিয়ার কল্যাণ (সুস্থতা, হালাল রিজিক, নেক আমল), আখিরাতের কল্যাণ (জান্নাত) এবং জাহান্নাম থেকে মুক্তি — তিনটিই একসঙ্গে চাওয়া হয়েছে। রাসূলুল্লাহ ﷺ এই দোয়া বেশি পড়তেন।',
 '2:255': 'আয়াতুল কুরসি — কুরআনের শ্রেষ্ঠ আয়াতগুলোর একটি। এতে আল্লাহর একত্ব, চিরঞ্জীবতা, সবকিছুর ধারণ-ক্ষমতা, ঘুম-তন্দ্রা থেকে পবিত্রতা, আসমান-জমিনের মালিকানা, তাঁর অনুমতি ছাড়া সুপারিশের অসম্ভবতা, সর্বব্যাপী জ্ঞান এবং কুরসির (তাঁর জ্ঞান ও কর্তৃত্বের) বিশালতা বর্ণিত হয়েছে। (তাফসিরে ইবনে কাসির)',
 '2:256': 'ধর্মে কোনো জবরদস্তি নেই — হেদায়েত ও গোমরাহি স্পষ্ট হয়ে যাওয়ার পর ঈমান স্বেচ্ছায় গ্রহণের বিষয়। তাগুত (আল্লাহ ছাড়া যার ইবাদত করা হয়) কে অস্বীকার করে আল্লাহর প্রতি ঈমান আনলেই মজবুত হাতল ধরা হয়।',
 '2:257': 'আল্লাহ মুমিনদের অভিভাবক (ওলি); তিনি তাদের কুফর ও অজ্ঞতার অন্ধকার থেকে ঈমানের আলোতে বের করে আনেন। বিপরীতে কাফেরদের অভিভাবক তাগুত, যারা তাদের আলো থেকে অন্ধকারে নিয়ে যায়।',
 '2:285': 'রাসূল ﷺ ও মুমিনগণ আল্লাহ, ফেরেশতা, কিতাবসমূহ ও রাসূলগণের প্রতি ঈমান এনেছেন — রাসূলদের মধ্যে কোনো পার্থক্য (কাউকে মানা, কাউকে অস্বীকার) করেন না। "শুনলাম ও আনুগত্য করলাম" — এটাই মুমিনের জবাব।',
 '2:286': 'আল্লাহ কাউকে তার সাধ্যের বাইরে দায়িত্ব দেন না। প্রত্যেকে নিজের অর্জিত পুণ্য ও পাপের ফল পাবে। আয়াতের শেষাংশের দোয়াগুলো আল্লাহ নিজে শিখিয়ে দিয়েছেন; হাদিসে এসেছে, রাতে এই দুই আয়াত (২৮৫–২৮৬) পড়লে তা যথেষ্ট হয়। (সহিহ বুখারি: ৫০০৯)',
 '3:26': 'সব রাজত্ব ও ক্ষমতার প্রকৃত মালিক আল্লাহ; তিনি যাকে চান ক্ষমতা ও সম্মান দেন, যার থেকে চান ছিনিয়ে নেন। দুনিয়ার উত্থান-পতন তাঁর ইচ্ছার অধীন — তাই ক্ষমতাবানদের ভয়ে নয়, আল্লাহর ভয়েই চলতে হয়।',
 '3:139': 'উহুদের পরাজয়ের পর মুসলিমদের সান্ত্বনা: দুর্বল হয়ো না, দুঃখ করো না — সত্যিকারের মুমিন হলে চূড়ান্ত বিজয় তোমাদেরই। পরাজয় সাময়িক পরীক্ষা মাত্র।',
 '13:28': 'অন্তরের প্রকৃত প্রশান্তি (তুমানিনা) পাওয়া যায় আল্লাহর যিকিরে — দুনিয়ার সম্পদ ও ভোগে নয়। যিকির অর্থ নামাজ, কুরআন তিলাওয়াত ও আল্লাহর স্মরণের সব রূপ।',
 '14:7': 'আল্লাহর ঘোষণা: নেয়ামতের কৃতজ্ঞতা (শুকর) করলে তিনি নেয়ামত আরও বাড়িয়ে দেন; আর অকৃতজ্ঞতা করলে তাঁর শাস্তি কঠিন। শুকর হয় অন্তরের স্বীকৃতি, মুখের প্রশংসা ও নেয়ামতকে সৎকাজে ব্যবহারের মাধ্যমে।',
 '36:58': 'জান্নাতবাসীদের জন্য সবচেয়ে বড় সম্মান: পরম দয়ালু রবের পক্ষ থেকে সরাসরি "সালাম" — শান্তির অভিবাদন। সব নেয়ামতের ঊর্ধ্বে এই মর্যাদা।',
 '40:60': 'আল্লাহ নিজে দোয়ার আহ্বান করে কবুলের প্রতিশ্রুতি দিয়েছেন। হাদিসে এসেছে, "দোয়াই ইবাদত" (তিরমিযি: ২৯৬৯)। যারা অহংকারে ইবাদত থেকে মুখ ফিরিয়ে নেয়, তাদের জন্য অপমানজনক জাহান্নামের হুশিয়ারি রয়েছে।',
 '55:13': 'সূরা আর-রাহমানে এই আয়াতটি ৩১ বার এসেছে। প্রতিটি নেয়ামত বর্ণনার পর মানুষ ও জিন — উভয় সম্প্রদায়কে প্রশ্ন করা হচ্ছে: এত নেয়ামতের পরও কোনটি অস্বীকার করবে? এটি কৃতজ্ঞতার দিকে বারবার আহ্বান।',
 '65:3': 'যে আল্লাহর ওপর তাওয়াক্কুল (ভরসা) করে, আল্লাহ তার জন্য যথেষ্ট হন এবং এমন উৎস থেকে রিজিক দেন যা সে কল্পনাও করেনি। তাওয়াক্কুল অর্থ চেষ্টা করে ফলাফল আল্লাহর হাতে ছেড়ে দেওয়া।',
 '67:1': 'সার্বভৌম কর্তৃত্ব একমাত্র আল্লাহর হাতে; তিনি সবকিছুর ওপর ক্ষমতাবান। "তাবারাকা" অর্থ তাঁর কল্যাণ ও মাহাত্ম্য অপরিসীম।',
 '67:2': 'মৃত্যু ও জীবন সৃষ্টির উদ্দেশ্য পরীক্ষা: কে সবচেয়ে উত্তম আমল করে — আমলের পরিমাণ নয়, মান (ইখলাস ও সুন্নাহ অনুযায়ী হওয়া) ই এখানে বিবেচ্য।',
 '94:5': 'নিশ্চয় কষ্টের সঙ্গেই স্বস্তি রয়েছে — কষ্টের পরে নয়, সঙ্গে। অর্থাৎ প্রতিটি সংকটের ভেতরেই মুক্তির বীজ থাকে; একটি কষ্ট দুটি স্বস্তিকে হারাতে পারে না।',
 '94:6': 'আগের আয়াতের বক্তব্য জোর দিয়ে পুনরাবৃত্তি করা হয়েছে, যাতে রাসূল ﷺ ও প্রতিটি মুমিন নিশ্চিত থাকে: কষ্ট স্থায়ী নয়, স্বস্তি অবশ্যম্ভাবী।',
 '97:1': 'লাইলাতুল কদরে পুরো কুরআন লাওহে মাহফুজ থেকে প্রথম আসমানে নাজিল হয়; এরপর ২৩ বছরে ধাপে ধাপে রাসূল ﷺ-এর ওপর অবতীর্ণ হয়। (তাফসিরে ইবনে কাসির)',
 '97:3': 'এই এক রাতের ইবাদত হাজার মাস (৮৩ বছর ৪ মাস) এর ইবাদতের চেয়ে উত্তম — এমন ব্যক্তির জন্যও সম্ভব যার পুরো জীবনই ৮৩ বছর নয়। এটি উম্মতে মুহাম্মদির জন্য বিশেষ অনুগ্রহ।',
 '97:4': 'এই রাতে ফেরেশতাগণ ও "রূহ" (জিবরাইল আ.) আল্লাহর হুকুমে প্রতিটি নির্ধারিত বিষয় নিয়ে পৃথিবীতে অবতরণ করেন — তাই রাতটি বরকতময়।',
 '97:5': 'ফজর উদয় পর্যন্ত পুরো রাতটাই শান্তি ও কল্যাণে ভরা; শয়তানের অনিষ্ট থেকে এটি সুরক্ষিত রাত।',
 '103:1': 'আল্লাহ সময়ের শপথ করেছেন — সময় মানুষের জীবনের মূলধন; তা কাজে লাগানো বা নষ্ট করার ওপরই সাফল্য-ব্যর্থতা নির্ভর করে।',
 '103:2': 'সমগ্র মানবজাতি ক্ষতির মধ্যে রয়েছে — কারণ জীবন নামের পুঁজি প্রতিদিন কমছে, অথচ অধিকাংশ মানুষ তা আখিরাতের কাজে লাগায় না।',
 '103:3': 'ক্ষতি থেকে বাঁচার চার শর্ত: (১) ঈমান, (২) নেক আমল, (৩) পরস্পরকে সত্যের উপদেশ (দাওয়াত ও সৎকাজের আদেশ), (৪) পরস্পরকে ধৈর্যের উপদেশ। শুধু নিজে ভালো হওয়া যথেষ্ট নয় — অন্যকে ভালোর দিকে ডাকাও শর্ত।',
 '108:1': 'কাউসার অর্থ প্রচুর কল্যাণ; বিশেষভাবে জান্নাতে রাসূলুল্লাহ ﷺ-কে দেওয়া হাউজ/নহরের নাম কাউসার। মক্কার কাফেররা তাঁকে "আবতার" (নির্বংশ) বলায় সান্ত্বনা হিসেবে এই সূরা নাজিল হয়।',
 '108:2': 'নেয়ামতের শুকরিয়া: নামাজ শুধু আল্লাহর জন্য এবং কুরবানিও শুধু তাঁর নামে — ইবাদতে কাউকে শরিক করা যাবে না।',
 '108:3': 'প্রকৃত নির্বংশ তারাই যারা রাসূল ﷺ-এর শত্রু; আর তাঁর নাম ও বাণী যুগে যুগে জীবিত থাকবে — ইতিহাসই এর প্রমাণ।',
 '109:6': 'তাওহিদে কোনো আপস নেই: কাফেররা প্রস্তাব দিয়েছিল এক বছর একে অপরের উপাস্যের ইবাদত করার — তার জবাবে এই স্পষ্ট ঘোষণা। নিজের ধর্মে অবিচল থাকা ও অন্যের ধর্মে হস্তক্ষেপ না করা — দুটোই এখানে শিক্ষা।',
 '112:1': 'আল্লাহ এক ও অদ্বিতীয় — তাঁর সত্তা, গুণাবলি ও ইবাদতে কোনো শরিক নেই। এই সূরা তাওহিদের বিশুদ্ধ ঘোষণা।',
 '112:2': '"সামাদ" অর্থ: তিনি সবার প্রয়োজন পূরণকারী, সবাই তাঁর মুখাপেক্ষী; অথচ তিনি কারো মুখাপেক্ষী নন, তাঁর কোনো অভাব নেই।',
 '112:3': 'আল্লাহ কাউকে জন্ম দেননি এবং তাঁকেও জন্ম দেওয়া হয়নি — সন্তান ও পিতা-মাতার সম্পর্ক থেকে তিনি পবিত্র। এটি খ্রিস্টান ও মুশরিকদের ভ্রান্ত ধারণার জবাব।',
 '112:4': 'তাঁর সমতুল্য, সমকক্ষ বা সদৃশ কেউ নেই — কোনো দিক থেকেই সৃষ্টির সঙ্গে তাঁর তুলনা চলে না।',
 '113:1': 'ভোরের রবের কাছে আশ্রয় — যিনি অন্ধকার বিদীর্ণ করে আলো আনেন, তিনিই সব অনিষ্ট দূর করতে সক্ষম। এই সূরা ও সূরা আন-নাস মিলে "মুআওয়িযাতাইন"; সকাল-সন্ধ্যায় পড়া সুন্নাত।',
 '114:1': 'মানুষের রব, বাদশাহ ও ইলাহ — এই তিনটি গুণ উল্লেখ করে আশ্রয় চাওয়া হয়েছে গোপনে কুমন্ত্রণাদাতা শয়তানের থেকে, যে মানুষের বুকে ওয়াসওয়াসা দিয়ে পিছিয়ে যায়। কুরআনের শেষ সূরাটি সুরক্ষার দোয়া দিয়ে শেষ হয়েছে।'
};
$('readerBody').addEventListener('click', function(e){
  var b = e.target.closest('[data-tafsir]'); if (!b) return;
  var box = $('tfs-' + b.getAttribute('data-tafsir'));
  if (!box) return;
  box.classList.toggle('hidden');
  b.textContent = box.classList.contains('hidden') ? 'তাফসির দেখুন' : 'তাফসির লুকান';
});
</script>
<script>
/* ================= New sections: tilawat, kitab, articles, quran shikkha, taleem, amal, roza, sunnah, mosque, bayan, fitra, hijri calendar, dua bookmarks, last read ================= */

/* ---------- Tilawat (full-surah audio) ---------- */
var tilSurah = null;
function tilUrl(n){ return 'https://cdn.mp3quran.net/audio/maher-muaiqly/r1/' + ('00' + n).slice(-3) + '.mp3'; }
function buildTilawat(){
  if (typeof QURAN === 'undefined' || !QURAN) return;
  var q = ($('tilSearch').value || '').trim();
  var html = '';
  QURAN.surahs.forEach(function(s, i){
    if (q && (SURA_BN[i] + ' ' + s.n).indexOf(q) === -1) return;
    var playing = tilSurah === s.n && !player.paused;
    html += '<button class="srow" data-til="' + s.n + '"><span class="sno">' + bn(s.n) + '</span><span class="tt"><b>সূরা ' + SURA_BN[i] + ' (' + s.ar + ')</b><span>' + bn(s.cnt) + ' আয়াত • ' + (s.rev === 'Makki' ? 'মাক্কী' : 'মাদানী') + '</span></span><span style="font-weight:700; color:var(--gold)">' + (playing ? '❚❚ চলছে' : '▶ শুনুন') + '</span></button>';
  });
  $('tilList').innerHTML = html || '<p class="loadmsg">কিছু পাওয়া যায়নি।</p>';
}
loadQuran(function(){ buildTilawat(); });
$('tilSearch').addEventListener('input', buildTilawat);
$('tilReciter').addEventListener('change', function(){ toast('তিলাওয়াতে শুধু ক্বারী মাহের আল-মুয়াইকলির তিলাওয়াত রয়েছে'); });
$('tilList').addEventListener('click', function(e){
  var b = e.target.closest('[data-til]'); if (!b) return;
  var n = +b.getAttribute('data-til');
  if (tilSurah === n && !player.paused){ player.pause(); }
  else { stopAudio(); tilSurah = n; playAudioSmart(tilUrl(n)); }
  setTimeout(buildTilawat, 80);
});
player.addEventListener('ended', function(){ if (tilSurah){ tilSurah = null; buildTilawat(); } });
player.addEventListener('pause', function(){ if (tilSurah && currentView === 'tilawat') setTimeout(buildTilawat, 80); });

/* v2.7: Maher Al-Muaiqly full-surah audio auto-downloads in the background for offline listening */
var tilDlStarted = false;
function autoDownloadTilawat(){
  if (tilDlStarted || !('caches' in window)) return; tilDlStarted = true;
  var status = $('audioDlStatus');
  function upd(done){
    if (!status) return;
    status.textContent = done >= 114
      ? '✅ পুরো কোরআনের তিলাওয়াত অফলাইনের জন্য ডাউনলোড সম্পূর্ণ — এখন নেট ছাড়াই শোনা যাবে।'
      : '⬇ অফলাইনের জন্য তিলাওয়াত ডাউনলোড হচ্ছে… ' + bn(done) + '/১১৪ সূরা (নিজে নিজেই হচ্ছে)';
  }
  caches.open(AUDIO_CACHE).then(function(cache){
    var n = 1, done = 0;
    function next(){
      if (n > 114){ upd(114); return; }
      var url = tilUrl(n);
      cache.match(url).then(function(m){
        if (m){ done++; upd(done); n++; next(); }
        else {
          cache.add(url).then(function(){ done++; upd(done); n++; setTimeout(next, 120); })
            .catch(function(){ setTimeout(next, 900); });
        }
      }).catch(function(){ setTimeout(next, 900); });
    }
    next();
  }).catch(function(){});
}
setTimeout(autoDownloadTilawat, 3500);

/* ---------- Kitab ---------- */
var KITAB = [
 { t:'রিয়াদুস সালেহিন', a:'ইমাম আবু যাকারিয়া আন-নববি (রহ.) (মৃ. ৬৭৬ হি.)', d:'কুরআনের আয়াত ও প্রায় ১,৯০০ হাদিসের অনন্য সংকলন — তাকওয়া, সবর, সত্যবাদিতা, পিতামাতার হক, প্রতিবেশীর হকসহ দৈনন্দিন জীবনের প্রায় সব বিষয়ে অধ্যায় সাজানো। ঘরের তালিম ও ব্যক্তিগত পাঠের জন্য সবচেয়ে উপযোগী বইগুলোর একটি।' },
 { t:'ফিকহুস সুন্নাহ', a:'সাইয়েদ সাবেক (রহ.)', d:'ইবাদতের ফিকহ — পবিত্রতা, নামাজ, রোজা, যাকাত ও হজের মাসআলা কুরআন-হাদিসের দলিলসহ সহজ ভাষায়। চার মাযহাবের মতামতের তুলনামূলক আলোচনাও রয়েছে।' },
 { t:'বেহেশতি জেওর', a:'মাওলানা আশরাফ আলী থানভি (রহ.)', d:'মহিলাদের জন্য রচিত বিখ্যাত ফিকহের বই — ঈমান, ইবাদত, বিবাহ, পর্দা ও দৈনন্দিন জীবনের মাসআলা। উপমহাদেশের ঘরে ঘরে পঠিত।' },
 { t:'ফাজায়েলে আমল', a:'শায়খুল হাদিস মাওলানা মুহাম্মদ জাকারিয়া কান্ধলভি (রহ.)', d:'নামাজ, কুরআন তিলাওয়াত, যিকির, রমজান, হজ ও দাওয়াতের ফজিলত-বিষয়ক হাদিসের সংকলন — ফাজায়েলে কুরআন, ফাজায়েলে নামাজ, ফাজায়েলে রমজান ইত্যাদি খণ্ডে বিভক্ত; তালিমের মজলিসে বহুল পঠিত।' },
 { t:'আর-রাহিকুল মাখতুম (সীরাতে নববি)', a:'আল্লামা সফিউর রহমান মোবারকপুরি (রহ.)', d:'রাসূলুল্লাহ ﷺ-এর পূর্ণাঙ্গ জীবনী — জন্ম থেকে ওফাত পর্যন্ত ধারাবাহিক ও প্রামাণ্য বর্ণনা। মক্কা শরিফে অনুষ্ঠিত বিশ্ব সীরাত প্রতিযোগিতায় প্রথম পুরস্কারপ্রাপ্ত গ্রন্থ।' },
 { t:'তাফসিরে মারফুল কুরআন', a:'মুফতি মুহাম্মদ শাফি (রহ.)', d:'উর্দু ভাষায় রচিত সহজ ও নির্ভরযোগ্য তাফসির; বাংলা অনুবাদও বহুল প্রচলিত। প্রতি সূরার সারসংক্ষেপ ও আয়াতের ব্যাখ্যা সাধারণ পাঠকের উপযোগী করে লেখা।' },
 { t:'তাফসিরে ইবনে কাসির', a:'হাফিজ ইমাদুদ্দিন ইবনে কাসির (রহ.) (মৃ. ৭৭৪ হি.)', d:'সবচেয়ে প্রসিদ্ধ আছারভিত্তিক তাফসির — কুরআনের আয়াত দিয়ে আয়াতের ব্যাখ্যা, হাদিস ও সাহাবিদের বর্ণনার ভিত্তিতে তাফসির। গভীর অধ্যয়নের জন্য অপরিহার্য।' },
 { t:'হিসনুল মুসলিম', a:'ড. সাইদ ইবন আলি আল-কাহতানি', d:'কুরআন ও সহিহ হাদিস থেকে সংকলিত দৈনন্দিন দোয়া ও যিকিরের ছোট্ট কিন্তু অমূল্য বই — সকাল-সন্ধ্যার আমল, ঘুম, খাবার, সফরসহ জীবনের প্রতিটি মুহূর্তের দোয়া।' }
];
