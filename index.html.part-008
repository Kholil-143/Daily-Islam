    <div id="sub-tracker" class="subview hidden">
      <h2 class="sec">নামাজ ট্র্যাকার</h2>
      <p class="sub">আজ কোন কোন ওয়াক্তের নামাজ পড়লেন, টিক দিয়ে রাখুন। ওয়াক্তের বোতামে চাপ দিলেই হিসাব বদলে যাবে। (এই হিসাব শুধু এই সেশনের জন্য — পেজ বন্ধ করলে মুছে যাবে।)</p>
      <div class="card" id="trackerCard"></div>
    </div>

    <div id="sub-hajj" class="subview hidden">
      <h2 class="sec">হজ ও উমরাহ গাইড</h2>
      <p class="sub">ধাপে ধাপে হজ ও উমরাহর নিয়ম এবং প্রধান দোয়াসমূহ। এটি একটি সাধারণ গাইড — সফরের আগে নির্ভরযোগ্য আলেম ও অভিজ্ঞ গাইডের পরামর্শ নিন।</p>
      <div id="hajjBody"></div>
    </div>

    <div id="sub-baby" class="subview hidden">
      <h2 class="sec">ইসলামিক নামের ভান্ডার</h2>
      <p class="sub">ছেলে ও মেয়েদের সুন্দর ইসলামিক নাম — অর্থসহ। রাসূলুল্লাহ ﷺ বলেছেন, কিয়ামতের দিন তোমাদের নিজের নাম ও পিতার নামে ডাকা হবে, তাই সুন্দর নাম রাখো। (সুনানে আবু দাউদ: ৪৯৪৮)</p>
      <div class="seg" role="group" aria-label="নামের ধরন">
        <button id="segBoy" aria-pressed="true">ছেলেদের নাম</button>
        <button id="segGirl" aria-pressed="false">মেয়েদের নাম</button>
      </div>
      <input class="search" type="text" id="babySearch" placeholder="নাম খুঁজুন…" aria-label="নাম খুঁজুন" />
      <div class="names" id="babyList" style="grid-template-columns:repeat(2,1fr)"></div>
    </div>

    <div id="sub-masala" class="subview hidden">
      <h2 class="sec">সাধারণ মাসআলা প্রশ্নোত্তর</h2>
      <p class="sub">দৈনন্দিন জীবনের সাধারণ প্রশ্নের সংক্ষিপ্ত উত্তর (হানাফি ফিকহ অনুযায়ী)। জটিল বা ব্যক্তিগত বিষয়ে অবশ্যই নির্ভরযোগ্য আলেমের ফতোয়া নিন।</p>
      <input class="search" type="text" id="masalaSearch" placeholder="প্রশ্ন খুঁজুন…" aria-label="মাসআলা খুঁজুন" />
      <div id="masalaList"></div>
    </div>

    <div id="sub-roza" class="subview hidden">
      <h2 class="sec">নফল রোজার তালিকা ও ফজিলত</h2>
      <p class="sub">ফরজ রোজার বাইরে সারা বছর যেসব নফল রোজা রাখা সুন্নাত ও মোস্তাহাব।</p>
      <div id="rozaList"></div>
    </div>

    <div id="sub-days" class="subview hidden">
      <h2 class="sec">হিজরি ক্যালেন্ডার ও গুরুত্বপূর্ণ দিবস</h2>
      <p class="sub">চলতি হিজরি মাসের ক্যালেন্ডার — প্রতিটি ঘরে হিজরি তারিখ ও ছোট করে ইংরেজি তারিখ দেওয়া আছে। নিচে হিজরি তারিখ অনুযায়ী বছরের গুরুত্বপূর্ণ দিবসসমূহ — আসন্ন তারিখটি হিজরি ক্যালেন্ডার অনুযায়ী হিসাব করে দেখানো হয়েছে (চাঁদ দেখার ওপর ভিত্তি করে এক-দুই দিন এদিক-সেদিক হতে পারে)।</p>
      <div class="card" style="padding:16px; margin-bottom:14px">
        <h3 style="margin:0 0 10px; text-align:center" id="hijriCalTitle"></h3>
        <div id="hijriCal"></div>
      </div>
      <div id="daysList"></div>
    </div>
  </section>

  <!-- ================= PROFILE ================= -->
  <section class="view" id="view-profile">
    <h2 class="sec">আমার প্রোফাইল</h2>
    <div id="lastReadBox"></div>
    <div id="profileBody"></div>
  </section>

  <!-- ================= RAMADAN ================= -->
  <section class="view" id="view-ramadan">
    <h2 class="sec">রমজান ও রোজা</h2>
    <p class="sub">সেহরি ও ইফতারের সময় নির্বাচিত জেলা অনুযায়ী হিসাব করা (সেহরি: ফজরের প্রায় ১০ মিনিট আগে শেষ — ইসলামিক ফাউন্ডেশন বাংলাদেশের সতর্কতামূলক সময় অনুযায়ী; ইফতার: মাগরিবের সময়)।</p>
    <div class="card" style="text-align:center; padding:24px 18px">
      <p style="margin:0; color:var(--ink-2)" id="ramadanHijri">…</p>
      <div style="display:flex; flex-wrap:wrap; gap:14px; justify-content:center; margin-top:14px">
        <div style="flex:1; min-width:150px; border:1px solid var(--line); border-radius:14px; padding:14px">
          <div style="color:var(--ink-2); font-size:14px">আজকের সেহরির শেষ সময়</div>
          <div style="font-size:30px; font-weight:700" id="sehriTime">—</div>
        </div>
        <div style="flex:1; min-width:150px; border:1px solid var(--gold); border-radius:14px; padding:14px; background:rgba(201,162,75,.08)">
          <div style="color:var(--ink-2); font-size:14px">আজকের ইফতার</div>
          <div style="font-size:30px; font-weight:700" id="iftarTime">—</div>
        </div>
      </div>
      <p style="margin:16px 0 0; font-size:17px" id="ramadanNextLbl">পরবর্তী</p>
      <div style="font-size:clamp(34px,8vw,46px); font-weight:700; font-variant-numeric:tabular-nums; color:var(--green-800)" id="ramadanCd">--:--:--</div>
      <p class="sub" style="margin-bottom:0" id="ramadanNote"></p>
    </div>
    <div class="card" style="margin-top:12px">
      <h3 style="margin-top:0">রোজা সম্পর্কে জরুরি কথা</h3>
      <p>রমজানের রোজা প্রতিটি প্রাপ্তবয়স্ক, সুস্থ মুসলিমের ওপর ফরজ (সূরা আল-বাকারা: ১৮৩)। সেহরি খাওয়া সুন্নাত ও বরকতময় (সহিহ বুখারি: ১৯২৩), আর সূর্যাস্তের সঙ্গে সঙ্গে দ্রুত ইফতার করা সুন্নাত (সহিহ বুখারি: ১৯৫৭)। রোজা অবস্থায় মিথ্যা ও গুনাহের কাজ ছাড়তে না পারলে শুধু ক্ষুধা-তৃষ্ণাই সার হয় (সহিহ বুখারি: ১৯০৩)।</p>
      <p style="margin-bottom:0">সেহরি ও ইফতারের দোয়া পাবেন <b>দোয়া</b> অংশে। নফল রোজার তালিকা দেখুন <b>আরও → নফল রোজা</b> অংশে।</p>
    </div>
  </section>
  <!-- ================= TILAWAT ================= -->
  <section class="view" id="view-tilawat">
    <h2 class="sec">তিলাওয়াত — পূর্ণ সূরার অডিও</h2>
    <p class="sub">ক্বারী মাহের আল-মুয়াইকলির কণ্ঠে পূর্ণ সূরার তিলাওয়াত। সব সূরার অডিও অ্যাপ খুললেই নিজে নিজে ডাউনলোড হয়ে যায় — তারপর ইন্টারনেট ছাড়াই শোনা যাবে।</p>
    <p class="sub" id="audioDlStatus" style="font-weight:700"></p>
    <div class="controls">
      <label>ক্বারী
        <select id="tilReciter">
          <option value="maher">মাহের আল-মুয়াইকলি</option>
        </select>
      </label>
    </div>
    <input class="search" type="text" id="tilSearch" placeholder="সূরা খুঁজুন…" aria-label="সূরা খুঁজুন" />
    <div class="slist" id="tilList"><p class="loadmsg">তালিকা লোড হচ্ছে…</p></div>
  </section>

  <!-- ================= KITAB ================= -->
  <section class="view" id="view-kitab">
    <h2 class="sec">কিতাব — ইসলামিক বইয়ের ভান্ডার</h2>
    <p class="sub">কওমি মাদরাসার পাঠ্য ও প্রসিদ্ধ ইসলামিক কিতাবের ভান্ডার — বেশিরভাগ বইয়ের পিডিএফ এখানেই দেওয়া আছে, বোতামে চাপ দিলেই পড়া বা ডাউনলোড করা যাবে। ওপরে খুঁজে নিন পছন্দের কিতাব।</p>
    <input class="search" type="text" id="kitabSearch" placeholder="কিতাব খুঁজুন…" aria-label="কিতাব খুঁজুন" />
    <div id="kitabList"></div>
  </section>

  <!-- ================= PROBONDHO ================= -->
  <section class="view" id="view-probondho">
    <h2 class="sec">প্রবন্ধ — ইসলামিক রচনাবলি</h2>
    <p class="sub">ঈমান, আমল ও চরিত্র নিয়ে সংক্ষিপ্ত প্রবন্ধ। যেকোনো শিরোনামে চাপ দিলে পুরো লেখা খুলবে।</p>
    <div id="articleList"></div>
  </section>

  <!-- ================= QURAN SHIKKHA ================= -->
  <section class="view" id="view-qshikkha">
    <h2 class="sec">কুরআন শিক্ষা — হরফ ও তাজউইদ</h2>
    <p class="sub">শূন্য থেকে কুরআন পড়া শেখার প্রথম ধাপ: আরবি হরফ চেনা, মাখরাজ ও তাজউইদের মূল নিয়ম। এরপর একজন শিক্ষকের কাছে সহিহ তিলাওয়াত শেখা সবচেয়ে উত্তম।</p>
    <h3 style="font-family:'Noto Sans Bengali','Hind Siliguri',sans-serif">আরবি হরফ — ২৯টি</h3>
    <div class="names" id="letterGrid" style="grid-template-columns:repeat(3,1fr)"></div>
    <h3 style="font-family:'Noto Sans Bengali','Hind Siliguri',sans-serif; margin-top:22px">তাজউইদের মূল নিয়ম</h3>
    <div id="tajwidBody">
      <details class="acc"><summary>নূন সাকিনা ও তানভিনের বি