" alt="" />
  <div class="shade"></div>
  <div class="hero-in">
    <div class="topbar">
      <span class="date-chip" id="topDateChip">…</span>
      <span class="top-right">
        <button id="themeBtn" class="theme-mini" aria-label="ডার্ক / লাইট থিম বদলান" title="ডার্ক / লাইট থিম"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 13.2A8.2 8.2 0 1 1 10.8 4a6.6 6.6 0 0 0 9.2 9.2z"/></svg></button>
        <span class="loc-pill">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 21s-6.5-5.4-6.5-10.2A6.5 6.5 0 0 1 12 4a6.5 6.5 0 0 1 6.5 6.8C18.5 15.6 12 21 12 21z"/><circle cx="12" cy="10.6" r="2.3"/></svg>
          <select id="homeCitySel" aria-label="লোকেশন বেছে নিন — জায়গা বদলালে সময়সূচি বদলে যাবে"></select>
        </span>
      </span>
    </div>
    <div class="hijri-banner">
      <div class="hb-main" id="hijriBig">…</div>
      <div class="hb-sub" id="hijriSub">…</div>
      <p style="margin:0"><button id="profileChip" class="profile-chip">গেস্ট হিসেবে আছেন — প্রোফাইল দেখুন</button></p>
    </div>
    <div class="waqt-card">
      <div class="wq-top">
        <span class="wq-live"><span class="dot"></span>চলমান</span>
        <span class="wq-clock" id="clock">--:--:--</span>
      </div>
      <div class="arcwrap" aria-hidden="true">
        <svg viewBox="0 0 300 132">
          <path d="M25 122 A 125 125 0 0 1 275 122" fill="none" stroke="rgba(201,162,75,.35)" stroke-width="2.5" stroke-dasharray="5 6" stroke-linecap="round"/>
          <line x1="8" y1="122" x2="292" y2="122" stroke="rgba(201,162,75,.5)" stroke-width="2" stroke-linecap="round"/>
          <g id="arcSun">
            <circle id="arcSunC" cx="45" cy="122" r="13" fill="#e3c878" stroke="#c9a24b" stroke-width="2"/>
            <g id="arcSunRays" stroke="#e3c878" stroke-width="2.4" stroke-linecap="round">
              <line x1="45" y1="100" x2="45" y2="93"/><line x1="45" y1="151" x2="45" y2="144" transform="rotate(180 45 122)"/>
            </g>
          </g>
          <g id="arcMoon" style="display:none">
            <path id="arcMoonP" d="M52 108 a15 15 0 1 0 10 22 a11.5 11.5 0 1 1 -10 -22z" fill="#fdf6da" stroke="#c9a24b" stroke-width="1.6"/>
          </g>
        </svg>
      </div>
      <div class="wq-name" id="wqName">—</div>
      <div class="wq-end" id="wqEnd"></div>
      <div class="wq-bar"><i id="wqProg"></i></div>
      <div class="wq-next" id="wqNext"></div>
      <div class="wq-cd" id="wqCd">--:--:--</div>
      <span id="nextPrayerName" hidden></span><span id="nextPrayerCd" hidden></span>
    </div>
    <div class="hero-prayer">
      <button class="refresh-btn" id="refreshBtn" aria-label="সময় ও তারিখ রিফ্রেশ করুন" title="রিফ্রেশ করুন"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12a9 9 0 1 1-2.64-6.36"/><path d="M21 3v6h-6"/></svg></button>
      <div class="hp-head" style="padding-right:44px">
        <span class="hp-city" id="homePrayerCity"></span>
      </div>
      <div id="homePrayerList"></div>
      <div class="hp-loc">
        <button type="button" id="homeGpsBtn">GPS দিয়ে আমার লোকেশন নিন</button>
        <button type="button" id="homeSearchBtn">অন্য জায়গা খুঁজুন</button>
      </div>
      <p class="hp-foot"><button data-goto="prayer">তারিখ অনুযায়ী পূর্ণ সময়সূচি →</button></p>
    </div>
  </div>
</header>



<main class="wrap">

  <!-- ================= HOME ================= -->
  <section class="view on" id="view-home">
    <div class="card" style="padding:14px 16px; margin-bottom:14px">
      <input class="search" type="text" id="globalSearch" placeholder="সব জায়গায় খুঁজুন — সূরা, হাদিস, দোয়া, আল্লাহর নাম, শিশুর নাম…" aria-label="সব জায়গায় খুঁজুন" style="margin:0" />
      <div id="globalResults"></div>
    </div>
    <h2 class="hsec" style="margin-top:2px">ইলম ও আমল</h2>
    <div class="hgrid" id="featureGridIlm"></div>
    <h2 class="hsec">সেবা</h2>
    <div class="hgrid" id="featureGridSeba"></div>

    <div class="daily">
      <div class="card">
        <h3>আজকের আয়াত</h3>
        <p class="ar" id="dailyAyahAr">…</p>
        <p id="dailyAyahBn"></p>
        <p class="src" id="dailyAyahSrc"></p>
      </div>
      <div class="card">
        <h3>আজকের হাদিস</h3>
        <p class="ar" id="dailyHadithAr">…</p>
        <p id="dailyHadithBn"></p>
        <p class="src" id="dailyHadithSrc"></p>
      </div>
    </div>

  </section>

  <!-- ================= PRAYER ================= -->
  <section class="view" id="view-prayer">
    <h2 class="sec">নামাজের সময়সূচি</h2>
    <p class="sub">ডিফল্ট লোকেশন <b>ভাঙা, ফরিদপুর</b> — তবে লোকেশন যেকোনো সময় বদলানো যায়। তালিকা থেকে যেকোনো জেলা বেছে নিন, "আমার লোকেশন (GPS)" চাপ দিয়ে নিজের অবস্থান নিন, অথবা নিচের খোঁজার ঘরে <b>যেকোনো জায়গার নাম</b> (গ্রাম, থানা, শহর বা দেশ — বাংলা বা ইংরেজিতে) লিখলেই সেই জায়গার সময়সূচি হয়ে যাবে। বেছে নেওয়া লোকেশন এই সেশনে সব জায়গায় (হোম, কাউন্টডাউন, সেহরি-ইফতার, কিবলা) প্রযোজ্য থাকবে। তারিখ বদলে যেকোনো দিনের সময় দেখা যায়। (আসর: হানাফি মাযহাব অনুযায়ী।)</p>
    <div class="controls">
      <label>জেলা / শহর
        <select id="citySel"></select>
      </label>
      <label>তারিখ
        <input type="date" id="prayerDate" />
      </label>
      <button class="btn" id="todayBtn">আজকের তারিখ</button>
      <button class="btn gold" id="gpsBtn" type="button">আমার লোকেশন (GPS)</button>
      <span id="locStatus" style="font-weight:600; align-self:center"></span>
    </div>
    <div class="controls" style="margin-top:2px">
      <label style="flex:1 1 240px">যেকোনো জায়গা খুঁজুন — শুধু নাম লিখলেই ওই জায়গার সময়
        <input type="text" id="placeSearch" placeholder="যেমন: ভাঙা, নগরকান্দা, কুমিল্লা, Makkah, Dubai…" aria-label="যেকোনো জায়গার নাম লিখে খুঁজুন" />
      </label>
      <button class="btn gold" id="placeSearchBtn" type="button">এই জায়গার সময় দেখুন</button>
      <span id="placeStatus" style="font-weight:600; align-self:center"></span>
    </div>
    <details style="margin:0 0 14px">
      <summary style="font-weight:600; cursor:pointer">জায়গা খুঁজে না পেলে — অক্ষাংশ / দ্রাঘিমাংশ দিয়ে সেট করুন</summary>
      <div class="controls" style="margin-top:10px">
        <label>জায়গার নাম
          <input type="text" id="customName" placeholder="যেমন: আমার গ্রাম" />
        </label>
        <label>অক্ষাংশ (Latitude)
          <input type="number" step="any" id="customLat" placeholder="যেমন: 23.3736" />
        </label>
        <label>দ্রাঘিমাংশ (Longitude)
          <input type="number" step="any" id="customLng" placeholder="যেমন: 90.0272" />
        </label>
        <button class="btn" id="customApply" type="button">এই লোকেশন ব্যবহার করুন</button>
      </div>
      <p class="sub" style="margin:0">Google Maps-এ জায়গাটিতে চাপ দিয়ে ধরে রাখলেই নিচে অক্ষাংশ-দ্রাঘিমাংশ দেখা যায়।</p>
    </details>
    <div class="card" style="padding:6px 0; overflow:hidden">
      <table class="ptable">
        <thead><tr><th>নামাজ</th><th>শুরু</th><th>শেষ</th><th>অ্যালার্ম</th></tr></thead>
        <tbody id="prayerBody"></tbody>
      </table>
    </div>
    <div class="card" style="padding:14px 16px; margin-top:14px">
      <h3 style="margin:0 0 8px">নফল নামাজের সময়</h3>
      <table class="ptable"><tbody id="nafalBody"></tbody></table>
    </div>
    <div class="card" style="padding:14px 16px; margin-top:12px; border-color:var(--danger)">
      <h3 style="margin:0 0 6px; color:var(--danger)">⚠ নামাজের নিষিদ্ধ সময়</h3>
      <p class="sub" style="margin:0 0 8px">এই সময়গুলোতে নামাজ পড়া নিষিদ্ধ/মাকরুহে তাহরিমি — সূর্যোদয়ের সময়, সূর্য ঠিক মাথার ওপরে থাকার সময় (জাওয়াল) এবং সূর্যাস্তের সময়। (সহিহ মুসলিম: ৮৩১)</p>
      <table class="ptable"><tbody id="forbidBody"></tbody></table>
    </div>
    <div class="card" style="padding:14px 16px; margin-top:12px" id="alarmCard">
      <h3 style="margin:0 0 6px">নামাজের অ্যালার্ম ও রিমাইন্ডার</h3>
      <p class="sub" style="margin:0 0 10px">প্রতিটি ওয়াক্তের অ্যালার্ম অন করলে ওয়াক্ত শুরু হলে (বা পছন্দমতো কয়েক মিনিট আগে) শব্দ বাজিয়ে রিমাইন্ডার দেওয়া হবে। সেহরি ও ইফতারের জন্যও আলাদা অ্যালার্ম আছে। অ্যালার্ম শুধু এই পেজটি খোলা থাকলেই বাজবে এবং সেটিংস এই সেশনেই থাকে। শব্দ ঠিকমতো বাজে কিনা "টেস্ট শুনুন" দিয়ে যাচাই করে নিন।</p>
      <div id="alarmRows"></div>
      <div class="zform" style="margin-top:14px">
        <label>রিমাইন্ডারের শব্দ
          <select id="alarmSound">
            <option value="bell">মধুর ঘণ্টা ধ্বনি</option>
            <option value="melody">নরম সুর</option>
            <option value="beep">সতর্ক বিপ</option>
          </select>
        </label>
        <label>ভলিউম
          <input type="range" id="alarmVol" min="0" max="100" value="80" />
        </label>
      </div>
      <p style="margin:14px 0 0; display:flex; gap:10px; flex-wrap:wrap"><button class="btn gold" id="alarmTest">টেস্ট শুনুন</button><button class="btn" id="alarmStop" disabled>বন্ধ করুন</button></p>
    </div>
    <p class="sub" style="margin-top:12px" id="prayerNote"></p>
  </section>

  <!-- ================= QURAN ================= -->
  <section class="view" id="view-quran">
    <div id="quranListWrap">
      <h2 class="sec">পবিত্র কুরআন</h2>
      <p class="sub">সম্পূর্ণ ১১৪ সূরা — আরবি পাঠ, বাংলা অর্থ (অনুবাদ: মুহিউদ্দীন খান) ও প্রতি আয়াতের তিলাওয়াত অডিও (ক্বারী বাছাইয়ের সুবিধাসহ)। "পারা অনুযায়ী" চাপ দিলে ১–৩০ পারার আলাদা তালিকা পাবেন — যেকোনো পারা বেছে পড়া যাবে। যেসব আয়াতের তাফসির সংকলিত আছে, সেগুলোর অর্থের নিচে <b>"তাফসির দেখুন"</b> বোতাম পাবেন।</p>
      <div class="seg" role="group" aria-label="তালিকার ধরন">
        <button id="segSurah" aria-pressed="true">সূরা অনুযায়ী</button>
        <button id="segJuz" aria-pressed="false" title="কুরআনের ভিতরেই ৩০ পারার তালিকা">পারা অনুযায়ী (৩০ পারা)</button>
      </div>
      <input class="search" type="text" id="surahSearch" placeholder="সূরা খুঁজুন — নাম বা নম্বর লিখুন…" aria-label="সূরা খুঁজুন" />
      <div class="slist" id="surahList"><p class="loadmsg">কুরআনের তথ্য লোড হচ্ছে…</p></div>
      <div class="slist hidden" id="juzList"></div>
    </div>
    <div id="readerWrap" class="hidden">
      <div class="reader-head">
        <button class="btn ghost" id="readerBack">← তালিকায় ফিরুন</button>
        <h3 id="readerTitle"></h3>
        <button class="btn gold" id="playAllBtn">▶ পুরো অংশ শুনুন</button>
        <button class="btn ghost" id="bookmarkBtn">🔖 বুকমার্ক করুন</button>
        <label style="display:flex; align-items:center; gap:7px; font-weight:600; font-size:14.5px">ক্বারী:
          <select id="reciterSel" aria-label="ক্বারী বাছাই করুন">
            <option value="ar.alafasy">মিশারি রাশিদ আল-আফাসি</option>
            <option value="ar.husary">মাহমুদ খলিল আল-হুসারি</option>
            <option value="ar.minshawi">মুহাম্মদ সিদ্দিক আল-মিনশাওয়ি</option>
            <option value="ar.abdulbasitmurattal">আব্দুল বাসিত আব্দুস সামাদ</option>
            <option value="ar.mahermuaiqly">মাহের আল-মুয়াইকলি</option>
            <option value="ar.hanirifai">হানি আর-রিফায়ি</option>
          </select>
        </label>
      </div>
      <p class="sub" id="readerMeta" style="margin-bottom:0"></p>
      <div class="card" style="margin-top:10px">
        <div id="readerBody"></div>
      </div>
      <div class="reader-head" style="margin-top:14px">
        <button class="btn ghost" id="prevPartBtn">← আগেরটি</button>
        <span style="flex:1"></span>
        <button class="btn" id="nextPartBtn">পরেরটি →</button>
      </div>
    </div>
  </section>

  
  <!-- ================= HADITH ================= -->
  <section class="view" id="view-hadith">
    <h2 class="sec">হাদিস ভান্ডার</h2>
    <p class="sub">সহিহ হাদিস — আরবি পাঠ, বাংলা অর্থ ও পূর্ণ সূত্রসহ।</p>
    <input class="search" type="text" id="hadithSearch" placeholder="হাদিস খুঁজুন…" aria-label="হাদিস খুঁজুন" />
    <div id="hadithList"></div>
    <h3 class="sec" style="margin-top:28px">বড় হাদিসের কিতাবসমূহ — হাজার হাজার হাদিস</h3>
    <p class="sub">ছয়টি প্রসিদ্ধ হাদিসের কিতাবের পূর্ণ বাংলা অনুবাদ — অধ্যায় অনুযায়ী পড়ুন বা খুঁজুন। প্রথমবার খুললে কিতাবটি ডাউনলোড হয়ে সেভ হয়ে যায়, পরে অফলাইনেও পড়া যাবে।</p>
    <div class="controls">
      <label>কিতাব
        <select id="hbBookSel">
          <option value="ben-bukhari">সহিহ বুখারি</option>
          <option value="ben-muslim">সহিহ মুসলিম</option>
          <option value="ben-abudawud">সুনানে আবু দাউদ</option>
          <option value="ben-tirmidhi">সুনানে তিরমিযি</option>
          <option value="ben-nasai">সুনানে নাসায়ি</option>
          <option value="ben-ibnmajah">সুনানে ইবনে মাজাহ</option>
        </select>
      </label>
      <label>অধ্যায়
        <select id="hbSecSel"><option value="">সব অধ্যায়</option></select>
      </label>
    </div>
    <input class="search" type="text" id="hbSearch" placeholder="এই কিতাবে হাদিস খুঁজুন…" aria-label="কিতাবে হাদিস খুঁজুন" />
    <p class="sub" id="hbStatus"></p>
    <div id="hbList"></div>
    <button class="btn ghost" id="hbMore" style="display:none; width:100%; margin-top:10px">আরও হাদিস দেখুন</button>
  </section>

  <!-- ================= DUA ================= -->
  <section class="view" id="view-dua">
    <h2 class="sec">দৈনন্দিন ও মাসনুন দোয়া</h2>
    <p class="sub">ঘুম, খাবার, ঘর থেকে বের হওয়া থেকে শুরু করে বিপদ-আপদের দোয়া — আরবি, বাংলা অর্থ ও সূত্রসহ। যেসব দোয়া নির্দিষ্ট সংখ্যায় পড়তে হয়, সেগুলোর সংখ্যা দেওয়া আছে।</p>
    <input class="search" type="text" id="duaSearch" placeholder="দোয়া খুঁজুন…" aria-label="দোয়া খুঁজুন" />
    <div id="duaList"></div>
  </section>

  <!-- ================= QIBLA ================= -->
  <section class="view" id="view-qibla">
    <h2 class="sec">কিবলা নির্ণয়</h2>
    <p class="sub">আপনার অবস্থান থেকে পবিত্র কাবা শরিফের দিক। ফোনের কম্পাস চালু করলে তীরটি সরাসরি কিবলার দিকে ঘুরবে।</p>
    <div class="qibla-flex">
      <div class="card">
        <div class="compass" aria-label="কিবলা কম্পাস">
          <div class="ring"></div>
          <div class="dial" id="compassDial">
            <span class="dir">উ</span><span class="dir e">পূ</span><span class="dir s">দ</span><span class="dir w">প</span>
            <span class="kaaba" aria-hidden="true">🕋</span>
          </div>
          <div class="needle" id="qiblaNeedle"></div>
          <div class="pin"></div>
        </div>
        <p style="text-align:center; margin:12px 0 0">
          <button class="btn gold" id="compassBtn">কম্পাস চালু করুন</button>
        </p>
        <p class="sub" style="text-align:center; margin:8px 0 0" id="compassMsg">কম্পাস বন্ধ আছে — নিচের কোণ দেখে দিক মিলিয়ে নিন।</p>
      </div>
      <div class="card">
        <h3 style="margin-top:0">কিবলার দিকের তথ্য</h3>
        <p>শহর: <b id="qiblaCity">ভাঙা, ফরিদপুর</b></p>
        <p>কিবলার কোণ (উত্তর থেকে ঘড়ির কাঁটার দিকে): <b id="qiblaAngle" style="font-size:20px">—°</b></p>
        <p>কাবা শরিফের দূরত্ব: <b id="qiblaDist">—</b></p>
        <p class="sub" style="margin-bottom:0">কম্পাস ব্যবহারের সময় ফোনটি ধাতব জিনিস ও চুম্বক থেকে দূরে রাখুন এবং একবার ইংরেজি 8-এর মতো করে ঘুরিয়ে ক্যালিব্রেট করুন। কম্পাস ছাড়া: সূর্য বা মানচিত্রের উত্তর দিক ধরে উপরের কোণ অনুযায়ী ঘুরে দাঁড়ালেই কিবলা পাবেন।</p>
      </div>
    </div>
  </section>

  <!-- ================= TASBIH ================= -->
  <section class="view" id="view-tasbih">
    <h2 class="sec">ডিজিটাল তাসবিহ</h2>
    <p class="sub">বড় বোতামে চাপ দিয়ে যিকির গুনুন। লক্ষ্যে পৌঁছালে পরের যিকিরে চলে যাওয়া যাবে।</p>
    <div class="card tasbih">
      <div class="chips" id="dhikrChips"></div>
      <div class="dhikr-ar" id="dhikrAr"></div>
      <div style="font-weight:600" id="dhikrBn"></div>
      <div class="big" id="tasbihCount">০</div>
      <p style="margin:0; color:var(--ink-2)">লক্ষ্য: <b id="tasbihTarget"></b> &nbsp;•&nbsp; মোট গণনা: <b id="tasbihTotal">০</b> &nbsp;•&nbsp; চক্র: <b id="tasbihCycle">০</b></p>
      <button class="tapbtn" id="tapBtn">চাপ দিন</button>
      <div class="chips">
        <button id="tasbihUndo">↩ এক কমান</button>
        <button id="tasbihReset">শূন্য করুন</button>
      </div>
    </div>
  </section>

  <!-- ================= QUIZ ================= -->
  <section class="view" id="view-quiz">
    <h2 class="sec">ইসলামিক কুইজ</h2>
    <p class="sub">কুরআন, হাদিস, সীরাত ও ইসলামের ইতিহাস থেকে প্রশ্ন — প্রতিটি উত্তরের ব্যাখ্যা ও সূত্রসহ।</p>
    <div class="card" id="quizCard"></div>
  </section>

