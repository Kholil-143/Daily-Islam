').then(function(r){ return r.json(); }).then(function(j){
    QURAN = j; buildSurahList(); buildJuzList(); renderDailyAyah(); cb && cb();
  }).catch(function(){
    $('surahList').innerHTML = '<p class="loadmsg">কুরআনের তথ্য লোড করা যায়নি। ইন্টারনেট সংযোগ দেখে আবার চেষ্টা করুন।</p>';
  });
}
function globalAyah(surahIdx, ayahIdx){
  var g = 1;
  for (var i = 0; i < surahIdx; i++) g += QURAN.surahs[i].cnt;
  return g + ayahIdx;
}
var SURA_MEAN = ['সূচনা','গাভী','ইমরানের পরিবার','নারীগণ','খাদ্যপূর্ণ দস্তরখান','গৃহপালিত পশু','উচ্চ স্থানসমূহ','যুদ্ধলব্ধ সম্পদ','অনুশোচনা','ইউনুস','হুদ','ইউসুফ','বজ্রপাত','ইব্রাহিম','পাথুরে উপত্যকা','মৌমাছি','রাতের যাত্রা','গুহা','মারইয়াম','ত্বা-হা','নবীগণ','হজ','মুমিনগণ','আলো','সত্য-মিথ্যার পার্থক্যকারী','কবিগণ','পিপীলিকা','কাহিনিসমূহ','মাকড়সা','রোমানগণ','লুকমান','সিজদা','সম্মিলিত বাহিনী','সাবা','স্রষ্টা','ইয়াসীন','সারিবদ্ধগণ','সোয়াদ','দলসমূহ','ক্ষমাকারী','বিশদ বর্ণিত','পরামর্শ','সোনার অলংকার','ধোঁয়া','হাঁটু গেড়ে বসা','বালির পাহাড়','মুহাম্মদ','বিজয়','কক্ষসমূহ','ক্বাফ','বিক্ষিপ্তকারী বায়ু','পর্বত','নক্ষত্র','চন্দ্র','পরম করুণাময়','অবশ্যম্ভাবী ঘটনা','লোহা','বিতর্ককারিণী','সমাবেশ','পরীক্ষিতা নারী','সারি','সমাবেশ (জুমা)','মুনাফিকগণ','পারস্পরিক ক্ষতি','তালাক','নিষিদ্ধকরণ','সার্বভৌমত্ব','কলম','অবশ্যম্ভাবী সত্য','সিঁড়িসমূহ','নূহ','জিন','বস্ত্রাচ্ছাদিত','চাদরাবৃত','পুনরুত্থান','মানুষ','প্রেরিত বায়ু','মহান সংবাদ','যারা টেনে বের করে','তিনি ভ্রুকুটি করলেন','গুটিয়ে নেওয়া','বিদীর্ণ হওয়া','ওজনে কম দেওয়া','খণ্ডিত হওয়া','বুরুজসমূহ','রাতের আগন্তুক','সর্বোচ্চ','আচ্ছাদনকারী','ঊষা','নগর','সূর্য','রাত','পূর্বাহ্ণ','প্রশস্ত করা','ডুমুর','জমাট রক্ত','মর্যাদার রাত','সুস্পষ্ট প্রমাণ','ভূমিকম্প','দ্রুতগামী অশ্ব','মহাপ্রলয়','প্রাচুর্যের প্রতিযোগিতা','সময়','নিন্দাকারী','হাতি','কুরাইশ','সাহায্য-সামগ্রী','প্রাচুর্য','অবিশ্বাসীগণ','সাহায্য','খেজুর পাতার দড়ি','একনিষ্ঠতা','ঊষা','মানুষ'];
function buildSurahList(){
  var html = '';
  QURAN.surahs.forEach(function(s, i){
    html += '<button class="sitem" data-surah="' + i + '"><span class="no"><i>' + bn(s.n) + '</i></span>' +
      '<span class="tt"><b>সূরা ' + SURA_BN[i] + '</b><span>' + (SURA_MEAN[i] || '') + ' • ' + (s.rev === 'Makki' ? 'মাক্কী' : 'মাদানী') + ' • ' + bn(s.cnt) + ' আয়াত</span></span>' +
      '<span class="arn">' + esc(s.ar) + '</span></button>';
  });
  $('surahList').innerHTML = html;
}
function juzSegments(){
  var segs = [];
  for (var j = 1; j <= 30; j++) segs.push([]);
  QURAN.surahs.forEach(function(s, si){
    for (var b = 0; b < s.juz.length; b++){
      var start = s.juz[b][0], juz = s.juz[b][1];
      var end = (b + 1 < s.juz.length) ? s.juz[b + 1][0] - 1 : s.cnt - 1;
      segs[juz - 1].push({ s: si, from: start, to: end });
    }
  });
  return segs;
}
var JUZ_SEGS = null;
function buildJuzList(){
  JUZ_SEGS = juzSegments();
  var html = '';
  JUZ_SEGS.forEach(function(seg, j){
    var first = seg[0], fs = QURAN.surahs[first.s];
    var cnt = 0; seg.forEach(function(x){ cnt += x.to - x.from + 1; });
    html += '<button class="sitem" data-juzopen="' + j + '"><span class="no"><i>' + bn(j + 1) + '</i></span>' +
      '<span class="tt"><b>পারা ' + bn(j + 1) + ' — ' + JUZ_NAMES[j] + '</b><span>শুরু: সূরা ' + SURA_BN[first.s] + ', আয়াত ' + bn(first.from + 1) + ' • মোট ' + bn(cnt) + ' আয়াত</span></span></button>';
  });
  $('juzList').innerHTML = html;
}
function switchQuranTab(tab){
  quranTab = tab;
  $('segSurah').setAttribute('aria-pressed', tab === 'surah' ? 'true' : 'false');
  $('segJuz').setAttribute('aria-pressed', tab === 'juz' ? 'true' : 'false');
  $('surahList').classList.toggle('hidden', tab !== 'surah');
  $('juzList').classList.toggle('hidden', tab !== 'juz');
  $('surahSearch').style.display = tab === 'surah' ? '' : 'none';
  if (!QURAN) loadQuran();
}
$('segSurah').addEventListener('click', function(){ switchQuranTab('surah'); });
$('segJuz').addEventListener('click', function(){ switchQuranTab('juz'); });
$('surahSearch').addEventListener('input', function(){
  var q = this.value.trim();
  document.querySelectorAll('#surahList .sitem').forEach(function(el){
    el.style.display = (!q || el.textContent.indexOf(q) > -1) ? '' : 'none';
  });
});
$('surahList').addEventListener('click', function(e){
  var b = e.target.closest('[data-surah]'); if (b) openReader('surah', +b.getAttribute('data-surah'));
});
$('juzList').addEventListener('click', function(e){
  var b = e.target.closest('[data-juzopen]'); if (b) openReader('juz', +b.getAttribute('data-juzopen'));
});
/* v2.16: Quran landing shortcuts + quick links */
document.querySelectorAll('[data-qsc]').forEach(function(b){ b.addEventListener('click', function(){
  var k = b.getAttribute('data-qsc');
  if (k === 'tilawat') showView('tilawat');
  else if (k === 'search'){ switchQuranTab('surah'); var s = $('surahSearch'); if (s){ s.focus(); s.scrollIntoView({ block: 'center' }); } }
  else if (k === 'tafsir'){
    var ti = 0;
    if (typeof TAFSIR !== 'undefined' && TAFSIR){ var ks = Object.keys(TAFSIR); if (ks.length && +ks[0] >= 0 && +ks[0] < 114) ti = +ks[0]; }
    openReader('surah', ti);
    toast('যেসব আয়াতের তাফসির আছে, অর্থের নিচে "তাফসির দেখুন" বোতাম পাবেন');
  }
  else if (k === 'bookmark'){
    showView('profile');
    setTimeout(function(){
      var els = document.querySelectorAll('#view-profile h3, #view-profile h4, #view-profile b, #view-profile p');
      for (var i = 0; i < els.length; i++){ if (els[i].textContent.indexOf('বুকমার্ক') > -1){ els[i].scrollIntoView({ block: 'start' }); break; } }
    }, 150);
  }
}); });
document.querySelectorAll('[data-qchip]').forEach(function(b){ b.addEventListener('click', function(){
  var k = b.getAttribute('data-qchip');
  if (k === 'yasin') openReader('surah', 35);
  else if (k === 'kahf') openReader('surah', 17);
  else if (k === 'rahman') openReader('surah', 54);
  else if (k === 'waqiah') openReader('surah', 55);
  else if (k === 'mulk') openReader('surah', 66);
  else if (k === 'dukhan') openReader('surah', 43);
  else if (k === 'sajdah') openReader('surah', 31);
  else if (k === 'kursi'){
    openReader('surah', 1);
    var tries = 0;
    var iv = setInterval(function(){
      tries++;
      var el = document.getElementById('ayah-' + globalAyah(1, 254));
      if (el){ clearInterval(iv); el.scrollIntoView({ block: 'center' }); el.style.outline = '2px solid var(--gold)'; el.style.borderRadius = '12px'; setTimeout(function(){ el.style.outline = ''; }, 4000); }
      else if (tries > 40) clearInterval(iv);
    }, 150);
  }
}); });
function ayahHTML(si, ai){
  var s = QURAN.surahs[si], a = s.a[ai];
  var g = globalAyah(si, ai);
  var tf = (typeof TAFSIR_AYAH !== 'undefined') ? TAFSIR_AYAH[(si + 1) + ':' + (ai + 1)] : null;
  var tHtml = tf ? '<button class="play" data-tafsir="' + g + '">তাফসির দেখুন</button><div class="tfs hidden" id="tfs-' + g + '"><b>সংক্ষিপ্ত তাফসির:</b> ' + tf + '</div>' : '';
  return '<div class="ayah" id="ayah-' + g + '"><div class="top"><span class="ano">' + bn(ai + 1) + '</span>' +
    '<span><button class="play" data-lr="' + si + ':' + ai + '">থামার চিহ্ন</button> <button class="play" data-card-ayah="' + si + ':' + ai + '">ছবি কার্ড</button> <button class="play" data-play="' + g + '">▶ শুনুন</button></span></div>' +
    '<p class="arabic">' + esc(a[0]) + ' ۝</p><p class="bangla">' + esc(a[1]) + '</p>' + tHtml + '</div>';
}
function openReader(mode, idx){
  loadQuran(function(){
    readerState = { mode: mode, idx: idx };
    stopAudio();
    $('quranListWrap').classList.add('hidden');
    $('readerWrap').classList.remove('hidden');
    var body = '', title = '', meta = '';
    if (mode === 'surah'){
      var s = QURAN.surahs[idx];
      title = 'সূরা ' + SURA_BN[idx] + ' (' + s.ar + ')';
      meta = 'সূরা নম্বর: ' + bn(s.n) + ' • ' + (s.rev === 'Makki' ? 'মাক্কী' : 'মাদানী') + ' • মোট ' + bn(s.cnt) + ' আয়াত';
      if (idx !== 8 && idx !== 0) body += '<div class="bismillah">بِسْمِ ٱللَّهِ ٱلرَّحْمَـٰنِ ٱلرَّحِيمِ</div>';
      if (idx === 0) body += '<p class="sub" style="text-align:center">সূরা আল-ফাতিহার প্রথম আয়াতটিই বিসমিল্লাহ।</p>';
      if (typeof TAFSIR !== 'undefined' && TAFSIR[idx]) body += '<div class="quiz-exp" style="margin:12px 0"><b>সংক্ষিপ্ত তাফসির ও পরিচিতি:</b> ' + TAFSIR[idx] + '</div>';
      for (var i = 0; i < s.cnt; i++) body += ayahHTML(idx, i);
      body += '<div class="surah-end">صَدَقَ ٱللَّهُ ٱلْعَظِيم</div>';
      playCtx = { mode: 'surah', list: [] };
      for (var k = 0; k < s.cnt; k++) playCtx.list.push(globalAyah(idx, k));
    } else {
      var seg = JUZ_SEGS[idx];
      title = 'পারা ' + bn(idx + 1) + ' — ' + JUZ_NAMES[idx];
      meta = 'এই পারায় ' + bn(seg.length) + 'টি অংশ রয়েছে';
      playCtx = { mode: 'juz', list: [] };
      seg.forEach(function(part){
        var s2 = QURAN.surahs[part.s];
        body += '<h3 style="font-family:\'Noto Sans Bengali\',\'Hind Siliguri\',sans-serif; margin:18px 0 2px">সূরা ' + SURA_BN[part.s] + ' — আয়াত ' + bn(part.from + 1) + ' থেকে ' + bn(part.to + 1) + '</h3>';
        if (part.from === 0 && part.s !== 8 && part.s !== 0) body += '<div class="bismillah">بِسْمِ ٱللَّهِ ٱلرَّحْمَـٰنِ ٱلرَّحِيمِ</div>';
        for (var i2 = part.from; i2 <= part.to; i2++){ body += ayahHTML(part.s, i2); playCtx.list.push(globalAyah(part.s, i2)); }
      });
    }
    $('readerTitle').textContent = title;
    $('readerMeta').textContent = meta;
    $('readerBody').innerHTML = body;
    $('prevPartBtn').textContent = mode === 'surah' ? '← আগের সূরা' : '← আগের পারা';
    $('nextPartBtn').textContent = mode === 'surah' ? 'পরের সূরা →' : 'পরের পারা →';
    $('prevPartBtn').disabled = idx === 0;
    if (typeof syncBookmarkBtn === 'function') syncBookmarkBtn();
    if (typeof setLastRead === 'function'){
      if (mode === 'surah') setLastRead(mode, idx, idx, 0);
      else if (typeof JUZ_SEGS !== 'undefined' && JUZ_SEGS[idx] && JUZ_SEGS[idx][0]) setLastRead(mode, idx, JUZ_SEGS[idx][0].s, JUZ_SEGS[idx][0].from);
    }
    $('nextPartBtn').disabled = idx === (mode === 'surah' ? 113 : 29);
    window.scrollTo({ top: 0 });
  });
}
$('readerBack').addEventListener('click', function(){
  stopAudio();
  $('readerWrap').classList.add('hidden');
  $('quranListWrap').classList.remove('hidden');
});
$('prevPartBtn').addEventListener('click', function(){ if (readerState.idx > 0) openReader(readerState.mode, readerState.idx - 1); });
$('nextPartBtn').addEventListener('click', function(){
  var max = readerState.mode === 'surah' ? 113 : 29;
  if (readerState.idx < max) openReader(readerState.mode, readerState.idx + 1);
});

/* ---- audio ---- */
var playingG = null, playAllOn = false;
var AUDIO_CACHE = 'di-audio-v1';
function cacheAudio(url){
  if (!('caches' in window)) return;
  caches.open(AUDIO_CACHE).then(function(c){
    c.match(url).then(function(m){ if (!m) c.add(url).catch(function(){}); });
  }).catch(function(){});
}
function playAudioSmart(url){
  function go(){ var p = player.play(); if (p && p.catch) p.catch(function(){ toast('অডিও চালানো যায়নি — ইন্টারনেট সংযোগ দেখুন'); }); }
  if (!('caches' in window)){ player.src = url; go(); return; }
  caches.open(AUDIO_CACHE).then(function(c){ return c.match(url); }).then(function(res){
    if (res){ res.blob().then(function(b){ player.src = URL.createObjectURL(b); go(); }); }
    else { player.src = url; go(); cacheAudio(url); }
  }).catch(function(){ player.src = url; go(); });
}
var RECITER = 'ar.alafasy';
function a