      <p style="margin:12px 0 0"><button class="btn gold" id="ramadanTableBtn">রমজানের ৩০ দিনের সময়সূচি দেখুন</button></p>
      <div id="ramadanTable" style="text-align:left; margin-top:14px"></div>
    </div>
    <h3 style="font-family:'Noto Sans Bengali','Hind Siliguri',sans-serif">রোজার নিয়ত ও দোয়া</h3>
    <div id="rozaDuas"></div>
    <h3 style="font-family:'Noto Sans Bengali','Hind Siliguri',sans-serif">নফল রোজা</h3>
    <div id="rozaViewList"></div>
