<?xml version="1.0" encoding="utf-8"?>
<!-- Second (compact) widget: NO android:configure attribute, so it
     places immediately with the default district — the v2.13 lesson. -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:description="@string/widget_description_compact"
    android:initialLayout="@layout/widget_compact"
    android:minHeight="110dp"
    android:minWidth="250dp"
    android:minResizeHeight="90dp"
    android:minResizeWidth="170dp"
    android:resizeMode="horizontal|vertical"
    android:targetCellHeight="2"
    android:targetCellWidth="4"
    android:updatePeriodMillis="1800000"
    android:widgetCategory="home_screen" />
