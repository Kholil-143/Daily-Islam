<?xml version="1.0" encoding="utf-8"?>
<!--
  Widget background — plain, no border frame (Khalilur asked for the
  gold edge to be removed). The fill colour comes from widget_colors.xml,
  which has a light (white) set in values/ and a dark (black) set in
  values-night/ — so this one drawable renders plain white by day and
  plain black in the phone's dark mode. Rounded corners only.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <corners android:radius="16dp" />
    <solid android:color="@color/widget_background" />
</shape>
