<?xml version="1.0" encoding="utf-8"?>
<!--
  Border for each waqt cell in the compact widget's bottom row
  (v2.17, Khalilur's request): transparent fill, thin translucent
  gold outline, softly rounded corners.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="#00000000" />
    <stroke
        android:width="1dp"
        android:color="#66C9A227" />
    <corners android:radius="6dp" />
</shape>
