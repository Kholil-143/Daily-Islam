 ['الرَّحْمَنُ','আর-রাহমান','পরম দয়ালু'],['الرَّحِيمُ','আর-রাহিম','অতি দয়ালু'],['الْمَلِكُ','আল-মালিক','সর্বাধিপতি'],['الْقُدُّوسُ','আল-কুদ্দুস','পরম পবিত্র'],['السَّلَامُ','আস-সালাম','শান্তি ও নিরাপত্তাদাতা'],['الْمُؤْمِنُ','আল-মুমিন','নিরাপত্তা ও ঈমানদাতা'],['الْمُهَيْمِنُ','আল-মুহাইমিন','রক্ষণাবেক্ষণকারী'],['الْعَزِيزُ','আল-আজিজ','পরাক্রমশালী'],['الْجَبَّارُ','আল-জাব্বার','মহাপরাক্রমশালী'],['الْمُتَكَبِّرُ','আল-মুতাকাব্বির','সর্বশ্রেষ্ঠ গৌরবের অধিকারী'],['الْخَالِقُ','আল-খালিক','সৃষ্টিকর্তা'],['الْبَارِئُ','আল-বারি','উদ্ভাবক'],['الْمُصَوِّرُ','আল-মুসাওয়ির','আকৃতিদাতা'],['الْغَفَّارُ','আল-গাফফার','মহাক্ষমাশীল'],['الْقَهَّارُ','আল-কাহহার','মহাপরাক্রান্ত'],['الْوَهَّابُ','আল-ওয়াহহাব','মহাদাতা'],['الرَّزَّاقُ','আর-রাজ্জাক','রিজিকদাতা'],['الْفَتَّاحُ','আল-ফাত্তাহ','বিজয় ও ফয়সালাদাতা'],['الْعَلِيمُ','আল-আলিম','সর্বজ্ঞ'],['الْقَابِضُ','আল-কাবিদ','রিজিক সংকীর্ণকারী'],['الْبَاسِطُ','আল-বাসিত','রিজিক প্রশস্তকারী'],['الْخَافِضُ','আল-খাফিদ','অবনতকারী'],['الرَّافِعُ','আর-রাফি','উন্নতকারী'],['الْمُعِزُّ','আল-মুইজ','সম্মানদাতা'],['الْمُذِلُّ','আল-মুজিল','অসম্মানকারী'],['السَّمِيعُ','আস-সামি','সর্বশ্রোতা'],['الْبَصِيرُ','আল-বাসির','সর্বদ্রষ্টা'],['الْحَكَمُ','আল-হাকাম','ন্যায়বিচারক'],['الْعَدْلُ','আল-আদল','পরিপূর্ণ ন্যায়পরায়ণ'],['اللَّطِيفُ','আল-লাতিফ','সূক্ষ্মদর্শী ও সদয়'],['الْخَبِيرُ','আল-খাবির','সব খবর রাখেন'],['الْحَلِيمُ','আল-হালিম','মহাধৈর্যশীল'],['الْعَظِيمُ','আল-আজিম','মহান'],['الْغَفُورُ','আল-গাফুর','পরম ক্ষমাশীল'],['الشَّكُورُ','আশ-শাকুর','কৃতজ্ঞতার উত্তম প্রতিদানদাতা'],['الْعَلِيُّ','আল-আলিয়্যু','সুউচ্চ'],['الْكَبِيرُ','আল-কাবির','সুমহান'],['الْحَفِيظُ','আল-হাফিজ','মহারক্ষক'],['الْمُقِيتُ','আল-মুকিত','আহার ও শক্তিদাতা'],['الْحَسِيبُ','আল-হাসিব','হিসাব গ্রহণকারী'],['الْجَلِيلُ','আল-জালিল','মহিমান্বিত'],['الْكَرِيمُ','আল-কারিম','মহানুভব দাতা'],['الرَّقِيبُ','আর-রাকিব','সতর্ক পর্যবেক্ষক'],['الْمُجِيبُ','আল-মুজিব','দোয়া কবুলকারী'],['الْوَاسِعُ','আল-ওয়াসি','সর্বব্যাপী'],['الْحَكِيمُ','আল-হাকিম','প্রজ্ঞাময়'],['الْوَدُودُ','আল-ওয়াদুদ','পরম প্রেমময়'],['الْمَجِيدُ','আল-মাজিদ','মহাগৌরবময়'],['الْبَاعِثُ','আল-বায়িস','পুনরুত্থানকারী'],['الشَّهِيدُ','আশ-শাহিদ','সর্বসাক্ষী'],['الْحَقُّ','আল-হাক্ক','পরম সত্য'],['الْوَكِيلُ','আল-ওয়াকিল','কর্মবিধায়ক ও নির্ভরযোগ্য'],['الْقَوِيُّ','আল-কাওয়িয়্যু','মহাশক্তিধর'],['الْمَتِينُ','আল-মাতিন','সুদৃঢ় শক্তির অধিকারী'],['الْوَلِيُّ','আল-ওয়ালিয়্যু','অভিভাবক ও বন্ধু'],['الْحَمِيدُ','আল-হামিদ','সর্বপ্রশংসিত'],['الْمُحْصِي','আল-মুহসি','সবকিছুর হিসাবরক্ষক'],['الْمُبْدِئُ','আল-মুবদি','প্রথম সৃষ্টিকারী'],['الْمُعِيدُ','আল-মুয়িদ','পুনঃসৃষ্টিকারী'],['الْمُحْيِي','আল-মুহয়ি','জীবনদাতা'],['الْمُمِيتُ','আল-মুমিত','মৃত্যুদাতা'],['الْحَيُّ','আল-হাইয়্যু','চিরঞ্জীব'],['الْقَيُّومُ','আল-কাইয়্যুম','সবকিছুর ধারক ও সংরক্ষক'],['الْوَاجِدُ','আল-ওয়াজিদ','সবকিছু লাভকারী'],['الْمَاجِدُ','আল-মাজিদ','মহিমান্বিত'],['الْوَاحِدُ','আল-ওয়াহিদ','এক ও অদ্বিতীয়'],['الصَّمَدُ','আস-সামাদ','অমুখাপেক্ষী, সবাই তাঁর মুখাপেক্ষী'],['الْقَادِرُ','আল-কাদির','সর্বশক্তিমান'],['الْمُقْتَدِرُ','আল-মুকতাদির','পূর্ণ ক্ষমতাবান'],['الْمُقَدِّمُ','আল-মুকাদ্দিম','অগ্রসরকারী'],['الْمُؤَخِّرُ','আল-মুআখখির','পেছনে সরিয়ে দেন যাকে ইচ্ছা'],['الْأَوَّلُ','আল-আউয়াল','সর্বপ্রথম'],['الْآخِرُ','আল-আখির','সর্বশেষ'],['الظَّاهِرُ','আজ-জাহির','সর্বপ্রকাশিত'],['الْبَاطِنُ','আল-বাতিন','সর্বগোপন'],['الْوَالِي','আল-ওয়ালি','সর্বকর্তৃত্বের অধিকারী'],['الْمُتَعَالِي','আল-মুতাআলি','সুউচ্চ মর্যাদাবান'],['الْبَرُّ','আল-বারর','পরম কল্যাণকারী'],['التَّوَّابُ','আত-তাওয়াব','তাওবা কবুলকারী'],['الْمُنْتَقِمُ','আল-মুনতাকিম','প্রতিশোধ গ্রহণকারী'],['الْعَفُوُّ','আল-আফুওয়ু','পরম মার্জনাকারী'],['الرَّؤُوفُ','আর-রাউফ','পরম স্নেহশীল'],['مَالِكُ الْمُلْكِ','মালিকুল মুলক','সার্বভৌমত্বের অধিপতি'],['ذُو الْجَلَالِ وَالْإِكْرَامِ','জুল জালালি ওয়াল ইকরাম','মহিমা ও সম্মানের অধিকারী'],['الْمُقْسِطُ','আল-মুকসিত','ন্যায়পরায়ণ'],['الْجَامِعُ','আল-জামি','একত্রকারী'],['الْغَنِيُّ','আল-গানিয়্যু','অভাবমুক্ত ধনী'],['الْمُغْنِي','আল-মুগনি','ধনী বানানকারী'],['الْمَانِعُ','আল-মানি','প্রতিরোধকারী'],['الضَّارُّ','আদ-দারর','ক্ষতি পৌঁছানোর ক্ষমতাবান'],['النَّافِعُ','আন-নাফি','উপকারকারী'],['النُّورُ','আন-নূর','আলো ও জ্যোতি'],['الْهَادِي','আল-হাদি','পথপ্রদর্শক'],['الْبَدِيعُ','আল-বাদি','অতুলনীয় উদ্ভাবক'],['الْبَاقِي','আল-বাকি','চিরস্থায়ী'],['الْوَارِثُ','আল-ওয়ারিস','সবকিছুর উত্তরাধিকারী'],['الرَّشِيدُ','আর-রাশিদ','সঠিক পথ নির্দেশক'],['الصَّبُورُ','আস-সাবুর','মহাধৈর্যশীল']
];
$('namesGrid').innerHTML = NAMES99.map(function(n, i){
  return '<div class="name-card"><div class="n">' + bn(i + 1) + '</div><div class="a">' + n[0] + '</div><div class="t">' + n[1] + '</div><div class="m">' + n[2] + '</div></div>';
}).join('');

/* ================= Kalima ================= */
var KALIMAS = [
 { t:'প্রথম কালিমা — তাইয়্যিবা', ar:'لَا إِلَٰهَ إِلَّا اللَّهُ مُحَمَّدٌ رَسُولُ اللَّهِ', bn:'আল্লাহ ছাড়া কোনো ইলাহ (উপাস্য) নেই; মুহাম্মদ ﷺ আল্লাহর রাসূল।' },
 { t:'দ্বিতীয় কালিমা — শাহাদাত', ar:'أَشْهَدُ أَنْ لَا إِلَٰهَ إِلَّا اللَّهُ وَحْدَهُ لَا شَرِيكَ لَهُ، وَأَشْهَدُ أَنَّ مُحَمَّدًا عَبْدُهُ وَرَسُولُهُ', bn:'আমি সাক্ষ্য দিচ্ছি যে, আল্লাহ ছাড়া কোনো ইলাহ নেই; তিনি এক, তাঁর কোনো শরিক নেই। আর আমি সাক্ষ্য দিচ্ছি যে, মুহাম্মদ ﷺ তাঁর বান্দা ও রাসূল।' },
 { t:'তৃতীয় কালিমা — তামজিদ', ar:'سُبْحَانَ اللَّهِ وَالْحَمْدُ لِلَّهِ وَلَا إِلَٰهَ إِلَّا اللَّهُ وَاللَّهُ أَكْبَرُ، وَلَا حَوْلَ وَلَا قُوَّةَ إِلَّا بِاللَّهِ الْعَلِيِّ الْعَظِيمِ', bn:'আল্লাহ পবিত্র, সব প্রশংসা আল্লাহর, আল্লাহ ছাড়া কোনো ইলাহ নেই, আল্লাহ সবচেয়ে বড়। মহান ও সুমহান আল্লাহর সাহায্য ছাড়া কোনো শক্তি ও সামর্থ্য নেই।' },
 { t:'চতুর্থ কালিমা — তাওহিদ', ar:'لَا إِلَٰهَ إِلَّا اللَّهُ وَحْدَهُ لَا شَرِيكَ لَهُ، لَهُ الْمُلْكُ وَلَهُ الْحَمْدُ، يُحْيِي وَيُمِيتُ، وَهُوَ حَيٌّ لَا يَمُوتُ أَبَدًا أَبَدًا، ذُو الْجَلَالِ وَالْإِكْرَامِ، بِيَدِهِ الْخَيْرُ، وَهُوَ عَلَىٰ كُلِّ شَيْءٍ قَدِيرٌ', bn:'আল্লাহ ছাড়া কোনো ইলাহ নেই; তিনি এক, তাঁর কোনো শরিক নেই। সব রাজত্ব তাঁরই, সব প্রশংসা তাঁরই। তিনি জীবন দেন ও মৃত্যু দেন; তিনি চিরঞ্জীব, কখনো মরবেন না। তিনি মহিমা ও সম্মানের অধিকারী; সব কল্যাণ তাঁর হাতে; তিনি সবকিছুর ওপর ক্ষমতাবান।' },
 { t:'পঞ্চম কালিমা — আস্তাগফার', ar:'أَسْتَغْفِرُ اللَّهَ رَبِّي مِنْ كُلِّ ذَنْبٍ أَذْنَبْتُهُ عَمَدًا أَوْ خَطَأً، سِرًّا أَوْ