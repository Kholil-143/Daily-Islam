 { q:'দৈনিক ফরজ নামাজ মোট কত রাকাত?', o:['১২ রাকাত','১৭ রাকাত','২০ রাকাত','৩২ রাকাত'], a:1, e:'ফজর ২ + যোহর ৪ + আসর ৪ + মাগরিব ৩ + এশা ৪ = মোট ১৭ রাকাত ফরজ।', s:'সহিহ বুখারি: ৩৪৯ (পাঁচ ওয়াক্ত ফরজ)' },
 { q:'যাকাতের হার শতকরা কত?', o:['১%','২%','২.৫%','৫%'], a:2, e:'নিসাব পরিমাণ সম্পদ এক বছর থাকলে মোট সম্পদের ২.৫% (চল্লিশ ভাগের এক ভাগ) যাকাত দিতে হয়।', s:'সহিহ বুখারি: ১৪৫৪; সূরা আত-তাওবা: ৬০' },
 { q:'কোন শহরকে "মদিনাতুন নবী" বলা হয়?', o:['মক্কা','তায়েফ','ইয়াসরিব (মদিনা)','খায়বার'], a:2, e:'হিজরতের পর ইয়াসরিবের নাম হয় মদিনাতুন নবী (নবীর শহর), সংক্ষেপে মদিনা।', s:'সহিহ বুখারি: ১৮৭১' },
 { q:'উহুদের যুদ্ধ কোন হিজরি সালে হয়?', o:['২ হিজরি','৩ হিজরি','৫ হিজরি','৬ হিজরি'], a:1, e:'উহুদের যুদ্ধ ৩ হিজরির শাওয়াল মাসে সংঘটিত হয়; এতে ৭০ জন সাহাবি শহীদ হন।', s:'সীরাতে ইবনে হিশাম; সহিহ বুখারি: ৪০৪৩' },
 { q:'কুরআন সংকলন (এক খণ্ডে গ্রন্থন) প্রথম কার খিলাফতে হয়?', o:['হযরত উমর (রা.)','হযরত আবু বকর (রা.)','হযরত উসমান (রা.)','হযরত আলী (রা.)'], a:1, e:'ইয়ামামার যুদ্ধে অনেক হাফেজ শহীদ হলে হযরত উমর (রা.)-এর পরামর্শে খলিফা আবু বকর (রা.)-এর আমলে যায়েদ ইবনে সাবিত (রা.) কুরআন সংকলন করেন। পরে উসমান (রা.)-এর আমলে প্রমিত অনুলিপি তৈরি হয়।', s:'সহিহ বুখারি: ৪৯৮৬' }
];
var quizState = { order: [], pos: 0, score: 0, answered: false };
function quizStart(){
  quizState.order = QUIZ.map(function(_, i){ return i; });
  for (var i = quizState.order.length - 1; i > 0; i--){
    var j = Math.floor(Math.random() * (i + 1));
    var tmp = quizState.order[i]; quizState.order[i] = quizState.order[j]; quizState.order[j] = tmp;
  }
  quizState.pos = 0; quizState.score = 0;
  quizRender();
}
function quizRender(){
  var card = $('quizCard');
  if (quizState.pos >= quizState.order.length){
    var total = quizState.order.length;
    var msg = quizState.score === total ? 'মাশাআল্লাহ! সব উত্তর সঠিক হয়েছে।' :
      quizState.score >= total * 0.7 ? 'খুব ভালো! আলহামদুলিল্লাহ।' :
      quizState.score >= total * 0.4 ? 'ভালো চেষ্টা! আরও পড়লে আরও ভালো হবে, ইনশাআল্লাহ।' :
      'চেষ্টা চালিয়ে যান — কুরআন-হাদিসের জ্ঞান ধীরে ধীরে বাড়বে, ইনশাআল্লাহ।';
    card.innerHTML = '<div style="text-align:center; padding:14px 0">' +
      '<div style="font-size:52px; font-weight:700; color:var(--green-800)">' + bn(quizState.score) + '/' + bn(total) + '</div>' +
      '<p style="font-size:18px; font-weight:600">' + msg + '</p>' +
      '<button class="btn gold" id="quizAgain">আবার খেলুন</button></div>';
    $('quizAgain').addEventListener('click', quizStart);
    return;
  }
  var item = QUIZ[quizState.order[quizState.pos]];
  quizState.answered = false;
  var opts = '';
  item.o.forEach(function(o, i){ opts += '<button class="quiz-opt" data-opt="' + i + '">' + o + '</button>'; });
  card.innerHTML = '<div class="qmeta"><span>প্রশ্ন ' + bn(quizState.pos + 1) + '/' + bn(quizState.order.length) + '</span><span>স্কোর: ' + bn(quizState.score) + '</span></div>' +
    '<h3 style="margin:4px 0 10px; font-size:19.5px">' + item.q + '</h3>' + opts + '<div id="quizExp"></div>';
}
$('quizCard').addEventListener('click', function(e){
  var b = e.target.closest('[data-opt]'); if (!b || quizState.answered) return;
  quizState.answered = true;
  var item = QUIZ[quizState.order[quizState.pos]];
  var pick = +b.getAttribute('data-opt');
  var btns = document.querySelectorAll('#quizCard .quiz-opt');
  btns.forEach(function(x, i){
    if (i === item.a) x.classList.add('right');
    else if (i === pick) x.classList.add('wrong');
    x.disabled = true;
  });
  if (pick === item.a){ quizState.score++; toast('সঠিক উত্তর! মাশাআল্লাহ'); }
  else toast('সঠিক উত্তর: ' + item.o[item.a]);
  $('quizExp').innerHTML = '<div class="quiz-exp"><b>ব্যাখ্যা:</b> ' + item.e + '<br /><span style="color:var(--ink-2)">সূত্র: ' + item.s + '</span></div>' +
    '<p style="margin:14px 0 0; text-align:right"><button class="btn gold" id="quizNext">' + (quizState.pos + 1 >= quizState.order.length ? 'ফলাফল দেখুন' : 'পরের প্রশ্ন →') + '</button></p>';
  $('quizNext').addEventListener('click', function(){ quizState.pos++; quizRender(); });
});
quizStart();
</script>
<script>
