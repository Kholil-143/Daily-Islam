 { t:'বাথরুমে প্রবেশের দোয়া', ar:'اللَّهُمَّ إِنِّي أَعُوذُ بِكَ مِنَ الْخُبُثِ وَالْخَبَائِثِ', bn:'হে আল্লাহ! আমি আপনার কাছে আশ্রয় চাই দুষ্ট জিন ও জিন্নী থেকে।', s:'সহিহ বুখারি: ১৪২; সহিহ মুসলিম: ৩৭৫', n:'' },
 { t:'বাথরুম থেকে বের হওয়ার দোয়া', ar:'غُفْرَانَكَ', bn:'(হে আল্লাহ!) আপনার ক্ষমা প্রার্থনা করছি।', s:'সুনানে আবু দাউদ: ৩০; সুনানে তিরমিযি: ৭', n:'' },
 { t:'পোশাক পরার দোয়া', ar:'الْحَمْدُ لِلَّهِ الَّذِي كَسَانِي هَٰذَا وَرَزَقَنِيهِ مِنْ غَيْرِ حَوْلٍ مِنِّي وَلَا قُوَّةٍ', bn:'সব প্রশংসা আল্লাহর, যিনি আমাকে এই পোশাক পরিয়েছেন এবং আমার কোনো শক্তি-সামর্থ্য ছাড়াই তা রিজিক হিসেবে দিয়েছেন।', s:'সুনানে আবু দাউদ: ৪০২৩ (হাসান)', n:'' },
 { t:'আয়নায় দেখার দোয়া', ar:'اللَّهُمَّ كَمَا حَسَّنْتَ خَلْقِي فَحَسِّنْ خُلُقِي', bn:'হে আল্লাহ! আপনি যেমন আমার গঠন সুন্দর করেছেন, তেমনি আমার চরিত্রও সুন্দর করুন।', s:'মুসনাদে আহমাদ: ২৪৩৯২ (সহিহ)', n:'' },
 { t:'সফরের দোয়া', ar:'سُبْحَانَ الَّذِي سَخَّرَ لَنَا هَٰذَا وَمَا كُنَّا لَهُ مُقْرِنِينَ، وَإِنَّا إِلَىٰ رَبِّنَا لَمُنْقَلِبُونَ', bn:'পবিত্র তিনি, যিনি এটিকে আমাদের অধীন করে দিয়েছেন, অথচ আমরা তা করতে সক্ষম ছিলাম না; আর নিশ্চয় আমরা আমাদের রবের দিকে ফিরে যাব।', s:'সূরা আয-যুখরুফ: ১৩–১৪; সহিহ মুসলিম: ১৩৪২', n:'' },
 { t:'বিপদ ও দুশ্চিন্তার দোয়া', ar:'لَا إِلَٰهَ إِلَّا أَنْتَ سُبْحَانَكَ إِنِّي كُنْتُ مِنَ الظَّالِمِينَ', bn:'আপনি ছাড়া কোনো ইলাহ নেই; আপনি পবিত্র; নিশ্চয় আমি জালিমদের অন্তর্ভুক্ত হয়েছি। (হযরত ইউনুস আ.-এর দোয়া)', s:'সূরা আল-আম্বিয়া: ৮৭; সুনানে তিরমিযি: ৩৫০৫', n:'' },
 { t:'দুঃখ ও ঋণ থেকে মুক্তির দোয়া', ar:'اللَّهُمَّ إِنِّي أَعُوذُ بِكَ مِنَ الْهَمِّ وَالْحَزَنِ، وَالْعَجْزِ وَالْكَسَلِ، وَالْبُخْلِ وَالْجُبْنِ، وَضَلَعِ الدَّيْنِ وَغَلَبَةِ الرِّجَالِ', bn:'হে আল্লাহ! আমি আপনার কাছে আশ্রয় চাই দুশ্চিন্তা ও দুঃখ থেকে, অক্ষমতা ও অলসতা থেকে, কৃপণতা ও ভীরুতা থেকে, ঋণের বোঝা ও মানুষের জুলুম থেকে।', s:'সহিহ বুখারি: ৬৩৬৯', n:'' },
 { t:'পিতা-মাতার জন্য দোয়া', ar:'رَّبِّ ارْحَمْهُمَا كَمَا رَبَّيَانِي صَغِيرًا', bn:'হে আমার রব! তাঁদের (পিতা-মাতা) প্রতি দয়া করুন, যেমন তাঁরা শৈশবে আমাকে লালন-পালন করেছেন।', s:'সূরা আল-ইসরা: ২৪', n:'' },
 { t:'দুনিয়া ও আখিরাতের কল্যাণের দোয়া', ar:'رَبَّنَا آتِنَا فِي الدُّنْيَا حَسَنَةً وَفِي الْآخِرَةِ حَسَنَةً وَقِنَا عَذَابَ النَّارِ', bn:'হে আমাদের রব! আমাদের দুনিয়াতে কল্যাণ দিন, আখিরাতেও কল্যাণ দিন এবং জাহান্নামের আগুন থেকে রক্ষা করুন।', s:'সূরা আল-বাকারা: ২০১', n:'' },
 { t:'রোগমুক্তির দোয়া', ar:'اللَّهُمَّ رَبَّ النَّاسِ، أَذْهِبِ الْبَاسَ، اشْفِ أَنْتَ الشَّافِي، لَا شِفَاءَ إِلَّا شِفَاؤُكَ، شِفَاءً لَا يُغَادِرُ سَقَمًا', bn:'হে আল্লাহ, মানুষের রব! কষ্ট দূর করুন, আরোগ্য দিন — আপনিই আরোগ্যদাতা; আপনার আরোগ্য ছাড়া কোনো আরোগ্য নেই; এমন আরোগ্য দিন যাতে কোনো রোগ বাকি না থাকে। (রোগীর গায়ে হাত রেখে পড়ুন)', s:'সহিহ বুখারি: ৫৬৭৫; সহিহ মুসলিম: ২১৯১', n:'৭ বার' },
 { t:'বৃষ্টির দোয়া', ar:'اللَّهُمَّ صَيِّبًا نَافِعًا', bn:'হে আল্লাহ! (এই বৃষ্টিকে) উপকারী বৃষ্টি করুন।', s:'সহিহ বুখারি: ১০৩২', n:'' },
 { t:'ইফতারের দোয়া', ar:'اللَّهُمَّ إِنِّي لَكَ صُمْتُ وَعَلَىٰ رِزْقِكَ أَفْطَرْتُ', bn:'হে আল্লাহ! আমি আপনার জন্যই রোজা রেখেছি এবং আপনার দেওয়া রিজিক দিয়েই ইফতার করছি।', s:'সুনানে আবু দাউদ: ২৩৫৮', n:'' },
 { t:'সেহরির দোয়া (নিয়ত)', ar:'نَوَيْتُ أَنْ أَصُومَ غَدًا لِلَّهِ تَعَالَىٰ مِنْ فَرْضِ رَمَضَانَ', bn:'আমি আল্লাহ তাআলার জন্য আগামীকাল রমজানের ফরজ রোজা রাখার নিয়ত করলাম। (নিয়ত মূলত অন্তরের সংকল্প; মুখে বলা জরুরি নয়।)', s:'রোজার নিয়ত অন্তরে করাই যথেষ্ট — ফিকহের কিতাবসমূহ', n:'' },
 { t:'সাইয়্যিদুল ইস্তিগফার', ar:'اللَّهُمَّ أَنْتَ رَبِّي لَا إِلَٰهَ إِلَّا أَنْتَ، خَلَقْتَنِي وَأَنَا عَبْدُكَ، وَأَنَا عَلَىٰ عَهْدِكَ وَوَعْدِكَ مَا اسْتَطَعْتُ، أَعُوذُ بِكَ مِنْ شَرِّ مَا صَنَعْتُ، أَبُوءُ لَكَ بِنِعْمَتِكَ عَلَيَّ، وَأَبُوءُ بِذَنْبِي فَاغْفِرْ لِي، فَإِنَّهُ لَا يَغْفِرُ الذُّنُوبَ إِلَّا أَنْتَ', bn:'হে আল্লাহ! আপনিই আমার রব, আপনি ছাড়া কোনো ইলাহ নেই। আপনি আমাকে সৃষ্টি করেছেন, আমি আপনার বান্দা; আমি সাধ্যমতো আপনার অঙ্গীকার ও প্রতিশ্রুতির ওপর আছি। আমার কৃতকর্মের অনিষ্ট থেকে আপনার আশ্রয় চাই। আমার প্রতি আপনার নেয়ামত স্বীকার করছি এবং আমার গুনাহও স্বীকার করছি — আমাকে ক্ষমা করুন; কারণ আপনি ছাড়া কেউ গুনাহ ক্ষমা করতে পারে না। সকালে বা সন্ধ্যায় পড়লে বিশেষ ফজিলত রয়েছে।', s:'সহিহ বুখারি: ৬৩০৬', n:'সকাল-সন্ধ্যা ১ বার' },
 { t:'আয়াতুল কুরসি', ar:'اللَّهُ لَا إِلَٰهَ إِلَّا هُوَ الْحَيُّ الْقَيُّومُ، لَا تَأْخُذُهُ سِنَةٌ وَلَا نَوْمٌ، لَهُ مَا فِي السَّمَاوَاتِ وَمَا فِي الْأَرْضِ، مَنْ ذَا الَّذِي يَشْفَعُ عِنْدَهُ إِلَّا بِإِذْنِهِ، يَعْلَمُ مَا بَيْنَ أَيْدِيهِمْ وَمَا خَلْفَهُمْ، وَلَا يُحِيطُونَ بِشَيْءٍ مِنْ عِلْمِهِ إِلَّا بِمَا شَاءَ، وَسِعَ كُرْسِيُّهُ السَّمَاوَاتِ وَالْأَرْضَ، وَلَا يَئُودُهُ حِفْظُهُمَا، وَهُوَ الْعَلِيُّ الْعَظِيمُ', bn:'আল্লাহ — তিনি ছাড়া কোনো ইলাহ নেই; তিনি চিরঞ্জীব, সবকিছুর ধারক। তাঁকে তন্দ্রা বা ঘুম স্পর্শ করে না। আসমান-জমিনে যা কিছু আছে সব তাঁরই। তাঁর অনুমতি ছাড়া তাঁর কাছে সুপারিশ করবে কে? তিনি জানেন তাদের সামনে ও পেছনে যা আছে; তাঁর জ্ঞান থেকে তারা কিছুই আয়ত্ত করতে পারে না, তিনি যা চান তা ছাড়া। তাঁর কুরসি আসমান-জমিন ব্যাপী; এ দুটির রক্ষণাবেক্ষণ তাঁকে ক্লান্ত করে না। তিনি সুউচ্চ, মহান। প্রতি ফরজ নামাজের পর পড়ার ফজিলত হাদিসে এসেছে।', s:'সূরা আল-বাকারা: ২৫৫; সুনানে নাসায়ি, আমালুল ইয়াওম: ১০০', n:'প্রতি নামাজের পর ১ বার' },
 { t:'ঘুমানোর আগে সুরক্ষার দোয়া', ar:'بِسْمِ اللَّهِ الَّذِي لَا يَضُرُّ مَعَ اسْمِهِ شَيْءٌ فِي الْأَرْضِ وَلَا فِي السَّمَاءِ وَهُوَ السَّمِيعُ الْعَلِيمُ', bn:'আল্লাহর নামে (শুরু করছি), যাঁর নামের বরকতে আসমান-জমিনের কোনো কিছুই ক্ষতি করতে পারে না; তিনি সর্বশ্রোতা, সর্বজ্ঞ।', s:'সুনানে আবু দাউদ: ৫০৮৮; সুনানে তিরমিযি: ৩৩৮৮', n:'সকাল-সন্ধ্যা ৩ বার' },
 { t:'হাসবুনাল্লাহ', ar:'حَسْبُنَا اللَّهُ وَنِعْمَ الْوَكِيلُ', bn:'আল্লাহই আমাদের জন্য যথেষ্ট, এবং তিনি কতই না উত্তম কর্মবিধায়ক!', s:'সূরা আলে-ইমরান: ১৭৩; সহিহ বুখারি: ৪৫৬৩', n:'' }
];
function duaCard(d){
  var cnt = d.n ? ' <span class="cnt">' + d.n + '</span>' : '';
  var marked = (typeof isBookmarked === 'function') && isBookmarked('dua:' + d.t);
  return '<article class="hcard"><button class="bmkbtn" data-bmd="' + esc(d.t) + '">' + (marked ? '✓ বুকমার্ক করা' : 'বুকমার্ক') + '</button><h3>' + d.t + cnt + '</h3><p class="ar">' + d.ar + '</p><p>' + d.bn + '</p><p class="src">সূত্র: ' + d.s + '</p></article>';
}
function renderDuas(filter){
  var list = DUAS.filter(function(d){ return !filter || (d.t + d.bn).indexOf(filter) > -1; });
  $('duaList').innerHTML = list.length ? list.map(duaCard).join('') : '<p class="loadmsg">কিছু পাওয়া যায়নি।</p>';
}
$('duaSearch').addEventListener('input', function(){ renderDuas(this.value.trim()); });
renderDuas('');
</script>
<script>
/* ================= Qibla ================= */
var KAABA = { lat: 21.4225, lng: 39.8262 };
function qiblaBearing(lat, lng){
  var dLng = dtr(KAABA.lng - lng);
  var y = Math.sin(dLng);
  var x = Math.cos(dtr(lat)) * Math.tan(dtr(KAABA.lat)) - Math.sin(dtr(lat)) * Math.cos(dLng);
  return fixA(rtd(Math.atan2(y, x)));
}
function haversineKm(lat1, lng1, lat2, lng2){
  var R = 6371, dLat = dtr(lat2 - lat1), dLng = dtr(lng2 - lng1);
  var a = Math.sin(dLat/2) * Math.sin(dLat/2) + Math.cos(dtr(lat1)) * Math.cos(dtr(lat2)) * Math.sin(dLng/2) * Math.sin(dLng/2);
  return Math.round(R * 2 * Math.atan2(Math.sqrt(a), Math.sqrt(1 - a)));
}
var deviceHeading = null, compassOn = false;
function renderQibla(){
  var c = curLoc();
  var b = qiblaBearing(c.lat, c.lng);
  var rot = (deviceHeading === null) ? b : b - deviceHeading;
  $('qiblaNeedle').style.transform = 'translate(-50%,-100%) rotate(' + rot + 'deg)';
  $('compassDial').style.transform = 'rotate(' + (deviceHeading === null ? 0 : -deviceHeading) + 'deg)';
  $('qiblaAngle').textContent = bn(Math.round(b)) + '°';
}
function updateQiblaInfo(){
  var c = curLoc();
  $('qiblaCity').textContent = c.name;
  $('qiblaDist').textContent = bn(haversineKm(c.lat, c.lng, KAABA.lat, KAABA.lng).toLocaleString('en-IN')) + ' কিমি (প্রায়)';
  renderQibla();
}
function onOrient(e){
  var h = null;
  if (typeof e.webkitCompassHeading === 'number') h = e.webkitCompassHeading;
  else if (e.alpha !== null) h = 360 - e.alpha;
  if (h !== null){ deviceHeading = h; renderQibla(); }
}
$('compassBtn').addEventListener('click', function(){
  if (compassOn){
    window.removeEventListener('deviceorientationabsolute', onOrient);
    window.removeEventListener('deviceorientation', onOrient);
    compassOn = false; deviceHeading = null;
    $('compassBtn').textContent = 'কম্পাস চালু করুন';
    $('compassMsg').textContent = 'কম্পাস বন্ধ আছে — নিচের কোণ দেখে দিক মিলিয়ে নিন।';
    renderQibla(); return;
  }
  function start(){
    window.addEventListener('deviceorientationabsolute', onOrient);
    window.addEventListener('deviceorientation', onOrient);
    compassOn = true;
    $('compassBtn').textContent = 'কম্পাস বন্ধ করুন';
    $('compassMsg').textContent = 'কম্পাস চালু হয়েছে — ফোন ঘোরালে তীর কিবলার দিকেই থাকবে। সোনালি তীর যেদিকে, সেদিকেই কিবলা।';
  }
  if (typeof DeviceOrientationEvent !== 'undefined' && typeof DeviceOrientationEvent.requestPermission === 'function'){
    DeviceOrientationEvent.requestPermission().then(function(res){
      if (res === 'granted') start(); else toast('কম্পাসের অনুমতি দেওয়া হয়নি');
    }).catch(function(){ toast('এই ডিভাইসে কম্পাস পাওয়া যায়নি'); });
  } else if (typeof DeviceOrientationEvent !== 'undefined'){ start(); }
  else { toast('এই ডিভাইসে কম্পাস সেন্সর নেই'); }
});
updateQiblaInfo();

/* ================= Tasbih ================= */
var DHIKRS = [
  { ar:'سُبْحَانَ اللَّهِ', bn:'সুবহানাল্লাহ — আল্লাহ পবিত্র', target:33 },
  { ar:'الْحَمْدُ لِلَّهِ', bn:'আলহামদুলিল্লাহ — সব প্রশংসা আল্লাহর', target:33 },
  { ar:'اللَّهُ أَكْبَرُ', bn:'আল্লাহু আকবার — আল্লাহ সবচেয়ে বড়', target:34 },
  { ar:'لَا إِلَٰهَ إِلَّا اللَّهُ', bn:'লা ইলাহা ইল্লাল্লাহ — আল্লাহ ছাড়া কোনো ইলাহ নেই', target:100 },
  { ar:'أَسْتَغْفِرُ اللَّهَ', bn:'আস্তাগফিরুল্লাহ — আমি আল্লাহর কাছে ক্ষমা চাই', target:100 },
  { ar:'سُبْحَانَ اللَّهِ وَبِحَمْدِهِ', bn:'সুবহানাল্লাহি ওয়া বিহামদিহি', target:100 },
  { ar:'لَا حَوْلَ وَلَا قُوَّةَ إِلَّا بِاللَّهِ', bn:'লা হাওলা ওয়ালা কুওয়াতা ইল্লা বিল্লাহ', target:100 },
  { ar:'اللَّهُمَّ صَلِّ عَلَىٰ مُحَمَّدٍ', bn:'দরুদ শরিফ — আল্লাহুম্মা সাল্লি আলা মুহাম্মদ', target:100 }
];
var tasbih = { di: 0, count: 0, total: 0, cycle: 0 };
function renderTasbih(){
  var d = DHIKRS[tasbih.di];
  $('dhikrAr').textContent = d.ar;
  $('dhikrBn').textContent = d.bn;
  $('tasbihCount').textContent = bn(tasbih.count);
  $('tasbihTarget').textContent = bn(d.target) + ' বার';
  $('tasbihTotal').textContent = bn(tasbih.total);
  $('tasbihCycle').textContent = bn(tasbih.cycle);
  document.querySelectorAll('#dhikrChips button').forEach(function(b, i){
    b.setAttribute('aria-pressed', i === tasbih.di ? 'true' : 'false');
  });
}
(function initTasbih(){
  var html = '';
  DHIKRS.forEach(function(d, i){ html += '<button data-dhikr="' + i + '">' + d.bn.split(' — ')[0] + '</button>'; });
  $('dhikrChips').innerHTML = html;
  $('dhikrChips').addEventListener('click', function(e){
    var b = e.target.closest('[data-dhikr]'); if (!b) return;
    tasbih.di = +b.getAttribute('data-dhikr'); tasbih.count = 0; renderTasbih();
  });
  $('tapBtn').addEventListener('click', function(){
    tasbih.count++; tasbih.total++;
    if (navigator.vibrate) navigator.vibrate(12);
    if (tasbih.count >= DHIKRS[tasbih.di].target){
      tasbih.cycle++;
      if (navigator.vibrate) navigator.vibrate([60, 40, 60]);
      toast('আলহামদুলিল্লাহ! ' + bn(DHIKRS[tasbih.di].target) + ' বার পূর্ণ হয়েছে');
      tasbih.count = 0;
    }
    renderTasbih();
  });
  $('tasbihUndo').addEventListener('click', function(){ if (tasbih.count > 0){ tasbih.count--; tasbih.total--; } renderTasbih(); });
  $('tasbihReset').addEventListener('click', function(){ tasbih.count = 0; tasbih.total = 0; tasbih.cycle = 0; renderTasbih(); toast('তাসবিহ শূন্য করা হয়েছে'); });
  renderTasbih();
})();

/* ================= Quiz ================= */
