turn g + ayahIdx;
}
function buildSurahList(){
  var html = '';
  QURAN.surahs.forEach(function(s, i){
    html += '<button class="sitem" data-surah="' + i + '"><span class="no"><i>' + bn(s.n) + '</i></span>' +
      '<span class="tt"><b>সূরা ' + SURA_BN[i] + '</b><span>' + (s.rev === 'Makki' ? 'মাক্কী' : 'মাদানী') + ' • ' + bn(s.cnt) + ' আয়াত</span></span>' +
      '<span class="arn">' + esc(s.ar) + '</span></button>';
  });
  $('surahList').innerHTML = html;
}
function juzSegments(){
  var segs = [];
  for (var j = 1; j <= 30; j++) segs.push([]);
  QURAN.surahs.forEach(function(s, si){
    for (var b = 0; b < s.juz.length; b++){
      var start = s.juz[b][0], juz = s.juz[b][1];
      var end = (b + 1 < s.juz.length) ? s.juz[b + 1][0] - 1 : s.cnt - 1;
      segs[juz - 1].push({ s: si, from: start, to: end });
    }
  });
  return segs;
}
var JUZ_SEGS = null;
function buildJuzList(){
  JUZ_SEGS = juzSegments();
  var html = '';
  JUZ_SEGS.forEach(function(seg, j){
    var first = seg[0], fs = QURAN.surahs[first.s];
    var cnt = 0; seg.forEach(function(x){ cnt += x.to - x.from + 1; });
    html += '<button class="sitem" data-juzopen="' + j + '"><span class="no"><i>' + bn(j + 1) + '</i></span>' +
      '<span class="tt"><b>পারা ' + bn(j + 1) + ' — ' + JUZ_NAMES[j] + '</b><span>শুরু: সূরা ' + SURA_BN[first.s] + ', আয়াত ' + bn(first.from + 1) + ' • মোট ' + bn(cnt) + ' আয়াত</span></span></button>';
  });
  $('juzList').innerHTML = html;
}
function switchQuranTab(tab){
  quranTab = tab;
  $('segSurah').setAttribute('aria-pressed', tab === 'surah' ? 'true' : 'false');
  $('segJuz').setAttribute('aria-pressed', tab === 'juz' ? 'true' : 'false');
  $('surahList').classList.toggle('hidden', tab !== 'surah');
  $('juzList').classList.toggle('hidden', tab !== 'juz');
  $('surahSearch').style.display = tab === 'surah' ? '' : 'none';
  if (!QURAN) loadQuran();
}
$('segSurah').addEventListener('click', function(){ switchQuranTab('surah'); });
$('segJuz').addEventListener('click', function(){ switchQuranTab('juz'); });
$('surahSearch').addEventListener('input', function(){
  var q = this.value.trim();
  document.querySelectorAll('#surahList .sitem').forEach(function(el){
    el.style.display = (!q || el.textContent.indexOf(q) > -1) ? '' : 'none';
  });
});
$('surahList').addEventListener('click', function(e){
  var b = e.target.closest('[data-surah]'); if (b) openReader('surah', +b.getAttribute('data-surah'));
});
$('juzList').addEventListener('click', function(e){
  var b = e.target.closest('[data-juzopen]'); if (b) openReader('juz', +b.getAttribute('data-juzopen'));
});
function ayahHTML(si, ai){
  var s = QURAN.surahs[si], a = s.a[ai];
  var g = globalAyah(si, ai);
  var tf = (typeof TAFSIR_AYAH !== 'undefined') ? TAFSIR_AYAH[(si + 1) + ':' + (ai + 1)] : null;
  var tHtml = tf ? '<button class="play" data-tafsir="' + g + '">তাফসির দেখুন</button><div class="tfs hidden" id="tfs-' + g + '"><b>সংক্ষিপ্ত তাফসির:</b> ' + tf + '</div>' : '';
  return '<div class="ayah" id="ayah-' + g + '"><div class="top"><span class="ano">' + bn(ai + 1) + '</span>' +
    '<span><button class="play" data-lr="' + si + ':' + ai + '">থামার চিহ্ন</button> <button class="play" data-card-ayah="' + si + ':' + ai + '">ছবি কার্ড</button> <button class="play" data-play="' + g + '">▶ শুনুন</button></span></div>' +
    '<p class="arabic">' + esc(a[0]) + ' ۝</p><p class="bangla">' + esc(a[1]) + '</p>' + tHtml + '</div>';
}
function openReader(mode, idx){
  loadQuran(function(){
    readerState = { mode: mode, idx: idx };
    stopAudio();
    $('quranListWrap').classList.add('hidden');
    $('readerWrap').classList.remove('hidden');
    var body = '', title = '', meta = '';
    if (mode === 'surah'){
      var s = QURAN.surahs[idx];
      title = 'সূরা ' + SURA_BN[idx] + ' (' + s.ar + ')';
      meta = 'সূরা নম্বর: ' + bn(s.n) + ' • ' + (s.rev === 'Makki' ? 'মাক্কী' : 'মাদানী') + ' • মোট ' + bn(s.cnt) + ' আয়াত';
      if (idx !== 8 && idx !== 0) body += '<div class="bismillah">بِسْمِ ٱللَّهِ ٱلرَّحْمَـٰنِ ٱلرَّحِيمِ</div>';
      if (idx === 0) body += '<p class="sub" style="text-align:center">সূরা আল-ফাতিহার প্রথম আয়াতটিই বিসমিল্লাহ।</p>';
      if (typeof TAFSIR !== 'undefined' && TAFSIR[idx]) body += '<div class="quiz-exp" style="margin:12px 0"><b>সংক্ষিপ্ত তাফসির ও পরিচিতি:</b> ' + TAFSIR[idx] + '</div>';
      for (var i = 0; i < s.cnt; i++) body += ayahHTML(idx, i);
      body += '<div class="surah-end">صَدَقَ ٱللَّهُ ٱلْعَظِيم</div>';
      playCtx = { mode: 'surah', list: [] };
      for (var k = 0; k < s.cnt; k++) playCtx.list.push(globalAyah(idx, k));
    } else {
      var seg = JUZ_SEGS[idx];
      title = 'পারা ' + bn(idx + 1) + ' — ' + JUZ_NAMES[idx];
      meta = 'এই পারায় ' + bn(seg.length) + 'টি অংশ রয়েছে';
      playCtx = { mode: 'juz', list: [] };
      seg.forEach(function(part){
        var s2 = QURAN.surahs[part.s];
        body += '<h3 style="font-family:\'Noto Serif Bengali\',serif; margin:18px 0 2px">সূরা ' + SURA_BN[part.s] + ' — আয়াত ' + bn(part.from + 1) + ' থেকে ' + bn(part.to + 1) + '</h3>';
        if (part.from === 0 && part.s !== 8 && part.s !== 0) body += '<div class="bismillah">بِسْمِ ٱللَّهِ ٱلرَّحْمَـٰنِ ٱلرَّحِيمِ</div>';
        for (var i2 = part.from; i2 <= part.to; i2++){ body += ayahHTML(part.s, i2); playCtx.list.push(globalAyah(part.s, i2)); }
      });
    }
    $('readerTitle').textContent = title;
    $('readerMeta').textContent = meta;
    $('readerBody').innerHTML = body;
    $('prevPartBtn').textContent = mode === 'surah' ? '← আগের সূরা' : '← আগের পারা';
    $('nextPartBtn').textContent = mode === 'surah' ? 'পরের সূরা →' : 'পরের পারা →';
    $('prevPartBtn').disabled = idx === 0;
    if (typeof syncBookmarkBtn === 'function') syncBookmarkBtn();
    if (typeof setLastRead === 'function'){
      if (mode === 'surah') setLastRead(mode, idx, idx, 0);
      else if (typeof JUZ_SEGS !== 'undefined' && JUZ_SEGS[idx] && JUZ_SEGS[idx][0]) setLastRead(mode, idx, JUZ_SEGS[idx][0].s, JUZ_SEGS[idx][0].from);
    }
    $('nextPartBtn').disabled = idx === (mode === 'surah' ? 113 : 29);
    window.scrollTo({ top: 0 });
  });
}
$('readerBack').addEventListener('click', function(){
  stopAudio();
  $('readerWrap').classList.add('hidden');
  $('quranListWrap').classList.remove('hidden');
});
$('prevPartBtn').addEventListener('click', function(){ if (readerState.idx > 0) openReader(readerState.mode, readerState.idx - 1); });
$('nextPartBtn').addEventListener('click', function(){
  var max = readerState.mode === 'surah' ? 113 : 29;
  if (readerState.idx < max) openReader(readerState.mode, readerState.idx + 1);
});
/* ---- audio ---- */
var playingG = null, playAllOn = false;
var RECITER = 'ar.alafasy';
function audioUrl(g){ return 'https://cdn.islamic.network/quran/audio/128/' + RECITER + '/' + g + '.mp3'; }
$('reciterSel').addEventListener('change', function(){
  RECITER = this.value;
  if (playingG !== null){ var g = playingG, all = playAllOn; playAyah(g, all); }
  toast('ক্বারী পরিবর্তন করা হয়েছে');
});
function markPlaying(){
  document.querySelectorAll('.ayah .play').forEach(function(b){
    var on = +b.getAttribute('data-play') === playingG;
    b.classList.toggle('playing', on);
    b.innerHTML = on ? '⏸ চলছে…' : '▶ শুনুন';
  });
  $('playAllBtn').textContent = playAllOn ? '⏸ থামান' : '▶ পুরো অংশ শুনুন';
}
function playAyah(g, autoNext){
  playingG = g; playAllOn = !!autoNext;
  player.src = audioUrl(g);
  player.play().catch(function(){ toast('অডিও চালানো যায়নি — ইন্টারনেট সংযোগ দেখুন'); });
  markPlaying();
  var el = $('ayah-' + g);
  if (el) el.scrollIntoView({ block: 'center', behavior: 'smooth' });
}
function stopAudio(){
  player.pause(); playingG = null; playAllOn = false; markPlaying();
}
player.addEventListener('ended', function(){
  if (playAllOn && playCtx && playingG){
    var i = playCtx.list.indexOf(playingG);
    if (i > -1 && i < playCtx.list.length - 1){ playAyah(playCtx.list[i + 1], true); return; }
  }
  playingG = null; playAllOn = false; markPlaying();
});
$('readerBody').addEventListener('click', function(e){
  var b = e.target.closest('[data-play]'); if (!b) return;
  var g = +b.getAttribute('data-play');
  if (playingG === g && !player.paused){ stopAudio(); } else { playAyah(g, false); }
});
$('playAllBtn').addEventListener('click', function(){
  if (playAllOn){ stopAudio(); return; }
  if (playCtx && playCtx.list.length) playAyah(playCtx.list[0], true);
});
/* ---- daily ayah ---- */
function dayIndex(){ var n = dhakaNow(); return Math.floor(Date.UTC(n.getFullYear(), n.getMonth(), n.getDate()) / 86400000); }
function renderDailyAyah(){
  if (!QURAN) return;
  var flat = [];
  QURAN.surahs.forEach(function(s, si){ s.a.forEach(function(a, ai){ flat.push([si, ai]); }); });
  var pick = flat[dayIndex() % flat.length];
  var s = QURAN.surahs[pick[0]], a = s.a[pick[1]];
  $('dailyAyahAr').textContent = a[0];
  $('dailyAyahBn').textContent = a[1];
  $('dailyAyahSrc').textContent = '— সূরা ' + SURA_BN[pick[0]] + ', আয়াত ' + bn(pick[1] + 1);
}
loadQuran();
</script>
<script>
/* ================= Hadith ================= */
var HADITHS = [
 { c:'ঈমান ও নিয়ত', t:'নিয়তের ওপর আমলের ভিত্তি', ar:'إِنَّمَا الأَعْمَالُ بِالنِّيَّاتِ، وَإِنَّمَا لِكُلِّ امْرِئٍ مَا نَوَىٰ', bn:'সব আমলের ফলাফল নিয়তের ওপর নির্ভরশীল, আর প্রত্যেক মানুষ তাই পাবে যার সে নিয়ত করেছে।', s:'সহিহ বুখারি: ১; সহিহ মুসলিম: ১৯০৭' },
 { c:'ঈমান ও নিয়ত', t:'দ্বীনের ভিত্তি কল্যাণকামিতা', ar:'الدِّينُ النَّصِيحَةُ', bn:'দ্বীন হলো কল্যাণকামিতা — আল্লাহর জন্য, তাঁর কিতাবের জন্য, তাঁর রাসূলের জন্য, মুসলিম শাসকদের জন্য এবং সর্বসাধারণ মুসলিমের জন্য।', s:'সহিহ মুসলিম: ৫৫' },
 { c:'চরিত্র ও আচরণ', t:'সেরা মুসলিম কে', ar:'الْمُسْلِمُ مَنْ سَلِمَ الْمُسْلِمُونَ مِنْ لِسَانِهِ وَيَدِهِ', bn:'প্রকৃত মুসলিম সেই ব্যক্তি, যার জিহ্বা ও হাত থেকে অন্য মুসলিমরা নিরাপদ থাকে।', s:'সহিহ বুখারি: ১০; সহিহ মুসলিম: ৪০' },
 { c:'চরিত্র ও আচরণ', t:'নিজের জন্য যা পছন্দ, ভাইয়ের জন্যও তাই', ar:'لَا يُؤْمِنُ أَحَدُكُمْ حَتَّىٰ يُحِبَّ لِأَخِيهِ مَا يُحِبُّ لِنَفْسِهِ', bn:'তোমাদের কেউ পূর্ণ মুমিন হতে পারবে না, যতক্ষণ না সে নিজের জন্য যা পছন্দ করে, তার ভাইয়ের জন্যও তা-ই পছন্দ করে।', s:'সহিহ বুখারি: ১৩; সহিহ মুসলিম: ৪৫' },
 { c:'চরিত্র ও আচরণ', t:'রাগ নিয়ন্ত্রণই প্রকৃত শক্তি', ar:'لَيْسَ الشَّدِيدُ بِالصُّرَعَةِ، إِنَّمَا الشَّدِيدُ الَّذِي يَمْلِكُ نَفْسَهُ عِنْدَ الْغَضَبِ', bn:'কুস্তিতে জয়ী ব্যক্তি শক্তিশালী নয়; প্রকৃত শক্তিশালী সেই ব্যক্তি, যে রাগের সময় নিজেকে নিয়ন্ত্রণ করতে পারে।', s:'সহিহ বুখারি: ৬১১৪; সহিহ মুসলিম: ২৬০৯' },
 { c:'চরিত্র ও আচরণ', t:'সত্য ও মিথ্যা', ar:'إِنَّ الصِّدْقَ يَهْدِي إِلَى الْبِرِّ، وَإِنَّ الْبِرَّ يَهْدِي إِلَى الْجَنَّةِ، وَإِنَّ الْكَذِبَ يَهْدِي إِلَى الْفُجُورِ، وَإِنَّ الْفُجُورَ يَهْدِي إِلَى النَّارِ', bn:'সত্য সৎকর্মের দিকে পথ দেখায়, আর সৎকর্ম জান্নাতের দিকে নিয়ে যায়। আর মিথ্যা পাপের দিকে পথ দেখায়, আর পাপ জাহান্নামের দিকে নিয়ে যায়।', s:'সহিহ বুখারি: ৬০৯৪; সহিহ মুসলিম: ২৬০৭' },
 { c:'নামাজ', t:'নামাজ দ্বীনের স্তম্ভ', ar:'رَأْسُ الْأَمْرِ الْإِسْلَامُ، وَعَمُودُهُ الصَّلَاةُ، وَذِرْوَةُ سَنَامِهِ الْجِهَادُ', bn:'সবকিছুর মূল হলো ইসলাম, তার স্তম্ভ হলো নামাজ, আর তার সর্বোচ্চ শিখর হলো জিহাদ (আল্লাহর পথে সংগ্রাম)।', s:'সুনানে তিরমিযি: ২৬১৬ (সহিহ)' },
 { c:'নামাজ', t:'প্রথম হিসাব হবে নামাজের', ar:'إِنَّ أَوَّلَ مَا يُحَاسَبُ بِهِ الْعَبْدُ يَوْمَ الْقِيَامَةِ مِنْ عَمَلِهِ صَلَاتُهُ', bn:'কিয়ামতের দিন বান্দার আমলের মধ্যে সর্বপ্রথম নামাজের হিসাব নেওয়া হবে।', s:'সুনানে তিরমিযি: ৪১৩; সুনানে আবু দাউদ: ৮৬৪' },
 { c:'নামাজ', t:'জামাতে নামাজের ফজিলত', ar:'صَلَاةُ الْجَمَاعَةِ تَفْضُلُ صَلَاةَ الْفَذِّ بِسَبْعٍ وَعِشْرِينَ دَرَجَةً', bn:'জামাতে নামাজ পড়া একাকী নামাজ পড়ার চেয়ে সাতাশ গুণ বেশি মর্যাদাপূর্ণ।', s:'সহিহ বুখারি: ৬৪৫; সহিহ মুসলিম: ৬৫০' },
 { c:'কুরআন', t:'কুরআন শেখা ও শেখানো', ar:'خَيْرُكُمْ مَنْ تَعَلَّمَ الْقُرْآنَ وَعَلَّمَهُ', bn:'তোমাদের মধ্যে সর্বোত্তম সেই ব্যক্তি, যে কুরআন শেখে এবং শেখায়।', s:'সহিহ বুখারি: ৫০২৭' },
 { c:'কুরআন', t:'কুরআন পাঠের প্রতিদান', ar:'مَنْ قَرَأَ حَرْفًا مِنْ كِتَابِ اللَّهِ فَلَهُ بِهِ حَسَنَةٌ، وَالْحَسَنَةُ بِعَشْرِ أَمْثَالِهَا', bn:'যে ব্যক্তি আল্লাহর কিতাব থেকে একটি হরফ পড়বে, তার জন্য একটি নেকি রয়েছে; আর প্রতিটি নেকি দশ গুণ বাড়িয়ে দেওয়া হয়।', s:'সুনানে তিরমিযি: ২৯১০ (সহিহ)' },
 { c:'কুরআন', t:'দুই আয়াতের আমল', ar:'الآيَتَانِ مِنْ آخِرِ سُورَةِ الْبَقَرَةِ، مَنْ قَرَأَهُمَا فِي لَيْلَةٍ كَفَتَاهُ', bn:'সূরা আল-বাকারার শেষ দুই আয়াত — যে ব্যক্তি রাতে তা পড়বে, তা তার জন্য যথেষ্ট হবে।', s:'সহিহ বুখারি: ৫০০৯; সহিহ মুসলিম: ৮০৭' },
 { c:'যিকির ও দোয়া', t:'সেরা যিকির', ar:'أَفْضَلُ الذِّكْرِ لَا إِلَٰهَ إِلَّا اللَّهُ، وَأَفْضَلُ الدُّعَاءِ الْحَمْدُ لِلَّهِ', bn:'সর্বোত্তম যিকির হলো "লা ইলাহা ইল্লাল্লাহ", আর সর্বোত্তম দোয়া হলো "আলহামদুলিল্লাহ"।', s:'সুনানে তিরমিযি: ৩৩৮৩' },
 { c:'যিকির ও দোয়া', t:'হালকা অথচ ভারী দুটি বাক্য', ar:'كَلِمَتَانِ خَفِيفَتَانِ عَلَى اللِّسَانِ، ثَقِيلَتَانِ فِي الْمِيزَانِ، حَبِيبَتَانِ إِلَى الرَّحْمَٰنِ: سُبْحَانَ اللَّهِ وَبِحَمْدِهِ، سُبْحَانَ اللَّهِ الْعَظِيمِ', bn:'দুটি বাক্য জিহ্বায় হালকা, মিজানে (পাল্লায়) ভারী এবং দয়াময়ের কাছে প্রিয়: "সুবহানাল্লাহি ওয়া বিহামদিহি" ও "সুবহানাল্লাহিল আজিম"।', s:'সহিহ বুখারি: ৬৬৮২; সহিহ মুসলিম: ২৬৯৪' },
 { c:'যিকির ও দোয়া', t:'দোয়া কবুলের সময়', ar:'إِنَّ فِي اللَّيْلِ لَسَاعَةً لَا يُوَافِقُهَا رَجُلٌ مُسْلِمٌ يَسْأَلُ اللَّهَ خَيْرًا مِنْ أَمْرِ الدُّنْيَا وَالْآخِرَةِ إِلَّا أَعْطَاهُ إِيَّاهُ', bn:'রাতের মধ্যে এমন একটি মুহূর্ত আছে, কোনো মুসলিম দুনিয়া-আখিরাতের কল্যাণ চেয়ে দোয়া করলে আল্লাহ তাকে তা দান করেন।', s:'সহিহ মুসলিম: ৭৫৭' },
 { c:'সদকা ও দান', t:'হাসিমুখও সদকা', ar:'كُلُّ مَعْرُوفٍ صَدَقَةٌ', bn:'প্রতিটি ভালো কাজই সদকা। (অন্য বর্ণনায়: ভাইয়ের সামনে হাসিমুখে থাকাও সদকা।)', s:'সহিহ বুখারি: ৬০২১; সহিহ মুসলিম: ১০০৫' },
 { c:'সদকা ও দান', t:'সদকায় সম্পদ কমে না', ar:'مَا نَقَصَتْ صَدَقَةٌ مِنْ مَالٍ', bn:'সদকা করলে সম্পদ কমে না।', s:'সহিহ মুসলিম: ২৫৮৮' },
 { c:'পরিবার ও সমাজ', t:'মায়ের পায়ের নিচে জান্নাত', ar:'الْجَنَّةُ تَحْتَ أَقْدَامِ الْأُمَّهَاتِ', bn:'জান্নাত মায়েদের পায়ের নিচে। (অর্থাৎ মায়ের সেবা ও সন্তুষ্টির মাধ্যমে জান্নাত লাভ হয়।)', s:'সুনানে নাসায়ি: ৩১০৪; মুসনাদে আহমাদ: ১৫৫৭৭' },
 { c:'পরিবার ও সমাজ', t:'প্রতিবেশীর হক', ar:'مَا زَالَ جِبْرِيلُ يُوصِينِي بِالْجَارِ حَتَّىٰ ظَنَنْتُ أَنَّهُ سَيُوَرِّثُهُ', bn:'জিবরাইল (আ.) আমাকে প্রতিবেশী সম্পর্কে এত বেশি উপদেশ দিতে থাকলেন যে, আমি মনে করলাম তিনি প্রতিবেশীকে উত্তরাধিকারী বানিয়ে দেবেন।', s:'সহিহ বুখারি: ৬০১৪; সহিহ মুসলিম: ২৬২৪'.replace(/ih/g,'হি') },
 { c:'জ্ঞান', t:'জ্ঞান অন্বেষণ ফরজ', ar:'طَلَبُ الْعِلْمِ فَرِيضَةٌ عَلَىٰ كُلِّ مُسْلِمٍ', bn:'জ্ঞান অন্বেষণ করা প্রতিটি মুসলিমের ওপর ফরজ।', s:'সুনানে ইবনে মাজাহ: ২২৪ (সহিহ)' },
 { c:'জ্ঞান', t:'জ্ঞানীর মর্যাদা', ar:'مَنْ سَلَكَ طَرِيقًا يَلْتَمِسُ فِيهِ عِلْمًا سَهَّلَ اللَّهُ لَهُ بِهِ طَرِيقًا إِلَى الْجَنَّةِ', bn:'যে ব্যক্তি জ্ঞান অন্বেষণের পথে চলে, আল্লাহ তার জন্য জান্নাতের পথ সহজ করে দেন।', s:'সহিহ মুসলিম: ২৬৯৯' },
 { c:'তাওবা ও ক্ষমা', t:'আল্লাহর ক্ষমার হাত', ar:'إِنَّ اللَّهَ يَبْسُطُ يَدَهُ بِاللَّيْلِ لِيَتُوبَ مُسِيءُ النَّهَارِ، وَيَبْسُطُ يَدَهُ بِالنَّهَارِ لِيَتُوبَ مُسِيءُ اللَّيْلِ', bn:'আল্লাহ রাতে তাঁর হাত প্রসারিত করেন, যাতে দিনের পাপী তাওবা করে; আর দিনে হাত প্রসারিত করেন, যাতে রাতের পাপী তাওবা করে।', s:'সহিহ মুসলিম: ২৭৫৯'.replace(/ih/g,'হি') },
 { c:'ধৈর্য ও কৃতজ্ঞতা', t:'মুমিনের অবস্থা বিস্ময়কর', ar:'عَجَبًا لِأَمْرِ الْمُؤْمِنِ، إِنَّ أَمْرَهُ كُلَّهُ خَيْرٌ، إِنْ أَصَابَتْهُ سَرَّاءُ شَكَرَ فَكَانَ خَيْرًا لَهُ، وَإِنْ أَصَابَتْهُ ضَرَّاءُ صَبَرَ فَكَانَ خَيْرًا لَهُ', bn:'মুমিনের অবস্থা বিস্ময়কর! তার সব অবস্থাই কল্যাণকর: সুখ এলে সে কৃতজ্ঞতা প্রকাশ করে — তা তার জন্য কল্যাণ; আর দুঃখ এলে সে ধৈর্য ধারণ করে — তাও তার জন্য কল্যাণ।', s:'সহিহ মুসলিম: ২৯৯৯'.replace(/ih/g,'হি') },
 { c:'রোজা', t:'রোজাদারের জন্য বিশেষ দরজা', ar:'إِنَّ فِي الْجَنَّةِ بَابًا يُقَالُ لَهُ الرَّيَّانُ، يَدْخُلُ مِنْهُ الصَّائِمُونَ يَوْمَ الْقِيَامَةِ', bn:'জান্নাতে "রাইয়ান" নামে একটি দরজা আছে; কিয়ামতের দিন সেই দরজা দিয়ে রোজাদাররা প্রবেশ করবে।', s:'সহিহ বুখারি: ১৮৯৬; সহিহ মুসলিম: ১১৫২' }
];
function hadithCard(h){
  var marked = (typeof isBookmarked === 'function') && isBookmarked('hadith:' + h.t);
  return '<article class="hcard"><button class="bmkbtn" data-bmh="' + esc(h.t) + '">' + (marked ? '✓ বুকমার্ক করা' : 'বুকমার্ক') + '</button><span class="cat">' + h.c + '</span><h3>' + h.t + '</h3>' +
    '<p class="ar">' + h.ar + '</p><p>' + h.bn + '</p><p class="src">সূত্র: ' + h.s + '</p><p style="margin:8px 0 0"><button class="play" data-card-hadith="' + esc(h.t) + '">ছবি কার্ড বানান</button></p></article>';
}
function renderHadiths(filter){
  var list = HADITHS.filter(function(h){
    return !filter || (h.t + h.bn + h.c).indexOf(filter) > -1;
  });
  $('hadithList').innerHTML = list.length ? list.map(hadithCard).join('') : '<p class="loadmsg">কিছু পাওয়া যায়নি।</p>';
}
$('hadithSearch').addEventListener('input', function(){ renderHadiths(this.value.trim()); });
renderHadiths('');
(function dailyHadith(){
  var h = HADITHS[dayIndex() % HADITHS.length];
  $('dailyHadithAr').textContent = h.ar;
  $('dailyHadithBn').textContent = h.bn;
  $('dailyHadithSrc').textContent = '— ' + h.s;
})();

/* ================= Duas ================= */
