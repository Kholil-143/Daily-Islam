 { c:'পরিবার ও সমাজ', t:'প্রতিবেশীর হক', ar:'مَا زَالَ جِبْرِيلُ يُوصِينِي بِالْجَارِ حَتَّىٰ ظَنَنْتُ أَنَّهُ سَيُوَرِّثُهُ', bn:'জিবরাইল (আ.) আমাকে প্রতিবেশী সম্পর্কে এত বেশি উপদেশ দিতে থাকলেন যে, আমি মনে করলাম তিনি প্রতিবেশীকে উত্তরাধিকারী বানিয়ে দেবেন।', s:'সহিহ বুখারি: ৬০১৪; সহিহ মুসলিম: ২৬২৪'.replace(/ih/g,'হি') },
 { c:'জ্ঞান', t:'জ্ঞান অন্বেষণ ফরজ', ar:'طَلَبُ الْعِلْمِ فَرِيضَةٌ عَلَىٰ كُلِّ مُسْلِمٍ', bn:'জ্ঞান অন্বেষণ করা প্রতিটি মুসলিমের ওপর ফরজ।', s:'সুনানে ইবনে মাজাহ: ২২৪ (সহিহ)' },
 { c:'জ্ঞান', t:'জ্ঞানীর মর্যাদা', ar:'مَنْ سَلَكَ طَرِيقًا يَلْتَمِسُ فِيهِ عِلْمًا سَهَّلَ اللَّهُ لَهُ بِهِ طَرِيقًا إِلَى الْجَنَّةِ', bn:'যে ব্যক্তি জ্ঞান অন্বেষণের পথে চলে, আল্লাহ তার জন্য জান্নাতের পথ সহজ করে দেন।', s:'সহিহ মুসলিম: ২৬৯৯' },
