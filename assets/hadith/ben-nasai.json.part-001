					"grade": "Sahih Muslim"
				}
			],
			"reference": {
				"book": 16,
				"hadith": 9
			}
		},
		{
			"hadithnumber": 1468,
			"arabicnumber": 1468,
			"text": "। মুহাম্মাদ ইবনু মুসান্না (রহঃ) ... ইবনু আব্বাস (রাঃ) সূত্রে নবী সাল্লাল্লাহু আলাইহি ওয়াসাল্লাম থেকে বর্ণিত যে, তিনি গ্রহণের সময় সালাত আদায় করছিলেন। তিনি তখন কিরাআত পড়লেন ও রুকু করলেন, তারপর পুনরায় কিরাআত পড়লেন ও রুকু করলেন। পুনরায় কিরাআত পড়লেন ও রুকু করলেন। তারপর কিরাআত পড়লেন, রুকু করলেন, তারপর সিজদা করলেন পুনরায় তার মত আর এক রাকআত আদায় করলেন।",
			"grades": [
				{
					"name": "Abu Ghuddah",
					"grade": "Shadh"
				},
				{
					"name": "Al-Albani",
					"grade": "Daif"
				},
				{
					"name": "Zubair Ali Zai",
					"grade": "Sahih"
				}
			],
			"reference": {
				"book": 16,
