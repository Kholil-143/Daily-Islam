					"grade": "Isnaad Sahih"
				}
			],
			"reference": {
				"book": 11,
				"hadith": 113
			}
		},
		{
			"hadithnumber": 989,
			"arabicnumber": 989,
			"text": "। মুহাম্মাদ ইবনু সালামা (রহঃ) ... যায়দ ইবনু সাবিত (রাঃ) থেকে বর্ণিত যে, তিনি মারওয়ানকে বললেন, হে আবূ আবদুল মালিক! আপনি কি মাগরিবের সালাতে قُلْ هُوَ اللَّهُ أَحَدٌ এবং إِنَّا أَعْطَيْنَاكَ الْكَوْثَرَ পড়ে থাকেন? তিনি বললেন, হ্যাঁ। তিনি বললেন, আল্লাহর শপথ! আমি রাসুলুল্লাহ সাল্লাল্লাহু আলাইহি ওয়াসাল্লাম কে দেখেছি তিনি দীর্ঘ সুরার মধ্যে (সূরা আনআম এবং সূরা আরাফ দীর্ঘ) বড় সুরা আলিফ লাম মীম সোয়াদ (সূরা আরাফ) পড়েছেন।",
			"grades": [
				{
					"name": "Abu Ghuddah",
					"grade": "Sahih"
				},
				{
					"name": "Al-Albani",
					"grade": "Sahih"
				},
				{
					"name": "Zubair Ali Zai",
					"grade": "Isnaad Sahih"
				}
			],
			"reference": {
				"book": 11,
				"hadith": 114
			}
		},
		{
			"hadithnumber": 990,
			"arabicnumber": 990,
			"text": "। মুহাম্মাদ ইবনু আবদুল আলা (রহঃ) ... মারওয়ান ইবনু হাকাম থেকে বর্ণিত যে, যায়িদ ইবনু সাবিত (রাঃ) বললেন, আমার কি হলো আমি দেখছি আপনি মাগরিবের সালাতে ছোট ছোট সূরা পড়লেন। অথচ রাসুলুল্লাহ সাল্লাল্লাহু আলাইহি ওয়াসাল্লাম কে দেখেছি তিনি তাতে দু'টি দীর্ঘ সূরার মধ্য থেকে যে সুরা অধিক দীর্ঘ তা পাঠ করতেন। তিনি জিজ্ঞাসা করলেন, ঐ দীর্ঘ সূরা কি? তিনি বললেন, তা হলো সূরা আ’রাফ।",
			"grades": [
				{
					"name": "Abu Ghuddah",
					"grade": "Sahih"
				},
				{
					"name": "Al-Albani",
					"grade": "Sahih"
				},
				{
					"name": "Zubair Ali Zai",
					"grade": "Sahih Bukhari"
				}
			],
			"reference": {
				"book": 11,
				"hadith": 115
			}
		},
		{
			"hadithnumber": 991,
			"arabicnumber": 991,
			"text": "। আমর ইবনু উসমান (রহঃ) ... আয়িশা (রাঃ) থেকে বর্ণিত যে, রাসুলুল্লাহ সাল্লাল্লাহু আলাইহি ওয়াসাল্লাম মাগরিবের সালাতে সূরা আ’রাফ পাঠ করতেন। আর তিনি তা দু' রাকআতে ভাগ করলেন।",
			"grades": [
				{
					"name": "Abu Ghuddah",
