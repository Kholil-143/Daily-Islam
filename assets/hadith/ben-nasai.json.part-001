					"name": "Abu Ghuddah",
					"grade": "Sahih"
				},
				{
					"name": "Al-Albani",
					"grade": "Sahih"
				},
				{
					"name": "Zubair Ali Zai",
					"grade": "Sahih Bukhari"
				}
			],
			"reference": {
				"book": 12,
				"hadith": 50
			}
		},
		{
			"hadithnumber": 1079,
			"arabicnumber": 1079,
			"text": "। ইসহাক ইবনু ইবরাহীম (রহঃ) ... আনাস (রাঃ) থেকে বর্ণিত যে, রাসুলুল্লাহ সাল্লাল্লাহু আলাইহি ওয়াসাল্লাম কুনুত পড়েছেন একমাস, যাতে তিনি আরবের গোত্রসমূহ থেকে কোন গোত্রের উপর বদদোয়া করছিলেন। এরপর তা পরিত্যাগ করেন।",
