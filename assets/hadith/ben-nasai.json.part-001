					"name": "Zubair Ali Zai",
					"grade": "Sahih"
				}
			],
			"reference": {
				"book": 10,
				"hadith": 14
			}
		},
		{
			"hadithnumber": 791,
			"arabicnumber": 791,
			"text": "। যিয়াদ ইবনু আইয়্যুব (রহঃ) ... আনাস (রাঃ) থেকে বর্ণিত। তিনি বলেন, সালাতের ইকামত বলা হলো আর রাসুলুল্লাহ সাল্লাল্লাহু আলাইহি ওয়াসাল্লাম এক ব্যক্তির সাথে একান্তে কথা বলছিলেন। তারপর তিনি সালাতে দাঁড়ালেন না, যতক্ষন না লোকেরা ঘুমিয়ে পড়ল।",
			"grades": [
