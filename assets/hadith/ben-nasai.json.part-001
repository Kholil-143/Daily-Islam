					"grade": "Sahih"
				}
			],
			"reference": {
				"book": 15,
				"hadith": 2
			}
		},
		{
			"hadithnumber": 1435,
			"arabicnumber": 1435,
			"text": "। কুতায়বা (রহঃ) ... ইবনু আব্বাস (রাঃ) থেকে বর্ণিত যে, রাসুলুল্লাহ সাল্লাল্লাহু আলাইহি ওয়াসাল্লাম যখন মক্কা থেকে মদীনা অভিমুখে বের হলেন, তিনি রাব্বুল আলামীন ব্যতীত আর কাউকে ভয় করতেন না। (এতদসত্ত্বেও) তিনি সালাত দু’রাকআতই আদায় করতেন।",
			"grades": [
				{
					"name": "Abu Ghuddah",
					"grade": "Sahih"
				},
				{
					"name": "Al-Albani",
					"grade": "Sahih"
				},
				{
					"name": "Zubair Ali Zai",
					"grade": "Sahih"
				}
			],
			"reference": {
				"book": 15,
				"hadith": 3
			}
		},
		{
			"hadithnumber": 1436,
			"arabicnumber": 1436,
			"text": "। মুহাম্মদ আব্দুল আলা (রহঃ) ... ইবনু আব্বাস (রাঃ) থেকে বর্ণিত। তিনি বলেন, আমরা রাসুলুল্লাহ সাল্লাল্লাহু আলাইহি ওয়াসাল্লাম এর সাথে মক্কা এবং মদীনার মধ্যে সফর করতাম, তখন আমরা আল্লাহ ব্যতীত আর কাউকে ভয় করতাম না। এতদসত্ত্বেও আমরা সালাত দু’রাকআতই আদায় করতাম।",
			"grades": [
				{
					"name": "Abu Ghuddah",
					"grade": "Sahih"
				},
				{
					"name": "Al-Albani",
					"grade": "Sahih"
				},
				{
					"name": "Zubair Ali Zai",
					"grade": "Isnaad Sahih"
				}
			],
			"reference": {
				"book": 15,
				"hadith": 4
			}
		},
		{
			"hadithnumber": 1437,
			"arabicnumber": 1437,
			"text": "। ইসহাক ইবনু ইবরাহীম (রহঃ) ... ইবনুুস সিম্‌ত (রহঃ) থেকে বর্ণিত। তিনি বলেন, আমি উমর ইবনু খাত্তাব (রাঃ) যুল হুলায়ফাতে সালাত দু’রাকআত আদায় করতে দেখেছি। তখন আমি তাকে সে সম্পর্কে জিজ্ঞাসা করলাম। তিনি বললেন, আমি তদ্রুপই করছি যেরূপ রাসুলুল্লাহ সাল্লাল্লাহু আলাইহি ওয়াসাল্লাম-কে করতে দেখেছি।",
			"grades": [
				{
					"name": "Abu Ghuddah",
					"grade": "Sahih"
				},
				{
					"name": "Al-Albani",
					"grade": "Sahih"
				},
				{
					"name": "Zubair Ali Zai",
					"grade": "Sahih Muslim"
				}
			],
			"reference": {
				"book": 15,
				"hadith": 5
			}
		},
		{
			"hadithnumber": 1438,
			"arabicnumber": 1438,
			"text": "। কুতায়বা (রহঃ) ... আনাস (রাঃ) থেকে বর্ণিত। তিনি বলেন, আমি রাসুলুল্লাহ সাল্লাল্লাহু আলাইহি ওয়াসাল্লাম এর সাথে মদীনা থেকে মক্কা অভিমুখে বের হলাম। তিনি প্রত্যাবর্তন করা পর্যন্ত সর্বদাই সালাত সংক্ষিপ্তভাবে আদায় করতেন। তিনি মক্কায় দশ দিন অবস্থান করেছিলেন।",
			"grades": [
				{
					"name": "Abu Ghuddah",
					"grade": "Sahih"
				},
				{
					"name": "Al-Albani",
					"grade": "Sahih"
				},
				{
					"name": "Zubair Ali Zai",
					"grade": "Sahih - Agreed Upon"
				}
			],
			"reference": {
				"book": 15,
				"hadith": 6
			}
		},
		{
			"hadithnumber": 1439,
			"arabicnumber": 1439,
			"text": "। মুহাম্মাদ ইবনু আলী (রহঃ) ... আব্দুল্লাহ (রাঃ) থেকে বর্ণিত। তিনি বলেন, আমি রাসুলুল্লাহ সাল্লাল্লাহু আলাইহি ওয়াসাল্লাম-এর সাথে এক সফরে সালাত দূ’রাকআত আদায় করলাম, আর আবূ বকর (রাঃ) ও উমর (রাঃ)-এর সাথেও (সফরে) দু’রাকআত আদায় করেছি।",
			"grades": [
				{
					"name": "Abu Ghuddah",
					"grade": "Sahih Isnaad"
				},
				{
					"name": "Al-Albani",
					"grade": "Sahih Isnaad"
				},
				{
					"name": "Zubair Ali Zai",
					"grade": "Sahih"
				}
			],
			"reference": {
				"book": 15,
				"hadith": 7
			}
		},
		{
			"hadithnumber": 1440,
			"arabicnumber": 1440,
			"text": "। হুমায়দ ইবনু মাসআদা (রহঃ) ... উমর (রাঃ) থেকে বর্ণিত। তিনি বলেন, জুমু'আর সালাত দু’রাকআত, ঈদুল ফিতরের সালাত দু’রাকআত, ঈদুল আযহার সালাত দু’রাকআত আর সফরের সালাত দু’রাকআতই পরিপূর্ণ, অসম্পূর্ণ নয়। নবী সাল্লাল্লাহু আলাইহি ওয়াসাল্লাম-এর ভাষ্য মতে।",
			"grades": [
				{
					"name": "Abu Ghuddah",
					"grade": "Sahih"
				},
				{
					"name": "Al-Albani",
					"grade": "Sahih"
				},
				{
					"name": "Zubair Ali Zai",
					"grade": "Sahih"
				}
			],
			"reference": {
				"book": 15,
				"hadith": 8
			}
		},
		{
			"hadithnumber": 1441,
			"arabicnumber": 1441,
			"text": "। মুহাম্মাদ ইবনু ওয়াহব (রহঃ) ... ইবনু আব্বাস (রাঃ) থেকে বর্ণিত। তিনি বলেন, তোমাদের নবী সাল্লাল্লাহু আলাইহি ওয়াসাল্লাম-এর ভাষ্য মতে বাড়ীতে অবস্থানকালীন সালাত চার রাকআত, আর সফরকালীন সালাত দু’রাকআত, এবং শঙ্কাকালীন সময়ের সালাত এক রাকআত ফরয করা হয়েছে।",
			"grades": [
				{
					"name": "Abu Ghuddah",
					"grade": "Sahih"
				},
				{
					"name": "Al-Albani",
					"grade": "Sahih"
				},
				{
					"name": "Zubair Ali Zai",
					"grade": "Sahih"
				}
			],
			"reference": {
				"book": 15,
				"hadith": 9
			}
		},
		{
			"hadithnumber": 1442,
			"arabicnumber": 1442,
			"text": "। ইয়াকুব ইবনু মাহান (রহঃ) ... ইবনু অববাস (রাঃ) থেকে বর্ণিত। তিনি বলেন, তোমাদের নবী সাল্লাল্লাহু আলাইহি ওয়াসাল্লাম-এর ভাষ্য মতে আল্লাহ তা'আলা বাড়ীতে অবস্থানকালীন সময়ে চার রাকআত, সফরকালীন দু’রাকআত এবং শঙ্কাকালীন এক রাকআত সালাত ফরয করেছেন।",
			"grades": [
				{
					"name": "Abu Ghuddah",
					"grade": "Sahih"
				},
				{
					"name": "Al-Albani",
					"grade": "Sahih"
				},
				{
					"name": "Zubair Ali Zai",
					"grade": "Sahih"
				}
			],
			"reference": {
				"book": 15,
				"hadith": 10
			}
		},
		{
			"hadithnumber": 1443,
			"arabicnumber": 1443,
			"text": "। মুহাম্মদ ইবনু আবদুল আলা (রহঃ) ... মুসা ইবনু সালামা (রাঃ) থেকে বর্ণিত। তিনি বলেন, আমি ইবনু আব্বাস (রাঃ)-কে বললাম, আমি মক্কায় কিভাবে সালাত আদায় করব যখন আমি জামাআতে সালাত আদায় না করি? তিনি বললেন, দু’রাকআত আদায় করবে, এটাই আবূল কাসেম সাল্লাল্লাহু আলাইহি ওয়াসাল্লাম এর সুন্নাত।",
			"grades": [
				{
					"name": "Abu Ghuddah",
					"grade": "Sahih"
				},
				{
					"name": "Al-Albani",
					"grade": "Sahih"
				},
				{
					"name": "Zubair Ali Zai",
					"grade": "Sahih Muslim"
				}
			],
			"reference": {
				"book": 15,
				"hadith": 11
			}
		},
		{
			"hadithnumber": 1444,
			"arabicnumber": 1444,
			"text": "। ইসমাঈল ইবনু মাসউদ (রাঃ) ... মুসা ইবনু সালামা (রাঃ) থেকে বর্ণিত যে, তিনি ইবনু আব্বাস (রাঃ)-কে প্রশ্ন করলেন যে, এরপর আমি জামাআতে সালাত পেলাম না, তখন আমি “বাথহা” নামক স্থানে ছিলাম। তা কিরূপে আদায় করা সমীচীন মনে করেন? তিনি বললেন, দু’রাকআত আদায় করবে, এটাই আবূল কাসেম সাল্লাল্লাহু আলাইহি ওয়াসাল্লাম-এর সুন্নাত।",
			"grades": [
				{
					"name": "Abu Ghuddah",
					"grade": "Sahih"
				},
				{
					"name": "Al-Albani",
					"grade": "Sahih"
				},
				{
					"name": "Zubair Ali Zai",
					"grade": "Sahih"
				}
			],
			"reference": {
				"book": 15,
				"hadith": 12
			}
		},
		{
			"hadithnumber": 1445,
			"arabicnumber": 1445,
			"text": "। কুতায়বা (রহঃ) ... হারিছা ইবনু ওয়াহব খুযায়ী (রাঃ) থেকে বর্ণিত। তিনি বলেন, আমি একদা নবী সাল্লাল্লাহু আলাইহি ওয়াসাল্লাম–এর সাথে মিনায় দু’রাকআত সালাত আদায় করলাম অথচ মানুষ তখন অধিক নিরাপদ ছিল।",
			"grades": [
				{
					"name": "Abu Ghuddah",
					"grade": "Sahih"
				},
				{
					"name": "Al-Albani",
					"grade": "Sahih"
				},
				{
					"name": "Zubair Ali Zai",
					"grade": "Sahih - Agreed Upon"
				}
			],
			"reference": {
				"book": 15,
				"hadith": 13
			}
		},
		{
			"hadithnumber": 1446,
			"arabicnumber": 1446,
			"text": "। আমর ইবনু আলী (রহঃ) ... হারিছা ইবনু ওয়াহব (রাঃ) থেকে বর্ণিত। তিনি বলেন, রাসুলুল্লাহ সাল্লাল্লাহু আলাইহি ওয়াসাল্লাম আমাদের নিয়ে মিনায় দু’রাকআত সালাত আদায় করলেন, অথচ তখন মানুষ অধিক নিরাপদ ছিল।",
			"grades": [
				{
					"name": "Abu Ghuddah",
					"grade": "Sahih"
				},
				{
					"name": "Al-Albani",
					"grade": "Sahih"
				},
				{
					"name": "Zubair Ali Zai",
					"grade": "Sahih"
				}
			],
			"reference": {
				"book": 15,
				"hadith": 14
			}
		},
		{
			"hadithnumber": 1447,
			"arabicnumber": 1447,
			"text": "। কুতায়বা (রহঃ) ... আনাস ইবনু মালিক (রাঃ) থেকে বর্ণিত। তিনি বলেন, আমি রাসুলুল্লাহ সাল্লাল্লাহু আলাইহি ওয়াসাল্লাম-এর সাথে মিনায় দু’রাকআত সালাত আদায় করেছি এবং আবূ বকর (রাঃ) ও উমর (রাঃ)-এর সাথেও আর উসমান (রাঃ)-এর সাথেও দু’রাকআত আদায় করেছি তাঁর খিলাফতের প্রথম যামানায়।",
			"grades": [
				{
					"name": "Abu Ghuddah",
					"grade": "Sahih Lighairihi"
				},
				{
					"name": "Al-Albani",
					"grade": "Sahih"
				},
				{
					"name": "Zubair Ali Zai",
					"grade": "Isnaad Hasan"
				}
			],
			"reference": {
				"book": 15,
				"hadith": 15
			}
		},
		{
			"hadithnumber": 1448,
			"arabicnumber": 1448,
			"text": "। কুতায়বা এবং মাহমূদ ইবনু গায়লান (রহঃ) ... আব্দুল্লাহ (রাঃ) থেকে বর্ণিত। তিনি বলেন, আমি মিনায় রাসুলুল্লাহ সাল্লাল্লাহু আলাইহি ওয়াসাল্লাম-এর সাথে দু’রাকআত সালাত আদায় করেছি।",
			"grades": [
				{
					"name": "Abu Ghuddah",
					"grade": "Sahih"
				},
				{
					"name": "Al-Albani",
					"grade": "Sahih"
				},
				{
					"name": "Zubair Ali Zai",
					"grade": "Sahih - Agreed Upon"
				}
			],
			"reference": {
				"book": 15,
				"hadith": 16
			}
		},
		{
			"hadithnumber": 1449,
			"arabicnumber": 1449,
			"text": "। আলী ইবনু খাশরাম (রহঃ) ... আব্দুর রহমান ইবনু ইয়াযীদ (রাঃ) থেকে বর্ণিত। তিনি বলেন, উসমান (রাঃ) মিনায় চার রাকআত সালাত আদায় করলেন এবং এ সংবাদ আব্দুল্লাহ (রাঃ)-এর কাছে পৌছল। তখন তিনি বললেন, আমি রাসুলুল্লাহ সাল্লাল্লাহু আলাইহি ওয়াসাল্লাম-এর সাথে সালাত দু’রাকআত আদায় করেছি।",
			"grades": [
				{
					"name": "Abu Ghuddah",
					"grade": "Sahih"
				},
				{
					"name": "Al-Albani",
					"grade": "Sahih"
				},
				{
					"name": "Zubair Ali Zai",
					"grade": "Sahih Muslim"
				}
			],
			"reference": {
				"book": 15,
				"hadith": 17
