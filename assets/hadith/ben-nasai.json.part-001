			}
		},
		{
			"hadithnumber": 1010,
			"arabicnumber": 1010,
			"text": "। নূহ ইবনু হাবীব (রহঃ) ... আবূ যর (রাঃ) থেকে বর্ণিত যে, নবী সাল্লাল্লাহু আলাইহি ওয়াসাল্লাম ভোর পর্যন্ত একটি আয়াত দিয়েই সালাত আদায় করলেন। আর সে আয়াতখানা হলো মহান আল্লাহর বাণীঃ إِنْ تُعَذِّبْهُمْ فَإِنَّهُمْ عِبَادُكَ وَإِنْ تَغْفِرْ لَهُمْ فَإِنَّكَ أَنْتَ الْعَزِيزُ الْحَكِيمُ",
			"grades": [
				{
					"name": "Abu Ghuddah",
					"grade": "Hasan"
				},
				{
					"name": "Al-Albani",
					"grade": "Hasan"
				},
				{
					"name": "Zubair Ali Zai",
					"grade": "Isnaad Hasan"
				}
			],
			"reference": {
