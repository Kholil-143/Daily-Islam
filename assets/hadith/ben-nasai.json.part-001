			"hadithnumber": 1378,
			"arabicnumber": 1378,
			"text": "। হুমায়দ ইবনু মাসআদা (রহঃ) ... জাবির (রাঃ) থেকে বর্ণিত। তিনি বলেন, রাসুলুল্লাহ সাল্লাল্লাহু আলাইহি ওয়াসাল্লাম বলেছেন, প্রত্যেক মুসলিম ব্যক্তির উপর প্রত্যেক সাত দিনে একদিন গোসল করা জরুরী এবং সেই দিনটি হল জুমু'আর দিন।",
			"grades": [
				{
					"name": "Abu Ghuddah",
					"grade": "Sahih Lighairihi"
				},
				{
					"name": "Al-Albani",
					"grade": "Sahih"
				},
				{
					"name": "Zubair Ali Zai",
					"grade": "Sahih"
				}
			],
			"reference": {
				"book": 14,
				"hadith": 15
