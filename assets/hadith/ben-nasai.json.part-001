			"hadithnumber": 1319,
			"arabicnumber": 1319,
			"text": "। মুহাম্মদ ইবনু মুসান্না (রহঃ) ... আব্দুল্লাহ (রাঃ) থেকে বর্ণিত। তিনি বলেন, আমি রাসুলুল্লাহ সাল্লাল্লাহু আলাইহি ওয়াসাল্লাম-কে দেখেছি যে, তিনি প্রত্যেক নীচু হওয়ার সময় এবং উপরে উঠার সময় তাকবীর বলতেন, আর দাঁড়াবার সময় এবং বসার সময়েও তাকবীর বলতেন। আর তিনি তার ডান দিকে এবং বাম দিকে “আলসালামূ আলাইকুম ওয়া রহমাতুল্লাহ, আলসালামু আলাইকুম ওয়া রহমাতুল্লাহ,” বলে সালাম ফিরাতেন, তখন তার গণ্ড দেশের শুভ্রতা দেখা যেত। আর আমি আবূ বকর এবং উমর (রাঃ)-কেও অনুরূপ করতে দেখেছি।",
			"grades": [
				{
					"name": "Abu Ghuddah",
					"grade": "Sahih"
				},
				{
					"name": "Al-Albani",
					"grade": "Sahih"
				},
				{
					"name": "Zubair Ali Zai",
					"grade": "Sahih"
				}
			],
			"reference": {
