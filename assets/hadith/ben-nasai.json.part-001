					"name": "Abu Ghuddah",
					"grade": "Sahih"
				},
				{
					"name": "Al-Albani",
					"grade": "Sahih"
				},
				{
					"name": "Zubair Ali Zai",
					"grade": "Sahih Bukhari"
				}
			],
			"reference": {
				"book": 14,
				"hadith": 29
			}
		},
		{
			"hadithnumber": 1393,
			"arabicnumber": 1393,
			"text": "। মুহাম্মাদ ইবনু ইয়াহয়া ইবনু আবদুল্লাহ (রহঃ) ... ইবনু শিহাব (রহঃ) থেকে বর্ণিত যে, সাইব ইবনু ইয়াযীদ (রাঃ) তার কাছে বর্ণনা করেছেন যে, যখন মদীনায় মানুষের সংখ্যা বেড়ে গিয়েছিল তখন উসমান (রাঃ) তৃতীয় আযানের নির্দেশ দিয়েছিলেন। কিন্তু রাসুলুল্লাহ সাল্লাল্লাহু আলাইহি ওয়াসাল্লাম এর যুগে একটি মাত্র ব্যতীত অন্য আযান ছিল না, আর জুমু'আর দিনে যখন ইমাম (মিম্বরের উপর) বসতেন তখন উক্ত আযান দেওয়া হতো।",
			"grades": [
