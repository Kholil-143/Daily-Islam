					"name": "Abu Ghuddah",
					"grade": "Hasan"
				},
				{
					"name": "Al-Albani",
					"grade": "Hasan"
				},
				{
					"name": "Zubair Ali Zai",
					"grade": "Daif"
				}
			],
			"reference": {
				"book": 10,
				"hadith": 99
			}
		},
		{
			"hadithnumber": 876,
			"arabicnumber": 876,
			"text": "। আমর ইবন মানসুর ও আহমদ ইবন মুহাম্মাদ ইবন মুগীরা ... ইবনু উমার (রাঃ) হতে বর্ণিত, তিনি বলেন, আমি রাসুলুল্লাহ সাল্লাল্লাহু আলাইহি ওয়াসাল্লাম কে দেখেছি, তিনি যখন নামাযে তাকবীর শুরু করতেন তখন তাকবীরের সময় তার দু'হাত উঠাতেন এবং দুই হাতখানাকে উভয় কাঁধ বরাবর করতেন। আর যখন রুকু করবার জন্য তাকবীর বলতেন তখনো এরূপ করতেন। এরপর যখন \"সামি'আল্লাহু লিমান হামিদাহ\" বলতেন তখনো এমন করতেন এবং বলতেন- رَبَّنَا وَلَكَ الْحَمْدُ আর যখন তিনি সিজদাহ করতেন তখন এবং যখন সিজদাহ থেকে মাথা উঠাতেন তখন এমন করতেন না।",
			"grades": [
				{
					"name": "Abu Ghuddah",
					"grade": "Sahih"
				},
				{
					"name": "Al-Albani",
					"grade": "Sahih"
				},
				{
					"name": "Zubair Ali Zai",
					"grade": "Sahih - Agreed Upon"
				}
			],
			"reference": {
