			}
		},
		{
			"hadithnumber": 1124,
			"arabicnumber": 1124,
			"text": "। মুহাম্মাদ ইবনু কুদামা (রহঃ) ... আয়িশা (রাঃ) থেকে বর্ণিত। (একরাতে) আমি রাসুলুল্লাহ সাল্লাল্লাহু আলাইহি ওয়াসাল্লাম-কে তাঁর বিছানায় না পেয়ে তাঁকে হাতড়িয়ে তালাশ করতে লাগলাম। আমি মনে করেছিলাম তিনি তার অন্য কোন স্ত্রীর নিকট গিয়ে থাকবেন। এমতাবস্থায় আমার হাত তাঁর উপর পতিত হলো, তখন তিনি সিজদায় থেকে বলছিলেনঃ اللَّهُمَّ اغْفِرْ لِي مَا أَسْرَرْتُ وَمَا أَعْلَنْتُ",
			"grades": [
				{
					"name": "Abu Ghuddah",
					"grade": "Sahih"
				},
				{
					"name": "Al-Albani",
					"grade": "Sahih"
				},
				{
					"name": "Zubair Ali Zai",
					"grade": "Sahih"
				}
			],
			"reference": {
				"book": 12,
				"hadith": 96
			}
		},
		{
			"hadithnumber": 1125,
			"arabicnumber": 1125,
			"text": "। মুহাস্মদ ইবনু মুছান্না (রহঃ) ... আয়িশা (রাঃ) থেকে বর্ণিত। তিনি বলেন, আমি রাসুলুল্লাহ সাল্লাল্লাহু আলাইহি ওয়াসাল্লাম কে না পেয়ে মনে করলাম তিনি হয়তো তাঁর কোন স্ত্রীর নিকট গিয়ে থাকবেন। তাঁকে খুঁজে দেখলাম, তিনি সিজদারত অবস্থায় বলছেনঃ رَبِّ اغْفِرْ لِي مَا أَسْرَرْتُ وَمَا أَعْلَنْتُ",
			"grades": [
