		{
			"hadithnumber": 805,
			"arabicnumber": 805,
			"text": "। আমর ইবনু আলী (রহঃ) ... আনাস (রাঃ) থেকে বর্ণিত। তিনি বলেন, রাসূলুল্লাহ সাল্লাল্লাহু আলাইহি ওয়াসাল্লাম আমাকে এবং আমার পরিবারের এক মহিলাকে সঙ্গে নিয়ে সালাত আদায় করেন। তিনি আমাকে দাঁড় করালেন তাঁর ডানদিকে আর মহিলা ছিলেন আমাদের পেছনে।",
			"grades": [
				{
					"name": "Abu Ghuddah",
					"grade": "Sahih"
				},
				{
					"name": "Al-Albani",
					"grade": "Sahih"
				},
				{
					"name": "Zubair Ali Zai",
					"grade": "Sahih"
				}
			],
			"reference": {
