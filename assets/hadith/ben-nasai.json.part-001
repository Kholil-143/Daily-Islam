			"reference": {
				"book": 14,
				"hadith": 34
			}
		},
		{
			"hadithnumber": 1398,
			"arabicnumber": 1398,
			"text": "। মাহমুদ ইবনু খালিদ (রহঃ) ... আওস ইবনু আওস সাকাফী (রাঃ) সুত্রে রাসুলুল্লাহ সাল্লাল্লাহু আলাইহি ওয়াসাল্লাম থেকে বর্ণিত। তিনি বলেন, যে ব্যক্তি শরীর ও মাথা ধৌত করত উত্তম রূপে গোসল করে ও জুমু'আর সময়ের প্রথম সময়েই মসজিদে গিয়ে খুতবা প্রথম থেকে শুনতে পায় আর নিরব হয়ে ইমামের নিকটে বসে এবং কোন অনর্থক কাজ না করে, তার জন্য প্রত্যেক পদক্ষেপে এক বছর আমল করার, এক বছর সালাত আদায় করার এবং সিয়াম পালন করার ন্যায় সওয়াব হরে।",
			"grades": [
				{
					"name": "Abu Ghuddah",
					"grade": "Sahih"
				},
				{
					"name": "Al-Albani",
					"grade": "Sahih"
				},
				{
					"name": "Zubair Ali Zai",
					"grade": "Sahih"
				}
