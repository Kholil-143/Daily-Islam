					"grade": "Isnaad Sahih"
				}
			],
			"reference": {
				"book": 11,
				"hadith": 152
			}
		},
		{
			"hadithnumber": 1028,
			"arabicnumber": 1028,
			"text": "। সুযায়দ ইবনু নাসর (রহঃ) ... আনাস (রাঃ) থেকে বর্ণিত যে, রাসুলুল্লাহ সাল্লাল্লাহু আলাইহি ওয়াসাল্লাম বলেছেন, তোমরা রুকু এবং সিজদা ঠিক ঠাক ভাবে করো। আর তোমাদের কেউ যেন কুকুরের ন্যায় উভয় হাত (জমিনে) না বিছিয়ে দেয়।",
			"grades": [
				{
					"name": "Abu Ghuddah",
					"grade": "Sahih"
				},
				{
					"name": "Al-Albani",
					"grade": "Sahih"
				},
				{
					"name": "Zubair Ali Zai",
					"grade": "Sahih"
				}
			],
			"reference": {
				"book": 11,
				"hadith": 153
			}
		},
		{
			"hadithnumber": 1029,
			"arabicnumber": 1029,
			"text": "। ইসমাঈল ইবনু মাসউদ (রহঃ) ... আলকামা এবং আসওয়াদ (রাঃ) থেকে বর্ণিত। তাঁরা উভয়ে আব্দুল্লাহ (রাঃ) এর সাথে তাঁর ঘরে ছিলেন। তিনি বললেন, তারা কি সালাত আদায় করেছে? আমরা বললাম, হ্যাঁ। তিনি তাঁদের ইমামতি করলেন। আর তাঁদের দু'জনের মধ্যে দাঁড়ালেন, আযান ও ইকামত ব্যতীত। তিনি বললেন, তোমরা যখন তিনজন হবে তখন এরূপ করবে, আর যখন এর চেয়ে বেশি লোক হবে তখন তোমাদের মধ্যে একজন ইমাম হবে এবং উভয় হাত রানের উপর বিছিয়ে রাখবে। আমি যেন এখনও দেখছি রাসুলুল্লাহ সাল্লাল্লাহু আলাইহি ওয়াসাল্লাম এর হাতের আদলের মধ্যস্থিত ফাঁক।",
			"grades": [
				{
					"name": "Abu Ghuddah",
					"grade": "Sahih"
				},
				{
					"name": "Al-Albani",
					"grade": "Sahih"
				},
				{
					"name": "Zubair Ali Zai",
					"grade": "Sahih"
				}
			],
			"reference": {
				"book": 12,
				"hadith": 1
			}
		},
		{
			"hadithnumber": 1030,
			"arabicnumber": 1030,
			"text": "। আহমদ ইবনু সায়ীদ রুবাতী (রহঃ) ... আসওয়াদ এবং আলকামা (রাঃ) থেকে বর্ণিত। তাঁরা উভয়ে বলেন, আমরা আব্দুল্লাহ ইবনু মাসউদ (রাঃ)-এর ঘরে তার সঙ্গে সালাত আদায় করলাম। তিনি আমাদের মধ্যে দাঁড়ালেন। আমরা আমাদের হাত রানের উপর রাখলাম। তিনি তা টেনে নিলেন এবং আমাদের অঙ্গুলীসমূহের মধ্যে ফাঁক করে দিলেন এবং বললেন, আমি রাসুলাল্লাহ সাল্লাল্লাহু আলাইহি ওয়াসাল্লাম কে এরূপ করতে দেখেছি।",
			"grades": [
				{
					"name": "Abu Ghuddah",
					"grade": "Sahih"
				},
				{
					"name": "Al-Albani",
					"grade": "Sahih"
				},
				{
					"name": "Zubair Ali Zai",
					"grade": "Sahih"
				}
			],
			"reference": {
				"book": 12,
				"hadith": 2
			}
		},
		{
			"hadithnumber": 1031,
			"arabicnumber": 1031,
			"text": "। নূহ ইবনু হাবীব (রহঃ) ... আবদুল্লাহ (রাঃ) থেকে বর্ণিত। তিনি বলেন, রাসুলুল্লাহ সাল্লাল্লাহু আলাইহি ওয়াসাল্লাম আমাদের সালাত শিক্ষা দিয়েছেন। তিনি দাঁড়িয়ে তাকবীর বললেন, যখন তিনি রুকু করতে ইচ্ছা করলেন, উভয় হাত হাটূদ্বয়ের মধ্যস্থলে রাখলেন, এবং রুকু করলেন। এ সংবাদ সা'দ (রাঃ) এর নিকট পৌছলে তিনি বললেন, আমার ভাই সত্যই বলেছেন। আমরা এরূপ করতাম। তারপর আমরা এরূপ করতে আদিষ্ট হয়েছি অর্থাৎ হাঁটু ধরে রাখতো।",
			"grades": [
				{
					"name": "Abu Ghuddah",
					"grade": "Sahih"
				},
				{
					"name": "Al-Albani",
					"grade": "Sahih"
				},
				{
					"name": "Zubair Ali Zai",
					"grade": "Isnaad Sahih"
				}
			],
			"reference": {
				"book": 12,
				"hadith": 3
			}
		},
		{
			"hadithnumber": 1032,
			"arabicnumber": 1032,
			"text": "। কুতায়বা (রহঃ) ... মুসআব ইবনু সা'দ (রাঃ) থেকে বর্ণিত। তিনি বলেন, আমি আমার পিতার পাশে সালাত আদায় করলাম, আর আমি আমার উভয় হাত আমার হাঁটুদ্বয়ের মধ্যস্থলে রাখলাম। তখন তিনি আমাকে বললেন, তোমার উভয় হাতের তালু তোমার হাঁটুদ্বয়ের উপর রাখ। তিনি বলেন, তারপর আমি তা পুনরায় করলাম। এরপর তিনি আমার হাত ধরে বললেন, আমাদের এরূপ করতে নিষেধ করা হয়েছে এবং আমরা আদিষ্ট হয়েছি হাঁটুর উপর হাত রাখতে।",
			"grades": [
				{
					"name": "Abu Ghuddah",
					"grade": "Sahih"
				},
				{
					"name": "Al-Albani",
					"grade": "Sahih"
				},
				{
					"name": "Zubair Ali Zai",
					"grade": "Sahih - Agreed Upon"
				}
			],
			"reference": {
				"book": 12,
				"hadith": 4
			}
		},
		{
			"hadithnumber": 1033,
			"arabicnumber": 1033,
			"text": "। আমর ইবনু আলী (রহঃ) ... মুস’আব ইবনু সাদ (রাঃ) থেকে বর্ণিত। তিনি বলেন, আমি রুকু করলাম এবং তাতে তাৎবিক (হাত দু'হাঁটুর মাঝে রাখা) করলাম। আমার পিতা বললেন, আমরা আগে এরূপ করতাম। তারপর আমরা আদিষ্ট হয়েছি হাটুতে হাত রাখতে।",
