					"name": "Zubair Ali Zai",
					"grade": "Daif"
				}
			],
			"reference": {
				"book": 12,
				"hadith": 30
			}
		},
		{
			"hadithnumber": 1059,
			"arabicnumber": 1059,
			"text": "। সুয়ায়দ ইবনু নাসর (রহঃ) ... ইবনু উমর (রাঃ) থেকে বর্ণিত যে, রাসুলুল্লাহ সাল্লাল্লাহু আলাইহি ওয়াসাল্লাম যখন সালাত আরম্ভ করতেন, তখন তার হাতদ্বয় কাঁধ পর্যন্ত উঠাতেন। আর যখন রুকুর জন্য তাকবীর বলতেন এবং রুকু থেকে তাঁর মাথা উঠাতেন, তখন হাতদ্বয় এরূপপ উঠাতেন এবং বলতেন, “সামিয়াহল্লাহু লিমান হামিদা, রাব্বানা ওয়া লাকাল হামদ। আর তিনি সিজদায় এরুপ করতেন না।",
			"grades": [
				{
					"name": "Abu Ghuddah",
					"grade": "Sahih"
				},
				{
					"name": "Al-Albani",
					"grade": "Sahih"
				},
				{
					"name": "Zubair Ali Zai",
					"grade": "Sahih"
				}
			],
			"reference": {
				"book": 12,
				"hadith": 31
			}
		},
		{
			"hadithnumber": 1060,
			"arabicnumber": 1060,
			"text": "। ইসহাক ইবনু ইবরাহীম (রহঃ) ... আবূ হুরায়রা (রাঃ) থেকে বর্ণিত যে, তিনি বলেন, রাসুলুল্লাহ সাল্লাল্লাহু আলাইহি ওয়াসাল্লাম যখন রুকু থেকে মাথা উঠাতেন, তখন বলতেনঃ اللَّهُمَّ رَبَّنَا وَلَكَ الْحَمْدُ",
			"grades": [
				{
					"name": "Abu Ghuddah",
					"grade": "Sahih"
				},
				{
					"name": "Al-Albani",
					"grade": "Sahih"
				},
				{
					"name": "Zubair Ali Zai",
					"grade": "Sahih"
				}
			],
			"reference": {
				"book": 12,
				"hadith": 32
			}
		},
		{
			"hadithnumber": 1061,
			"arabicnumber": 1061,
			"text": "। হান্নাদ ইবনু সারি (রহঃ) ... আনাস (রাঃ) থেকে বর্ণিত যে, নবী সাল্লাল্লাহু আলাইহি ওয়াসাল্লাম ঘোড়া থেকে ডান কাতে পড়ে গেলেন। তখন লোক তাকে দেখার জন্য আসলেন। এমতাবস্থায় সালাতের সময় উপস্থিত হলো। তিনি সালাত শেষ করে বললেন, ইমাম তো হয় এজন্য তার ইকতিদা করা হবে। যখন সে রুকু করবে তখন তোমরাও রুকু করবে। আর যখন সে উঠবে তখন তোমরাও উঠবে। আর যখন ইমাম 'সামিয়াল্লাহু লিমান হামিদাহ' বলবে তখন তোমরা 'রাব্বানা ওয়া লাকাল হামদ' বলবে।",
			"grades": [
				{
					"name": "Abu Ghuddah",
					"grade": "Sahih"
				},
				{
					"name": "Al-Albani",
					"grade": "Sahih"
				},
				{
					"name": "Zubair Ali Zai",
					"grade": "Sahih"
				}
			],
			"reference": {
				"book": 12,
				"hadith": 33
			}
		},
		{
			"hadithnumber": 1062,
			"arabicnumber": 1062,
			"text": "। মুহাম্মাদ ইবনু সালামা (রহঃ) ... রিফাআ ইবনু রাফি (রাঃ) থেকে বর্ণিত। তিনি বলেন, আমরা একদিন রাসুলুল্লাহ সাল্লাল্লাহু আলাইহি ওয়াসাল্লাম এর পেছনে সালাত আদায় করছিলাম। তিনি যখন রুকু থেকে মাথা উঠালেন, তখন বললেন, 'সামিয়াল্লাহু লিমান হামিদাহ'। তাঁর পেছনে একব্যক্তি বলে উঠল رَبَّنَا وَلَكَ الْحَمْدُ حَمْدًا كَثِيرًا طَيِّبًا مُبَارَكًا فِيهِ রাসুলুল্লাহ সাল্লাল্লাহু আলাইহি ওয়াসাল্লাম সালাত শেষ করে বললেন, এখন কে কথা বলল? সে ব্যক্তি বলল, ইয়া রাসুলাল্লাহ! আমি। রাসুলুল্লাহ সাল্লাল্লাহু আলাইহি ওয়াসাল্লাম বললেন, আমি ত্রিশের বেশি ফেরেশতাকে দেখেছি তা নিয়ে তাড়াহুড়া করছে, কে তা সর্বাগ্রে লিখবে।",
