			}
		},
		{
			"hadithnumber": 1202,
			"arabicnumber": 1202,
			"text": "। কুতায়বা ইবনু সাঈদ (রহঃ) ... আবূ হুরায়রা (রাঃ) থেকে বর্ণিত। তিনি বলেন, রাসুলুল্লাহ সাল্লাল্লাহু আলাইহি ওয়াসাল্লাম দুই কালো প্রাণী (সাপ এবং বিচ্ছু)-কে সালাতে হত্যা করার আদেশ করেছেন।",
			"grades": [
				{
					"name": "Abu Ghuddah",
					"grade": "Sahih"
				},
				{
					"name": "Al-Albani",
					"grade": "Sahih"
				},
				{
					"name": "Zubair Ali Zai",
					"grade": "Isnaad Sahih"
				}
			],
			"reference": {
				"book": 13,
				"hadith": 24
			}
		},
		{
			"hadithnumber": 1203,
			"arabicnumber": 1203,
			"text": "। মুহাম্মাদ ইবনু রাফি (রহঃ) ... আবূ হুরায়রা (রাঃ) থেকে বর্ণিত যে, রাসুলুল্লাহ সাল্লাল্লাহু আলাইহি ওয়াসাল্লাম দুই কালো প্রাণীকে (সাপ এবং বিচ্ছু) সালাতে হত্যা করার আদেশ করেছেন।",
			"grades": [
				{
					"name": "Abu Ghuddah",
					"grade": "Sahih"
				},
				{
					"name": "Al-Albani",
					"grade": "Sahih"
				},
				{
					"name": "Zubair Ali Zai",
					"grade": "Sahih - Agreed Upon"
				}
			],
			"reference": {
				"book": 13,
				"hadith": 25
			}
		},
		{
			"hadithnumber": 1204,
			"arabicnumber": 1204,
			"text": "। কুতায়বা ইবনু সাঈদ (রহঃ) ... আবূ কাতাদা (রাঃ) থেকে বর্ণিত। তিনি বলেন, রাসুলুল্লাহ সাল্লাল্লাহু আলাইহি ওয়াসাল্লাম সালাত আদায়কালীন সময়ে (তার দোহীত্রী) উমামা (রাঃ)-কে কাঁধে তুলে নিতেন এবং যখন সিজদায় যেতেন তাকে (নিচে) রেখে দিতেন। আবার যখন দাঁড়াতেন কোলে তুলে নিতেন।",
			"grades": [
				{
					"name": "Abu Ghuddah",
					"grade": "Sahih"
				},
				{
					"name": "Al-Albani",
					"grade": "Sahih"
				},
				{
					"name": "Zubair Ali Zai",
					"grade": "Sahih"
				}
			],
			"reference": {
				"book": 13,
				"hadith": 26
			}
		},
		{
			"hadithnumber": 1205,
			"arabicnumber": 1205,
			"text": "। কূতায়বা (ইবনু সাঈদ) (রহঃ) ... আবূ কাতাদা (রাঃ) থেকে বর্ণিত। তিনি বলেন, আমি নবী সাল্লাল্লাহু আলাইহি ওয়াসাল্লাম কে দেখলাম যে, তিনি সাহাবীদেরকে নিয়ে ইমামতি করছেন এবং উমামা বিনত আবূল আস (রাঃ)-কে তাঁর কাঁধে তুলে রেখেছেন, যখন তিনি রুকূতে যেতেন তাঁকে (নিচে) রেখে দিতেন এবং যখন সিজদা সমাপন করতেন তাঁকে পুনরায় কাঁধে তুলে নিতেন।",
			"grades": [
				{
					"name": "Abu Ghuddah",
					"grade": "Sahih"
				},
				{
					"name": "Al-Albani",
					"grade": "Sahih"
				},
				{
					"name": "Zubair Ali Zai",
					"grade": "Sahih"
				}
			],
			"reference": {
				"book": 13,
				"hadith": 27
			}
		},
		{
			"hadithnumber": 1206,
			"arabicnumber": 1206,
			"text": "। ইসহাক ইবনু ইবরাহীম (রহঃ) ... আয়িশা (রাঃ) থেকে বর্ণিত। তিনি বলেন, (একবার) আমি দরজা খুলতে চাইলাম। তখন রাসুলুল্লাহ সাল্লাল্লাহু আলাইহি ওয়াসাল্লাম নফল সালাত আদায় করছিলেন আর দরজা ছিল কিবলার দিকে। তখন তিনি বাম দিকে অথবা কয়েক কদম হেঁটে গিয়ে দরজা খুলে দিলেন এবং পুনরায় সালাতের স্থানে ফিরে আসলেন।",
			"grades": [
				{
					"name": "Abu Ghuddah",
					"grade": "Hasan"
				},
				{
					"name": "Al-Albani",
					"grade": "Hasan"
				},
				{
					"name": "Zubair Ali Zai",
					"grade": "Daif"
				}
			],
			"reference": {
				"book": 13,
				"hadith": 28
			}
		},
		{
			"hadithnumber": 1207,
			"arabicnumber": 1207,
			"text": "(। কুতায়বা ইবনু সাঈদ) এবং মুহাম্মাদ ইবনু মুছান্না (রহঃ) ... আবূ হুরায়রা (রাঃ) সূত্রে নবী সাল্লাল্লাহু আলাইহি ওয়াসাল্লাম থেকে বর্ণিত। তিনি বলেছেন, (সালাতে) তাসবীহ (সুবহানাল্লাহ) পড়া পুরুষদের জন্য আর হাতে তালি দেওয়া নারীদের জন্য, (মুহাম্মাদ) ইবনু মুছান্না (রহঃ) 'সালাতে' এ শব্দটি বেশি বলেছেন।",
			"grades": [
				{
					"name": "Abu Ghuddah",
					"grade": "Sahih"
				},
				{
					"name": "Al-Albani",
					"grade": "Sahih"
				},
				{
					"name": "Zubair Ali Zai",
					"grade": "Sahih - Agreed Upon"
				}
			],
			"reference": {
				"book": 13,
				"hadith": 29
			}
		},
		{
			"hadithnumber": 1208,
			"arabicnumber": 1208,
			"text": "। মুহাম্মদ ইবনু সালামা (রহঃ) ... আবূ হুরায়রা (রাঃ) থেকে বর্ণিত। তিনি বলেন, রাসুলুল্লাহ সাল্লাল্লাহু আলাইহি ওয়াসাল্লাম বলেছেন, তাসবীহ (সূবহানাল্লাহ) পড়া পুরুষদের জন্য আর হাতে তালি দেওয়া নারীদের জন্য।",
			"grades": [
				{
					"name": "Abu Ghuddah",
					"grade": "Sahih"
				},
				{
					"name": "Al-Albani",
					"grade": "Sahih"
				},
				{
					"name": "Zubair Ali Zai",
					"grade": "Sahih Muslim"
				}
			],
			"reference": {
				"book": 13,
				"hadith": 30
			}
		},
		{
			"hadithnumber": 1209,
			"arabicnumber": 1209,
			"text": "। কুতায়বা এবং সুওয়াইদ ইবনু নসর (রহঃ) ... আবূ হুরায়রা (রাঃ) থেকে বর্ণিত। তিনি বলেন, রাসুলুল্লাহ সাল্লাল্লাহু আলাইহি ওয়াসাল্লাম বলেছেন, তাসবীহ পুরুষদের জন্য আর হাতে তালি দেওয়া নারীদের জন্য।",
			"grades": [
				{
					"name": "Abu Ghuddah",
					"grade": "Sahih"
				},
				{
					"name": "Al-Albani",
					"grade": "Sahih"
				},
				{
					"name": "Zubair Ali Zai",
					"grade": "Sahih Muslim"
				}
			],
			"reference": {
				"book": 13,
				"hadith": 31
			}
		},
		{
			"hadithnumber": 1210,
			"arabicnumber": 1210,
			"text": "। উবায়দুল্লাহ ইবনু সাঈদ (রহঃ) ... আবূ হুরায়রা (রাঃ) সুত্রে রাসুলুল্লাহ সাল্লাল্লাহু আলাইহি ওয়াসাল্লাম থেকে বর্ণিত। তিনি বলেছেন, তাসবীহ পূরুষদের জন্য আর হাতে তালি দেওয়া নারীদের জন্য।",
			"grades": [
				{
					"name": "Abu Ghuddah",
					"grade": "Sahih"
				},
				{
					"name": "Al-Albani",
					"grade": "Sahih"
				},
				{
					"name": "Zubair Ali Zai",
					"grade": "Isnaad Sahih"
				}
			],
			"reference": {
				"book": 13,
				"hadith": 32
			}
		},
		{
			"hadithnumber": 1211,
			"arabicnumber": 1211,
			"text": "। মুহাম্মাদ ইবনু কুদামা (রহঃ) ... আলী (রাঃ) থেকে বর্ণিত। তিনি বলেন, আমার জন্য রাসুলুল্লাহ সাল্লাল্লাহু আলাইহি ওয়াসাল্লাম এর কাছে আসার একটা নির্দিষ্ট সময় ছিল। তখন আমি তাঁর কাছে আসতাম, আমি যখন তাঁর কাছে আসতাম অনুমতি চাইতাম। যদি তাকে সালাতরত পেতাম তবে তিনি গলা খাকার দিলে আমি প্রবেশ করতাম, আর অবসর থাকলে আমাকে অনুমতি দিতেন।",
			"grades": [
				{
					"name": "Abu Ghuddah",
					"grade": "Daif Isnaad"
				},
				{
					"name": "Al-Albani",
					"grade": "Daif Isnaad"
				},
				{
					"name": "Zubair Ali Zai",
					"grade": "Daif"
				}
			],
			"reference": {
				"book": 13,
				"hadith": 33
			}
		},
		{
			"hadithnumber": 1212,
			"arabicnumber": 1212,
			"text": "। মুহাম্মাদ ইবনু উবায়দ (রহঃ) ... আলী (রাঃ) থেকে বর্ণিত। তিনি বলেন, রাসুলুল্লাহ সাল্লাল্লাহু আলাইহি ওয়াসাল্লাম এর পক্ষ থেকে আমার জন্য প্রবেশের দুটি সময় ছিল। একটি রাতে অপরটি দিনে। যখন রাতে প্রবেশ করতাম তখন তিনি আমাকে উদ্দেশ করে গলা খাঁকার দিতেন।",
			"grades": [
				{
					"name": "Abu Ghuddah",
					"grade": "Daif Isnaad"
				},
				{
					"name": "Al-Albani",
					"grade": "Daif Isnaad"
				},
				{
					"name": "Zubair Ali Zai",
					"grade": "Daif"
				}
			],
			"reference": {
				"book": 13,
				"hadith": 34
			}
		},
		{
			"hadithnumber": 1213,
			"arabicnumber": 1213,
			"text": "। কাসিম ইবনু যাকারিয়া (রহঃ) ... নুজাই (রাঃ) থেকে বর্ণিত। তিনি বলেন, আলী (রাঃ) আমাকে বলেছেন যে, রাসুলুল্লাহ সাল্লাল্লাহু আলাইহি ওয়াসাল্লাম এর কাছে আমার একটা বিশেষ মর্যাদা ছিল যা জগতের মধ্যে অন্য কারো জন্য ছিল না, আমি তাঁর কাছে প্রতি রাতের শেষাংশে আসতাম এবং আসসালামু আলাইকুম ইয়া নবীয়াল্লাহ! বলতাম। তখন যদি তিনি গলা খাঁকার দিতেন তা হলে আমি ঘরে ফিরে যেতাম আর তা না হলে তার কাছে যেতাম।",
			"grades": [
				{
					"name": "Abu Ghuddah",
					"grade": "Daif Isnaad"
				},
				{
					"name": "Al-Albani",
					"grade": "Daif Isnaad"
				},
				{
					"name": "Zubair Ali Zai",
					"grade": "Isnaad Hasan"
				}
			],
			"reference": {
				"book": 13,
				"hadith": 35
			}
		},
		{
			"hadithnumber": 1214,
			"arabicnumber": 1214,
			"text": "। সুওয়ায়দ ইবনু নাসর (রহঃ) ... আবদুল্লাহ (রাঃ) থেকে বর্ণিত। তিনি বলেন, একদা আমি রাসুলুল্লাহ সাল্লাল্লাহু আলাইহি ওয়াসাল্লাম এর কাছে আসলাম, তখন তিনি সালাত আদায় করছিলেন, আর তাঁর ভিতরে ডেকচির শব্দের ন্যায় শব্দ হচ্ছিল। অর্থাৎ তিনি কাঁদছিলেন।",
			"grades": [
				{
					"name": "Abu Ghuddah",
					"grade": "Sahih"
				},
				{
					"name": "Al-Albani",
					"grade": "Sahih"
				},
				{
					"name": "Zubair Ali Zai",
					"grade": "Isnaad Sahih"
				}
			],
			"reference": {
				"book": 13,
				"hadith": 36
			}
		},
		{
			"hadithnumber": 1215,
			"arabicnumber": 1215,
			"text": "। মুহাম্মাদ ইবনু সালামা (রহঃ) ... আবূ দারদা (রাঃ) থেকে বর্ণিত। তিনি বলেন, রাসুলুল্লাহ সাল্লাল্লাহু আলাইহি ওয়াসাল্লাম (একবার) সালাতে দাঁড়ালে আমরা তাকে বলতে শুনলাম, আমি তোর (ইবলীস) থেকে আল্লাহর কাছে পানাহ চাই। তারপর বললেন, আমি আল্লাহর লানত দ্বারা তোকে লানত দিচ্ছি। (এ বাক্যটি তিনি) তিনবার (বললেন) এবং হাত প্রসারিত করলেন যেন কোন কিছু ধরতে চাচ্ছেন। যখন তিনি সালাত শেষ করলেন, আমরা বললাম, ইয়া রাসুলাল্লাহ! (আজ) আমরা সালাতে আপনাকে এমন কিছু বলতে শুনেছি যা ইতিপূর্বে আর কখনো বলতে শুনিনি, আর (আজ) আপনাকে হাত প্রসারিত করতে দেখেছি। তিনি বললেন, আল্লাহর দুশমন ইবলীস অগ্নিস্ফুলিংগ নিয়ে এসেছিল আমার চেহারায় নিক্ষেপ করার জন্য, তখন আমি তিনবার বললাম, আমি তোর থেকে আল্লাহর কাছে পানাহ চাই। এরপর আমি তিনবার বললাম, আল্লাহর লানত দ্বারা আমি তোকে লানত দিচ্ছি। এতেও সে যখন পেছনে সরে গেল না তখন আমি তাকে ধরতে ইচ্ছা করেছিলাম। আল্লাহর শপথ! যদি আমার ভাই সুলায়মান (আলাইহিস সালাম) এর দোয়া না থাকতো তা হলে সে ভোর পর্যন্ত খুঁটির সাথে বাঁধা থাকতো। তার সাথে মদীনার শিশু-কিশোররা খেলা করত।",
