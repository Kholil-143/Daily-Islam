			"reference": {
				"book": 11,
				"hadith": 57
			}
		},
		{
			"hadithnumber": 933,
			"arabicnumber": 933,
			"text": "। ইসহাক ইবনু ইবরাহীম (রহঃ) ... আয়িশা (রাঃ) থেকে বর্ণিত। তিনি বলেন, হারিস ইবনু হিশাম (রাঃ) রাসুলুল্লাহ সাল্লাল্লাহু আলাইহি ওয়াসাল্লাম কে জিজ্ঞাসা করলেন, আপনার নিকট কী রূপে ওহী আসে? তিনি বললেন, ঘণ্টার শব্দের মত। তারপর তা শেষ হলে দেখা যায় আমি তা মুখস্থ করে ফেলেছি। এটাই আমার নিকট অত্যন্ত কঠিন বোধ হয়। আর কোন কোন সময় আমার নিকট (ওহীর ফেরেশতা) মানুষের বেশে আগমন করে তা আমাকে বলে যান।",
			"grades": [
				{
					"name": "Abu Ghuddah",
					"grade": "Sahih"
				},
				{
					"name": "Al-Albani",
					"grade": "Sahih"
				},
				{
					"name": "Zubair Ali Zai",
					"grade": "Sahih - Agreed Upon"
				}
