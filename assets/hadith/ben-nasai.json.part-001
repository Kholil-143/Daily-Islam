					"name": "Abu Ghuddah",
					"grade": "Sahih"
				},
				{
					"name": "Al-Albani",
					"grade": "Sahih"
				},
				{
					"name": "Zubair Ali Zai",
					"grade": "Isnaad Sahih"
				}
			],
			"reference": {
				"book": 13,
				"hadith": 84
			}
		},
		{
			"hadithnumber": 1263,
			"arabicnumber": 1263,
			"text": "। কুতায়বা (রহঃ) ... ওয়াইল ইবনু হুজর (রাঃ) থেকে বর্ণিত। তিনি বলেন, আমি রাসুলুল্লাহ সাল্লাল্লাহু আলাইহি ওয়াসাল্লাম কে দেখেছি তিনি যখন সালাত আরম্ভ করতেন তাঁর হস্তদ্বয় উত্তোলন করতেন, আর যখন রুকু করতেন ও রুকু থেকে মাথা ওঠাতেন তখনও। আর তিনি যখন বসতেন তার বাম পা বিছিয়ে দিতেন এবং ডান পা দাঁড় করে রাখতেন, আর তাঁর বাম হাত বাম উরুর উপর এবং ডান হাত ডান উরুর উপর রাখতেন এবং মধ্যম ও বৃদ্ধাঙ্গুলি দ্বারা গোলাকার বৃত্ত বানিয়ে ইশারা করতেন।",
			"grades": [
