			}
		},
		{
			"hadithnumber": 906,
			"arabicnumber": 906,
			"text": "। মুহাম্মদ ইবনু আলী ইবনু হাসান ইবনু শাকীক (রহঃ) ... আনাস ইবনু মালিক (রাঃ) থেকে বর্ণিত। তিনি বলেন, রাসুলুল্লাহ সাল্লাল্লাহু আলাইহি ওয়াসাল্লাম আমাদের নিয়ে সালাত আদায় করলেন। তখন বিসমিল্লাহির রহমানির রহীম-এর কিরাআত আমরা শুনতে পাইনি। আর আবূ বকর এবং উমর (রাঃ)-ও আমাদের নিয়ে সালাত আদায় করেছেন। তাঁদের থেকেও আমরা তা শুনিনি।",
			"grades": [
				{
					"name": "Abu Ghuddah",
					"grade": "Sahih Isnaad"
				},
				{
					"name": "Al-Albani",
					"grade": "Sahih Isnaad"
				},
				{
					"name": "Zubair Ali Zai",
					"grade": "Sahih"
				}
			],
			"reference": {
				"book": 11,
				"hadith": 31
			}
		},
		{
			"hadithnumber": 907,
			"arabicnumber": 907,
			"text": "। আবদুল্লাহ ইবনু সায়ীদ আবূ সায়ীদ আশাজ (রহঃ) ... আনাস (রাঃ) থেকে বর্ণিত। তিনি বলেন, আামি রাসুলুল্লাহ সাল্লাল্লাহু আলাইহি ওয়াসাল্লাম এবং আবূ বকর, উমর ও উসমান (রাঃ)-এর পেছনে সালাত আদায় করেছি। তাদের কাউকে বিসমিল্লাহির রহমানির রহীম- উচ্চস্বরে পড়তে শুনিনি।",
			"grades": [
