					"name": "Al-Albani",
					"grade": "Daif"
				},
				{
					"name": "Muhammad Fouad Abd al-Baqi",
					"grade": "Daif"
				},
				{
					"name": "Shuaib Al Arnaut",
					"grade": "Daif"
				},
				{
					"name": "Zubair Ali Zai",
					"grade": "Daif"
				}
			],
			"reference": {
				"book": 37,
				"hadith": 62
			}
		},
		{
			"hadithnumber": 4162,
			"arabicnumber": 4162,
			"text": "। ইবনে উমার (রাঃ) থেকে বর্ণিত। তিনি বলেন, আমি নিজেকে রাসূলুল্লাহ সাল্লাল্লাহু আলাইহি ওয়াসাল্লাম -এর সাথে (স্বপ্নে) দেখতে পেলাম যে, আমি রোদ-বৃষ্টি থেকে আশ্রয়ের জন্য একটি ঘর নির্মাণ করেছি। কিন্তু মহান আল্লাহর সৃষ্টির কেউ আমাকে সহযোগিত করেনি।",
			"grades": [
