					"grade": "Sahih Muslim"
				}
			],
			"reference": {
				"book": 31,
				"hadith": 78
			}
		},
		{
			"hadithnumber": 3514,
			"arabicnumber": 3514,
			"text": "। আবূ বাকর ইবনে মুহাম্মাদ (রাঃ) থেকে বর্ণিত। আনাস-কন্যা উম্মু নবী হাযম খালিদা আস-সাইদিয়া (রাঃ) নবী সাল্লাল্লাহু আলাইহি ওয়াসাল্লাম-এর নিকট আসেন এবং ঝাড়ফুঁক করার মন্ত্র পেশ করেন। তিনি তাকে তা দ্বারা ঝাড়ফুঁক করার অনুমতি দেন।",
			"grades": [
				{
					"name": "Al-Albani",
					"grade": "Daif"
				},
				{
					"name": "Muhammad Fouad Abd al-Baqi",
					"grade": "Daif"
				},
				{
					"name": "Shuaib Al Arnaut",
					"grade": "Hasan"
				},
				{
					"name": "Zubair Ali Zai",
					"grade": "Isnaad Hasan"
				}
			],
			"reference": {
				"book": 31,
				"hadith": 79
			}
		},
		{
			"hadithnumber": 3515,
			"arabicnumber": 3515,
			"text": "। জাবির (রাঃ) থেকে বর্ণিত। তিনি বলেন, আনসার সম্প্রদায়ভুক্ত আমর ইবনে হাযম নামক পরিবার বিষাক্ত প্রাণীর দংশনে ঝাড়ফুঁক করতো। অথচ রাসূলুল্লাহ সাল্লাল্লাহু আলাইহি ওয়াসাল্লাম ঝাড়ফুঁক করতে নিষেধ করেছেন। তারা তাঁর নিকট এসে বললো, হে আল্লাহর রাসূল! আপনি তো ঝাড়ফুঁক করতে নিষেধ করেছেন, অথচ আমরা বিষাক্ত প্রাণীর দংশনে ঝাড়ফুঁক করি। তিনি তাদের বলেনঃ সেগুলো আমার সামনে পেশ করো। তারা তা তাঁর নিকট পেশ করেন। তিনি বলেনঃ এগুলো দোষের কিছু নেই। এগুলো নির্ভরযোগ্য।",
			"grades": [
				{
					"name": "Al-Albani",
					"grade": "Sahih"
				},
				{
					"name": "Muhammad Fouad Abd al-Baqi",
					"grade": "Sahih"
				},
				{
					"name": "Zubair Ali Zai",
					"grade": "Sahih Muslim"
				}
			],
			"reference": {
				"book": 31,
				"hadith": 80
			}
		},
		{
			"hadithnumber": 3516,
			"arabicnumber": 3516,
			"text": "। আনাস (রাঃ) থেকে বর্ণিত। নবী সাল্লাল্লাহু আলাইহি ওয়াসাল্লাম বিষাক্ত প্রাণীর দংশন, বদনজর ও ব্রণ-ফুসকুড়ি (pimple) সারাতে ঝাড়ফুঁক করার অনুমতি দিয়েছেন।",
			"grades": [
				{
					"name": "Al-Albani",
					"grade": "Sahih"
				},
				{
					"name": "Muhammad Fouad Abd al-Baqi",
					"grade": "Sahih"
				},
				{
					"name": "Zubair Ali Zai",
					"grade": "Sahih Muslim"
				}
			],
			"reference": {
				"book": 31,
				"hadith": 81
			}
		},
		{
			"hadithnumber": 3517,
			"arabicnumber": 3517,
			"text": "। আয়েশা (রাঃ) থেকে বর্ণিত। তিনি বলেন, রাসূলুল্লাহ সাল্লাল্লাহু আলাইহি ওয়াসাল্লাম সাপ ও বিছার দংশনে ঝাড়ফুঁক করার অনুমতি দিয়েছেন।",
			"grades": [
				{
					"name": "Shuaib Al Arnaut",
					"grade": "Sahih"
				},
				{
					"name": "Zubair Ali Zai",
					"grade": "Sahih Muslim"
				}
			],
			"reference": {
				"book": 31,
				"hadith": 82
			}
		},
		{
			"hadithnumber": 3518,
			"arabicnumber": 3518,
			"text": "। আবূ হুরায়রা (রাঃ) থেকে বর্ণিত। তিনি বলেন, একটি বিছা এক ব্যক্তিকে দংশন করলে ঐ রাতে সে আর ঘুমাতে পারেনি। নবী সাল্লাল্লাহু আলাইহি ওয়াসাল্লাম কে বলা হলো, অমুক ব্যক্তিকে বিছায় দংশন করায় সে গত রাতে ঘুমাতে পারেনি। তিনি বলেনঃ আহা, সে যদি সন্ধ্যায় উপনীত হয়ে বলতো, ‘‘আউযু বিকালিমাতিল্লাহিত তাম্মাতি মিন শাররি মা খালাক’’ (আমি আল্লাহর পরিপূর্ণ কালামের উসীলায় তাঁর সৃষ্টির অনিষ্ট থেকে আশ্রয় চাই), তাহলে বিছার দংশন সকাল পর্যন্ত তার কোন ক্ষতি করতে পারতো না।",
			"grades": [
				{
					"name": "Al-Albani",
					"grade": "Sahih"
				},
				{
					"name": "Muhammad Fouad Abd al-Baqi",
					"grade": "Sahih"
				},
				{
					"name": "Zubair Ali Zai",
					"grade": "Sahih"
				}
			],
			"reference": {
				"book": 31,
				"hadith": 83
			}
		},
		{
			"hadithnumber": 3519,
			"arabicnumber": 3519,
			"text": "। আমর ইবনে হাযম (রাঃ) থেকে বর্ণিত। তিনি বলেন, রাসূলুল্লাহ সাল্লাল্লাহু আলাইহি ওয়াসাল্লাম -এর সামনে আমি সর্পদংশনের ঝাড়ফুঁকের দোয়া পেশ করলে তিনি আমাকে এর অনুমতি দেন।",
			"grades": [
