					"grade": "Sahih Muslim"
				}
			],
			"reference": {
				"book": 37,
				"hadith": 103
			}
		},
		{
			"hadithnumber": 4203,
			"arabicnumber": 4203,
			"text": "। আবূ সাদ ইবনে আবূ ফাদালা আল-আনসারী (রাঃ) থেকে বর্ণিত। তিনি সাহাবী ছিলেন। তিনি বলেন, রাসূলুল্লাহ সাল্লাল্লাহু আলাইহি ওয়াসাল্লাম বলেছেনঃ আল্লাহ তা‘আলা যখন কিয়ামতের দিন, যে দিনের আগমনে কোন সন্দেহ নাই, পূর্বাপর সকলকে একত্র করবেন, তখন একজন ঘোষক ঘোষণা করবে, যে ব্যক্তি আল্লাহর সন্তুষ্টির জন্য কাজ করতে গিয়ে এর মধ্যে কাউকে শরীক করেছে, সে যেন গাইরুল্লাহর নিকট নিজের সওয়াব চেয়ে নেয়। কেননা আল্লাহ তা‘আলা শরীকদের শিরক থেকে সম্পূর্ণ মুক্ত।",
			"grades": [
				{
					"name": "Al-Albani",
					"grade": "Hasan"
				},
				{
					"name": "Muhammad Fouad Abd al-Baqi",
					"grade": "Hasan"
				},
				{
					"name": "Zubair Ali Zai",
					"grade": "Isnaad Hasan"
				}
			],
			"reference": {
				"book": 37,
				"hadith": 104
			}
		},
		{
			"hadithnumber": 4204,
			"arabicnumber": 4204,
			"text": "। আবূ সাঈদ আল-খুদরী (রাঃ) থেকে বর্ণিত। তিনি বলেন, আমাদের নিকট রাসূলুল্লাহ সাল্লাল্লাহু আলাইহি ওয়াসাল্লাম বের হয়ে আসলেন, আমরা তখন মসীহ দাজ্জাল সম্পর্কে আলোচনা করছিলাম। তিনি সাল্লাল্লাহু আলাইহি ওয়াসাল্লাম বলেনঃ আমি কি তোমাদের এমন বিষয় অবহিত করবো না, যা আমার মতে তোমাদের জন্য মসীহ দাজ্জালের চেয়েও ভয়ংকর? রাবী বলেন, আমরা বললাম, হাঁ, অবশ্যই। তিনি বলেনঃ গুপ্ত শিরক। মানুষ নামায পড়তে দাঁড়ায় এবং লোকের দৃষ্টি আকর্ষণের জন্য সুন্দরভাবে নামায পড়ে।",
			"grades": [
