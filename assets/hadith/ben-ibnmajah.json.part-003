				{
					"name": "Muhammad Fouad Abd al-Baqi",
					"grade": "Sahih"
				},
				{
					"name": "Shuaib Al Arnaut",
					"grade": "Sahih"
				},
				{
					"name": "Zubair Ali Zai",
					"grade": "Sahih"
				}
			],
			"reference": {
				"book": 37,
				"hadith": 92
			}
		},
		{
			"hadithnumber": 4192,
			"arabicnumber": 4192,
			"text": "। আবূ হাযেম (রাঃ) থেকে বর্ণিত। আমের ইবনে আবদুল্লাহ ইবনুয যুবাইর (রাঃ) তাকে অবহিত করেন যে, তার পিতা তাকে অবহিত করেছেন যে, তাদের ইসলাম গ্রহণ এবং তাদেরকে তিরস্কার করে নিম্নোক্ত আয়াত নাযিলের মধ্যে চার বছরের ব্যবধান ছিলো। (অনুবাদঃ) ‘‘এরা যেন তাদের মতো না হয়, যাদেরকে পূর্বে কিতাব দেয়া হয়েছিল। অতঃপর তাদের উপর দীর্ঘ কাল অতিবাহিত হওয়ায় তাদের অন্তঃকরণ কঠিন হয়ে গিয়েছিল। তাদের অধিকাশই সত্যত্যাগী’’ (সূরা হাদীদঃ)",
			"grades": [
				{
					"name": "Al-Albani",
					"grade": "Hasan"
				},
				{
					"name": "Muhammad Fouad Abd al-Baqi",
					"grade": "Hasan"
				},
				{
					"name": "Zubair Ali Zai",
					"grade": "Hasan"
				}
			],
			"reference": {
				"book": 37,
				"hadith": 93
			}
		},
		{
			"hadithnumber": 4193,
			"arabicnumber": 4193,
			"text": "। আবূ হুরায়রা (রাঃ) থেকে বর্ণিত। তিনি বলেন, রাসূলুল্লাহ সাল্লাল্লাহু আলাইহি ওয়াসাল্লাম বলেছেনঃ তোমরা অধিক হাসবে না। কারণ অধিক হাসি অন্তরের মৃত্যু ঘটায়।",
			"grades": [
				{
					"name": "Al-Albani",
					"grade": "Sahih"
				},
				{
					"name": "Muhammad Fouad Abd al-Baqi",
					"grade": "Sahih"
				},
				{
					"name": "Shuaib Al Arnaut",
