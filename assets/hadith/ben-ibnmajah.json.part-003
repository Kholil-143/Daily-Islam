				{
					"name": "Zubair Ali Zai",
					"grade": "Sahih"
				}
			],
			"reference": {
				"book": 36,
				"hadith": 12
			}
		},
		{
			"hadithnumber": 3938,
			"arabicnumber": 3938,
			"text": "। সালামা ইবনুল হাকাম (রাঃ) থেকে বর্ণিত। তিনি বলেন, আমরা শত্রুপক্ষের মেষপালের নাগাল পেয়ে তা লুট করলাম। অতঃপর আমরা সেগুলোর গোশত পাতিলে করে রান্না করছিলাম। এমতাবস্থায় নবী সাল্লাল্লাহু আলাইহি ওয়াসাল্লাম পাতিলগুলো অতিক্রমকালে (সেগুলো উল্টে) ফেলে দেয়ার নির্দেশ দিলে তা উল্টে ফেলে দেয়া হলো। অতঃপর তিনি বলেনঃ লুটতরাজ করা হালাল নয়।",
			"grades": [
				{
					"name": "Al-Albani",
					"grade": "Sahih"
				},
				{
					"name": "Muhammad Fouad Abd al-Baqi",
					"grade": "Sahih"
				},
				{
					"name": "Shuaib Al Arnaut",
					"grade": "Hasan"
				},
				{
					"name": "Zubair Ali Zai",
					"grade": "Isnaad Hasan"
				}
			],
			"reference": {
				"book": 36,
				"hadith": 13
			}
		},
		{
			"hadithnumber": 3939,
			"arabicnumber": 3939,
			"text": "। আবদুল্লাহ ইবনে মাসউদ (রাঃ) থেকে বর্ণিত। তিনি বলেন, রাসূলুল্লাহ সাল্লাল্লাহু আলাইহি ওয়াসাল্লাম বলেছেনঃ মুসলিমকে গালি দেয়া ফাসেকী এবং তাকে হত্যা করা কুফরী।",
			"grades": [
				{
					"name": "Al-Albani",
					"grade": "Sahih"
				},
				{
					"name": "Muhammad Fouad Abd al-Baqi",
					"grade": "Sahih"
				},
				{
					"name": "Zubair Ali Zai",
					"grade": "Sahih - Agreed Upon"
				}
			],
			"reference": {
				"book": 36,
				"hadith": 14
			}
		},
		{
			"hadithnumber": 3940,
			"arabicnumber": 3940,
			"text": "। আবূ হুরায়রা (রাঃ) থেকে বর্ণিত। নবী সাল্লাল্লাহু আলাইহি ওয়াসাল্লাম বলেনঃ মুসলিমকে গালি দেয়া ফাসেকী এবং তাকে হত্যা করা কুফরী।",
			"grades": [
				{
					"name": "Al-Albani",
					"grade": "Hasan Sahih"
				},
				{
					"name": "Muhammad Fouad Abd al-Baqi",
					"grade": "Hasan Sahih"
				},
				{
					"name": "Zubair Ali Zai",
					"grade": "Sahih"
				}
			],
			"reference": {
				"book": 36,
				"hadith": 15
			}
		},
		{
			"hadithnumber": 3941,
			"arabicnumber": 3941,
			"text": "। সাদ (রাঃ) থেকে বর্ণিত। তিনি বলেন, রাসূলুল্লাহ সাল্লাল্লাহু আলাইহি ওয়াসাল্লাম বলেছেনঃ মুসলিমকে গালি দেয়া ফাসেকী এবং তাকে হত্যা করা কুফরী।",
			"grades": [
				{
					"name": "Al-Albani",
					"grade": "Sahih"
				},
				{
					"name": "Muhammad Fouad Abd al-Baqi",
					"grade": "Sahih"
				},
				{
					"name": "Shuaib Al Arnaut",
					"grade": "Sahih"
				},
				{
					"name": "Zubair Ali Zai",
					"grade": "Sahih"
				}
			],
			"reference": {
				"book": 36,
				"hadith": 16
			}
		},
		{
			"hadithnumber": 3942,
			"arabicnumber": 3942,
			"text": "। জাবীর ইবনে আবদুল্লাহ (রাঃ) থেকে বর্ণিত। রাসূলুল্লাহ সাল্লাল্লাহু আলাইহি ওয়াসাল্লাম বিদায় হজ্জে লোকেদেরকে নীরব নিস্তব্ধ করিয়ে বলেনঃ আমার পরে তোমরা পরস্পর হানাহানিতে লিপ্ত হয়ে কুফরীতে ফিরে যেও না।",
			"grades": [
				{
					"name": "Al-Albani",
					"grade": "Sahih"
				},
				{
					"name": "Muhammad Fouad Abd al-Baqi",
					"grade": "Sahih"
				},
				{
					"name": "Shuaib Al Arnaut",
					"grade": "Sahih"
				},
				{
					"name": "Zubair Ali Zai",
					"grade": "Sahih - Agreed Upon"
				}
			],
			"reference": {
				"book": 36,
				"hadith": 17
			}
		},
		{
			"hadithnumber": 3943,
			"arabicnumber": 3943,
			"text": "। ইবনে উমার (রাঃ) থেকে বর্ণিত। রাসূলুল্লাহ সাল্লাল্লাহু আলাইহি ওয়াসাল্লাম বলেনঃ তোমাদের জন্য আপসোস! তোমাদের জন্য দুর্ভাগ্য! আমার পরে তোমরা পরস্পর হানাহানিতে লিপ্ত হয়ে কুফরীতে ফিরে যেও না।",
			"grades": [
				{
					"name": "Al-Albani",
					"grade": "Sahih"
				},
				{
					"name": "Muhammad Fouad Abd al-Baqi",
					"grade": "Sahih"
				},
				{
					"name": "Shuaib Al Arnaut",
					"grade": "Sahih"
				},
				{
					"name": "Zubair Ali Zai",
					"grade": "Sahih - Agreed Upon"
				}
			],
			"reference": {
				"book": 36,
				"hadith": 18
			}
		},
		{
			"hadithnumber": 3944,
			"arabicnumber": 3944,
			"text": "। সুনাবিহী আল-আহমাসী (রাঃ) থেকে বর্ণিত। তিনি বলেন, রাসূলুল্লাহ সাল্লাল্লাহু আলাইহি ওয়াসাল্লাম বলেছেনঃ সাবধান! আমি হাওযে কাওসারে তোমাদের আগেই উপস্থিত থাকবো এবং আমি অন্যান্য উম্মাতদের উপর তোমাদের সংখ্যাধিক্যের গৌরব প্রকাশ করবো। সুতরাং তোমরা আমার পরে পরস্পর হানাহানিতে লিপ্ত হয়ো না।",
			"grades": [
				{
					"name": "Al-Albani",
					"grade": "Sahih"
				},
				{
					"name": "Muhammad Fouad Abd al-Baqi",
					"grade": "Sahih"
				},
				{
					"name": "Shuaib Al Arnaut",
					"grade": "Sahih"
				},
				{
					"name": "Zubair Ali Zai",
					"grade": "Isnaad Sahih"
				}
			],
			"reference": {
				"book": 36,
				"hadith": 19
			}
		},
		{
			"hadithnumber": 3945,
			"arabicnumber": 3945,
			"text": "। আবূ বাকর সিদ্দীক (রাঃ) থেকে বর্ণিত। তিনি বলেন, রাসূলুল্লাহ সাল্লাল্লাহু আলাইহি ওয়াসাল্লাম বলেছেনঃ যে ব্যক্তি ফজরের নামায পড়লো, সে আল্লাহর যিম্মায় থাকলো। অতএব তোমরা আল্লাহর যিম্মাদারিকে নষ্ট করো না। যে ব্যক্তি তাকে হত্যা করবে, আল্লাহ তাকে তলব করে এনে উল্টো মুখে জাহান্নামে নিক্ষেপ করবেন।",
			"grades": [
				{
					"name": "Al-Albani",
					"grade": "Sahih"
				},
				{
					"name": "Muhammad Fouad Abd al-Baqi",
					"grade": "Sahih"
				},
				{
					"name": "Shuaib Al Arnaut",
					"grade": "Sahih Lighairihi"
				},
				{
					"name": "Zubair Ali Zai",
					"grade": "Sahih"
				}
			],
			"reference": {
				"book": 36,
				"hadith": 20
			}
		},
		{
			"hadithnumber": 3946,
			"arabicnumber": 3946,
			"text": "। সামুরা ইবনে জুনদুব (রাঃ) থেকে বর্ণিত। তিনি বলেন, রাসূলুল্লাহ সাল্লাল্লাহু আলাইহি ওয়াসাল্লাম বলেছেনঃ যে ব্যক্তি ফজরের নামাজ পড়লো সে মহান আল্লাহর যিম্মায় রইলো।",
			"grades": [
				{
					"name": "Al-Albani",
					"grade": "Sahih"
				},
				{
					"name": "Muhammad Fouad Abd al-Baqi",
					"grade": "Sahih"
				},
				{
					"name": "Shuaib Al Arnaut",
					"grade": "Sahih Lighairihi"
				},
				{
					"name": "Zubair Ali Zai",
					"grade": "Isnaad Sahih"
				}
			],
			"reference": {
				"book": 36,
				"hadith": 21
			}
		},
		{
			"hadithnumber": 3947,
			"arabicnumber": 3947,
			"text": "। আবূ হুরায়রা (রাঃ) থেকে বর্ণিত। তিনি বলেন, রাসূলুল্লাহ সাল্লাল্লাহু আলাইহি ওয়াসাল্লাম বলেছেনঃ মুমিন ব্যক্তি মহান আল্লাহর নিকট তাঁর কোন কোন ফেরেশতার চেয়েও অধিক মর্যাদাবান।",
			"grades": [
				{
					"name": "Al-Albani",
					"grade": "Daif"
				},
				{
					"name": "Muhammad Fouad Abd al-Baqi",
					"grade": "Daif"
				},
				{
					"name": "Shuaib Al Arnaut",
					"grade": "Very Daif"
				},
				{
					"name": "Zubair Ali Zai",
					"grade": "Daif"
				}
			],
			"reference": {
				"book": 36,
				"hadith": 22
			}
		},
		{
			"hadithnumber": 3948,
			"arabicnumber": 3948,
			"text": "। আবূ হুরায়রা (রাঃ) থেকে বর্ণিত। তিনি বলেন, রাসূলুল্লাহ সাল্লাল্লাহু আলাইহি ওয়াসাল্লাম বলেছেনঃ যে ব্যক্তি লোকেদেরকে গোত্রবাদের দিকে আহবান করে অথবা গোত্রবাদে উন্মত্ত হয়ে ভ্রষ্টতার পতাকাতলে যুদ্ধ করে নিহত হলে সে জাহিলিয়াতের মৃত্যুবরণ করলো।",
			"grades": [
				{
					"name": "Al-Albani",
					"grade": "Sahih"
				},
				{
					"name": "Muhammad Fouad Abd al-Baqi",
					"grade": "Sahih"
				},
				{
					"name": "Zubair Ali Zai",
					"grade": "Sahih Muslim"
				}
			],
			"reference": {
				"book": 36,
				"hadith": 23
			}
		},
		{
			"hadithnumber": 3949,
			"arabicnumber": 3949,
			"text": "। ফাসীলা নাম্নী এক সিরীয় মহিলা বলেন, আমি আমার পিতাকে বলতে শুনেছি, আমি রাসূলুল্লাহ সাল্লাল্লাহু আলাইহি ওয়াসাল্লাম -এর নিকট জিজ্ঞাসা করলাম, হে আল্লাহর রাসূল! নিজ গোত্রের প্রতি ভালোবাসা কি গোত্রেবাদের অন্তর্ভুক্ত? তিনি বলেনঃ না। তবে নিজ গোত্রকে অন্যের উপর অত্যাচারে সহায়তা করা গোত্রবাদের অন্তর্ভুক্ত।",
			"grades": [
				{
					"name": "Al-Albani",
					"grade": "Daif"
				},
				{
					"name": "Muhammad Fouad Abd al-Baqi",
					"grade": "Daif"
				},
				{
					"name": "Shuaib Al Arnaut",
					"grade": "Daif"
				},
				{
					"name": "Zubair Ali Zai",
					"grade": "Daif"
				}
			],
			"reference": {
				"book": 36,
				"hadith": 24
			}
		},
		{
			"hadithnumber": 3950,
			"arabicnumber": 3950,
			"text": "। আনাস ইবনে মালেক (রাঃ) থেকে বর্ণিত। তিনি বলেন, আমি রাসূলুল্লাহ সাল্লাল্লাহু আলাইহি ওয়াসাল্লাম কে বলতে শুনেছিঃ আমার উম্মাত পথভ্রষ্টতার উপর ঐক্যবদ্ধ হবে না। তোমরা মতভেদ দেখতে পেলে অবশ্যই সর্ববৃহৎ দলের সাথে থাকবে।",
			"grades": [
				{
					"name": "Al-Albani",
					"grade": "Very Daif"
				},
				{
					"name": "Muhammad Fouad Abd al-Baqi",
					"grade": "Very Daif"
				},
				{
					"name": "Shuaib Al Arnaut",
					"grade": "Very Daif"
				},
				{
					"name": "Zubair Ali Zai",
					"grade": "Daif"
				}
			],
			"reference": {
				"book": 36,
				"hadith": 25
			}
		},
		{
			"hadithnumber": 3951,
			"arabicnumber": 3951,
			"text": "। মুআয ইবনে জাবাল (রাঃ) থেকে বর্ণিত। তিনি বলেন, এক দিন রাসূলুল্লাহ সাল্লাল্লাহু আলাইহি ওয়াসাল্লাম নামায পড়লেন। তিনি অবসর হলে আমরা বললাম, বা তারা বলেন, হে আল্লাহর রাসূল! আজ আপনি নামায দীর্ঘায়িত করেছেন। তিনি বলেনঃ আমি আশাব্যঞ্জক ও ভীতিজনক নামায পড়েছি। আমি মহামহিমান্বিত আল্লাহর নিকট আমার উম্মাতের জন্য তিনটি জিনিস প্রার্থনা করেছি। তিনি আমাকে দু’টি দান করেছেন এবং একটি প্রত্যাখ্যান করেছেন। আমি তাঁর নিকট প্রার্থনা করলাম যে, তাদের ব্যতীত তাদের শত্রুপক্ষ যেন আধিপত্য বিস্তার করতে না পারে। তিনি আমাকে এটা দান করলেন। আমি তাঁর নিকট আরো প্রার্থনা করলাম যে, আমার গোটা উম্মাতকে যেন পানিতে ডুবিয়ে মারা না হয়। তিনি এটাও আমাকে দান করেছেন। আমি তাঁর নিকট আরো প্রার্থনা করলাম যে, আমার উম্মাত যেন পরস্পর যুদ্ধে জড়িয়ে না পড়ে। তিনি আমার এ প্রার্থনা আমাকে ফেরত দিলেন।",
			"grades": [
