					"grade": "Daif"
				}
			],
			"reference": {
				"book": 32,
				"hadith": 3
			}
		},
		{
			"hadithnumber": 3553,
			"arabicnumber": 3553,
			"text": "। আনাস ইবনে মালেক (রাঃ) থেকে বর্ণিত। তিনি বলেন, আমি নবী সাল্লাল্লাহু আলাইহি ওয়াসাল্লাম -এর সাথে ছিলাম। তাঁর পরনে ছিল মোটা পাড়যুক্ত একটি নাজরানী চাদর।",
			"grades": [
