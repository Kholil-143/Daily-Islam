					"grade": "Daif"
				},
				{
					"name": "Zubair Ali Zai",
					"grade": "Daif"
				}
			],
			"reference": {
				"book": 29,
				"hadith": 120
			}
		},
		{
			"hadithnumber": 3371,
			"arabicnumber": 3371,
			"text": "। আবূ দারদা (রাঃ) থেকে বর্ণিত। তিনি বলেন, আমার বন্ধু (নবী সাল্লাল্লাহু আলাইহি ওয়াসাল্লাম) আমাকে উপদেশ দিয়েছেনঃ শরাব পান করো না, কারণ তা সমস্ত পাপাচারের প্রসূতি।",
			"grades": [
