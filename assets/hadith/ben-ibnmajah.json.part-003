			}
		},
		{
			"hadithnumber": 4208,
			"arabicnumber": 4208,
			"text": "। আবদুল্লাহ ইবনে মাসউদ (রাঃ) থেকে বর্ণিত। তিনি বলেন, রাসূলুল্লাহ সাল্লাল্লাহু আলাইহি ওয়াসাল্লাম বলেছেনঃ দু’ ব্যক্তি ছাড়া আর কারো ব্যাপারে ঈর্ষা করা বৈধ নয়। (এক) যাকে আল্লাহ সম্পদ দিয়েছেন এবং তাকে তা সৎকাজে ব্যয় করার মনোবলও দিয়েছেন। (দুই) যাকে আল্লাহ প্রজ্ঞা দান করেছেন এবং সে তদ্বারা (সঠিক) মীমাংসা করে এবং তা (লোককে) শিক্ষা দেয়।",
			"grades": [
				{
					"name": "Al-Albani",
					"grade": "Sahih"
				},
				{
					"name": "Muhammad Fouad Abd al-Baqi",
					"grade": "Sahih"
				},
				{
					"name": "Shuaib Al Arnaut",
					"grade": "Sahih"
				},
				{
					"name": "Zubair Ali Zai",
					"grade": "Sahih - Agreed Upon"
				}
			],
			"reference": {
				"book": 37,
				"hadith": 109
			}
		},
		{
			"hadithnumber": 4209,
			"arabicnumber": 4209,
			"text": "। সালেম (রাঃ) থেকে তার পিতার সূত্রে বর্ণিত। তিনি বলেন, রাসূলুল্লাহ সাল্লাল্লাহু আলাইহি ওয়াসাল্লাম বলেছেনঃ দু’টি ক্ষেত্র ব্যতীত ঈর্ষা করা জায়েয নেই। (এক) যাকে আল্লাহ কুরআন দান করেছেন এবং সে দিন-রাত সর্বক্ষণ তার উপর কায়েম থাকে। (দুই) যাকে আল্লাহ ধন-সম্পদ দান করেছেন এবং সে তা দিন-রাত সর্বক্ষণ (আল্লাহর পথে) ব্যয় করে।",
			"grades": [
				{
					"name": "Al-Albani",
					"grade": "Sahih"
				},
				{
					"name": "Muhammad Fouad Abd al-Baqi",
					"grade": "Sahih"
				},
				{
					"name": "Shuaib Al Arnaut",
					"grade": "Sahih"
				},
				{
					"name": "Zubair Ali Zai",
					"grade": "Sahih - Agreed Upon"
				}
			],
			"reference": {
				"book": 37,
				"hadith": 110
			}
		},
		{
			"hadithnumber": 4210,
			"arabicnumber": 4210,
			"text": "। আনাস (রাঃ) থেকে বর্ণিত। রাসূলুল্লাহ সাল্লাল্লাহু আলাইহি ওয়াসাল্লাম বলেনঃ হিংসা বা পরশ্রীকাতরতা নেক আমলসমূহ খেয়ে ফেলে, যেমন আগুন জ্বালানী কাঠ খেয়ে ফেলে। দান-খায়রাত গুনাহসমূহ বিলীন করে দেয় (রাঃ) যেমন পানি আগুনকে বিলীন করে (নিভিয়ে) দেয়। নামায মুমিনের নূর (আলো) এবং রোযা জাহান্নাম থেকে আত্মরক্ষার ঢাল।",
			"grades": [
				{
					"name": "Al-Albani",
					"grade": "Daif"
				},
				{
					"name": "Muhammad Fouad Abd al-Baqi",
					"grade": "Daif"
				},
				{
					"name": "Shuaib Al Arnaut",
					"grade": "Very Daif"
				},
				{
					"name": "Zubair Ali Zai",
					"grade": "Daif"
				}
			],
			"reference": {
				"book": 37,
				"hadith": 111
			}
		},
		{
			"hadithnumber": 4211,
			"arabicnumber": 4211,
			"text": "। আবূ বাকরা (রাঃ) থেকে বর্ণিত। তিনি বলেন, রাসূলুল্লাহ সাল্লাল্লাহু আলাইহি ওয়াসাল্লাম বলেছেনঃ (ন্যায়পরায়ণ শাসকের বিরুদ্ধে) বিদ্রোহ এবং আত্মীয়তার বন্ধন ছিন্ন করার মত মারাত্মক আর কোন গুনাহ নাই, যার শাস্তি আল্লাহ ত্বরিতে দুনিয়াতে দেন এবং আখেরাতের জন্যও জমা রাখেন।",
			"grades": [
				{
					"name": "Al-Albani",
					"grade": "Sahih"
				},
				{
					"name": "Muhammad Fouad Abd al-Baqi",
					"grade": "Sahih"
				},
				{
					"name": "Shuaib Al Arnaut",
					"grade": "Sahih"
				},
				{
					"name": "Zubair Ali Zai",
					"grade": "Isnaad Sahih"
				}
			],
			"reference": {
				"book": 37,
				"hadith": 112
			}
		},
		{
			"hadithnumber": 4212,
			"arabicnumber": 4212,
			"text": "। উম্মুল মুমিনীন আয়েশা (রাঃ) থেকে বর্ণিত। তিনি বলেন, রাসূলুল্লাহ সাল্লাল্লাহু আলাইহি ওয়াসাল্লাম বলেছেনঃ সৎকর্ম ও আত্মীয়তার সম্পর্ক বজায় রাখার সওয়াব দ্রুত পাওয়া যায় এবং দুরাচার ও আত্মীয়তার সম্পর্ক ছিন্ন করার শাস্তি দ্রুত কার্যকর হয়।",
			"grades": [
				{
					"name": "Al-Albani",
					"grade": "Very Daif"
				},
				{
					"name": "Muhammad Fouad Abd al-Baqi",
					"grade": "Very Daif"
				},
				{
					"name": "Shuaib Al Arnaut",
					"grade": "Very Daif"
				},
				{
					"name": "Zubair Ali Zai",
					"grade": "Daif"
				}
			],
			"reference": {
				"book": 37,
				"hadith": 113
			}
		},
		{
			"hadithnumber": 4213,
			"arabicnumber": 4213,
			"text": "। আবূ হুরায়রা (রাঃ) থেকে বর্ণিত। রাসূলুল্লাহ সাল্লাল্লাহু আলাইহি ওয়াসাল্লাম বলেনঃ কোন ব্যক্তির মন্দ প্রমাণিত হওয়ার জন্য এতটুকু যথেষ্ট যে, সে তার অপর মুসলিম ভাইকে তুচ্ছজ্ঞান করে।",
			"grades": [
				{
					"name": "Al-Albani",
					"grade": "Sahih"
				},
				{
					"name": "Muhammad Fouad Abd al-Baqi",
					"grade": "Sahih"
				},
				{
					"name": "Zubair Ali Zai",
					"grade": "Sahih"
				}
			],
			"reference": {
				"book": 37,
				"hadith": 114
			}
		},
		{
			"hadithnumber": 4214,
			"arabicnumber": 4214,
			"text": "। আনাস ইবনে মালেক (রাঃ) থেকে বর্ণিত। তিনি বলেন, রাসূলুল্লাহ সাল্লাল্লাহু আলাইহি ওয়াসাল্লাম বলেছেনঃ নিশ্চয় আল্লাহ আমার নিকট ওহী পাঠিয়েছেন যে, তোমরা নম্রতা অবলম্বন করো, বিনয়ী হও এবং তোমাদের কেউ যেন কারো প্রতি সীমালংঘন না করে।",
			"grades": [
				{
					"name": "Al-Albani",
					"grade": "Sahih"
				},
				{
					"name": "Muhammad Fouad Abd al-Baqi",
					"grade": "Sahih"
				},
				{
					"name": "Shuaib Al Arnaut",
					"grade": "Sahih Lighairihi"
				},
				{
					"name": "Zubair Ali Zai",
					"grade": "Hasan"
				}
			],
			"reference": {
				"book": 37,
				"hadith": 115
			}
		},
		{
			"hadithnumber": 4215,
			"arabicnumber": 4215,
			"text": "। আতিয়্যা আস-সাদী (রাঃ) থেকে বর্ণিত। তিনি ছিলেন নবী (রাঃ) -এর সাহাবী। তিনি বলেন, রাসূলুল্লাহ সাল্লাল্লাহু আলাইহি ওয়াসাল্লাম বলেছেনঃ কোন বান্দা ক্ষতিকর কাজে লিপ্ত হওয়ার আশংকায় বৈধ অক্ষতিকর বিষয় ত্যাগ না করা পর্যন্ত মোত্তাকীদের পর্যায়ে উন্নীত হতে পারে না।",
			"grades": [
				{
					"name": "Al-Albani",
					"grade": "Daif"
				},
				{
					"name": "Muhammad Fouad Abd al-Baqi",
					"grade": "Daif"
				},
				{
					"name": "Shuaib Al Arnaut",
					"grade": "Daif"
				},
				{
					"name": "Zubair Ali Zai",
					"grade": "Isnaad Hasan"
				}
			],
			"reference": {
				"book": 37,
				"hadith": 116
			}
		},
		{
			"hadithnumber": 4216,
			"arabicnumber": 4216,
			"text": "। আবদুল্লাহ ইবনে আমর (রাঃ) থেকে বর্ণিত। তিনি বলেন, রাসূলুল্লাহ সাল্লাল্লাহু আলাইহি ওয়াসাল্লাম কে বলা হলো, কোন ব্যক্তি সর্বোত্তম? তিনি বলেনঃ প্রত্যেক বিশুদ্ধ অন্তরের অধিকারী সত্যভাষী ব্যক্তি। তারা বলেন, সত্যভাষীকে তো আমরা চিনি, কিন্তু বিশুদ্ধ অন্তরের ব্যক্তি কে? তিনি বলেনঃ সে হলো পূত-পবিত্র নিষ্কলুষ চরিত্রের মানুষ যার কোন গুনাহ নাই, নাই কোন দুশমনি, হিংসা-বিদ্বেষ, আত্মহমিকা ও কপটতা।",
			"grades": [
				{
					"name": "Al-Albani",
					"grade": "Sahih"
				},
				{
					"name": "Muhammad Fouad Abd al-Baqi",
					"grade": "Sahih"
				},
				{
					"name": "Zubair Ali Zai",
					"grade": "Isnaad Sahih"
				}
			],
			"reference": {
				"book": 37,
				"hadith": 117
			}
		},
		{
			"hadithnumber": 4217,
			"arabicnumber": 4217,
			"text": "। আবূ হুরায়রা (রাঃ) থেকে বর্ণিত। তিনি বলেন, রাসূলুল্লাহ সাল্লাল্লাহু আলাইহি ওয়াসাল্লাম বললেনঃ হে আবূ হুরায়রা! তুমি আল্লাহভীরু হয়ে যাও, তাহলে লোকেদের মধ্যে শ্রেষ্ঠ ইবাদতকারী হতে পারবে। তুমি অল্পে তুষ্ট থাকো, তাহলে লোকেদের মধ্যে সর্বোত্তম কৃতজ্ঞ হতে পারবে। তুমি নিজের জন্য যা পছন্দ করো, অন্যদের জন্যও তাই পছন্দ করবে, তাহলে পূর্ণ মুমিন হতে পারবে। তোমার প্রতিবেশীর প্রতি সদাচারী ও দয়াপরবশ হও, তাহলে মুসলিম হতে পারবে। তোমার হাসি কমাও, কেননা অধিক হাসি অন্তরাত্মাকে ধ্বংস করে।",
			"grades": [
				{
					"name": "Al-Albani",
					"grade": "Sahih"
				},
				{
					"name": "Muhammad Fouad Abd al-Baqi",
					"grade": "Sahih"
				},
				{
					"name": "Zubair Ali Zai",
					"grade": "Daif"
				}
			],
			"reference": {
				"book": 37,
				"hadith": 118
			}
		},
		{
			"hadithnumber": 4218,
			"arabicnumber": 4218,
			"text": "। আবূ যার (রাঃ) থেকে বর্ণিত। তিনি বলেন, রাসূলুল্লাহ সাল্লাল্লাহু আলাইহি ওয়াসাল্লাম বলেছেনঃ তদবীরের (বিচক্ষণতা, পরিণামদর্শিতা) তুল্য কোন জ্ঞান নেই, নিষিদ্ধ বিষয় থেকে বিরত থাকার তুল্য ধার্মিকতা নেই এবং সচ্চরিত্র তুল্য কোন আভিজাত্য নেই।",
