			],
			"reference": {
				"book": 30,
				"hadith": 1
			}
		},
		{
			"hadithnumber": 3372,
			"arabicnumber": 3372,
			"text": "। খাব্বাব ইবনুল আরাত্তি (রাঃ) থেকে বর্ণিত। রাসূলুল্লাহ সাল্লাল্লাহু আলাইহি ওয়াসাল্লাম বলেনঃ সাবধান! শরাব পরিহার করো। কারণ শরাবের পাপ অন্যান্য পাপাচারকে আওতাভুক্ত করে নেয়, যেমন তার গাছ (আংগুর গাছ) অন্যান্য গাছের উপর বিস্তারিত হয়।",
			"grades": [
				{
					"name": "Al-Albani",
					"grade": "Daif"
				},
				{
					"name": "Muhammad Fouad Abd al-Baqi",
					"grade": "Daif"
				},
				{
					"name": "Shuaib Al Arnaut",
					"grade": "Daif"
				},
				{
					"name": "Zubair Ali Zai",
					"grade": "Daif"
				}
			],
			"reference": {
				"book": 30,
				"hadith": 2
			}
		},
		{
			"hadithnumber": 3373,
			"arabicnumber": 3373,
			"text": "। ইবনে উমার (রাঃ) থেকে বর্ণিত। রাসূলুল্লাহ সাল্লাল্লাহু আলাইহি ওয়াসাল্লাম বলেনঃ যে ব্যক্তি দুনিয়াতে শরাব পান করলো, সে তা থেকে তওবা না করলে, আখেরাতে তা পান করতে পারবে না।",
			"grades": [
				{
					"name": "Al-Albani",
					"grade": "Sahih"
				},
				{
					"name": "Muhammad Fouad Abd al-Baqi",
					"grade": "Sahih"
				},
				{
					"name": "Shuaib Al Arnaut",
					"grade": "Sahih"
				},
				{
					"name": "Zubair Ali Zai",
					"grade": "Sahih Muslim"
				}
			],
			"reference": {
				"book": 30,
				"hadith": 3
			}
		},
		{
			"hadithnumber": 3374,
			"arabicnumber": 3374,
			"text": "। আবু হুরায়রা (রাঃ) থেকে বর্ণিত। রাসূলুল্লাহ সাল্লাল্লাহু আলাইহি ওয়াসাল্লাম বলেনঃ যে ব্যক্তি দুনিয়াতে শরাব পান করে, সে আখেরাতে তা পান করতে পারবে না।",
			"grades": [
				{
					"name": "Al-Albani",
					"grade": "Sahih"
				},
				{
					"name": "Muhammad Fouad Abd al-Baqi",
					"grade": "Sahih"
				},
				{
					"name": "Zubair Ali Zai",
					"grade": "Sahih"
				}
			],
			"reference": {
				"book": 30,
				"hadith": 4
			}
		},
		{
			"hadithnumber": 3375,
			"arabicnumber": 3375,
			"text": "। আবূ হুরায়রা (রাঃ) থেকে বর্ণিত। তিনি বলেন, রাসূলুল্লাহ সাল্লাল্লাহু আলাইহি ওয়াসাল্লাম বলেছেনঃ শরাবখোর (পাপের ক্ষেত্রে) মূর্তিপূজকের সমতুল্য।",
			"grades": [
				{
					"name": "Al-Albani",
					"grade": "Hasan"
				},
				{
					"name": "Muhammad Fouad Abd al-Baqi",
					"grade": "Hasan"
				},
				{
					"name": "Zubair Ali Zai",
					"grade": "Isnaad Hasan"
				}
			],
			"reference": {
				"book": 30,
				"hadith": 5
			}
		},
		{
			"hadithnumber": 3376,
			"arabicnumber": 3376,
			"text": "। আবূ দারদা (রাঃ) থেকে বর্ণিত। নবী সাল্লাল্লাহু আলাইহি ওয়াসাল্লাম বলেনঃ শরাব পানে অভ্যস্ত ব্যক্তি জান্নাতে প্রবেশ করতে পারবে না।",
			"grades": [
				{
					"name": "Al-Albani",
					"grade": "Sahih"
				},
				{
					"name": "Muhammad Fouad Abd al-Baqi",
					"grade": "Sahih"
				},
				{
					"name": "Zubair Ali Zai",
					"grade": "Isnaad Hasan"
				}
			],
			"reference": {
				"book": 30,
				"hadith": 6
			}
		},
		{
			"hadithnumber": 3377,
			"arabicnumber": 3377,
			"text": "। ‘আবদুল্লাহ ইবনে ‘আমর (রাঃ) থেকে বর্ণিত। তিনি বলেন, রাসূলুল্লাহ সাল্লাল্লাহু আলাইহি ওয়াসাল্লাম বলেছেনঃ যে ব্যক্তি শরাব পান করে এবং মাতাল হয়, চল্লিশ দিন পর্যন্ত তার নামায কবুল হয় না। সে মারা গেলে জাহান্নামে প্রবেশ করবে। আর যদি সে তওবা করে, তবে আল্লাহ তা‘আলা তার তওবা কবুল করবেন। সে পুনরায় শরাব পানে লিপ্ত হলে কিয়ামতের দিন অল্লাহ তা‘আলা অবশ্যি তাকে ‘‘রাদগাতুল খাবাল’’ পান করাবেন। সাহাবীগণ জিজ্ঞেস করেন, ইয়া রাসূলাল্লাহ! ‘রাদগাতুল খাবাল’ কী? তিনি বলেনঃ জাহান্নামীদের দেহ থেকে নির্গত পুঁজ ও রক্ত।",
			"grades": [
				{
					"name": "Al-Albani",
					"grade": "Sahih"
				},
				{
					"name": "Muhammad Fouad Abd al-Baqi",
					"grade": "Sahih"
				},
				{
					"name": "Shuaib Al Arnaut",
					"grade": "Sahih"
				},
				{
					"name": "Zubair Ali Zai",
					"grade": "Isnaad Sahih"
				}
			],
			"reference": {
				"book": 30,
				"hadith": 7
			}
		},
		{
			"hadithnumber": 3378,
			"arabicnumber": 3378,
			"text": "। আবূ হুরায়রা (রাঃ) থেকে বর্ণিত। তিনি বলেন, রাসূলুল্লাহ সাল্লাল্লাহু আলাইহি ওয়াসাল্লাম বলেছেনঃ শরাব এই দু’টি গাছ থেকে তৈরি হয়ঃ খেজুর গাছ ও আংগুর গাছ।",
			"grades": [
				{
					"name": "Al-Albani",
					"grade": "Sahih"
				},
				{
					"name": "Muhammad Fouad Abd al-Baqi",
					"grade": "Sahih"
				},
				{
					"name": "Zubair Ali Zai",
					"grade": "Sahih Muslim"
				}
			],
			"reference": {
				"book": 30,
				"hadith": 8
			}
		},
		{
			"hadithnumber": 3379,
			"arabicnumber": 3379,
			"text": "। নু'মান ইবনে বাশীর (রাঃ) বলেন, রাসূলুল্লাহ সাল্লাল্লাহু আলাইহি ওয়াসাল্লাম বলেছেনঃ গম থেকে শরাব হয়, বার্লি থেকে শরাব হয়, আংগুর থেকে শরাব হয়, খেজুর থেকে শরাব হয় এবং মধু থেকে শরাব হয়।",
			"grades": [
				{
					"name": "Al-Albani",
					"grade": "Sahih"
				},
				{
					"name": "Muhammad Fouad Abd al-Baqi",
					"grade": "Sahih"
				},
				{
					"name": "Zubair Ali Zai",
					"grade": "Hasan"
				}
			],
			"reference": {
				"book": 30,
				"hadith": 9
			}
		},
		{
			"hadithnumber": 3380,
			"arabicnumber": 3380,
			"text": "। ইবনে উমার (রাঃ) বলেন, রাসূলুল্লাহ সাল্লাল্লাহু আলাইহি ওয়াসাল্লাম বলেছেনঃ শরাবের উপর দশভাবে অভিসম্পাত করা হয়েছেঃ স্বয়ং শরাব (অভিশপ্ত), শরাব উৎপাদক, যে তা উৎপাদন করায়, তার বিক্রেতা, তার ক্রেতা, তার বহনকারী, তা যার জন্য বহন করা হয়, এর মূল্য ভোগকারী, তা পানকারী ও তা পরিবেশনকারী (এদের সকলেই অভিশপ্ত)।",
			"grades": [
				{
					"name": "Al-Albani",
					"grade": "Sahih"
				},
				{
					"name": "Muhammad Fouad Abd al-Baqi",
					"grade": "Sahih"
				},
				{
					"name": "Shuaib Al Arnaut",
					"grade": "Hasan"
				},
				{
					"name": "Zubair Ali Zai",
					"grade": "Isnaad Hasan"
				}
			],
			"reference": {
				"book": 30,
				"hadith": 10
			}
		},
		{
			"hadithnumber": 3381,
			"arabicnumber": 3381,
			"text": "। আনাস ইবনে মালেক (রাঃ) বলেন, রাসূলুল্লাহ সাল্লাল্লাহু আলাইহি ওয়াসাল্লাম দশভাবে শরাবের উপর অভিসম্পাত করেছেনঃ শরাব প্রস্তুতকারী, তা উৎপাদনকারী, যে তা উৎপাদন করায়, তা যার জন্য উৎপাদন করা হয়, তা বহনকারী, যার জন্য তা বহন করা হয়, তার বিক্রেতা, তার ক্রেতা, তা পরিবেশনকারী এবং যার জন্য পরিবেশন করা হয়। এভাবে তিনি দশজনের উল্লেখ করেছেন।",
			"grades": [
				{
					"name": "Al-Albani",
					"grade": "Sahih"
				},
				{
					"name": "Muhammad Fouad Abd al-Baqi",
					"grade": "Sahih"
				},
				{
					"name": "Shuaib Al Arnaut",
					"grade": "Sahih Lighairihi"
				},
				{
					"name": "Zubair Ali Zai",
					"grade": "Hasan"
				}
			],
			"reference": {
				"book": 30,
				"hadith": 11
			}
		},
		{
			"hadithnumber": 3382,
			"arabicnumber": 3382,
			"text": "। আয়েশা (রাঃ) থেকে বর্ণিত। তিনি বলেন, যখন সুদ সম্পর্কিত সূরা বাকারার শেষ আয়াতগুলো নাযিল হয়, তখন রাসূলুল্লাহ সাল্লাল্লাহু আলাইহি ওয়াসাল্লাম বাইরে বের হয়ে আসেন এবং শরাবের ব্যবসাও নিষিদ্ধ (হারাম) ঘোষণা করেন।",
			"grades": [
				{
					"name": "Al-Albani",
					"grade": "Sahih Hadith"
				},
				{
					"name": "Muhammad Fouad Abd al-Baqi",
					"grade": "Sahih"
				},
				{
					"name": "Shuaib Al Arnaut",
					"grade": "Sahih"
				},
				{
					"name": "Zubair Ali Zai",
					"grade": "Sahih - Agreed Upon"
				}
			],
			"reference": {
				"book": 30,
				"hadith": 12
			}
		},
		{
			"hadithnumber": 3383,
			"arabicnumber": 3383,
			"text": "। ইবনে আব্বাস (রাঃ) থেকে বর্ণিত। তিনি বলেন, সামুরা (রাঃ) শরাব বিক্রয় করেন এ কথা উমার (রাঃ) জানতে পেরে বললেন, আল্লাহ সামুরাকে ধ্বংস করুনঃ সে কি জানে না যে, রাসূলুল্লাহ সাল্লাল্লাহু আলাইহি ওয়াসাল্লাম বলেছেনঃ ‘‘আল্লাহ তা‘আলা ইহূদীদের অভিসম্পাত করুন, তাদের প্রতি চর্বি হারাম করা হয়েছিল; কিন্তু তারা তা গলিয়ে বিক্রয় করতো’’।",
			"grades": [
				{
					"name": "Al-Albani",
					"grade": "Sahih"
				},
				{
					"name": "Muhammad Fouad Abd al-Baqi",
					"grade": "Sahih"
				},
				{
					"name": "Shuaib Al Arnaut",
					"grade": "Sahih"
				},
				{
					"name": "Zubair Ali Zai",
					"grade": "Sahih - Agreed Upon"
				}
			],
			"reference": {
				"book": 30,
				"hadith": 13
			}
		},
		{
			"hadithnumber": 3384,
			"arabicnumber": 3384,
			"text": "। আবূ উমামা আল-বাহিলী (রাঃ) থেকে বর্ণিত। তিনি বলেন, রাসূলুল্লাহ সাল্লাল্লাহু আলাইহি ওয়াসাল্লাম বলেছেনঃ এমন কোন রাত এবং দিন অতিবাহিত হবে না, যখন আমার উম্মাতের কতক লোক শরাবের ভিন্ন নামকরণ করে তা পান করবে না।",
			"grades": [
				{
					"name": "Al-Albani",
					"grade": "Sahih"
				},
				{
					"name": "Muhammad Fouad Abd al-Baqi",
					"grade": "Sahih"
				},
				{
					"name": "Shuaib Al Arnaut",
					"grade": "Sahih Lighairihi"
				},
				{
					"name": "Zubair Ali Zai",
					"grade": "Hasan"
				}
			],
			"reference": {
				"book": 30,
				"hadith": 14
			}
		},
		{
			"hadithnumber": 3385,
			"arabicnumber": 3385,
			"text": "। উবাদা ইবনুস সামিত (রাঃ) থেকে বর্ণিত। তিনি বলেন, রাসূলুল্লাহ সাল্লাল্লাহু আলাইহি ওয়াসাল্লাম বলেছেনঃ আমার উম্মাতের কতক লোক শরাবের ভিন্নতর নাম রেখে তা পান করবে।",
			"grades": [
