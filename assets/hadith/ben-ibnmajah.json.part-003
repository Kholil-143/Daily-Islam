				"hadith": 56
			}
		},
		{
			"hadithnumber": 3492,
			"arabicnumber": 3492,
			"text": "। সাদ ইবনে জুরারা আল-আনসারী (রাঃ) থেকে বর্ণিত। তার কণ্ঠনালীতে ‘যাব্হ’ নামীয় ব্যথা হলো। নবী সাল্লাল্লাহু আলাইহি ওয়াসাল্লাম বলেনঃ আবূ উমামার চিকিৎসার ব্যাপারে আমি যথাসাধ্য চেষ্টা করবো। অতঃপর তিনি নিজ হাতে তাকে তপ্ত লোহার দ্বারা সেঁক দিলেন। তিনি ইনতিকাল করলে নবী সাল্লাল্লাহু আলাইহি ওয়াসাল্লাম বলেনঃ তার মৃত্যুতে ইহূদীদের খারাপ অপবাদ হস্তগত হলো। তারা বলবে, সে তার সাথীর মৃত্যু ঠেকাতে পারলো না; অথচ আমি নিজের জন্য অথবা কারো জন্য কিছু করার ক্ষমতা রাখি না।",
			"grades": [
				{
					"name": "Al-Albani",
					"grade": "Hasan"
				},
				{
					"name": "Muhammad Fouad Abd al-Baqi",
					"grade": "Hasan"
				},
				{
					"name": "Shuaib Al Arnaut",
					"grade": "Hasan"
				},
				{
					"name": "Zubair Ali Zai",
					"grade": "Isnaad Hasan"
				}
			],
			"reference": {
				"book": 31,
				"hadith": 57
			}
		},
		{
			"hadithnumber": 3493,
			"arabicnumber": 3493,
			"text": "। জাবির (রাঃ) থেকে বর্ণিত। তিনি বলেন, উবাই ইবনে কাব (রাঃ) খুব অসুস্থ হয়ে পড়লেন। নবী সাল্লাল্লাহু আলাইহি ওয়াসাল্লাম তার নিকট চিকিৎসক পাঠালেন। সে তার (হাতের) শিরায় তপ্ত লোহার সেঁক দিলো।",
			"grades": [
				{
					"name": "Al-Albani",
					"grade": "Sahih"
				},
				{
					"name": "Muhammad Fouad Abd al-Baqi",
					"grade": "Sahih"
				},
				{
					"name": "Zubair Ali Zai",
					"grade": "Sahih Muslim"
				}
			],
			"reference": {
				"book": 31,
				"hadith": 58
			}
		},
		{
			"hadithnumber": 3494,
			"arabicnumber": 3494,
			"text": "। জাবির ইবনে আবদুল্লাহ (রাঃ) থেকে বর্ণিত। রাসূলুল্লাহ সাল্লাল্লাহু আলাইহি ওয়াসাল্লাম সাদ ইবনে মুআয (রাঃ) -র হাতের শিরায় দু’বার গরম লোহার সেঁক দিলেন।",
			"grades": [
				{
					"name": "Al-Albani",
					"grade": "Sahih"
				},
				{
					"name": "Muhammad Fouad Abd al-Baqi",
					"grade": "Sahih"
				},
				{
					"name": "Shuaib Al Arnaut",
					"grade": "Hasan Sahih"
				},
				{
					"name": "Zubair Ali Zai",
					"grade": "Sahih Muslim"
				}
			],
			"reference": {
				"book": 31,
				"hadith": 59
			}
		},
		{
			"hadithnumber": 3495,
			"arabicnumber": 3495,
			"text": "। সালেম ইবনে আবদুল্লাহ (রাঃ) থেকে তার পিতার সূত্রে বর্ণিত। তিনি বলেন, রাসূলুল্লাহ সাল্লাল্লাহু আলাইহি ওয়াসাল্লাম বলেছেনঃ তোমরা অবশ্যই ইসমিদ সুরমা ব্যবহার করবে। কেননা তা চোখের ময়লা দূর করে, দৃষ্টিশক্তি বাড়ায় এবং চোখের পাতায় লোম গজায়।",
			"grades": [
				{
					"name": "Al-Albani",
					"grade": "Sahih"
				},
				{
					"name": "Muhammad Fouad Abd al-Baqi",
					"grade": "Sahih"
				},
				{
					"name": "Shuaib Al Arnaut",
					"grade": "Hasan Lighairihi"
				},
				{
					"name": "Zubair Ali Zai",
					"grade": "Isnaad Hasan"
				}
			],
			"reference": {
				"book": 31,
				"hadith": 60
			}
		},
		{
			"hadithnumber": 3496,
			"arabicnumber": 3496,
			"text": "। জাবির (রাঃ) থেকে বর্ণিত। তিনি বলেন, আমি রাসূলুল্লাহ সাল্লাল্লাহু আলাইহি ওয়াসাল্লাম কে বলতে শুনেছিঃ তোমরা ঘুমানোর সময় অবশ্যই ইসমিদ সুরমা ব্যবহার করবে। কেননা তা দৃষ্টিশক্তিকে প্রখর করে এবং চোখের পাতায় লোম গজায়।",
			"grades": [
				{
					"name": "Al-Albani",
					"grade": "Sahih"
				},
				{
					"name": "Muhammad Fouad Abd al-Baqi",
					"grade": "Sahih"
				},
				{
					"name": "Shuaib Al Arnaut",
					"grade": "Daif"
				},
				{
					"name": "Zubair Ali Zai",
					"grade": "Daif"
				}
			],
			"reference": {
				"book": 31,
				"hadith": 61
			}
		},
		{
			"hadithnumber": 3497,
			"arabicnumber": 3497,
			"text": "। ইবনে আব্বাস (রাঃ) থেকে বর্ণিত। তিনি বলেন, রাসূলুল্লাহ সাল্লাল্লাহু আলাইহি ওয়াসাল্লাম বলেছেনঃ তোমাদের জন্য উত্তম সুরমা হচ্ছে ইসমিদ। তা চোখের জ্যোতি বাড়ায় এবং চোখের পাতায় লোম গজায়।",
			"grades": [
				{
					"name": "Al-Albani",
					"grade": "Sahih"
				},
				{
					"name": "Muhammad Fouad Abd al-Baqi",
					"grade": "Sahih"
				},
				{
					"name": "Zubair Ali Zai",
					"grade": "Hasan"
				}
			],
			"reference": {
				"book": 31,
				"hadith": 62
			}
		},
		{
			"hadithnumber": 3498,
			"arabicnumber": 3498,
			"text": "। আবূ হুরায়রা (রাঃ) থেকে বর্ণিত। নবী সাল্লাল্লাহু আলাইহি ওয়াসাল্লাম বলেনঃ যে ব্যক্তি সুরমা লাগায়, সে যেন বেজোড় সংখ্যকবার লাগায়। যে তা করলো, সে ভালো করলো এবং যে তা করলো না, তার দোষ হবে না।",
			"grades": [
				{
					"name": "Al-Albani",
					"grade": "Daif"
				},
				{
					"name": "Muhammad Fouad Abd al-Baqi",
					"grade": "Daif"
				},
				{
					"name": "Shuaib Al Arnaut",
					"grade": "Sanad Daif"
				},
				{
					"name": "Zubair Ali Zai",
					"grade": "Daif"
				}
			],
			"reference": {
				"book": 31,
				"hadith": 63
			}
		},
		{
			"hadithnumber": 3499,
			"arabicnumber": 3499,
			"text": "। ইবনে আব্বাস (রাঃ) থেকে বর্ণিত। তিনি বলেন, নবী সাল্লাল্লাহু আলাইহি ওয়াসাল্লাম -এর একটি সুরমাদানি ছিল। তিনি তা থেকে প্রতি চোখে তিনবার করে সুরমা লাগাতেন।",
			"grades": [
				{
					"name": "Al-Albani",
					"grade": "Daif"
				},
				{
					"name": "Muhammad Fouad Abd al-Baqi",
					"grade": "Daif"
				},
				{
					"name": "Shuaib Al Arnaut",
					"grade": "Very Daif"
				},
				{
					"name": "Zubair Ali Zai",
					"grade": "Daif"
				}
			],
			"reference": {
				"book": 31,
				"hadith": 64
			}
		},
		{
			"hadithnumber": 3500,
			"arabicnumber": 3500,
			"text": "। তারিক ইবনে সুয়াইদ আল-হাযরামী (রাঃ) থেকে বর্ণিত। তিনি বলেন, আমি বললাম, ইয়া রাসূলাল্লাহ! আমাদের এলাকায় প্রচুর আঙ্গুর হয়, আমরা তার রস নিংড়িয়ে পান করি। তিনি বলেনঃ না (পান করো না)। আমি পুনরায় বললাম, আমরা রোগীর ঔষধ রূপে তা ব্যবহার করি। তিনি বলেনঃ তা ঔষধ নয়, বরং রোগ।",
			"grades": [
				{
					"name": "Al-Albani",
					"grade": "Sahih"
				},
				{
					"name": "Muhammad Fouad Abd al-Baqi",
					"grade": "Sahih"
				},
				{
					"name": "Zubair Ali Zai",
					"grade": "Sahih"
				}
			],
			"reference": {
				"book": 31,
				"hadith": 65
			}
		},
		{
			"hadithnumber": 3501,
			"arabicnumber": 3501,
			"text": "। আলী (রাঃ) থেকে বর্ণিত। তিনি বলেন, রাসূলুল্লাহ সাল্লাল্লাহু আলাইহি ওয়াসাল্লাম বলেছেনঃ উত্তম আরোগ্য হলো কুরআন মজীদ।",
			"grades": [
				{
					"name": "Al-Albani",
					"grade": "Daif"
				},
				{
					"name": "Muhammad Fouad Abd al-Baqi",
					"grade": "Daif"
				},
				{
					"name": "Shuaib Al Arnaut",
					"grade": "Daif"
				},
				{
					"name": "Zubair Ali Zai",
					"grade": "Daif"
				}
			],
			"reference": {
				"book": 31,
				"hadith": 66
			}
		},
		{
			"hadithnumber": 3502,
			"arabicnumber": 3502,
			"text": "। রাসূলুল্লাহ সাল্লাল্লাহু আলাইহি ওয়াসাল্লাম -এর মুক্তদাসী সালমা উম্মু রাফে (রাঃ) -কে বর্ণিত। তিনি বলেন, নবী সাল্লাল্লাহু আলাইহি ওয়াসাল্লাম কখনো আঘাত পেলে বা তাঁর কাটা বিদ্ধ হলে তিনি আহত স্থানে মেহেদী লাগাতেন।",
			"grades": [
				{
					"name": "Al-Albani",
					"grade": "Hasan"
				},
				{
					"name": "Muhammad Fouad Abd al-Baqi",
					"grade": "Hasan"
				},
				{
					"name": "Zubair Ali Zai",
					"grade": "Daif"
				}
			],
			"reference": {
				"book": 31,
				"hadith": 67
			}
		},
		{
			"hadithnumber": 3503,
			"arabicnumber": 3503,
			"text": "। আনাস (রাঃ) থেকে বর্ণিত। উরায়না গোত্রের কতক লোক রাসূলুল্লাহ সাল্লাল্লাহু আলাইহি ওয়াসাল্লাম -এর নিকট আসে। কিন্তু মদীনার আবহাওয়া তাদের অনুকূল হলো না। নবী সাল্লাল্লাহু আলাইহি ওয়াসাল্লাম বলেনঃ যদি তোমরা আমাদের উটের পালে চলে যেতে এবং সেগুলোর দুধ ও পেশাব পান করতে! তারা তাই করলো।",
			"grades": [
				{
					"name": "Al-Albani",
					"grade": "Sahih"
				},
				{
					"name": "Muhammad Fouad Abd al-Baqi",
					"grade": "Sahih"
				},
				{
					"name": "Shuaib Al Arnaut",
					"grade": "Sahih"
				},
				{
					"name": "Zubair Ali Zai",
					"grade": "Sahih"
				}
			],
			"reference": {
				"book": 31,
				"hadith": 68
			}
		},
		{
			"hadithnumber": 3504,
			"arabicnumber": 3504,
			"text": "। আবূ সাঈদ (রাঃ) থেকে বর্ণিত। রাসূলুল্লাহ সাল্লাল্লাহু আলাইহি ওয়াসাল্লাম বলেনঃ মাছির দু’টি ডানার একটিতে বিষ এবং অন্যটিতে আরোগ্য আছে। অতএব খাদ্যদ্রব্যে মাছি পড়লে সেটিকে তাতে ডুবিয়ে দাও। কেননা সেটি বিষের ডানাকে আরোগ্যের ডানার আগে খাদ্যে লাগায়।",
			"grades": [
				{
					"name": "Al-Albani",
					"grade": "Sahih"
				},
				{
					"name": "Muhammad Fouad Abd al-Baqi",
					"grade": "Sahih"
				},
				{
					"name": "Shuaib Al Arnaut",
					"grade": "Sahih"
				},
				{
					"name": "Zubair Ali Zai",
					"grade": "Isnaad Hasan"
				}
			],
			"reference": {
				"book": 31,
				"hadith": 69
			}
		},
		{
			"hadithnumber": 3505,
			"arabicnumber": 3505,
			"text": "। আবূ হুরায়রা (রাঃ) থেকে বর্ণিত। নবী সাল্লাল্লাহু আলাইহি ওয়াসাল্লাম বলেনঃ তোমাদের পানীয়তে মাছি পড়লে সেটাকে তাতে ডুবিয়ে দাও, অতঃপর সেটিকে তুলে ফেলে দাও। কেননা তার একটি ডানায় রোগ এবং অন্যটিতে আরোগ্য রয়েছে।",
			"grades": [
				{
					"name": "Al-Albani",
					"grade": "Sahih"
				},
				{
					"name": "Muhammad Fouad Abd al-Baqi",
					"grade": "Sahih"
				},
				{
					"name": "Zubair Ali Zai",
					"grade": "Sahih Bukhari"
				}
			],
			"reference": {
				"book": 31,
				"hadith": 70
			}
		},
		{
			"hadithnumber": 3506,
			"arabicnumber": 3506,
			"text": "। আমের ইবনে রাবীআ (রাঃ) থেকে বর্ণিত। নবী সাল্লাল্লাহু আলাইহি ওয়াসাল্লাম বলেনঃ বদনজর সত্য।",
			"grades": [
				{
