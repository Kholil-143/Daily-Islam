					"grade": "Daif"
				},
				{
					"name": "Zubair Ali Zai",
					"grade": "Daif"
				}
			],
			"reference": {
				"book": 37,
				"hadith": 98
			}
		},
		{
			"hadithnumber": 4198,
			"arabicnumber": 4198,
			"text": "। আয়েশা (রাঃ) থেকে বর্ণিত। তিনি বলেন, আমি বললাম, হে আল্লাহর রাসূল! (অনুবাদঃ) ‘‘এবং যারা তাদের প্রভুর নিকট প্রত্যাবর্তন করবে, এই বিশ্বাসে তাদের যা দান করার তা দান করে ভীত-কম্পিত হৃদয়ে’’ (সূরা মুমিনূনঃ ৬০), এর দ্বারা কি এমন ব্যক্তিকে বুঝানো হয়েছে, যে ব্যভিচার করে, চুরি করে এবং মদ্যপান করে? তিনি বলেনঃ না, হে আবূ বাকরের কন্যা, হে সিদ্দীকের কন্যা! বরং উক্ত আয়াতে এমন ব্যক্তিকে বুঝানো হয়েছে, যে রোযা রাখে, যাকাত দেয়, দান-খয়রাত করে, নামায পড়ে এবং আশংকা করে যে, তার এসব ইবাদত কবুল হলো কি না?",
			"grades": [
