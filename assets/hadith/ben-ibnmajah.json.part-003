		{
			"hadithnumber": 3267,
			"arabicnumber": 3267,
			"text": "। উমার ইবনে আবূ সালামা (রাঃ) বলেন, আমি নবী সাল্লাল্লাহু আলাইহি ওয়াসাল্লাম এর প্রতিপালনাধীন ছিলাম। আহার গ্রহণের সময় আমার হাত পাত্রের যত্রতত্র চলে যেতো। তিনি আমাকে বলেনঃ এই ছেলে! আল্লাহর নাম স্মরণ করো, ডান হাতে আহার করো এবং তোমার নিকটের খাদ্য থেকে খাও।",
			"grades": [
				{
					"name": "Al-Albani",
					"grade": "Sahih"
				},
				{
					"name": "Muhammad Fouad Abd al-Baqi",
					"grade": "Sahih"
				},
				{
					"name": "Shuaib Al Arnaut",
					"grade": "Sahih"
				},
				{
					"name": "Zubair Ali Zai",
					"grade": "Sahih - Agreed Upon"
				}
			],
			"reference": {
