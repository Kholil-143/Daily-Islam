					"name": "Al-Albani",
					"grade": "Hasan Sahih"
				},
				{
					"name": "Muhammad Fouad Abd al-Baqi",
					"grade": "Hasan Sahih"
				},
				{
					"name": "Shuaib Al Arnaut",
					"grade": "Sahih Lighairihi"
				},
				{
					"name": "Zubair Ali Zai",
					"grade": "Hasan"
				}
			],
			"reference": {
				"book": 33,
				"hadith": 65
			}
		},
		{
			"hadithnumber": 3722,
			"arabicnumber": 3722,
			"text": "। ইবনে বুরাইদা (রাঃ) থেকে তার পিতার সূত্রে বর্ণিত। নবী সাল্লাল্লাহু আলাইহি ওয়াসাল্লাম ছায়া ও রোদের মাঝামাঝি বসতে নিষেধ করেছেন।",
