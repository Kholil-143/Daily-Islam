					"grade": "Sahih"
				},
				{
					"name": "Muhammad Fouad Abd al-Baqi",
					"grade": "Sahih"
				},
				{
					"name": "Shuaib Al Arnaut",
					"grade": "Sahih"
				},
				{
					"name": "Zubair Ali Zai",
					"grade": "Sahih - Agreed Upon"
				}
			],
			"reference": {
				"book": 33,
				"hadith": 40
			}
		},
		{
			"hadithnumber": 3697,
			"arabicnumber": 3697,
			"text": "। আনাস ইবনে মালেক (রাঃ) থেকে বর্ণিত। তিনি বলেন, রাসূলুল্লাহ সাল্লাল্লাহু আলাইহি ওয়াসাল্লাম বলেছেনঃ আহলে কিতাবের কেউ তোমাদের সালাম দিলে তোমরা বলবে, ওয়া আলাইকুম (তোমাদের প্রতিও)।",
			"grades": [
