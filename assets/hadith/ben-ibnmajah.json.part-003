				"hadith": 69
			}
		},
		{
			"hadithnumber": 3619,
			"arabicnumber": 3619,
			"text": "। ইবনে উমার (রাঃ) থেকে বর্ণিত। তিনি বলেন, নবী সাল্লাল্লাহু আলাইহি ওয়াসাল্লাম কোন ব্যক্তিকে দাঁড়ানো অবস্থায় জুতা পরতে নিষেধ করেছেন।",
			"grades": [
				{
					"name": "Al-Albani",
					"grade": "Sahih"
				},
				{
					"name": "Muhammad Fouad Abd al-Baqi",
					"grade": "Sahih"
				},
				{
					"name": "Shuaib Al Arnaut",
					"grade": "Sahih"
				},
				{
					"name": "Zubair Ali Zai",
					"grade": "Daif"
				}
			],
			"reference": {
				"book": 32,
				"hadith": 70
			}
		},
		{
			"hadithnumber": 3620,
			"arabicnumber": 3620,
			"text": "। বুরায়দা (রাঃ) থেকে বর্ণিত। নাজ্জাশী (রাঃ) রাসূলুল্লাহ সাল্লাল্লাহু আলাইহি ওয়াসাল্লাম কে মিশমিশে কালো রংয়ের একজোড়া মোজা উপঢৌকন দেন। তিনি তা পরিধান করেন।",
			"grades": [
				{
					"name": "Al-Albani",
					"grade": "Hasan"
				},
				{
					"name": "Muhammad Fouad Abd al-Baqi",
					"grade": "Hasan"
				},
				{
					"name": "Shuaib Al Arnaut",
					"grade": "Hasan Lighairihi"
				},
				{
					"name": "Zubair Ali Zai",
					"grade": "Daif"
				}
			],
			"reference": {
				"book": 32,
				"hadith": 71
			}
		},
		{
			"hadithnumber": 3621,
			"arabicnumber": 3621,
			"text": "। আবূ হুরায়রা (রাঃ) থেকে বর্ণিত। নবী সাল্লাল্লাহু আলাইহি ওয়াসাল্লাম বলেনঃ ইহূদী ও খৃস্টানরা খেযাব ব্যবহার করে না। সুতরাং তোমরা তাদের বিপরীত করো।",
			"grades": [
				{
					"name": "Al-Albani",
					"grade": "Sahih"
				},
				{
					"name": "Muhammad Fouad Abd al-Baqi",
					"grade": "Sahih"
				},
				{
					"name": "Shuaib Al Arnaut",
					"grade": "Sahih"
				},
				{
					"name": "Zubair Ali Zai",
					"grade": "Sahih - Agreed Upon"
				}
			],
			"reference": {
				"book": 32,
				"hadith": 72
			}
		},
		{
			"hadithnumber": 3622,
			"arabicnumber": 3622,
			"text": "। আবূ যার (রাঃ) থেকে বর্ণিত। তিনি বলেন, রাসূলুল্লাহ সাল্লাল্লাহু আলাইহি ওয়াসাল্লাম বলেছেনঃ যেসব জিনিস দিয়ে তোমরা বার্ধক্যকে পরিবর্তন করতে পারো তার মধ্যে মেহেদি ও কাতাম হলো সর্বোত্তম।",
			"grades": [
				{
					"name": "Al-Albani",
					"grade": "Sahih"
				},
				{
					"name": "Muhammad Fouad Abd al-Baqi",
					"grade": "Sahih"
				},
				{
					"name": "Shuaib Al Arnaut",
					"grade": "Hasan Sahih"
				},
				{
					"name": "Zubair Ali Zai",
					"grade": "Sahih"
				}
			],
			"reference": {
				"book": 32,
				"hadith": 73
			}
		},
		{
			"hadithnumber": 3623,
			"arabicnumber": 3623,
			"text": "। উসমান ইবনে মাওহাব (রাঃ) থেকে বর্ণিত। তিনি বলেন, আমি উম্মু সালামা (রাঃ) -এর নিকট প্রবেশ করলাম। রাবী বলেন, তিনি আমার সামনে রাসূলুল্লাহ সাল্লাল্লাহু আলাইহি ওয়াসাল্লাম এর কিছু চুল বের করলেন, যা মেহেদি ও কাতাম দ্বারা রঞ্জিত ছিল।",
			"grades": [
				{
					"name": "Al-Albani",
					"grade": "Sahih"
				},
				{
					"name": "Muhammad Fouad Abd al-Baqi",
					"grade": "Sahih"
				},
				{
					"name": "Shuaib Al Arnaut",
					"grade": "Sahih"
				},
				{
					"name": "Zubair Ali Zai",
					"grade": "Sahih Bukhari"
				}
			],
			"reference": {
				"book": 32,
				"hadith": 74
			}
		},
		{
			"hadithnumber": 3624,
			"arabicnumber": 3624,
			"text": "। জাবির (রাঃ) থেকে বর্ণিত। তিনি বলেন, মক্কা বিজয়ের দিন আবূ কুহাফাকে নবী সাল্লাল্লাহু আলাইহি ওয়াসাল্লাম -এর নিকট আনা হলো। তার মাথার চুল ছিল ধবধবে সাদা। রাসূলুল্লাহ সাল্লাল্লাহু আলাইহি ওয়াসাল্লাম বলেনঃ তোমরা তাকে তার কোন স্ত্রীর নিকট নিয়ে যাও এবং সে যেন তার (চুলের) রং পরিবর্তন করে দেয়। তবে তোমরা তার জন্য কালো রং পরিহার করো।",
			"grades": [
				{
					"name": "Al-Albani",
					"grade": "Sahih"
				},
				{
					"name": "Muhammad Fouad Abd al-Baqi",
					"grade": "Sahih"
				},
				{
					"name": "Zubair Ali Zai",
					"grade": "Sahih"
				}
			],
			"reference": {
				"book": 32,
				"hadith": 75
			}
		},
		{
			"hadithnumber": 3625,
			"arabicnumber": 3625,
			"text": "। সুহাইব আল-খায়ের (রাঃ) থেকে বর্ণিত। তিনি বলেন, রাসূলুল্লাহ সাল্লাল্লাহু আলাইহি ওয়াসাল্লাম বলেছেনঃ তোমরা যা দিয়ে চুল রঙ্গিন করো তার মধ্যে এই কালো খেযাব খুবই উত্তম। তাতে তোমাদের প্রতি নারীদের আকর্ষণ আছে এবং জিহাদে তা তোমাদের শত্রুদের মধ্যে ভীতি সৃষ্টিকর।",
			"grades": [
				{
					"name": "Al-Albani",
					"grade": "Daif"
				},
				{
					"name": "Muhammad Fouad Abd al-Baqi",
					"grade": "Daif"
				},
				{
					"name": "Shuaib Al Arnaut",
					"grade": "Daif"
				},
				{
					"name": "Zubair Ali Zai",
					"grade": "Daif"
				}
			],
			"reference": {
				"book": 32,
				"hadith": 76
			}
		},
		{
			"hadithnumber": 3626,
			"arabicnumber": 3626,
			"text": "। সাঈদ ইবনে আবূ সাঈদ (রাঃ) থেকে বর্ণিত। তিনি বলেন, ইবনে জুরাইজ (রাঃ) ইবনে উমার (রাঃ) কে জিজ্ঞেস করলেন, আমি তো আপনাকে ওয়ারস ঘাসের রং দিয়ে আপনার দাড়ি রঞ্জিত করতে দেখছি। ইবনে উমার (রাঃ) বলেন, আমার দাড়ি হলুদ রংয়ে রঞ্জিত করার কারণ এই যে, আমি রাসূলুল্লাহ সাল্লাল্লাহু আলাইহি ওয়াসাল্লাম কে তাঁর দাড়ি হলুদ রংয়ে রঞ্জিত করতে দেখেছি।",
			"grades": [
				{
					"name": "Al-Albani",
					"grade": "Sahih"
				},
				{
					"name": "Muhammad Fouad Abd al-Baqi",
					"grade": "Sahih"
				},
				{
					"name": "Shuaib Al Arnaut",
					"grade": "Sahih"
				},
				{
					"name": "Zubair Ali Zai",
					"grade": "Sahih - Agreed Upon"
				}
			],
			"reference": {
				"book": 32,
				"hadith": 77
			}
		},
		{
			"hadithnumber": 3627,
			"arabicnumber": 3627,
			"text": "। ইবনে আব্বাস (রাঃ) থেকে বর্ণিত। তিনি বলেন, রাসূলুল্লাহ সাল্লাল্লাহু আলাইহি ওয়াসাল্লাম মেহেদির খেযাব ব্যবহারকারী এক লোকের নিকট দিয়ে যাওয়ার সময় বলেনঃ এটা কতই না উত্তম! অতঃপর তিনি মেহেদি ও কাতামের খেযাব গ্রহণকারী এক ব্যক্তিকে অতিক্রম করার সময় বলেনঃ এটা ওটার চেয়েও উত্তম। অতঃপর তিনি হলুদ রঙের খেযাব গ্রহণকারী এক ব্যক্তিকে অতিক্রমকালে বলেনঃ এটা ঐ সবগুলোর চেয়ে উত্তম। রাবী বলেন, তাউস (রাঃ) হলুদ রঙের খেযাব ব্যবহার করতেন।",
			"grades": [
				{
					"name": "Al-Albani",
					"grade": "Daif"
				},
				{
					"name": "Muhammad Fouad Abd al-Baqi",
					"grade": "Daif"
				},
				{
					"name": "Shuaib Al Arnaut",
					"grade": "Daif"
				},
				{
					"name": "Zubair Ali Zai",
					"grade": "Daif"
				}
			],
			"reference": {
				"book": 32,
				"hadith": 78
			}
		},
		{
			"hadithnumber": 3628,
			"arabicnumber": 3628,
			"text": "। আবূ জুহাইফা (রাঃ) থেকে বর্ণিত। তিনি বলেন, আমি রাসূলুল্লাহ সাল্লাল্লাহু আলাইহি ওয়াসাল্লাম -এর এ অংশটা অর্থাৎ তাঁর চিবুকের নিচের ও উপরের কিছু চুল সাদা দেখেছি।",
			"grades": [
