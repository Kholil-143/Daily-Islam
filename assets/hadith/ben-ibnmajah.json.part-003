					"grade": "Hasan"
				}
			],
			"reference": {
				"book": 29,
				"hadith": 15
			}
		},
		{
			"hadithnumber": 3266,
			"arabicnumber": 3266,
			"text": "। আবূ হুরায়রা (রাঃ) থেকে বর্ণিত। নবী সাল্লাল্লাহু আলাইহি ওয়াসাল্লাম বলেনঃ তোমাদের প্রত্যেকে যেন ডান হাতে আহার করে, ডান হাতে পান করে, ডান হাতে গ্রহণ করে এবং ডান হাতে দান করে। কারণ শয়তান বাম হাতে খায়, বাম হাতে পান করে, বাম হাতে দেয় এবং বাম হাতে গ্রহণ করে।",
