					"grade": "Very Daif"
				},
				{
					"name": "Zubair Ali Zai",
					"grade": "Daif"
				}
			],
			"reference": {
				"book": 33,
				"hadith": 118
			}
		},
		{
			"hadithnumber": 3775,
			"arabicnumber": 3775,
			"text": "। আবদুল্লাহ (রাঃ) থেকে বর্ণিত। তিনি বলেন, রাসূলুল্লাহ সাল্লাল্লাহু আলাইহি ওয়াসাল্লাম বলেছেনঃ তোমরা তিনজন একত্র হলে একজনকে বাদ দিয়ে যেন দু’জনে কান পরামর্শ না করে। কেননা তাতে সে চিন্তিত হতে পারে।",
			"grades": [
				{
					"name": "Al-Albani",
					"grade": "Sahih"
				},
				{
					"name": "Muhammad Fouad Abd al-Baqi",
					"grade": "Sahih"
				},
				{
					"name": "Shuaib Al Arnaut",
					"grade": "Sahih"
				},
				{
					"name": "Zubair Ali Zai",
					"grade": "Sahih Muslim"
				}
			],
			"reference": {
				"book": 33,
				"hadith": 119
			}
		},
		{
			"hadithnumber": 3776,
			"arabicnumber": 3776,
			"text": "। ইবনে উমার (রাঃ) থেকে বর্ণিত। তিনি বলেন, রাসূলুল্লাহ সাল্লাল্লাহু আলাইহি ওয়াসাল্লাম তৃতীয় জনকে বাদ দিয়ে দু’জনে কান পরামর্শ করতে নিষেধ করেছেন।",
			"grades": [
				{
					"name": "Al-Albani",
					"grade": "Sahih"
				},
				{
					"name": "Muhammad Fouad Abd al-Baqi",
					"grade": "Sahih"
				},
				{
					"name": "Shuaib Al Arnaut",
					"grade": "Sahih"
				},
				{
					"name": "Zubair Ali Zai",
					"grade": "Isnaad Sahih"
				}
			],
			"reference": {
				"book": 33,
				"hadith": 120
			}
		},
		{
			"hadithnumber": 3777,
			"arabicnumber": 3777,
			"text": "। সুফিয়ান ইবনে উয়াইনা (রাঃ) বলেন, আমি আমর ইবনে দীনার (রাঃ) -কে বললাম, আপনি কি জাবির ইবনে আবদুল্লাহ (রাঃ) কে বলতে শুনেছেন, ‘‘এক ব্যক্তি তীরসহ মসজিদ অতিক্রম করলে রাসূলুল্লাহ সাল্লাল্লাহু আলাইহি ওয়াসাল্লাম বলেনঃ তীরের ‘ফলা’ মুষ্টিবন্ধ রাখো’’। তিনি বলেন, হ্যাঁ।",
			"grades": [
				{
					"name": "Al-Albani",
					"grade": "Sahih"
				},
				{
					"name": "Muhammad Fouad Abd al-Baqi",
					"grade": "Sahih"
				},
				{
					"name": "Shuaib Al Arnaut",
					"grade": "Sahih"
				},
				{
					"name": "Zubair Ali Zai",
					"grade": "Sahih - Agreed Upon"
				}
			],
			"reference": {
				"book": 33,
				"hadith": 121
			}
		},
		{
			"hadithnumber": 3778,
			"arabicnumber": 3778,
			"text": "। আবূ মূসা (রাঃ) থেকে বর্ণিত। নবী সাল্লাল্লাহু আলাইহি ওয়াসাল্লাম বলেন, তোমাদের কেউ তীরসহ আমাদের মসজিদ অথবা আমাদের বাজার অতিক্রম করলে সে যেন তার তীরের ফলার অংশটুকু মুষ্টিবন্ধ করে রাখে, যাতে তা কোন মুসলিমের গায়ে না লাগতে পারে।",
			"grades": [
				{
					"name": "Al-Albani",
					"grade": "Sahih"
				},
				{
					"name": "Muhammad Fouad Abd al-Baqi",
					"grade": "Sahih"
				},
				{
					"name": "Shuaib Al Arnaut",
					"grade": "Sahih"
				},
				{
					"name": "Zubair Ali Zai",
					"grade": "Sahih - Agreed Upon"
				}
			],
			"reference": {
				"book": 33,
				"hadith": 122
			}
		},
		{
			"hadithnumber": 3779,
			"arabicnumber": 3779,
			"text": "। আয়েশা (রাঃ) থেকে বর্ণিত। তিনি বলেন, রাসূলুল্লাহ সাল্লাল্লাহু আলাইহি ওয়াসাল্লাম বলেছেনঃ কুরআন মজীদে দক্ষ ব্যক্তি (আখেরাতে) সম্মানিত নেককার লিপিকার ফেরেশতাদের সাথে থাকবে। যে ব্যক্তি ঠেকে ঠেকে কষ্ট করে কুরআন পড়ে সে দু’টি পুরস্কার পাবে।",
			"grades": [
				{
					"name": "Al-Albani",
					"grade": "Sahih"
				},
				{
					"name": "Muhammad Fouad Abd al-Baqi",
					"grade": "Sahih"
				},
				{
					"name": "Zubair Ali Zai",
					"grade": "Sahih - Agreed Upon"
				}
			],
			"reference": {
				"book": 33,
				"hadith": 123
			}
		},
		{
			"hadithnumber": 3780,
			"arabicnumber": 3780,
			"text": "। আবূ সাঈদ আল-খুদরী (রাঃ) থেকে বর্ণিত। তিনি বলেন, রাসূলুল্লাহ সাল্লাল্লাহু আলাইহি ওয়াসাল্লাম বলেছেনঃ কুরআনের বাহককে জান্নাতে প্রবেশকালে বলা হবে, তুমি পাঠ করতে থাকো এবং উপরে আরোহণ করতে থাকো। অতঃপর সে পড়তে থাকবে এবং প্রতিটি আয়াত পড়ার সাথে সাথে একটি স্তর অতিক্রম করবে। এভাবে সে তার জ্ঞাত শেষ আয়াতটি পর্যন্ত পড়বে।",
			"grades": [
				{
					"name": "Al-Albani",
					"grade": "Sahih"
				},
				{
					"name": "Muhammad Fouad Abd al-Baqi",
					"grade": "Sahih"
				},
				{
					"name": "Shuaib Al Arnaut",
					"grade": "Sahih Lighairihi"
				},
				{
					"name": "Zubair Ali Zai",
					"grade": "Hasan"
				}
			],
			"reference": {
				"book": 33,
				"hadith": 124
			}
		},
		{
			"hadithnumber": 3781,
			"arabicnumber": 3781,
			"text": "। ইবনে বুরায়দা (রাঃ) থেকে তার পিতার সূত্রে বর্ণিত। তিনি বলেন, রাসূলুল্লাহ সাল্লাল্লাহু আলাইহি ওয়াসাল্লাম বলেছেনঃ কিয়ামতের দিন কুরআন পর্যুদস্ত লোকের অবয়বে উপস্থিত হয়ে বলবে, আমিই তোমাকে রাতে বিনিদ্র করেছি এবং দিনে পিপাসার্ত করেছি।",
			"grades": [
				{
					"name": "Al-Albani",
					"grade": "Daif"
				},
				{
					"name": "Muhammad Fouad Abd al-Baqi",
					"grade": "Daif"
				},
				{
					"name": "Shuaib Al Arnaut",
					"grade": "Daif"
				},
				{
					"name": "Zubair Ali Zai",
					"grade": "Isnaad Hasan"
				}
			],
			"reference": {
				"book": 33,
				"hadith": 125
			}
		},
		{
			"hadithnumber": 3782,
			"arabicnumber": 3782,
			"text": "। অবু হুরায়রা (রাঃ) থেকে বর্ণিত। তিনি বলেন, রাসূলুল্লাহ সাল্লাল্লাহু আলাইহি ওয়াসাল্লাম জিজ্ঞেস করলেনঃ তোমাদের কেউ কি তার ঘরে ফিরে এসে সেখানে তিনটি হৃষ্টপুষ্ট গর্ভবতী উষ্ট্রী পেতে পছন্দ করে? আমরা বললাম, হ্যাঁ। তিনি বলেনঃ তোমাদের কেউ তার নামাযে তিনটি আয়াত পড়লে তার জন্য হৃষ্টপুষ্ট তিনটি গর্ভবতী উষ্ট্রীর চেয়ে উত্তম।",
			"grades": [
				{
					"name": "Al-Albani",
					"grade": "Sahih"
				},
				{
					"name": "Muhammad Fouad Abd al-Baqi",
					"grade": "Sahih"
				},
				{
					"name": "Shuaib Al Arnaut",
					"grade": "Sahih"
				},
				{
					"name": "Zubair Ali Zai",
					"grade": "Sahih Muslim"
				}
			],
			"reference": {
				"book": 33,
				"hadith": 126
			}
		},
		{
			"hadithnumber": 3783,
			"arabicnumber": 3783,
			"text": "। ইবনে উমার (রাঃ) থেকে বর্ণিত। তিনি বলেন, রাসূলুল্লাহ সাল্লাল্লাহু আলাইহি ওয়াসাল্লাম বলেছেনঃ কুরআনের উদাহরণ হলো বেঁধে রাখা উটের (উদাহরণ) তুল্য। উটের মালিক তাকে রশি দিয়ে বেঁধে রাখলে সে তাকে আয়ত্তাধীন রাখতে পারে, সে যদি তার রশির বাঁধন খুলে দেয় তবে তা ভেগে যায়।",
