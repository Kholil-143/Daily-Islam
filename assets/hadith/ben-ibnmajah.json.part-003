					"grade": "Sahih"
				},
				{
					"name": "Muhammad Fouad Abd al-Baqi",
					"grade": "Sahih"
				},
				{
					"name": "Zubair Ali Zai",
					"grade": "Daif"
				}
			],
			"reference": {
				"book": 37,
				"hadith": 49
			}
		},
		{
			"hadithnumber": 4149,
			"arabicnumber": 4149,
			"text": "। সুলায়মান ইবনে সুরাদ (রাঃ) থেকে বর্ণিত। তিনি বলেন, রাসূলুল্লাহ সাল্লাল্লাহু আলাইহি ওয়াসাল্লাম আমাদের নিকট এলেন এবং তিন রাত আমাদের সঙ্গে অবস্থান করলেন। তখন আমরা তিন দিন যাবত খাদ্যের সংস্থান করতে পারিনি।",
			"grades": [
				{
					"name": "Al-Albani",
					"grade": "Daif"
				},
				{
					"name": "Muhammad Fouad Abd al-Baqi",
					"grade": "Daif"
				},
				{
					"name": "Shuaib Al Arnaut",
					"grade": "Daif"
				},
				{
					"name": "Zubair Ali Zai",
					"grade": "Daif"
				}
			],
			"reference": {
				"book": 37,
				"hadith": 50
			}
		},
		{
			"hadithnumber": 4150,
			"arabicnumber": 4150,
			"text": "। অবু হুরায়রা (রাঃ) থেকে বর্ণিত। তিনি বলেন, একদিন রাসূলুল্লাহ সাল্লাল্লাহু আলাইহি ওয়াসাল্লাম -এর সামনে গরম টাটকা খাবার পেশ করা হলো। তিনি আহার করলেন এবং আহার শেষে বললেনঃ সমস্ত প্রশংসা আল্লাহর। এতো দিন পর্যন্ত আমার উদরে কখনো এরূপ টাটকা উপাদেয় খাদ্য প্রবেশ করেনি।",
			"grades": [
