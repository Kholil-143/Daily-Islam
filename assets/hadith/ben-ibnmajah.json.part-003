			}
		},
		{
			"hadithnumber": 3483,
			"arabicnumber": 3483,
			"text": "। আনাস (রাঃ) থেকে বর্ণিত। নবী সাল্লাল্লাহু আলাইহি ওয়াসাল্লাম দু’ পাশের শিরায় এবং ঘাড়ের কাছাকাছি পিঠের ফোলা অংশে রক্ষমোক্ষণ করান।",
			"grades": [
				{
					"name": "Al-Albani",
					"grade": "Sahih"
				},
				{
					"name": "Muhammad Fouad Abd al-Baqi",
					"grade": "Sahih"
				},
				{
					"name": "Zubair Ali Zai",
					"grade": "Daif"
				}
