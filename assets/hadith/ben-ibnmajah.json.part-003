		{
			"hadithnumber": 3512,
			"arabicnumber": 3512,
			"text": "। আয়েশা (রাঃ) থেকে বর্ণিত। তিনি বলেন, রাসূলুল্লাহ সাল্লাল্লাহু আলাইহি ওয়াসাল্লাম বলেছেনঃ বদনজর ও বিষাক্ত প্রাণীর দংশন ছাড়া অন্য কিছুতে ঝাড়ফুঁক বৈধ নয়।",
			"grades": [
				{
					"name": "Al-Albani",
					"grade": "Sahih"
				},
				{
					"name": "Muhammad Fouad Abd al-Baqi",
					"grade": "Sahih"
				},
				{
					"name": "Zubair Ali Zai",
					"grade": "Sahih - Agreed Upon"
