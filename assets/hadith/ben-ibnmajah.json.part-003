					"grade": "Hasan"
				},
				{
					"name": "Muhammad Fouad Abd al-Baqi",
					"grade": "Hasan"
				},
				{
					"name": "Shuaib Al Arnaut",
					"grade": "Hasan"
				},
				{
					"name": "Zubair Ali Zai",
					"grade": "Daif"
				}
			],
			"reference": {
				"book": 32,
				"hadith": 56
			}
		},
		{
			"hadithnumber": 3606,
			"arabicnumber": 3606,
			"text": "। ইবনে উমার (রাঃ) থেকে বর্ণিত। তিনি বলেন, রাসূলুল্লাহ সাল্লাল্লাহু আলাইহি ওয়াসাল্লাম বলেছেনঃ যে ব্যক্তি খ্যাতি লাভের মানসে পোশাক পরে, কিয়ামতের দিন আল্লাহ তাকে অপমানের পোশাক পরাবেন।",
			"grades": [
				{
					"name": "Al-Albani",
					"grade": "Hasan"
				},
				{
					"name": "Muhammad Fouad Abd al-Baqi",
					"grade": "Hasan"
				},
				{
					"name": "Shuaib Al Arnaut",
					"grade": "Hasan"
				},
				{
					"name": "Zubair Ali Zai",
					"grade": "Hasan"
				}
			],
			"reference": {
				"book": 32,
				"hadith": 57
			}
		},
		{
			"hadithnumber": 3607,
			"arabicnumber": 3607,
			"text": "। আবদুল্লাহ ইবনে উমার (রাঃ) থেকে বর্ণিত। তিনি বলেন, রাসূলুল্লাহ সাল্লাল্লাহু আলাইহি ওয়াসাল্লাম বলেছেনঃ যে ব্যক্তি দুনিয়াতে যশ লাভের উদ্দেশ্যে পোশাক পরে আল্লাহ কিয়ামতের দিন তাকে অপমানের পোশাক পরাবেন, অতঃপর তাতে অগ্নিসংযোগ করবেন।",
			"grades": [
				{
					"name": "Al-Albani",
					"grade": "Hasan"
				},
				{
					"name": "Muhammad Fouad Abd al-Baqi",
					"grade": "Hasan"
				},
				{
					"name": "Shuaib Al Arnaut",
					"grade": "Hasan"
				},
				{
					"name": "Zubair Ali Zai",
					"grade": "Hasan"
				}
			],
			"reference": {
				"book": 32,
				"hadith": 58
			}
		},
		{
			"hadithnumber": 3608,
			"arabicnumber": 3608,
			"text": "। আবূ যার (রাঃ) থেকে বর্ণিত। নবী সাল্লাল্লাহু আলাইহি ওয়াসাল্লাম বলেনঃ যে ব্যক্তি যশের পোশাক পরে, আল্লাহ তার প্রতি ভ্রুক্ষেপ করবেন না যাবত না তাকে যেখানে ইচ্ছা ফেলে রাখেন।",
			"grades": [
				{
					"name": "Al-Albani",
					"grade": "Daif"
				},
				{
					"name": "Muhammad Fouad Abd al-Baqi",
					"grade": "Daif"
				},
				{
					"name": "Shuaib Al Arnaut",
					"grade": "Daif"
				},
				{
					"name": "Zubair Ali Zai",
					"grade": "Daif"
				}
			],
			"reference": {
				"book": 32,
				"hadith": 59
			}
		},
		{
			"hadithnumber": 3609,
			"arabicnumber": 3609,
			"text": "। ইবনে আব্বাস (রাঃ) থেকে বর্ণিত। তিনি বলেন, আমি রাসূলুল্লাহ সাল্লাল্লাহু আলাইহি ওয়াসাল্লাম কে বলতে শুনেছিঃ যে কোন চামড়া প্রক্রিয়াজাত করা হলেই তা পাক হয়ে যায়।",
			"grades": [
				{
					"name": "Al-Albani",
					"grade": "Sahih"
				},
				{
					"name": "Muhammad Fouad Abd al-Baqi",
					"grade": "Sahih"
				},
				{
					"name": "Shuaib Al Arnaut",
					"grade": "Sahih"
				},
				{
					"name": "Zubair Ali Zai",
					"grade": "Sahih Muslim"
				}
			],
			"reference": {
				"book": 32,
				"hadith": 60
			}
		},
		{
			"hadithnumber": 3610,
			"arabicnumber": 3610,
			"text": "। মায়মূনা (রাঃ) থেকে বর্ণিত। তার মুক্তদাসীকে যাকাত থেকে একটা বকরী দান করেছিলেন। বকরিটি মারা গেলে তা ফেলে দেয়া হলো। নবী সাল্লাল্লাহু আলাইহি ওয়াসাল্লাম সেটির পাশ অতিক্রমকালে বলেনঃ এরা এর চামড়াটা খুলে নিলো না কেন, এটা প্রক্রিয়াজাত করে কাজে লাগাতে পারতো! সাহাবীগণ বলেন, হে আল্লাহর রাসূল! এটা তো মৃত। তিনি বলেনঃ মৃত জীব খাওয়া হারাম।",
			"grades": [
				{
					"name": "Al-Albani",
					"grade": "Sahih"
				},
				{
					"name": "Muhammad Fouad Abd al-Baqi",
					"grade": "Sahih"
				},
				{
					"name": "Shuaib Al Arnaut",
					"grade": "Sahih"
				},
				{
					"name": "Zubair Ali Zai",
					"grade": "Sahih Muslim"
				}
			],
			"reference": {
				"book": 32,
				"hadith": 61
			}
		},
		{
			"hadithnumber": 3611,
			"arabicnumber": 3611,
			"text": "। সালমান (রাঃ) থেকে বর্ণিত। তিনি বলেন, কোন এক উম্মুল মুমিনীনের একটি বকরী মারা গেল। রাসূলুল্লাহ সাল্লাল্লাহু আলাইহি ওয়াসাল্লাম সেটি অতিক্রমকালে বলেনঃ তারা এর চামড়াটা কাজে লাগালে তাদের কোন ক্ষতি হতো না।",
			"grades": [
				{
					"name": "Al-Albani",
					"grade": "Sahih"
				},
				{
					"name": "Muhammad Fouad Abd al-Baqi",
					"grade": "Sahih Lighairihi"
				},
				{
					"name": "Shuaib Al Arnaut",
					"grade": "Daif"
				},
				{
					"name": "Zubair Ali Zai",
					"grade": "Daif"
				}
			],
			"reference": {
				"book": 32,
				"hadith": 62
			}
		},
		{
			"hadithnumber": 3612,
			"arabicnumber": 3612,
			"text": "। আয়েশা (রাঃ) থেকে বর্ণিত। তিনি বলেন, রাসূলুল্লাহ সাল্লাল্লাহু আলাইহি ওয়াসাল্লাম চামড়া প্রক্রিয়াজাত করার পর তা কাজে লাগাতে নির্দেশ দিয়েছেন।",
			"grades": [
				{
					"name": "Al-Albani",
					"grade": "Daif"
				},
				{
					"name": "Muhammad Fouad Abd al-Baqi",
					"grade": "Daif"
				},
				{
					"name": "Zubair Ali Zai",
					"grade": "Hasan"
				}
			],
			"reference": {
