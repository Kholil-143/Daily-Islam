				"hadith": 512
			}
		},
		{
			"hadithnumber": 903,
			"arabicnumber": 903,
			"text": "। যিয়াদ ইবনু সুবাইহ আল-হানাফী (রহঃ) হতে বর্ণিত। তিনি বলেন, একদা আমি ইবনু ‘উমারের পাশে দাঁড়িয়ে সালাত আদায় করি এবং আমি আমার কোমরের দু’ পার্শ্বের উপর দু’ হাতের ভর করি। সালাত শেষে তিনি আমাকে বললেনঃ এটা হচ্ছে সালাতের শূলী। এমনটি করতে রাসূলুল্লাহ সাল্লাল্লাহু আলাইহি ওয়াসাল্লাম নিষেধ করেছেন।[1] সহীহ।",
			"grades": [
				{
					"name": "Al-Albani",
					"grade": "Sahih"
				},
				{
					"name": "Muhammad Muhyi Al-Din Abdul Hamid",
					"grade": "Sahih"
				},
				{
					"name": "Shuaib Al Arnaut",
					"grade": "Sahih Lighairihi"
				},
				{
					"name": "Zubair Ali Zai",
					"grade": "Isnaad Sahih"
				}
			],
			"reference": {
				"book": 2,
				"hadith": 513
			}
		},
		{
			"hadithnumber": 904,
			"arabicnumber": 904,
			"text": "। মুত্বাররিফ (রহঃ) হতে তার পিতার সূত্রে বর্ণিত। তিনি বলেন, আমি দেখেছি, রাসূলুল্লাহ সাল্লাল্লাহু আলাইহি ওয়াসাল্লাম সালাত আদায় করছিলেন এবং এ সময় তাঁর বুক থেকে যাঁতা পেষার আওয়াজের ন্যায় কান্নার আওয়াজ হচ্ছিল।[1] সহীহ।",
			"grades": [
				{
					"name": "Al-Albani",
					"grade": "Sahih"
				},
				{
					"name": "Muhammad Muhyi Al-Din Abdul Hamid",
					"grade": "Sahih"
				},
				{
					"name": "Shuaib Al Arnaut",
					"grade": "Sahih"
				},
				{
					"name": "Zubair Ali Zai",
					"grade": "Isnaad Sahih"
				}
			],
			"reference": {
				"book": 2,
				"hadith": 514
			}
		},
		{
			"hadithnumber": 905,
			"arabicnumber": 905,
			"text": "। যায়িদ ইবনু খালিদ আল-জুহানী (রাঃ) সূত্রে বর্ণিত। নবী সাল্লাল্লাহু আলাইহি ওয়াসাল্লাম বলেছেনঃ কেউ উত্তমরূপে অযু করে নির্ভুলভাবে দু’ রাক‘আত সালাত আদায় করলে তার পূর্বের সমস্ত গুনাহ ক্ষমা করে দয়ো হয়।[1] হাসান।",
			"grades": [
				{
					"name": "Al-Albani",
					"grade": "Hasan"
				},
				{
					"name": "Muhammad Muhyi Al-Din Abdul Hamid",
					"grade": "Hasan"
				},
				{
					"name": "Zubair Ali Zai",
					"grade": "Isnaad Hasan"
				}
			],
			"reference": {
				"book": 2,
				"hadith": 515
			}
		},
		{
			"hadithnumber": 906,
			"arabicnumber": 906,
			"text": "। ‘উক্ববাহ ইবনু ‘আমির আল-জুহানী (রাঃ) সূত্রে বর্ণিত। রাসূলুল্লাহ সাল্লাল্লাহু আলাইহি ওয়াসাল্লাম বলেছেনঃ কেউ উত্তমরূপে অযু করে একাগ্রচিত্তে খালিস অন্তরে দু’ রাক‘আত সালাত আদায় করলে তার জন্য জান্নাত ওয়াজিব হয়ে যায়।[1] সহীহ : মুসলিম।",
			"grades": [
				{
					"name": "Al-Albani",
					"grade": "Sahih"
				},
				{
					"name": "Muhammad Muhyi Al-Din Abdul Hamid",
					"grade": "Sahih"
				},
				{
					"name": "Zubair Ali Zai",
					"grade": "Sahih Muslim (169)"
				}
			],
			"reference": {
				"book": 2,
				"hadith": 516
			}
		},
		{
			"hadithnumber": 907,
			"arabicnumber": 907,
			"text": "। মিসওয়ার ইবনু ইয়াযীদ আল-মালিকী (রাঃ) সূত্রে বর্ণিত। একদা আমি রাসূলুল্লাহ সাল্লাল্লাহু আলাইহি ওয়াসাল্লাম-এর সাথে সালাত আদায় করি। সালাতের ক্বিরাআতে তাঁর পঠিত আয়াতের অংশ বিশেষ ভুলবশত ছুটে গেলে সালাত শেষে এক ব্যক্তি তাঁকে বললো, হে আল্লাহর রসূল! আপনি অমুক অমুক আয়াত ছেড়ে দিয়েছেন। রাসূলুল্লাহ সাল্লাল্লাহু আলাইহি ওয়াসাল্লাম তাকে বললেন, তুমি আমাকে তা স্মরণ করিয়ে দাওনি কেন? সুলাইমানের বর্ণনায় রয়েছেঃ আমি ভেবেছিলাম, তা মানসূখ হয়ে গেছে। হাসান। ইবনু ‘উমার (রাঃ) হতে বর্ণিত। তিনি বলেন, নবী সাল্লাল্লাহু আলাইহি ওয়াসাল্লাম কোন এক সালাতে ক্বিরাআত পাঠে আটকে গেলেন। সালাত শেষে তিনি উবাই ইবনু কা‘বকে বললেন, তুমি কি আমাদের সাথে সালাত আদায় করেছো? তিনি বললেন, হাঁ। রাসূলুল্লাহ সাল্লাল্লাহু আলাইহি ওয়াসাল্লাম বললেন, তোমাকে কিসে বাঁধা দিয়েছে (আমাকে আয়াত মনে করিয়ে দিতে)? [1] সহীহ।",
			"grades": [
