		},
		{
			"hadithnumber": 896,
			"arabicnumber": 896,
			"text": "। আবূ ইসহাক (রাঃ) সূত্রে বর্ণিত। তিনি বলেন, একদা বারাআ ইবনু ‘আযিব (রাঃ) আমাদের কাছে সাজদার পদ্ধতি বর্ণনা করতে গিয়ে তাঁর দু’ হাত মাটিতে রাখেন এবং হাঁটুর উপর ভর করে (সিজদাতে) পাছা উঁচু করে রাখেন, অতঃপর বলেন, রাসূলুল্লাহ সাল্লাল্লাহু আলাইহি ওয়াসাল্লাম এভাবে সিজদা্ করতেন।[1] দুর্বল।",
			"grades": [
				{
					"name": "Al-Albani",
					"grade": "Daif"
				},
				{
					"name": "Muhammad Muhyi Al-Din Abdul Hamid",
					"grade": "Daif"
				},
				{
					"name": "Shuaib Al Arnaut",
					"grade": "Daif"
				},
				{
					"name": "Zubair Ali Zai",
					"grade": "Daif"
				}
			],
			"reference": {
