					"name": "Al-Albani",
					"grade": "Sahih"
				},
				{
					"name": "Muhammad Muhyi Al-Din Abdul Hamid",
					"grade": "Sahih"
				},
				{
					"name": "Zubair Ali Zai",
					"grade": "Sahih Bukhari (735، 736، 738) Sahih Muslim (390)"
				}
			],
			"reference": {
				"book": 2,
				"hadith": 331
			}
		},
		{
			"hadithnumber": 722,
			"arabicnumber": 722,
			"text": "। ‘আব্দুল্লাহ ইবনু ‘উমার (রাঃ) সূত্রে বর্ণিত। তিনি বলেন, রাসূলুল্লাহ সাল্লাল্লাহু আলাইহি ওয়াসাল্লাম সালাতে দাঁড়ানোর সময় স্বীয় দু’ হাত কান পর্যন্ত উঠাতেন। তিনি তাকবীর বলে রুকু‘তে গমনকালেও দু’ হাত উপরে উঠাতেন। রুকু' থেকে উঠার সময়ও দু’ হাত কাঁধ পর্যন্ত উঠিয়ে ‘‘সামিআল্লাহু লিমান্ হামিদাহ্’’- বলতেন। তবে তিনি সিজদার সময় হাত উঠাতেন না। প্রত্যেক রুকুর জন্য তাকবীর বলার সময় দু’ হাত উঠাতেন এবং এভাবেই সালাত সম্পন্ন করতেন।[1] সহীহ।",
			"grades": [
				{
					"name": "Al-Albani",
					"grade": "Sahih"
				},
				{
					"name": "Muhammad Muhyi Al-Din Abdul Hamid",
