					"grade": "Hasan"
				}
			],
			"reference": {
				"book": 5,
				"hadith": 46
			}
		},
		{
			"hadithnumber": 1296,
			"arabicnumber": 1296,
			"text": "। আল-মুত্তালিব (রাঃ) সূত্রে বর্ণিত। নবী সাল্লাল্লাহু আলাইহি ওয়াসাল্লাম বলেনঃ সালাত দু’ রাক‘আত দু’ রাক‘আত করে আদায় করতে হয়। প্রত্যেক দু’ রাক‘আতে তোমার তাশাহহুদ পড়তে হবে। অতঃপর তুমি তোমার বিপদাপদ ও দারিদ্রের কথা দু’ হাত উঠিয়ে দু‘আ করবে, হে আল্লাহ! হে আল্লাহ! যে ব্যক্তি এরূপ করে না তার আচরণ হবে ক্রটিপূর্ণ।[1] ইমাম আবূ দাউদ (রহঃ)-কে রাতে দু’ রাক‘আত করে সালাত সম্বন্ধে জিজ্ঞেস করা হলে তিনি বলেন, তুমি ইচ্ছা করলে দু’ রাক‘আত আদায় করতে পারো, আবার ইচ্ছে হলে চার রাক‘আত করেও আদায় করতে পারো। দুর্বল।",
