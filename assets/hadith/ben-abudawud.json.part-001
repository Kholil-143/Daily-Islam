			}
		},
		{
			"hadithnumber": 900,
			"arabicnumber": 900,
			"text": "। রাসূলুল্লাহ সাল্লাল্লাহু আলাইহি ওয়াসাল্লাম-এর সাহাবী আহমার ইবনু জায’ (রাঃ) সূত্রে বর্ণিত। রাসূলুল্লাহ সাল্লাল্লাহু আলাইহি ওয়াসাল্লাম সিজদাতে তাঁর দু’ বাহুকে পার্শ্বদেশ থেকে বিছিন্ন করে রাখতেন এবং এ অবস্থা দেখে আমাদের করুণা সৃষ্টি হতো।[1] হাসান সহীহ।",
			"grades": [
				{
					"name": "Al-Albani",
					"grade": "Hasan Sahih"
				},
				{
					"name": "Muhammad Muhyi Al-Din Abdul Hamid",
					"grade": "Hasan Sahih"
				},
				{
					"name": "Shuaib Al Arnaut",
					"grade": "Sahih Lighairihi"
				},
				{
					"name": "Zubair Ali Zai",
					"grade": "Isnaad Hasan"
				}
			],
			"reference": {
				"book": 2,
				"hadith": 510
			}
		},
		{
			"hadithnumber": 901,
			"arabicnumber": 901,
			"text": "। আবূ হুরাইরাহ (রাঃ) সূত্রে বর্ণিত। নবী সাল্লাল্লাহু আলাইহি ওয়াসাল্লাম বলেছেনঃ তোমাদের কেউ সিজদা করার সময় যেন স্বীয় দু’ হাত কুকুরের ন্যায় বিছিয়ে না রাখে এবং দু’ উরু যেন মিলিয়ে রাখে।[1] দুর্বল।",
			"grades": [
