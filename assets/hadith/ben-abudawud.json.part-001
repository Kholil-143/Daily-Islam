			}
		},
		{
			"hadithnumber": 902,
			"arabicnumber": 902,
			"text": "। আবূ হুরাইরাহ (রাঃ) সূত্রে বর্ণিত। নবী সাল্লাল্লাহু আলাইহি ওয়াসাল্লাম-এর সাহাবীগণ নবী সাল্লাল্লাহু আলাইহি ওয়াসাল্লাম-এর কাছে তাদের সমস্যার কথা জানান যে, সিজদার সময় তারা হাতকে বগল থেকে এবং পেটকে উরু থেকে আলাদা করে রাখলে এতে তাদের কষ্টবোধ হয়। নবী সাল্লাল্লাহু আলাইহি ওয়াসাল্লাম বললেনঃ এক্ষেত্রে তোমরা হাঁটুর সাহায্য নাও।[1] দুর্বল।",
			"grades": [
				{
					"name": "Al-Albani",
					"grade": "Daif"
				},
				{
					"name": "Muhammad Muhyi Al-Din Abdul Hamid",
					"grade": "Daif"
				},
				{
					"name": "Zubair Ali Zai",
					"grade": "Daif"
				}
			],
			"reference": {
