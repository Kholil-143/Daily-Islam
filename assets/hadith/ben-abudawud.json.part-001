		{
			"hadithnumber": 1284,
			"arabicnumber": 1284,
			"text": "। তাঊস (রহঃ) সূত্রে বর্ণিত। তিনি বলেন, ইবনু ‘উমার রাযিয়াল্লাহু ‘আনহুমা-কে মাগরিবের পূর্বে দু’ রাক‘আত সালাত সম্পর্কে জিজ্ঞেস করা হলে তিনি বলেন, রাসূলুল্লাহ সাল্লাল্লাহু আলাইহি ওয়াসাল্লাম-এর যুগে আমি কাউকে এ সালাত আদায় করতে দেখিনি। তবে ‘আসরের পরে দু’ রাক‘আত সালাত আদায়ের অনুমতি আছে।[1] দুর্বল।",
			"grades": [
				{
					"name": "Al-Albani",
					"grade": "Daif"
				},
				{
					"name": "Muhammad Muhyi Al-Din Abdul Hamid",
					"grade": "Daif"
				},
				{
					"name": "Zubair Ali Zai",
					"grade": "Isnaad Hasan"
				}
			],
			"reference": {
