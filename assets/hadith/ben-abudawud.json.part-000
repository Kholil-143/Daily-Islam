					"name": "Al-Albani",
					"grade": "Hasan Sahih"
				},
				{
					"name": "Muhammad Muhyi Al-Din Abdul Hamid",
					"grade": "Hasan Sahih"
				},
				{
					"name": "Shuaib Al Arnaut",
					"grade": "Sahih Lighairihi"
				},
				{
					"name": "Zubair Ali Zai",
					"grade": "Isnaad Hasan"
				}
			],
			"reference": {
				"book": 2,
				"hadith": 263
			}
		},
		{
			"hadithnumber": 654,
			"arabicnumber": 654,
			"text": "। আবূ হুরাইরাহ্ (রাঃ) সূত্রে বর্ণিত। রাসূলুল্লাহ সাল্লাল্লাহু আলাইহি ওয়াসাল্লাম বলেছেনঃ তোমাদের কেউ যেন সালাত আদায়কালে জুতা খুলে তার ডান পাশে ও বাম পাশে না রাখে। কারণ তা অন্যের ডান পাশে হবে। অবশ্য বাম পাশে কেউ না থাকলে (রাখতে পারবে)। তবে জুতাজোড়া উভয় পায়ের মধ্যখানে রাখাই শ্রেয়।[1] হাসান সহীহ।",
			"grades": [
				{
					"name": "Al-Albani",
					"grade": "Hasan Sahih"
				},
				{
					"name": "Muhammad Muhyi Al-Din Abdul Hamid",
					"grade": "Hasan Sahih"
				},
				{
					"name": "Shuaib Al Arnaut",
					"grade": "Hasan"
				},
				{
					"name": "Zubair Ali Zai",
					"grade": "Sahih"
				}
			],
			"reference": {
				"book": 2,
				"hadith": 264
			}
		},
		{
			"hadithnumber": 655,
			"arabicnumber": 655,
			"text": "। আবূ হুরাইরাহ্ (রাঃ) সূত্রে বর্ণিত। রাসূলুল্লাহ সাল্লাল্লাহু আলাইহি ওয়াসাল্লাম বলেছেনঃ তোমাদের কেউ সালাত আদায়কালে জুতা খুলে যেন এমন জায়গায় না রাখে যাতে অন্যের কষ্ট হয়। বরং জুতাজোড়া যেন দু’ পায়ের মাঝখানে রেখে দেয় অথবা তা পরেই সালাত আদায় করে।[1] সহীহ।",
			"grades": [
				{
					"name": "Al-Albani",
					"grade": "Sahih"
				},
				{
					"name": "Muhammad Muhyi Al-Din Abdul Hamid",
					"grade": "Sahih"
				},
				{
					"name": "Zubair Ali Zai",
					"grade": "Isnaad Sahih"
				}
			],
			"reference": {
				"book": 2,
