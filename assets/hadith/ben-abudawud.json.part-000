	"hadiths": [
		{
			"hadithnumber": 1,
			"arabicnumber": 1,
			"text": "। মুগীরাহ ইবনু শু’বাহ (রাঃ) সূত্রে বর্ণিত। নবী সাল্লাল্লাহু আলাইহি ওয়াসাল্লাম পায়খানার উদ্দেশ্যে দূরে চলে যেতেন।[1] হাসান সহীহ।",
			"grades": [
				{
					"name": "Al-Albani",
					"grade": "Hasan Sahih"
				},
				{
					"name": "Muhammad Muhyi Al-Din Abdul Hamid",
					"grade": "Hasan Sahih"
				},
				{
					"name": "Shuaib Al Arnaut",
					"grade": "Sahih Lighairihi"
				},
				{
					"name": "Zubair Ali Zai",
					"grade": "Isnaad Hasan"
				}
			],
			"reference": {
				"book": 1,
				"hadith": 1
			}
		},
		{
			"hadithnumber": 2,
			"arabicnumber": 2,
			"text": "। জাবির ইবনু ‘আবদুল্লাহ (রাঃ) সূত্রে বর্ণিত। নবী সাল্লাল্লাহু আলাইহি ওয়াসাল্লাম পায়খানার উদ্দেশে দূরে চলে যেতেন, যেন তাঁকে কেউ দেখতে না পায়।[1] সহীহ।",
			"grades": [
				{
					"name": "Al-Albani",
					"grade": "Sahih"
				},
				{
					"name": "Muhammad Muhyi Al-Din Abdul Hamid",
					"grade": "Sahih"
				},
				{
					"name": "Shuaib Al Arnaut",
					"grade": "Sahih Lighairihi"
				},
				{
					"name": "Zubair Ali Zai",
					"grade": "Daif"
				}
			],
			"reference": {
				"book": 1,
				"hadith": 2
			}
		},
		{
			"hadithnumber": 3,
			"arabicnumber": 3,
			"text": "। আবুত্ তাইয়্যাহ্ বর্ণনা করেন, জনৈক শায়খ আমাকে বলেছেন, ‘আবদুল্লাহ ইবনু ‘আব্বাস (রাঃ) যখন বসরাতে আগমন করলেন, তখন তার নিকট আবূ মূসা (রাঃ)-এর সূত্রে হাদীস বর্ণনা করা হয়। ‘আবদুল্লাহ (রাঃ) কিছু বিষয় জানতে চেয়ে আবূ মূসার (রাঃ) নিকট চিঠি লিখলেন। উত্তরে আবূ মূসা (রাঃ) তাকে লিখলেন, একদিন আমি রাসূলুল্লাহ সাল্লাল্লাহু আলাইহি ওয়াসাল্লাম-এর সঙ্গে ছিলাম। তিনি পেশাব করার ইচ্ছা করলেন। অতঃপর তিনি একটি দেয়ালের গোড়ার নরম মাটিতে গিয়ে পেশাব করলেন। এরপর তিনি বললেন, ‘তোমাদের কেউ পেশাব করতে চাইলে যেন নীচু নরম জায়গা অনুসন্ধান করে নেয়।’[1] দুর্বল : যঈফ আল-জামি‘উস সাগীর ৩১৯, মিশকাত ৩৪৫।",
			"grades": [
				{
					"name": "Al-Albani",
					"grade": "Daif"
				},
				{
					"name": "Muhammad Muhyi Al-Din Abdul Hamid",
					"grade": "Daif"
				},
				{
					"name": "Shuaib Al Arnaut",
					"grade": "Daif"
				},
				{
					"name": "Zubair Ali Zai",
					"grade": "Daif"
				}
			],
			"reference": {
				"book": 1,
				"hadith": 3
			}
		},
		{
			"hadithnumber": 4,
			"arabicnumber": 4,
			"text": "। আনাস ইবনু মালিক (রাঃ) সূত্রে বর্ণিত। তিনি বলেন, রাসূলুল্লাহ সাল্লাল্লাহু আলাইহি ওয়াসাল্লাম যখন পায়খানায় প্রবেশ করতেন, হাম্মাদের বর্ণনা মতে, তখন তিনি বলতেনঃ ‘‘হে আল্লাহ! আমি আপনার কাছে আশ্রয় প্রার্থনা করছি।’’ আর ‘আবদুল ওয়ারিসের বর্ণনা মতে, তিনি বলতেনঃ ‘‘আমি আল্লাহর কাছেআশ্রয় চাইছি শাইত্বানদের থেকে ও যাবতীয় অপবিত্রতা থেকে।’’[1] সহীহ : বুখারী- ১৪২ ও মুসলিম, হায়িয অধ্যায়- ১২২, তিরমিযী- ৫, নাসাঈ- ১৯। قَالَ أَبُو دَاوُدَ: رَوَاهُ شُعْبَةُ، عَنْ عَبْدِ الْعَزِيزِ: \"اللَّهُمَّ إِنِّي أَعُوذُ بِكَ\"، وَقَالَ مَرَّةً: \"أَعُوذُ بِاللهِ\"، وَقَالَ وُهَيْبٌ: \"فَلْيَتَعَوَّذْ بِاللهِ\". ইমাম আবূ দাঊদ (রহঃ) বলেন, শু‘বাহ আব্দুল আযীয থেকে বর্ণনা করেনঃ ‘‘হে আল্লাহ আমি তোমার কাছে আশ্রয় চাচ্ছি।’’ আরেক বর্ণনায় তিনি বলেনঃ আমি আল্লাহর কাছে আশ্রয় চাচ্ছি।",
			"grades": [
				{
					"name": "Al-Albani",
					"grade": "Sahih"
				},
				{
					"name": "Muhammad Muhyi Al-Din Abdul Hamid",
					"grade": "Sahih"
				},
				{
					"name": "Shuaib Al Arnaut",
					"grade": "Sahih"
				},
				{
					"name": "Zubair Ali Zai",
					"grade": "Sahih Bukhari (142) Sahih Muslim (375)"
				}
			],
			"reference": {
				"book": 1,
				"hadith": 4
			}
		},
		{
			"hadithnumber": 5,
			"arabicnumber": 5,
			"text": "। ‘আবদুল ‘আযীয ইবনু সুহাইব (রহঃ) আনাস (রাঃ) সূত্রে পূর্বোক্ত হাদীস বর্ণনা করেছেন। তাতে ‘হে আল্লাহ! আমি আপনার কাছে আশ্রয় প্রার্থনা করছি’ কথাটি রয়েছে। শু’বাহ আবদুল আজিজ সুত্রে বলেন, তিনি একবার ‘আউযুবিল্লাহ’ বলেছেন। আর আবদুল আযীয সুত্রে উহাইব বর্ণনা করেছেন যে, তাতে 'সে যেন আল্লাহর কাছে আশ্রয় প্রার্থনা করে' কথাটি রয়েছে।[1] শাজ।",
			"grades": [
				{
					"name": "Al-Albani",
					"grade": "Shadh"
				},
				{
					"name": "Muhammad Muhyi Al-Din Abdul Hamid",
					"grade": "Shadh"
				},
				{
					"name": "Zubair Ali Zai",
					"grade": "Isnaad Sahih"
				}
			],
			"reference": {
