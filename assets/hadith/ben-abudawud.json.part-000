					"grade": "Sahih Muslim (305)"
				}
			],
			"reference": {
				"book": 1,
				"hadith": 222
			}
		},
		{
			"hadithnumber": 223,
			"arabicnumber": 223,
			"text": "। ইউনুস হতে যুহরী সূত্রে একই সানাদে সমার্থবোধক হাদীস বর্ণিত আছে। তাতে একথাও রয়েছেঃ নাপাক অবস্থায় তিনি খাওয়ার ইচ্ছা করলে তাঁর উভয় হাত ধুয়ে নিতেন। [1] সহীহ। ইমাম আবূ দাউদ (রহঃ) বলেন, ইউনুস থেকে ইবনু ওয়াহ্ব এ হাদীসটিই বর্ণনা করেছেন। তবে তিনি খাওয়ার কথাটা ‘আয়িশাহ্ (রাঃ)-এর বক্তব্য বলে উল্লেখ করেছেন।",
			"grades": [
