			}
		},
		{
			"hadithnumber": 6,
			"arabicnumber": 6,
			"text": "। যায়িদ ইবনু আরক্বাম (রাঃ) সূত্র থেকে বর্ণিত। তিনি রাসূলুল্লাহ সাল্লাল্লাহু আলাইহি ওয়াসাল্লাম থেকে বর্ণনা করেছেন। তিনি বলেন, সাধারণতঃ পায়খানার স্থানে শয়তান এসে থাকে। সুতরাং তোমাদের কেউ পায়খানায় প্রবেশকালে যেন বলেঃ ‘‘আমি আল্লাহর কাছে শাইত্বান ও যাবতীয় অপবিত্রতা হতে আশ্রয় চাইছি।’’[1] সহীহ; ইবনু মাজাহ- ২৯৬।",
			"grades": [
				{
					"name": "Al-Albani",
					"grade": "Sahih"
				},
				{
					"name": "Muhammad Muhyi Al-Din Abdul Hamid",
					"grade": "Sahih"
				},
				{
					"name": "Zubair Ali Zai",
					"grade": "Isnaad Sahih"
				}
			],
			"reference": {
				"book": 1,
				"hadith": 6
			}
