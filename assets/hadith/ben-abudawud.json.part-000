			}
		},
		{
			"hadithnumber": 546,
			"arabicnumber": 546,
			"text": "। ‘আব্দুল্লাহ ইবনু ইসহাক হতে.... ‘আলী ইবনু আবূ তালিব (রাঃ) সূত্রে এই সানাদে পূর্বানুরূপ হাদীস বর্ণিত হয়েছে।",
			"grades": [
				{
					"name": "Al-Albani",
					"grade": "Daif"
				},
				{
					"name": "Muhammad Muhyi Al-Din Abdul Hamid",
					"grade": "Daif"
				},
				{
					"name": "Zubair Ali Zai",
					"grade": "Daif"
