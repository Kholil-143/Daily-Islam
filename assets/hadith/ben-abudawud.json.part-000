					"name": "Al-Albani",
					"grade": "Daif"
				},
				{
					"name": "Muhammad Muhyi Al-Din Abdul Hamid",
					"grade": "Daif"
				},
				{
					"name": "Shuaib Al Arnaut",
					"grade": "Daif"
				},
				{
					"name": "Zubair Ali Zai",
					"grade": "Daif"
				}
			],
			"reference": {
				"book": 2,
				"hadith": 68
			}
		},
		{
			"hadithnumber": 459,
			"arabicnumber": 459,
			"text": "। আবূ সালিহ সূত্রে বর্ণিত। তিনি বলেন, কথিত আছে, কোন ব্যক্তি যখন মাসজিদ থেকে পাথর কুচি বাইরে নিয়ে যায়, তখন সেগুলো তাকে শপথ দিতে থাকে (এবং বলতে থাকে, আমাদেরকে মাসজিদ থেকে বের করো না)।[1] সহীহ মাক্বতূ।",
			"grades": [
