					"name": "Zubair Ali Zai",
					"grade": "Sahih Bukhari (536) Sahih Muslim (615)"
				}
			],
			"reference": {
				"book": 2,
				"hadith": 12
			}
		},
		{
			"hadithnumber": 403,
			"arabicnumber": 403,
			"text": "। জাবির ইবনু সামুরাহ (রাঃ) সূত্রে বর্ণিত। সূর্য (পশ্চিম আকাশে) ঢলে পড়লে বিলাল (রাঃ) যুহরের সালাতের আযান দিতেন। [1] হাসান সহীহ : মুসলিম।",
			"grades": [
				{
					"name": "Al-Albani",
					"grade": "Hasan Sahih"
				},
				{
					"name": "Muhammad Muhyi Al-Din Abdul Hamid",
					"grade": "Hasan Sahih"
				},
				{
					"name": "Shuaib Al Arnaut",
					"grade": "Sahih Lighairihi"
				},
				{
					"name": "Zubair Ali Zai",
					"grade": "Isnaad Sahih Sahih Muslim"
				}
			],
			"reference": {
