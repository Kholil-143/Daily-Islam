			"hadithnumber": 2484,
			"arabicnumber": 2484,
			"text": "। ‘ইমরান ইবনু হুসাইন (রাঃ) সূত্রে বর্ণিত। তিনি বলেন, রাসূলুল্লাহ সাল্লাল্লাহু আলাইহি ওয়াসাল্লাম বলেছেনঃ আমার উম্মাতের একটি দল সর্বদা সত্যের পক্ষে জিহাদ করতে থাকবে এবং তাদের শত্রুদের বিরুদ্ধে বিজয়ী হবে। অবশেষে তাদের সর্বশেষ দলটি ঈসা (আঃ)-এর নেতৃত্বে দাজ্জালের বিরুদ্ধে জিহাদ করবে।",
			"grades": [
				{
					"name": "Al-Albani",
					"grade": "Sahih"
				},
				{
					"name": "Muhammad Muhyi Al-Din Abdul Hamid",
					"grade": "Sahih"
				},
				{
					"name": "Zubair Ali Zai",
					"grade": "Sahih"
				}
			],
			"reference": {
