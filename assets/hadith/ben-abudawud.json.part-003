			}
		},
		{
			"hadithnumber": 2505,
			"arabicnumber": 2505,
			"text": "। ইবনু ‘আব্বাস (রাঃ) সূত্রে বর্ণিত। তিনি বলেন, (মহান আল্লাহর বাণীঃ) ‘‘তোমরা যুদ্ধের জন্য বের না হলে তিনি তোমাদেরকে পীড়াদায়ক শাস্তি দিবেন ... (সূরা আত-তওবাঃ আয়াত ৩৬) ‘‘মদীনার অধিবাসী... তারা যা করে’’ পর্যন্ত (সূরা আত-তওবাঃ ১২০-১২১) উল্লিখিত আয়াতগুলোর হুকুম নিম্নের আয়াত দ্বারা মানসুখ হয়েছেঃ ‘‘সকল মুমিনের একসঙ্গে বের হওয়া জরুরী নয়...। (সূরা আত-তওবাঃ)",
			"grades": [
				{
					"name": "Al-Albani",
					"grade": "Hasan"
				},
				{
					"name": "Muhammad Muhyi Al-Din Abdul Hamid",
					"grade": "Hasan"
				},
				{
					"name": "Zubair Ali Zai",
					"grade": "Isnaad Hasan"
				}
			],
			"reference": {
