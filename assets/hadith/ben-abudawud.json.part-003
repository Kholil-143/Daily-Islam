					"grade": "Sahih"
				}
			],
			"reference": {
				"book": 18,
				"hadith": 20
			}
		},
		{
			"hadithnumber": 2882,
			"arabicnumber": 2882,
			"text": "। ইবনু ‘আব্বাস (রাঃ) সূত্রে বর্ণিত। এক ব্যক্তি বললো, হে আল্লাহর রাসূল! আমার মা মারা গেছেন। আমি তার পক্ষ থেকে দান-খয়রাত করলে এতে তার কোনো উপকার হবে কি? তিনি বললেনঃ হ্যাঁ। সে বললো, আমার একটি বাগান আছে। আমি আপনাকে সাক্ষী রেখে বাগানটি তার কল্যাণের জন্য দান করে দিলাম।",
			"grades": [
				{
					"name": "Al-Albani",
					"grade": "Sahih"
				},
				{
					"name": "Muhammad Muhyi Al-Din Abdul Hamid",
					"grade": "Sahih"
				},
				{
					"name": "Shuaib Al Arnaut",
					"grade": "Sahih"
				},
				{
					"name": "Zubair Ali Zai",
					"grade": "Sahih Bukhari (2770)"
				}
			],
			"reference": {
				"book": 18,
				"hadith": 21
			}
		},
		{
			"hadithnumber": 2883,
			"arabicnumber": 2883,
			"text": "। ‘আমর ইবনু শু‘আইব (রহঃ) থেকে পর্যায়ক্রমে তার পিতা ও তার দাদার সূত্রে বর্ণিত। আল-আস ইবনু ওয়াইল তার পক্ষ থেকে একশো গোলাম আযাদ করার ওসিয়াত করেন। তার এক ছেলে হিশাম পঞ্চাশটি গোলাম আযাদ করেন। পরে আরেক ছেলে ‘আমর (আঃ) বাকি পঞ্চাশটি আযাদ করার ইচ্ছা করেন। তিনি বিষয়টি রাসূলুল্লাহ সাল্লাল্লাহু আলাইহি ওয়াসাল্লাম-কে জিজ্ঞেস করার মনস্থ করেন। অতঃপর নবী সাল্লাল্লাহু আলাইহি ওয়াসাল্লাম-এর কাছে এসে তিনি বলেন, হে আল্লাহর রাসূল! আমার পিতা তার পক্ষ থেকে একশো গোলাম আযাদ করার ওসিয়াত করে যান। হিশাম পঞ্চাশটি গোলাম আযাদ করেছে, এখনও পঞ্চাশটি আযাদ করা বাকি আছে। আমি কি তার পক্ষ থেকে তা আযাদ করবো? রাসূলুল্লাহ সাল্লাল্লাহু আলাইহি ওয়াসাল্লাম বললেনঃ সে যদি মুসলিম হতো, তাহলে তোমরা তার পক্ষ থেকে তা আযাদ করলে বা সাদাকাহ করলে কিংবা হজ (হজ্জ) করলে তার কাছে এর সওয়াব পৌঁছতো।",
