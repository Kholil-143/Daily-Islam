					"name": "Al-Albani",
					"grade": "Hasan"
				},
				{
					"name": "Muhammad Muhyi Al-Din Abdul Hamid",
					"grade": "Hasan"
				},
				{
					"name": "Shuaib Al Arnaut",
					"grade": "Hasan"
				},
				{
					"name": "Zubair Ali Zai",
					"grade": "Isnaad Hasan"
				}
			],
			"reference": {
				"book": 16,
				"hadith": 55
			}
		},
		{
			"hadithnumber": 2843,
			"arabicnumber": 2843,
			"text": "। বুরাইদাহ (রাঃ) সূত্রে বর্ণিত। তিনি বলেন, জাহিলী যুগে আমাদের কারো সন্তান জন্মগ্রহণ করলে সে একটি বকরী যবাহ করতো এবং শিশুর মাথায় ঐ পশুর রক্ত মেখে দিতো। অতঃপর আল্লাহ যখন দীনে ইসলাম আনলেন, ‘আমরা বকরী যবাহ করতাম, শিশুর মাথা মুন্ডন করতাম এবং তাতে যা‘ফরান মাখতাম।",
			"grades": [
				{
					"name": "Al-Albani",
					"grade": "Hasan Sahih"
				},
				{
					"name": "Muhammad Muhyi Al-Din Abdul Hamid",
					"grade": "Hasan Sahih"
				},
				{
					"name": "Shuaib Al Arnaut",
					"grade": "Sahih Lighairihi"
				},
				{
					"name": "Zubair Ali Zai",
					"grade": "Isnaad Hasan"
				}
			],
			"reference": {
				"book": 16,
				"hadith": 56
			}
		},
		{
			"hadithnumber": 2844,
			"arabicnumber": 2844,
			"text": "। আবূ হুরাইরাহ (রাঃ) সূত্রে বর্ণিত। নবী সাল্লাল্লাহু আলাইহি ওয়াসাল্লাম বলেনঃ যে ব্যক্তি পশুদের রক্ষণাবেক্ষণ শিকার কিংবা কৃষিক্ষেতের পাহারার উদ্দেশ্যে ছাড়া অন্য কোনো উদ্দেশ্যে কুকুর পোষে, তার সাওয়াব থেকে প্রত্যহ এক ক্বীরাত করে বিয়োগ করা হবে।",
