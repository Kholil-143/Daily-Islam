		{
			"hadithnumber": 2600,
			"arabicnumber": 2600,
			"text": "। কাযা‘আহ (রহঃ) সূত্রে বর্ণিত। তিনি বলেন, ইবনু ‘উমার (রাঃ) আমাকে বললেন, এসো তোমাকে ঐভাবে বিদায় জানাই, যেভাবে রাসূলুল্লাহ সাল্লাল্লাহু আলাইহি ওয়াসাল্লাম আমাকে বিদায় দিয়েছেনঃ ‘‘আমি আল্লাহর নিকট তোমার দীন, আমানাত ও সর্বশেষ আমলের হিফাযাতের জন্য দু‘আ করছি।",
			"grades": [
				{
					"name": "Al-Albani",
					"grade": "Sahih"
				},
				{
					"name": "Muhammad Muhyi Al-Din Abdul Hamid",
