				},
				{
					"name": "Zubair Ali Zai",
					"grade": "Daif"
				}
			],
			"reference": {
				"book": 15,
				"hadith": 133
			}
		},
		{
			"hadithnumber": 2610,
			"arabicnumber": 2610,
			"text": "। নাফি‘ (রহঃ) সূত্রে বর্ণিত। ‘আব্দুল্লাহ ইবনু ‘উমার (রাঃ) বলেন, রাসূলুল্লাহ সাল্লাল্লাহু আলাইহি ওয়াসাল্লাম কুরআন সাথে নিয়ে শত্রু এলাকায় সফর করতে নিষেধ করেছেন। (মধ্যবর্তী বর্ণনাকারী) মালিক বলেন, আমার ধারণা শত্রুর হাতে পড়ে কুরআন অবমাননার আশঙ্কায় তিনি (সাল্লাল্লাহু আলাইহি ওয়াসাল্লাম) এ নিষেধ করেছেন।",
			"grades": [
				{
					"name": "Al-Albani",
					"grade": "Sahih"
				},
				{
					"name": "Muhammad Muhyi Al-Din Abdul Hamid",
					"grade": "Sahih"
				},
				{
					"name": "Shuaib Al Arnaut",
					"grade": "Sahih"
				},
				{
					"name": "Zubair Ali Zai",
					"grade": "Sahih Bukhari (2990) Sahih Muslim (1869)"
				}
			],
			"reference": {
				"book": 15,
