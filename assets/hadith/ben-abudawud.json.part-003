			}
		},
		{
			"hadithnumber": 2235,
			"arabicnumber": 2235,
			"text": "। ‘আয়িশাহ্ (রাঃ) সূত্রে বর্ণিত। যখন বারীরাহকে আযাদ করে দেয়া হয় তখন তার স্বামী ছিলো আযাদ এবং তাকে এখতিয়ার দেয়া হলে সে বলে, তার সাথে বসবাসের কোনো আকর্ষণ আমার নেই, যদিও আমাকে এতো এতো কিছু দেয়া হয়।[1] সহীহ। বুখারী। আর ‘স্বামী আযাদ হওয়ার’ কথাটি মুদরাজ। যা আসওয়াদের উক্তি থেকে এসেছে।",
			"grades": [
				{
					"name": "Al-Albani",
					"grade": "Sahih"
				},
				{
					"name": "Muhammad Muhyi Al-Din Abdul Hamid",
					"grade": "Sahih"
				},
				{
					"name": "Shuaib Al Arnaut",
					"grade": "Hasan Sahih"
				},
				{
					"name": "Zubair Ali Zai",
					"grade": "Daif"
				}
			],
			"reference": {
