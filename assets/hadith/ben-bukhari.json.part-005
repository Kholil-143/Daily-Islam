		},
		{
			"hadithnumber": 2922,
			"arabicnumber": 2922,
			"text": "আনাস (রাঃ) হতে বর্ণিত যে, শরীরে চুলকানী থাকার কারণে তাদের দু’জনকে (আবদুর রাহমান ও যুবায়রকে) রেশমী পোষাক পরার অনুমতি দিয়েছিলেন বা দেয়া হয়েছিল। (২৯১৯) (আধুনিক প্রকাশনীঃ ২৭০৭, ইসলামিক ফাউন্ডেশনঃ)",
			"grades": [],
			"reference": {
				"book": 56,
				"hadith": 135
