					"grade": "Hasan"
				}
			],
			"reference": {
				"book": 23,
				"hadith": 31
			}
		},
		{
			"hadithnumber": 2466,
			"arabicnumber": 2466,
			"text": "আমর ইবনু মানসূর (রহঃ) ও মাহমুদ ইবন গায়লান (রহঃ) ... আবদুল্লাহ ইবন হিলাল সাকাফী (রাঃ) থেকে বর্ণিত। তিনি বলেন। এক ব্যক্তি নবী সাল্লাল্লাহু আলাইহি ওয়াসাল্লাম এর কাছে এসে বলল, আপনার তিরোধানের পরে শীঘ্রই আমাকে যাকাতের উট এবং বকরীর জন্য হত্যা করা হবে, (যাকাতের ব্যাপারে আপনার জীবদ্দশায়ই যখন এত কড়াকড়ি, না জানি আপনার তিরোধানের পর কত কড়াকড়ি করা হয়) রাসূলুল্লাহ্ সাল্লাল্লাহু আলাইহি ওয়াসাল্লাম বললেন, যদি সেগুলো গরীব মুহাজিরদের মাঝে দান করে দেওয়া না হত, তাহলে সেগুলো আমি গ্রহণই করতাম না।",
