			}
		},
		{
			"hadithnumber": 3113,
			"arabicnumber": 3113,
			"text": "আমর ইবন আলী (রহঃ) ... আবূ হুরায়রা (রাঃ) সূত্রে নবী সাল্লাল্লাহু আলাইহি ওয়াসাল্লাম থেকে বর্ণিত। তিনি বলেন, আল্লাহর রাস্তার ধূলা এবং জাহান্নামের ধোঁয়া কোন মুসলিমের নাকের ছিদ্রে প্রবেশ করবে না।",
			"grades": [
				{
					"name": "Abu Ghuddah",
					"grade": "Sahih"
