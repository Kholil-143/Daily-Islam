			}
		},
		{
			"hadithnumber": 2976,
			"arabicnumber": 2976,
			"text": "মাহমূদ ইবন গায়লান (রহঃ) ... কাসীর ইবন জুমহান (রহঃ) বলেনঃ আমি ইবন উমর (রাঃ)-কে দেখেছি তিনি সাফা ও মারওয়ার মধ্যস্থলে হাঁটছেন, তিনি বলেন, যদি আমি হেঁটে চলি, তা এজন্য যে, আমি রাসূলুল্লাহ সাল্লাল্লাহু আলাইহি ওয়াসাল্লাম-কে হাঁটতে দেখেছি। আর যদি আমি দ্রুত চলি, তা এজন্য যে, আমি রাসূলুল্লাহ সাল্লাল্লাহু আলাইহি ওয়াসাল্লাম-কে দ্রুত চলতে দেখেছি।",
			"grades": [
				{
					"name": "Abu Ghuddah",
					"grade": "Sahih"
				},
				{
					"name": "Al-Albani",
					"grade": "Sahih"
				},
				{
					"name": "Zubair Ali Zai",
					"grade": "Hasan"
				}
			],
			"reference": {
				"book": 24,
				"hadith": 359
			}
		},
		{
			"hadithnumber": 2977,
			"arabicnumber": 2977,
			"text": "মুহাম্মদ ইবন রাফি (রহঃ) ... সাঈদ ইবন জুবায়র (রহঃ) বলেন, আমি ইবন উমর (রাঃ)-কে দেখেছি, এরপর তিনি পূর্ব হাদীসের মত উল্লেখ করেন। তবে তিনি অতিরিক্ত বলেনঃ আর আমি তখন ছিলাম বৃদ্ধ ।",
			"grades": [
				{
					"name": "Abu Ghuddah",
					"grade": "Sahih"
				},
				{
					"name": "Al-Albani",
					"grade": "Sahih"
				},
				{
					"name": "Zubair Ali Zai",
					"grade": "Isnaad Sahih"
				}
			],
			"reference": {
				"book": 24,
				"hadith": 360
			}
		},
		{
			"hadithnumber": 2978,
			"arabicnumber": 2978,
			"text": "মুহাম্মদ ইবন মানসূর (রহঃ) ... যুহরী (রহঃ) থেকে বর্ণিত। তিনি বলেন, লোকেরা ইবন উমর (রাঃ)-কে জিজ্ঞাসা করলোঃ আপনি কি রাসূলুল্লাহ সাল্লাল্লাহু আলাইহি ওয়াসাল্লাম-কে সাফা ও মারওয়ার মধ্যস্থলে রমল করতে দেখেছেন? তিনি বলেনঃ রাসূলুল্লাহসাল্লাল্লাহু আলাইহি ওয়াসাল্লাম ছিলেন একদল লোকের মধ্যে তারা সকলেই রমল করেন, আমি তাদের সকলকে রাসূলুল্লাহ সাল্লাল্লাহু আলাইহি ওয়াসাল্লাম-এর রমলের অনুকরণেই রমল করতে দেখেছি।",
			"grades": [
				{
					"name": "Abu Ghuddah",
					"grade": "Daif Isnaad"
				},
				{
					"name": "Al-Albani",
					"grade": "Daif Isnaad"
				},
				{
					"name": "Zubair Ali Zai",
					"grade": "Daif"
				}
			],
			"reference": {
				"book": 24,
				"hadith": 361
			}
		},
		{
			"hadithnumber": 2979,
			"arabicnumber": 2979,
			"text": "আবু আম্মার হুসায়ন ইন হুরায়স (রহঃ) ... ইবন আব্বাস (রাঃ) থেকে বর্ণিত। তিনি বলেন, রাসূলুল্লাহ সাল্লাল্লাহু আলাইহি ওয়াসাল্লাম সাফা ও মারওয়ার মধ্যে সাঈ করেন মুশরিকদেরকে তার শক্তি প্রদর্শনের জন্য।",
			"grades": [
				{
					"name": "Abu Ghuddah",
					"grade": "Sahih"
				},
				{
					"name": "Al-Albani",
					"grade": "Sahih"
				},
				{
					"name": "Zubair Ali Zai",
					"grade": "Sahih - Agreed Upon"
				}
			],
			"reference": {
				"book": 24,
				"hadith": 362
			}
		},
		{
			"hadithnumber": 2980,
			"arabicnumber": 2980,
			"text": "কুতায়বা (রহঃ) ... জনৈক মহিলা থেকে বর্ণিত যে, আমি রাসূলুল্লাহ্ সাল্লাল্লাহু আলাইহি ওয়াসাল্লাম-কে বাতনে মাসীলে সাঈ করতে দেখেছি। তিনি বলছিলেনঃ এই উপত্যকা দ্রুতগতিতে অতিক্রম করতে হয়।",
			"grades": [
				{
					"name": "Abu Ghuddah",
					"grade": "Sahih"
				},
				{
					"name": "Al-Albani",
					"grade": "Sahih"
				},
				{
					"name": "Zubair Ali Zai",
					"grade": "Isnaad Sahih"
				}
			],
			"reference": {
				"book": 24,
				"hadith": 363
			}
		},
		{
			"hadithnumber": 2981,
			"arabicnumber": 2981,
			"text": "মুহাম্মদ ইবন সালমা ও হারিস ইবন মিসকীন (রহঃ) ... জাবির ইবন আবদুল্লাহ (রাঃ) থেকে বর্ণিত যে, রাসূলুল্লাহ সাল্লাল্লাহু আলাইহি ওয়াসাল্লাম যখন সাফা থেকে অবতরণ করতেন তখন হাঁটতেন, এমনকি তার পদদ্বয় বাতনে ওয়াদীতে নামার পর তিনি সাঈ করে তা হতে বের হতেন।",
			"grades": [
				{
					"name": "Abu Ghuddah",
					"grade": "Sahih"
				},
				{
					"name": "Al-Albani",
					"grade": "Sahih"
				},
				{
					"name": "Zubair Ali Zai",
					"grade": "Isnaad Sahih"
				}
			],
			"reference": {
				"book": 24,
				"hadith": 364
			}
		},
		{
			"hadithnumber": 2982,
			"arabicnumber": 2982,
			"text": "মুহাম্মাদ ইবন মুসান্না (রহঃ) ... জাবির (রাঃ) থেকে বর্ণিত। তিনি বলেন, রাসূলুল্লাহ সাল্লাল্লাহু আলাইহি ওয়াসাল্লাম এর পদদ্বয় বাতনে উপত্যকায় পৌছলে, তখন তিনি রমল করতে করতে তা থেকে বের হয়ে যান।",
			"grades": [
				{
					"name": "Abu Ghuddah",
					"grade": "Sahih"
				},
				{
					"name": "Al-Albani",
					"grade": "Sahih"
				},
				{
					"name": "Zubair Ali Zai",
					"grade": "Hasan"
				}
			],
			"reference": {
				"book": 24,
				"hadith": 365
			}
		},
		{
			"hadithnumber": 2983,
			"arabicnumber": 2983,
			"text": "ইয়াকূব ইবন ইবরহীম (রহঃ) ... জাবির (রাঃ) বর্ণনা করেন যে, রাসূলুল্লাহ সাল্লাল্লাহু আলাইহি ওয়াসাল্লাম অবতরণ করেন অর্থাৎ সাফা হতে। যখন তাঁর পদযুগল ওয়াদীতে অবতরণ করে, তখন তিনি রমল করেন। আর যখন তিনি উপত্যকা অতিক্রম করেন, তখন তিনি হেঁটে চলেন।",
			"grades": [
				{
					"name": "Abu Ghuddah",
					"grade": "Sahih"
				},
				{
					"name": "Al-Albani",
					"grade": "Sahih"
				},
				{
					"name": "Zubair Ali Zai",
					"grade": "Hasan"
				}
			],
			"reference": {
				"book": 24,
				"hadith": 366
			}
		},
		{
			"hadithnumber": 2984,
			"arabicnumber": 2984,
			"text": "মুহাম্মদ ইবন আবদুল্লাহ্ ইবন আবদুল হাকাম (রহঃ) ... জাবির ইবন আবদুল্লাহ (রাঃ) থেকে বর্ণিত যে, রাসূলুল্লাহ সাল্লাল্লাহু আলাইহি ওয়াসাল্লাম মারওয়ায় এসে তার উপর আরোহণ করেন, তারপর বায়তুল্লাহ্ তার দৃষ্টিগোচর হয়। তখন তিনি তিনবার বলেনঃ (لاَ إِلَهَ إِلاَّ اللَّهُ وَحْدَهُ لاَ شَرِيكَ لَهُ لَهُ الْمُلْكُ وَلَهُ الْحَمْدُ وَهُوَ عَلَى كُلِّ شَىْءٍ قَدِيرٌ) এরপর তিনি আল্লাহকে স্মরণ করেন, সুবহানাল্লাহ ও আল-হামদুলিল্লাহ বলেন। তারপর তিনি আল্লাহর ইচ্ছা অনুযায়ী দুআ করেন এবং এই কাজের মাধ্যমে তিনি তাওয়াফ শেষ করেন।",
			"grades": [
				{
					"name": "Abu Ghuddah",
					"grade": "Sahih"
				},
				{
					"name": "Al-Albani",
					"grade": "Sahih"
				},
				{
					"name": "Zubair Ali Zai",
					"grade": "Hasan"
				}
			],
			"reference": {
				"book": 24,
				"hadith": 367
			}
		},
		{
			"hadithnumber": 2985,
			"arabicnumber": 2985,
			"text": "আলী ইবন হুজুর (রহঃ) ... জাবির (রাঃ) থেকে বর্ণিত যে, রাসূলুল্লাহ সাল্লাল্লাহু আলাইহি ওয়াসাল্লাম সাফার দিকে গেলেন এবং তাতে আরোহণ করলেন। এরপর বায়তুল্লাহ তার দৃষ্টিগোচর হলো। এরপর তিনি মহান আল্লাহর তাওহীদ বর্ণনা করে তাকবীর পাঠ করলেন। তিনি বলেনঃ لَا إِلَهَ إِلَّا اللَّهُ وَحْدَهُ لَا شَرِيكَ لَهُ لَهُ الْمُلْكُ وَلَهُ الْحَمْدُ يُحْيِي وَيُمِيتُ وَهُوَ عَلَى كُلِّ شَيْءٍ قَدِيرٌ এরপর তিনি চলতে লাগলেন যখন তাঁর পদদ্বয় উপত্যকাতে নামলো তখন সাঈ করলেন। যখন উভয় পদ 'উপতাকা থেকে উপরে উঠে এলো, তখন তিনি হেঁটে মারওয়ায় আগমন করেন। এখানেও তাই করলেন, যা তিনি সাফা পাহাড়ে করেছিলেন। এভাবে তিনি তার তাওয়াফ শেষ করেন।",
			"grades": [
				{
					"name": "Abu Ghuddah",
					"grade": "Sahih"
				},
				{
					"name": "Al-Albani",
					"grade": "Sahih"
				},
				{
					"name": "Zubair Ali Zai",
					"grade": "Hasan"
				}
			],
			"reference": {
				"book": 24,
				"hadith": 368
			}
		},
		{
			"hadithnumber": 2986,
			"arabicnumber": 2986,
			"text": "আমর ইবন আলী (রহঃ) ... আবু যুবায়র (রহঃ) বর্ণনা করেন যে, তিনি জাবির (রাঃ)-কে বলতে শুনেছেন যে, নবী সাল্লাল্লাহু আলাইহি ওয়াসাল্লাম ও সাফা এবং মারওয়ার মধ্যে একবারের বেশী সাঈ করেন নি।",
			"grades": [
				{
					"name": "Abu Ghuddah",
					"grade": "Sahih"
				},
				{
					"name": "Al-Albani",
					"grade": "Sahih"
				},
				{
					"name": "Zubair Ali Zai",
					"grade": "Sahih Muslim"
				}
			],
			"reference": {
				"book": 24,
				"hadith": 369
			}
		},
		{
			"hadithnumber": 2987,
			"arabicnumber": 2987,
			"text": "মুহাম্মাদ ইবন মুসান্না (রহঃ) ... মুআবিয়া (রাঃ) থেকে বর্ণিত যে, তিনি নবী সাল্লাল্লাহু আলাইহি ওয়াসাল্লাম এর উমরায় তাঁর চুল তীরের ফলা দিয়ে কেটেছেন মারওয়া পাহাড়ের উপরে।",
			"grades": [
				{
					"name": "Abu Ghuddah",
					"grade": "Sahih"
				},
				{
					"name": "Al-Albani",
					"grade": "Sahih"
				},
				{
					"name": "Zubair Ali Zai",
					"grade": "Hasan"
				}
			],
			"reference": {
				"book": 24,
				"hadith": 370
			}
		},
		{
			"hadithnumber": 2988,
			"arabicnumber": 2988,
			"text": "মুহাম্মদ ইবন ইয়াহইয়া ইবন আবদুল্লাহ্ (রহঃ) ... মুআবিয়া (রাঃ) থেকে বর্ণিত। তিনি বলেন, আমি মারওয়ায় নবী সাল্লাল্লাহু আলাইহি ওয়াসাল্লাম এর চুল কেটেছি বেদুঈনের তীরের ফলা দিয়ে।",
			"grades": [
				{
					"name": "Abu Ghuddah",
					"grade": "Sahih"
				},
				{
					"name": "Al-Albani",
					"grade": "Sahih"
				},
				{
					"name": "Zubair Ali Zai",
					"grade": "Hasan"
				}
			],
			"reference": {
				"book": 24,
				"hadith": 371
			}
		},
		{
			"hadithnumber": 2989,
			"arabicnumber": 2989,
			"text": "মুহাম্মদ ইবন মানসূর (রহঃ) ... মুআবিয়া (রাঃ) থেকে বর্ণিত। তিনি বলেনঃ আমি রাসূলুল্লাহ্ সাল্লাল্লাহু আলাইহি ওয়াসাল্লাম এর চুলের চারদিক থেকে কেটেছি, আমার নিকট তীরের ফলা ছিল তা দিয়ে, তাঁর বায়তুল্লাহর তাওয়াফ ও সাফা মারওয়া সাঈ-এর পর যুলহিজ্জার দশ দিনের মধ্যে। কায়স (রহঃ) বলেন, লোকেরা মুআবিয়া (রাঃ)-এর এ ব্যাপারটি অস্বীকার করেছেন।",
			"grades": [
				{
					"name": "Abu Ghuddah",
					"grade": "Shadh"
				},
				{
					"name": "Al-Albani",
					"grade": "Shadh"
				},
				{
					"name": "Zubair Ali Zai",
					"grade": "Isnaad Sahih"
				}
			],
			"reference": {
				"book": 24,
				"hadith": 372
			}
		},
		{
			"hadithnumber": 2990,
			"arabicnumber": 2990,
			"text": "মুহাম্মদ ইবন রাফি (রহঃ) ... আয়েশা (রাঃ) থেকে বর্ণিত। তিনি বলেন আমরা হজ্জের নিয়্যতে রাসূলুল্লাহ সাল্লাল্লাহু আলাইহি ওয়াসাল্লাম এর সঙ্গে বের হই। যখন তিনি বায়তুল্লাহর তাওয়াফ এবং সাফা ও মারওয়ার সাঈ করেন, তখন বললেনঃ যার সাথে কুরবানীর পশু রয়েছে, সে তার ইহরামের উপর আসবে। আর যার সাথে কুরবানীর পশু নেই, সে হালাল হয়ে যাবে।",
			"grades": [
				{
					"name": "Abu Ghuddah",
					"grade": "Sahih"
				},
				{
					"name": "Al-Albani",
					"grade": "Sahih"
				},
				{
					"name": "Zubair Ali Zai",
					"grade": "Isnaad Sahih"
				}
			],
			"reference": {
				"book": 24,
				"hadith": 373
			}
		},
		{
			"hadithnumber": 2991,
			"arabicnumber": 2991,
			"text": "মুহাম্মদ ইবন হাতিম (রহঃ) ... আয়েশা (রাঃ) থেকে বর্ণিত। তিনি বলেন আমরা বিদায় হজ্জে রাসূলুল্লাহ সাল্লাল্লাহু আলাইহি ওয়াসাল্লাম এর সঙ্গে বের হই। আমাদের মধ্যে কেউ তোমরা হজ্জের ইহরাম করে, আর কেউ কেউ উমরার ইহরাম করে এবং কুরবানীর পশু সঙ্গে নেয়। রাসূলুল্লাহ্ সাল্লাল্লাহু আলাইহি ওয়াসাল্লাম বলেনঃ যে উমরাহর ইহরাম করেছে, আর কুরবানীর পশু সাথে আনেনি, সে হালাল হয়ে যাবে। আর যে উমরাহর ইহরাম করে কুরবানীর পশু সঙ্গে এনেছে, সে হালাল হবে না। আর যে হজ্জের ইহরাম করেছে সে তার হজ্জ পূর্ণ করবে। আয়েশা (রাঃ) বলেনঃ আমি ঐ সকল লোকের মধ্যে ছিলাম, যারা উমরার ইহরাম করেছিল।",
			"grades": [
				{
					"name": "Abu Ghuddah",
					"grade": "Sahih"
				},
				{
					"name": "Al-Albani",
					"grade": "Sahih"
				},
				{
					"name": "Zubair Ali Zai",
					"grade": "Hasan"
				}
			],
			"reference": {
				"book": 24,
				"hadith": 374
			}
		},
		{
			"hadithnumber": 2992,
			"arabicnumber": 2992,
			"text": "মুহাম্মদ ইবন আবদুল্লাহ ইবন মুবারক (রহঃ) ... আসমা বিনত আবু বকর (রাঃ) থেকে বর্ণিত। তিনি বলেন, আমরা হজ্জের ইহরাম করে রাসূলুল্লাহ্ সাল্লাল্লাহু আলাইহি ওয়াসাল্লাম এর সঙ্গে বের হলাম। আমরা মক্কার নিকটবর্তী হলে রাসূলুল্লাহ্ সাল্লাল্লাহু আলাইহি ওয়াসাল্লাম বলেনঃ যার সাথে কুরবানীর পশু নেই, সে যেন হালাল হয়ে যায়, আর যার সাথে কুরবানীর পশু রয়েছে, সে তার ইহরামের উপর থাকবে। আসমা (রাঃ) বলেনঃ যুবায়র (রাঃ)-এর সাথে কুরবানীর পশু থাকায় তিনি তার ইহরামের উপর থাকেন। আর আমার সাথে কুরবানীর পশু না থাকায় আমি হালাল হয়ে যাই। আমি আমার জামাকাপড় পরিধান করি, সুগন্ধি ব্যবহার করি এবং যুবায়র (রাঃ)-এর কাছে বসি। তিনি বললেন, আমার থেকে দূরে বস। আমি বলিঃ তুমি কি ভয় কর যে, আমি তোমার উপর ঝাঁপিয়ে পড়বাে?",
