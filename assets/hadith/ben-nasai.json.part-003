					"name": "Zubair Ali Zai",
					"grade": "Sahih Muslim"
				}
			],
			"reference": {
				"book": 22,
				"hadith": 260
			}
		},
		{
			"hadithnumber": 2350,
			"arabicnumber": 2350,
			"text": "। রবী ইবনু সুলায়মান (রহঃ) ... আব্দুল্লাহ ইবনু আবূ কায়স (রাঃ) থেকে বর্নিত যে, রাসুলুল্লাহ সাল্লাল্লাহু আলাইহি ওয়াসাল্লাম এর কাছে মাস সমূহের মধ্যে শা'বান মাসের সাওম পালন করা সর্বাধিক পছন্দনীয় ছিল। বরং তিনি শা'বান মাসকে (সাওম পালনসহ) রমযানের সাথে মিলিরে নিতেন।",
