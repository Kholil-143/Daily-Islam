					"grade": "Sahih"
				},
				{
					"name": "Al-Albani",
					"grade": "Sahih"
				},
				{
					"name": "Zubair Ali Zai",
					"grade": "Hasan"
				}
			],
			"reference": {
				"book": 22,
				"hadith": 285
			}
		},
		{
			"hadithnumber": 2375,
			"arabicnumber": 2375,
			"text": "। আব্বাস ইবনু ওলীদ (রহঃ) ... ইবনু উমর (রাঃ) থেকে বর্ণিত, রাসুলুল্লাহ সাল্লাল্লাহু আলাইহি ওয়াসাল্লাম বলেছেন, যে ব্যক্তি সারা জীবন সাওম পালন করে তার সাওম পালন হবে না।",
			"grades": [
				{
					"name": "Abu Ghuddah",
					"grade": "Sahih"
				},
				{
					"name": "Al-Albani",
					"grade": "Sahih"
				},
				{
					"name": "Zubair Ali Zai",
					"grade": "Hasan"
				}
			],
			"reference": {
				"book": 22,
				"hadith": 286
			}
		},
		{
			"hadithnumber": 2376,
			"arabicnumber": 2376,
			"text": "। ইসমাঈল ইবনু ইয়াকুব (রহঃ) ... ইবনু উমর (রাঃ) থেকে শ্রবণকারী এক ব্যক্তি বর্ণনা করেছেন যে, নবী সাল্লাল্লাহু আলাইহি ওয়াসাল্লাম বলেছেন, যে ব্যক্তি সারা জীবন সাওম পালন করে তার সাওম পালন গ্রহণযোগ্য হবে না।",
			"grades": [
				{
					"name": "Abu Ghuddah",
					"grade": "Sahih"
				},
				{
					"name": "Al-Albani",
					"grade": "Sahih"
				},
				{
					"name": "Zubair Ali Zai",
					"grade": "Sahih"
				}
			],
			"reference": {
				"book": 22,
				"hadith": 287
			}
		},
		{
			"hadithnumber": 2377,
			"arabicnumber": 2377,
			"text": "। আহমাদ ইবনু ইবরাহীম (রহঃ) ... আব্দুল্লাহ ইবনু আমর (রাঃ) থেকে বর্ণিত। রাসুলুল্লাহ সাল্লাল্লাহু আলাইহি ওয়াসাল্লাম বলেছেন, যে ব্যক্তি সারা জীবন সাওম পালন করে তার সাওম ও ইফতার গ্রহণযোগ্য হবে না।",
			"grades": [
				{
					"name": "Abu Ghuddah",
					"grade": "Sahih"
				},
				{
					"name": "Al-Albani",
					"grade": "Sahih"
				},
				{
					"name": "Zubair Ali Zai",
					"grade": "Sahih - Agreed Upon"
				}
			],
			"reference": {
				"book": 22,
				"hadith": 288
			}
		},
		{
			"hadithnumber": 2378,
			"arabicnumber": 2378,
			"text": "। ইবরাহীম ইবনু হাসান (রহঃ) ... আবদুল্লাহ ইবনু আমর (রাঃ) বলেনঃ তিনি একবার রাসুলুল্লাহ সাল্লাল্লাহু আলাইহি ওয়াসাল্লাম এর কাছে সংবাদ পৌছাল যে, আমি সর্বদা সাওম পালন করি। (ইহা একটি দীর্ঘ হাদীস) রাবী বলেন, আতা (রহঃ) বলেছেন যে, আমি বলতে পারব না তিনি সর্বদা সাওম পালনের ব্যাপার কিভাবে উল্লেখ করেছিলেন যে ব্যক্তি সর্বদা সাওম পালন করে তার সাওম গ্রহণ যোগ্য নয়”। (এভাবে বলেছেন না অন্যভাবে বলেছেন, সঠিক শব্দগুলি আমার মনে নাই।)",
			"grades": [
				{
					"name": "Abu Ghuddah",
					"grade": "Sahih"
				},
				{
					"name": "Al-Albani",
					"grade": "Sahih"
				},
				{
					"name": "Zubair Ali Zai",
					"grade": "Sahih - Agreed Upon"
				}
			],
			"reference": {
				"book": 22,
				"hadith": 289
			}
		},
		{
			"hadithnumber": 2379,
			"arabicnumber": 2379,
			"text": "। আলী ইবনু হুজর (রহঃ) ... ইমরান (রাঃ) থেকে বর্ণিত। তিনি বলেন, একদা রাসুলুল্লাহ সাল্লাল্লাহু আলাইহি ওয়াসাল্লাম-কে জিজ্ঞাসা করা হল ইয়া রাসুলাল্লাহ! অমুক ব্যক্তি সারা বছর দিনে খায় না (সাওম পালন করে)। রাসুলুল্লাহ সাল্লাল্লাহু আলাইহি ওয়াসাল্লাম বললেন, তার সাওম পালন এবং তার ইফতার গ্রহণযোগ্য হবে না।",
			"grades": [
				{
					"name": "Abu Ghuddah",
					"grade": "Sahih"
				},
				{
					"name": "Al-Albani",
					"grade": "Sahih"
				},
				{
					"name": "Zubair Ali Zai",
					"grade": "Isnaad Sahih"
				}
			],
			"reference": {
				"book": 22,
				"hadith": 290
			}
		},
		{
			"hadithnumber": 2380,
			"arabicnumber": 2380,
			"text": "। আমর ইবনু হিশাম (রহঃ) ... মুতাররিফ (রহঃ) এর পিতা আব্দুল্লাহ (রাঃ) থেকে বর্ণিত। একদা রাসুলুল্লাহ সাল্লাল্লাহু আলাইহি ওয়াসাল্লাম-এর সামনে এক ব্যক্তি সম্পর্কে আলোচনা করা হল। যে সর্বদা সাওম পালন করত। তখন রাসুলুল্লাহ সাল্লাল্লাহু আলাইহি ওয়াসাল্লাম বললেনঃ তার সাওম এবং তার ইফতার গ্রহণযোগ্য নয়।",
			"grades": [
				{
					"name": "Abu Ghuddah",
					"grade": "Sahih"
				},
				{
					"name": "Al-Albani",
					"grade": "Sahih"
				},
				{
					"name": "Zubair Ali Zai",
					"grade": "Sahih"
				}
			],
			"reference": {
				"book": 22,
				"hadith": 291
			}
		},
		{
			"hadithnumber": 2381,
			"arabicnumber": 2381,
			"text": "। মুহাম্মদ ইবনু মুছান্না (রহঃ) ... মুতাররিফ-এর পিতা আব্দুল্লাহ (রাঃ) থেকে বর্ণিত যে, রাসুলুল্লাহ সাল্লাল্লাহু আলাইহি ওয়াসাল্লাম সর্বদা সাওম পালনকারীর ব্যাপারে বলেছেন যে, তার সাওম এবং ইফতার গ্রহণযোগ্য হবে না।",
			"grades": [
				{
					"name": "Abu Ghuddah",
					"grade": "Sahih"
				},
				{
					"name": "Al-Albani",
					"grade": "Sahih"
				},
				{
					"name": "Zubair Ali Zai",
					"grade": "Isnaad Sahih"
				}
			],
			"reference": {
				"book": 22,
				"hadith": 292
			}
		},
		{
			"hadithnumber": 2382,
			"arabicnumber": 2382,
			"text": "। হারুন ইবনু আব্দুল্লাহ (রহঃ) ... উমর (রাঃ) থেকে বর্ণিত। তিনি বলেন, আমরা একবার রাসুলুল্লাহ সাল্লাল্লাহু আলাইহি ওয়াসাল্লাম এর সাথে ছিলাম। আমরা এক ব্যক্তির পাশ দিয়ে যাচ্ছিলাম। সাহাবীরা বললেনঃ হে আল্লাহ্‌র নবী! এই ব্যক্তি দীর্ঘ দিন পর্যন্ত সাওম ভঙ্গ করে না। রাসুলুল্লাহ সাল্লাল্লাহু আলাইহি ওয়াসাল্লাম বললেনঃ তার সাওমও গ্রহণযোগ্য নয় আর তার সাওম ভঙ্গও গ্রহণযোগ্য নয়।",
			"grades": [
				{
					"name": "Abu Ghuddah",
					"grade": "Sahih Lighairihi"
				},
				{
					"name": "Al-Albani",
					"grade": "Sahih"
				},
				{
					"name": "Zubair Ali Zai",
					"grade": "Sahih"
				}
			],
			"reference": {
				"book": 22,
				"hadith": 293
			}
		},
		{
			"hadithnumber": 2383,
			"arabicnumber": 2383,
			"text": "। মুহাম্মাদ ইবনু বাশশার (রহঃ) ... আবূ কাতাদা (রাঃ) থেকে বর্ণিত যে, রাসুলুল্লাহ সাল্লাল্লাহু আলাইহি ওয়াসাল্লাম কে তার সাওম সম্পর্কে জিজ্ঞাসা করলে তিনি রাগান্বিত হয়ে গেলেন, তখন উমর (রাঃ) বললেন যে, আমরা রব হিসাবে আল্লাহর উপর, ধর্ম হিসাবে ইসলামের উপর এবং রাসুল হিসারে মুহাম্মদ সাল্লাল্লাহু আলাইহি ওয়াসাল্লাম এর উপর সন্তুষ্ট। আরেকবার সর্বদা সাওম পালনকারী ব্যক্তি সম্পর্কে জিজ্ঞাসিত হলে তিনি বললেনঃ তার সাওম পালনও গ্রহণযোগ্য নয়। তার সাওম ভঙ্গও গ্রহণযোগ্য নয়।",
			"grades": [
				{
					"name": "Abu Ghuddah",
					"grade": "-"
				},
				{
					"name": "Al-Albani",
					"grade": "Sahih"
				},
				{
					"name": "Zubair Ali Zai",
					"grade": "Sahih Muslim"
				}
			],
			"reference": {
