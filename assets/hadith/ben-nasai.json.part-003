					"grade": "Sahih"
				},
				{
					"name": "Al-Albani",
					"grade": "Sahih"
				},
				{
					"name": "Zubair Ali Zai",
					"grade": "Daif"
				}
			],
			"reference": {
				"book": 24,
				"hadith": 391
			}
		},
		{
			"hadithnumber": 3009,
			"arabicnumber": 3009,
			"text": "আহমদ ইবন সারহ (রহঃ) ... সালিম ইবন আবদুল্লাহ (রহঃ) থেকে বর্ণিত যে, আরাফার দিন আবদুল্লাহ্ ইবন উমর (রাঃ) হাজ্জাজ ইবন ইউসুফের নিকট আসলেন, তখন সূর্য ঢলে পড়েছিল, আর আমি তার সাথে ছিলাম। তিনি বললেনঃ যদি আপনি সুন্নত তরীকা মত আমল করতে চান, তা হলে এই অপরাহ্নে বেরিয়ে পড়ুন। তিনি বললেনঃ এখনই? আবদুল্লাহ বললেনঃ হ্যাঁ। সালিম বলেনঃ আমি হাজ্জাজকে বললামঃ যদি আপনি আজ সুন্নত মুতাবিক আমল করতে চান, তাহলে খুবা সংক্ষেপ করুন এবং সালাত তাড়াতাড়ি আদায় করুন। তখন আবদুল্লাহ ইবন উমর (রাঃ) বললেনঃ সে ঠিকই বলেছে।",
			"grades": [
				{
					"name": "Abu Ghuddah",
					"grade": "Sahih"
				},
				{
					"name": "Al-Albani",
					"grade": "Sahih"
				},
				{
					"name": "Zubair Ali Zai",
					"grade": "Hasan"
