					"name": "Abu Ghuddah",
					"grade": "Sahih"
				},
				{
					"name": "Al-Albani",
					"grade": "Sahih"
				},
				{
					"name": "Zubair Ali Zai",
					"grade": "Sahih"
				}
			],
			"reference": {
				"book": 23,
				"hadith": 163
			}
		},
		{
			"hadithnumber": 2598,
			"arabicnumber": 2598,
			"text": "আমর ইবন আলী এবং মুহাম্মদ মুছান্না ... উবায়দুল্লাহ ইবন আদী (রহঃ) বর্ণনা করেছেন যে, দু'জন লোক তাকে বলেছেন, তাঁরা রাসূলুল্লাহ্ সাল্লাল্লাহু আলাইহি ওয়াসাল্লাম এর কাছে এসে তার কাছে সাদাক হতে কিছু সাহায্য চাইলেন। তিনি তাদের পানে তাকিয়ে দেখলেন যে, তারা উভয়েই সক্ষম ব্যক্তি। তখন রাসূলুল্লাহ সাল্লাল্লাহু আলাইহি ওয়াসাল্লাম বললেন, যদি তোমরা চাও তবে তোমাদেরকে দেব, কিন্তু স্বচ্ছল ও উপার্জনে সক্ষম ব্যক্তির জন্য এতে কোন অংশ নেই।",
			"grades": [
				{
					"name": "Abu Ghuddah",
					"grade": "Sahih"
				},
				{
					"name": "Al-Albani",
					"grade": "Sahih"
				},
				{
					"name": "Zubair Ali Zai",
					"grade": "Isnaad Sahih"
