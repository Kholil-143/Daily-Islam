					"name": "Abu Ghuddah",
					"grade": "Sahih"
				},
				{
					"name": "Al-Albani",
					"grade": "Sahih"
				},
				{
					"name": "Zubair Ali Zai",
					"grade": "Sahih - Agreed Upon"
				}
			],
			"reference": {
				"book": 24,
				"hadith": 131
			}
		},
		{
			"hadithnumber": 2750,
			"arabicnumber": 2750,
			"text": "ইয়াকুব ইবন ইবরাহীম (রহঃ) ... উবায়দুল্লাহ্ ইবন আবদুল্লাহ্ ইবন উমর তাঁর পিতা থেকে বর্ণনা করেন। তিনি বলেন, রাসূলুল্লাহ সাল্লাল্লাহু আলাইহি ওয়াসাল্লাম এর তালবিয়া ছিলঃ لَبَّيْكَ اللَّهُمَّ لَبَّيْكَ لَبَّيْكَ لاَ شَرِيكَ لَكَ لَبَّيْكَ إِنَّ الْحَمْدَ وَالنِّعْمَةَ لَكَ وَالْمُلْكَ لاَ شَرِيكَ لَكَ ইবন উমর (রাঃ) তাতে আরও বাড়িয়ে বলেছেনঃ لَبَّيْكَ لَبَّيْكَ وَسَعْدَيْكَ وَالْخَيْرُ فِي يَدَيْكَ وَالرَّغْبَاءُ إِلَيْكَ وَالْعَمَلُ",
			"grades": [
				{
					"name": "Abu Ghuddah",
					"grade": "Sahih"
				},
				{
					"name": "Al-Albani",
					"grade": "Sahih"
				},
				{
					"name": "Zubair Ali Zai",
					"grade": "Isnaad Sahih"
				}
			],
			"reference": {
				"book": 24,
				"hadith": 132
			}
		},
		{
			"hadithnumber": 2751,
			"arabicnumber": 2751,
			"text": "আহমদ ইবন আবদা (রহঃ) ... আবদুল্লাহ্ ইবন মাসউদ (রাঃ) থেকে বর্ণিত। তিনি বলেনঃ নবী সাল্লাল্লাহু আলাইহি ওয়াসাল্লাম এর তালবিয়া ছিলঃ لَبَّيْكَ اللَّهُمَّ لَبَّيْكَ لَبَّيْكَ لاَ شَرِيكَ لَكَ لَبَّيْكَ إِنَّ الْحَمْدَ وَالنِّعْمَةَ لَكَ",
			"grades": [
				{
					"name": "Abu Ghuddah",
					"grade": "Sahih Lighairihi"
				},
				{
					"name": "Al-Albani",
					"grade": "Sahih"
				},
				{
					"name": "Zubair Ali Zai",
					"grade": "Sahih"
				}
			],
			"reference": {
				"book": 24,
				"hadith": 133
			}
		},
		{
			"hadithnumber": 2752,
			"arabicnumber": 2752,
			"text": "কুতায়বা (রহঃ) ... আবু হুরায়রা (রাঃ) থেকে বর্ণিত। তিনি বলেন, নবী সাল্লাল্লাহু আলাইহি ওয়াসাল্লাম এর তালবিয়ার মধ্যে ছিলঃ (لَبَّيْكَ إِلَهَ الْحَقِّ)। আবু আবদুর রহমান বলেনঃ আবদুল আযীয ব্যতীত আবদুল্লাহ ইবন ফজল থেকে অন্য কেউ ইহা বৰ্ণনা করেছেন বলে জানা নেই। ইসমাঈল ইবন উমাইয়া তার থেকে মুরসালরূপে বর্ণনা করেছেন।",
			"grades": [
				{
					"name": "Abu Ghuddah",
					"grade": "Sahih"
				},
				{
					"name": "Al-Albani",
					"grade": "Sahih"
				},
				{
					"name": "Zubair Ali Zai",
					"grade": "Isnaad Sahih"
				}
			],
			"reference": {
				"book": 24,
				"hadith": 134
			}
		},
		{
			"hadithnumber": 2753,
			"arabicnumber": 2753,
			"text": "ইসহাক ইবন ইবরাহীম (রহঃ) ... খাল্লাদ ইবন সায়িব তার পিতা থেকে, তিনি রাসূলুল্লাহ্ সাল্লাল্লাহু আলাইহি ওয়াসাল্লাম থেকে বর্ণনা করেন যে, তিনি বলেছেনঃ জিবরীল (আঃ) আমার নিকট এসে আমাকে বলেন, হে মুহাম্মদ! আপনি আপনার সাহাবীগণকে বলে দিন, তারা যেন উঁচু স্বরে তালবিয়া পাঠ করে।",
			"grades": [
				{
					"name": "Abu Ghuddah",
					"grade": "Sahih"
				},
				{
					"name": "Al-Albani",
					"grade": "Sahih"
				},
				{
					"name": "Zubair Ali Zai",
					"grade": "Isnaad Sahih"
				}
			],
			"reference": {
				"book": 24,
				"hadith": 135
			}
		},
		{
			"hadithnumber": 2754,
			"arabicnumber": 2754,
			"text": "কুতায়বা (রহঃ) ... ইবন আব্বাস (রাঃ) থেকে বর্ণিত। রাসূলুল্লাহ্ সাল্লাল্লাহু আলাইহি ওয়াসাল্লাম সালতের পর তালবিয়া পড়া আরম্ভ করতেন।",
			"grades": [
				{
					"name": "Abu Ghuddah",
					"grade": "Daif"
				},
				{
					"name": "Al-Albani",
					"grade": "Daif"
				},
				{
					"name": "Zubair Ali Zai",
					"grade": "Daif"
				}
			],
			"reference": {
				"book": 24,
				"hadith": 136
			}
		},
		{
			"hadithnumber": 2755,
			"arabicnumber": 2755,
			"text": "ইসহাক ইবন ইবরাহীম (রহঃ) ... আনাস (রাঃ) থেকে বর্ণিত। তিনি বলেন, রাসূলুল্লাহ্ সাল্লাল্লাহু আলাইহি ওয়াসাল্লাম বায়দা নামক স্থানে জোহরের সালাত আদায় করে সওয়ার হলেন এবং বায়দা পাহাড়ে আরোহণ করেন। আর হজ্জ ও উমরাহর তালবিয়া পাঠ করলেন। জোহরের সালাত আদায়ের পর।",
			"grades": [
				{
					"name": "Abu Ghuddah",
					"grade": "Daif"
				},
				{
					"name": "Al-Albani",
					"grade": "Daif"
				},
				{
					"name": "Zubair Ali Zai",
					"grade": "Daif"
				}
			],
			"reference": {
				"book": 24,
				"hadith": 137
			}
		},
		{
			"hadithnumber": 2756,
			"arabicnumber": 2756,
			"text": "ইমরান ইবন ইয়াযীদ (রহঃ) ... জাবির (রাঃ) থেকে বর্ণিত। তিনি নবী সাল্লাল্লাহু আলাইহি ওয়াসাল্লাম এর হজ্জ সম্বন্ধে বলেন, যখন তিনি যুলহুলায়ফায় আগমন করেন, তখন তিনি সালাত আদায় করেন এবং বায়দায় আসা পর্যন্ত নীরব থাকেন।",
			"grades": [
				{
					"name": "Abu Ghuddah",
					"grade": "Sahih"
				},
				{
					"name": "Al-Albani",
					"grade": "Sahih"
				},
				{
					"name": "Zubair Ali Zai",
					"grade": "Isnaad Sahih"
				}
			],
			"reference": {
				"book": 24,
				"hadith": 138
			}
		},
		{
			"hadithnumber": 2757,
			"arabicnumber": 2757,
			"text": "কুতায়বা (রহঃ) ... সালিম (রহঃ) থেকে বর্ণিত তিনি তাঁর পিতাকে বলতে শুনেছেনঃ ইহা তোমাদের ঐ বায়দা যার ব্যাপারে তোমরা রাসূলুল্লাহ্ সাল্লাল্লাহু আলাইহি ওয়াসাল্লাম সম্বন্ধে মিথ্যা বলছাে। অথচ রাসূলুল্লাহ্ সাল্লাল্লাহু আলাইহি ওয়াসাল্লাম যুলহুলায়ফার মসজিদ ব্যতীত অন্য কোথাও থেকে তালবিয়া পড়া আরম্ভ করেন নি।",
			"grades": [
				{
					"name": "Abu Ghuddah",
					"grade": "Sahih"
				},
				{
					"name": "Al-Albani",
					"grade": "Sahih"
				},
				{
					"name": "Zubair Ali Zai",
					"grade": "Sahih - Agreed Upon"
				}
			],
			"reference": {
				"book": 24,
				"hadith": 139
			}
		},
		{
			"hadithnumber": 2758,
			"arabicnumber": 2758,
			"text": "ঈসা ইবন ইবরাহীম (রহঃ) ... ইবন শিহাব (রহঃ) থেকে বর্ণিত যে, সালিম ইবন আবদুল্লাহ্ (রহঃ) তাকে সংবাদ দিয়েছেন যে, আবদুল্লাহ্ ইবন উমর (রাঃ) বলেছেনঃ আমি রাসূলুল্লাহ্ সাল্লাল্লাহু আলাইহি ওয়াসাল্লাম-কে যুলহুলায়ফায় তাঁর সওয়ারীতে আরোহণ করতে এবং সওয়ারীতে যখন স্থির উপবিষ্ট হতেন তখন তালবিয়া পাঠ করতে দেখেছি।",
			"grades": [
				{
					"name": "Abu Ghuddah",
					"grade": "Sahih"
				},
				{
					"name": "Al-Albani",
					"grade": "Sahih"
				},
				{
					"name": "Zubair Ali Zai",
					"grade": "Sahih - Agreed Upon"
				}
			],
			"reference": {
				"book": 24,
				"hadith": 140
			}
		},
		{
			"hadithnumber": 2759,
			"arabicnumber": 2759,
			"text": "ইমরান ইবন ইয়াযীদ ও মুহাম্মদ ইবন ইসমাঈল (রহঃ) ... ইবন উমর (রাঃ) থেকে বর্ণিত। তিনি বলেনঃ রাসূলুল্লাহ্ সাল্লাল্লাহু আলাইহি ওয়াসাল্লাম যখন স্বীয় সওয়ারীতে স্থির হয়ে উপবেশন করতেন, তখন তালবিয়া পাঠ করতেন।",
			"grades": [
				{
					"name": "Abu Ghuddah",
					"grade": "Sahih"
				},
				{
					"name": "Al-Albani",
					"grade": "Sahih"
				},
				{
					"name": "Zubair Ali Zai",
					"grade": "Sahih - Agreed Upon"
				}
			],
			"reference": {
				"book": 24,
				"hadith": 141
			}
		},
		{
			"hadithnumber": 2760,
			"arabicnumber": 2760,
			"text": "মুহাম্মদ ইবন আলী (রহঃ) ... উবায়দ ইবন জুরায়জ (রহঃ) থেকে বর্ণিত। তিনি বলেন, আমি ইবন উমর (রাঃ)-কে বললামঃ আমি আপনাকে দেখলাম যে, আপনি যখন আপনার উটনীর উপর স্থির হয়ে বসেন, তখন তালবিয়া পাঠ করেন? তিনি বললেনঃ রাসূলুল্লাহ্ সাল্লাল্লাহু আলাইহি ওয়াসাল্লাম যখন স্বীয় উটনীর উপর স্থির হয়ে উপবেশন করতেন, তখন তিনি তালবিয়া পাঠ করতেন।",
			"grades": [
				{
					"name": "Abu Ghuddah",
					"grade": "Sahih"
				},
				{
					"name": "Al-Albani",
					"grade": "Sahih"
				},
				{
					"name": "Zubair Ali Zai",
					"grade": "Sahih"
				}
			],
			"reference": {
				"book": 24,
				"hadith": 142
			}
		},
		{
			"hadithnumber": 2761,
			"arabicnumber": 2761,
			"text": "মুহাম্মদ ইবন আবদুল্লাহ্ ইবন আবদুল হাকম (রহঃ) ... জাবির ইবন আবদুল্লাহ (রাঃ) থেকে বর্ণিত । তিনি বলেন, রাসূলুল্লাহ্ সাল্লাল্লাহু আলাইহি ওয়াসাল্লাম (মদীনায়) নয় বছর অবস্থান করেন, কিন্তু তিনি হজ্জ করেন নি। তারপর তিনি লোকদেরকে হজ্জের ব্যাপারে ঘোষণা দিলেন। ফলে যে সওয়ার হয়ে অথবা পদব্ৰজে আসার ক্ষমতা রাখতো, এমন কেউ আসতে বাকী রইলো না। তারা মিলিত হলো রাসূলুল্লাহ্ সাল্লাল্লাহু আলাইহি ওয়াসাল্লাম এর সাথে হজ্জে শরীক হওয়ার জন্য। এমনিভাবে সকলে যুলহুলায়ফায় উপস্থিত হলো। সেখানে আসমা বিনত উমায়স-এর গর্ভে মুহাম্মদ ইবন আবু বকর ভূমিষ্ট হন। রাসূলুল্লাহ্ সাল্লাল্লাহু আলাইহি ওয়াসাল্লাম এর নিকট এ সংবাদ পাঠালে তিনি বলেন, গোসল করে একখানা কাপড় বেঁধে নাও, তারপর তালবিয়া পাঠ কর, তিনি তা-ই করেন। (সংক্ষিপ্ত)",
			"grades": [
