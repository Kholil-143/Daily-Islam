		{
			"hadithnumber": 2131,
			"arabicnumber": 2131,
			"text": "। ইবনু উমার (রাঃ) হতে বর্ণিত আছে, রাসূলুল্লাহ সাল্লাল্লাহু আলাইহি ওয়াসাল্লাম বলেছেনঃ যে লোক দান করার পর তা আবার ফিরিয়ে নেয় সে কুকুর সমতুল্য, যে পেট ভরে খাওয়ার পর বমি করে, আবার ফিরে এসে তা খায়। সহীহ, ইরওয়া (৬/৩৬), বুখারী, মুসলিম সংক্ষিপ্ত ভাবে। আবূ ঈসা বলেন, ইবনু আব্বাস ও আবদুল্লাহ ইবনু আমর (রাঃ) হতেও এ অনুচ্ছেদে হাদীস বর্ণিত আছে।",
			"grades": [
				{
					"name": "Ahmad Muhammad Shakir",
					"grade": "Sahih"
				},
				{
					"name": "Al-Albani",
					"grade": "Sahih"
				},
				{
					"name": "Zubair Ali Zai",
					"grade": "Isnaad Sahih"
				}
			],
			"reference": {
