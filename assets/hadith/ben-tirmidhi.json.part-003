				},
				{
					"name": "Zubair Ali Zai",
					"grade": "Sahih"
				}
			],
			"reference": {
				"book": 25,
				"hadith": 72
			}
		},
		{
			"hadithnumber": 1856,
			"arabicnumber": 1856,
			"text": "। আনাস ইবনু মালিক (রাঃ) হতে বর্ণিত আছে, তিনি বলেছেন, রাসূলুল্লাহ সাল্লাল্লাহু আলাইহি ওয়াসাল্লাম বলেছেনঃ তোমরা অবশ্যই রাতের খাবার খাবে তা একমুঠ খেজুর হলেও। কেননা রাতের খাবার বাদ দেয়া বার্ধক্যের কারণ। যঈফ, যঈফা (১১৬) আবূ ঈসা বলেছেন, এটি একটি প্রত্যাখ্যাত (মুনকার) হাদীস। আমরা শুধু উল্লেখিত সূত্রে এটি জেনেছি। রাবী আনবাসাকে হাদীস শাস্ত্রে দুর্বল সাব্যস্ত করা হয়েছে। তাছাড়া আবদুল মালিক ইবনু আল্লাক একজন অখ্যাত-অপরিচিত রাবী।",
			"grades": [
