			}
		},
		{
			"hadithnumber": 1729,
			"arabicnumber": 1729,
			"text": "। ইবনু ‘আব্বাস (রাযি.) সূত্রে বর্ণিত। তিনি বলেন, রাসূলুল্লাহ সাল্লাল্লাহু আলাইহি ওয়াসাল্লাম বলেছেনঃ ইসলামে সন্নাসবাদীতা নেই।[1] দুর্বলঃ যঈফ আল-জামি‘উস সাগীর (৬২৬৯), মিশকাত (২৫২২)।",
			"grades": [
				{
					"name": "Al-Albani",
					"grade": "Daif"
				},
				{
					"name": "Muhammad Muhyi Al-Din Abdul Hamid",
					"grade": "Daif"
				},
				{
