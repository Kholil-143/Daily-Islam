					"grade": "Daif"
				}
			],
			"reference": {
				"book": 11,
				"hadith": 9
			}
		},
		{
			"hadithnumber": 1730,
			"arabicnumber": 1730,
			"text": "। ইবনু ‘আব্বাস (রাযি.) সূত্রে বর্ণিত। তিনি বলেন, লোকজন হজ (হজ্জ) করতো কিন্তু সাথে পাথেয় নিয়ে আসতো না। আবূ মাসঊদ বলেন, ইয়ামেনের কতিপয় লোক হজে (হজ্জে) যেতো কিন্তু সাথে পাথেয় আনতো না এবং তারা বলতো যে, আমরা আল্লাহর উপর তাওয়াক্কুল করেছি। অথচ মক্কায় পৌঁছার পর তারা ভিক্ষা করতো। ফলে মহান আল্লাহ অবতীর্ণ করলেন, ‘‘তোমরা হজের (হজ্জের) সফরে পাথেয় নিয়ে যাবে, আর জেনে রেখো তাকওয়াই হলো উত্তম পাথেয়। (২ঃ ১৯৭)[1] সহীহ।",
