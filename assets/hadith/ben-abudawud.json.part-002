			}
		},
		{
			"hadithnumber": 1562,
			"arabicnumber": 1562,
			"text": "। সামুরাহ ইবনু জুনদুব (রাঃ) সূত্রে বর্ণিত। তিনি বলেন, রাসূলুল্লাহ সাল্লাল্লাহু আলাইহি ওয়াসাল্লাম আমাদেরকে বাণিজ্যিক পণ্যের যাকাত দিতে নির্দেশ করেছেন।[1] দুর্বল।",
			"grades": [
				{
					"name": "Al-Albani",
					"grade": "Daif"
				},
				{
					"name": "Muhammad Muhyi Al-Din Abdul Hamid",
					"grade": "Daif"
