		},
		{
			"hadithnumber": 1719,
			"arabicnumber": 1719,
			"text": "। ‘আব্দুর রহমান ইবনু ‘উসমান আত-তাইমী সূত্রে বর্ণিত। তিনি বলেন, রাসূলুল্লাহ সাল্লাল্লাহু আলাইহি ওয়াসাল্লাম হাজীদেরকে পথে পড়ে থাকা বস্ত্ত তুলে নিতে নিষেধ করেছেন। আহমাদ বলেন, ইবনু ওয়াহাব হাজ্জের মৌসুমে পথে পড়ে থাকা বস্ত্ত সম্পর্কে বলেন, তা পতিত অবস্থায় থাকতে দাও যাতে তার মালিক তা পেয়ে যায়।[1] সহীহ।",
			"grades": [
				{
					"name": "Al-Albani",
					"grade": "Sahih"
				},
				{
					"name": "Muhammad Muhyi Al-Din Abdul Hamid",
					"grade": "Sahih"
				},
				{
					"name": "Shuaib Al Arnaut",
					"grade": "Sahih"
				},
				{
					"name": "Zubair Ali Zai",
					"grade": "Sahih Muslim (1724)"
				}
			],
			"reference": {
