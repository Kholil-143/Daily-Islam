					"name": "Al-Albani",
					"grade": "Sahih"
				},
				{
					"name": "Muhammad Muhyi Al-Din Abdul Hamid",
					"grade": "Sahih"
				},
				{
					"name": "Shuaib Al Arnaut",
					"grade": "Sahih"
				},
				{
					"name": "Zubair Ali Zai",
					"grade": "Daif"
				}
			],
			"reference": {
				"book": 9,
				"hadith": 99
			}
		},
		{
			"hadithnumber": 1655,
			"arabicnumber": 1655,
			"text": "। আনাস (রাঃ) সূত্রে বর্ণিত। একদা রাসূলুল্লাহ সাল্লাল্লাহু আলাইহি ওয়াসাল্লাম-এর খিদমাতে গোশত পেশ করা হলে তিনি জিজ্ঞেস করলেনঃ এটা কি ধরনের গোশত? লোকেরা বললো, এটা বারীরাহকে সাদাকা দেয়া হয়েছিলো। তিনি বললেনঃ এটা তার জন্য সাদাকা, কিন্তু আমাদের জন্য উপঢৌকন।[1] সহীহ : বুখারী ও মুসলিম।",
			"grades": [
				{
