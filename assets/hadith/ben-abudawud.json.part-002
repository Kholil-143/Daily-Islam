					"grade": "Isnaad Sahih"
				}
			],
			"reference": {
				"book": 11,
				"hadith": 225
			}
		},
		{
			"hadithnumber": 1946,
			"arabicnumber": 1946,
			"text": "। আবূ হুরাইরাহ (রাযি.) বলেন, আবূ বাকর (রাযি.) নহরের দিন আমাকে এরূপ ঘোষণা দিতে পাঠালেন যে, ‘এ বছরের পর আর কোনো মুশরিক হজ (হজ্জ) করতে পারবে না এবং কেউ উলঙ্গ হয়ে বায়তুল্লাহ তাওয়াফ করতে পারবে না।’ আর এই কুরবানীর দিনই হচ্ছে হজে (হজ্জে) আকবার এবং হজে (হজ্জে) আকবার হলো হজ (হজ্জ)।[1] সহীহ।",
			"grades": [
				{
					"name": "Al-Albani",
					"grade": "Sahih"
				},
				{
					"name": "Muhammad Muhyi Al-Din Abdul Hamid",
					"grade": "Sahih"
