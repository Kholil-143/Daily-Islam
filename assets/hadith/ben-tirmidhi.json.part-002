		{
			"hadithnumber": 1186,
			"arabicnumber": 1186,
			"text": "। সাওবান (রাঃ) হতে বর্ণিত আছে, নবী সাল্লাল্লাহু আলাইহি ওয়াসাল্লাম বলেনঃ খোলা তালাক দাবিকারিণী নারীরা মুনাফিক। — সহীহ, সহীহা (৬৩৩), মিশকাত তাহকীক ছানী (৩২৯০) এ হাদীসটিকে উল্লেখিত সনদসূত্রে আবু ঈসা গরীব বলেছেন। এর সনদ খুব একটা মজবুত নয়। রাসূলুল্লাহ সাল্লাল্লাহু আলাইহি ওয়াসাল্লাম হতে আরো বর্ণিত আছে যে, তিনি বলেছেনঃ “যে সকল নারী স্বামীর নিকট হতে কোন বিবেচনাযোগ্য কারণ ছাড়াই খোলা তালাক গ্রহণ করে সে জান্নাতের সুগন্ধও পাবে না”।",
			"grades": [
				{
					"name": "Ahmad Muhammad Shakir",
					"grade": "Sahih"
				},
				{
					"name": "Al-Albani",
					"grade": "Sahih"
				},
				{
					"name": "Zubair Ali Zai",
					"grade": "Sahih"
				}
			],
			"reference": {
				"book": 13,
				"hadith": 13
