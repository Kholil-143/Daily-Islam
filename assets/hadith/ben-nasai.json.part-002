					"name": "Zubair Ali Zai",
					"grade": "Sahih Muslim"
				}
			],
			"reference": {
				"book": 22,
				"hadith": 50
			}
		},
		{
			"hadithnumber": 2140,
			"arabicnumber": 2140,
			"text": "। মুহাম্মাদ ইবনু মুছান্না (রহঃ) ... ইবনু উমর (রাঃ) সুত্রে নবী সাল্লাল্লাহু আলাইহি ওয়াসাল্লাম থেকে বর্ণিত। তিনি বলেন যে, আমরা হলাম উম্মাতে উম্মিয়্যা। (মা এর শিশু সন্তানের মত) আমরা ভাল করে লিখা জানি না আর ভাল করে হিসাবও জানি না। মাস এত দিনের হয়, মাস এত দিনের হয়, মাস এত দিনের হয়। এরকম তিনবার বলে তিনি ঊনত্রিশ দিনের উল্লেখ করলেন।",
			"grades": [
				{
					"name": "Abu Ghuddah",
					"grade": "Sahih"
				},
				{
					"name": "Al-Albani",
					"grade": "Sahih"
				},
				{
					"name": "Zubair Ali Zai",
					"grade": "Sahih - Agreed Upon"
