				},
				{
					"name": "Al-Albani",
					"grade": "Daif"
				},
				{
					"name": "Zubair Ali Zai",
					"grade": "Daif"
				}
			],
			"reference": {
				"book": 22,
				"hadith": 197
			}
		},
		{
			"hadithnumber": 2287,
			"arabicnumber": 2287,
			"text": "। মুহাম্মাদ ইবনু হাতিম (রহঃ) ... ইবনু আব্বাস (রাঃ) থেকে বর্ণিত যে, নবী সাল্লাল্লাহু আলাইহি ওয়াসাল্লাম একবার রমযান মাসে সফরে বের হলেন। যখন কুদায়দ নামক স্থানে পৌছলেন তখন একটি দুধের পেয়ালা আনা হলে তিনি এবং তার সাহাবীগণ তা পান করলেন এবং সাওম (রোযা/রোজা/সিয়াম/ছিয়াম) ভঙ্গ করে ফেললেন।",
			"grades": [
				{
					"name": "Abu Ghuddah",
					"grade": "Sahih Lighairihi"
				},
				{
					"name": "Al-Albani",
					"grade": "Sahih"
				},
				{
					"name": "Zubair Ali Zai",
					"grade": "Sahih"
				}
			],
			"reference": {
				"book": 22,
				"hadith": 198
			}
		},
		{
			"hadithnumber": 2288,
			"arabicnumber": 2288,
			"text": "। কাসিম ইবনু যাকারিয়্যা (রহঃ) ... ইবনু আব্বাস (রাঃ) থেকে বর্ণিত। তিনি বলেন যে, রাসুলুল্লাহ সাল্লাল্লাহু আলাইহি ওয়াসাল্লাম মদীনায় সাওম (রোযা/রোজা/সিয়াম/ছিয়াম) শুরু করে (সফর করে) কুদায়দ নামক স্থানে আসলেন এবং সাওম ভঙ্গ করে মক্কায় পৌছলেন।",
			"grades": [
