					"name": "Abu Ghuddah",
					"grade": "Sahih"
				},
				{
					"name": "Al-Albani",
					"grade": "Sahih"
				},
				{
					"name": "Zubair Ali Zai",
					"grade": "Hasan"
				}
			],
			"reference": {
				"book": 20,
				"hadith": 169
			}
		},
		{
			"hadithnumber": 1767,
			"arabicnumber": 1767,
			"text": "। ইসহাক ইবনু মানসূর (রহঃ) ... হাফসা (রাঃ) থেকে বর্ণিত। তিনি বলেন, রাসুলুল্লাহ সাল্লাল্লাহু আলাইহি ওয়াসাল্লাম ফজরের ফরয সালাত এবং আযানের মাঝখানে সংক্ষিপ্তভাবে দু’রাকআত সুন্নাত সালাত আদায় করতেন।",
			"grades": [
				{
					"name": "Abu Ghuddah",
					"grade": "Sahih"
				},
				{
					"name": "Al-Albani",
					"grade": "Sahih"
				},
				{
					"name": "Zubair Ali Zai",
					"grade": "Hasan"
				}
			],
			"reference": {
				"book": 20,
				"hadith": 170
			}
		},
		{
			"hadithnumber": 1768,
			"arabicnumber": 1768,
			"text": "। হিশাম ইবনু আম্মার (রহঃ) ... হাফসা (রাঃ) থেকে বর্ণিত যে, নবী সাল্লাল্লাহু আলাইহি ওয়াসাল্লাম ফজরের আযান এবং ইকামাতের মধ্যবর্তী সময়ে সংক্ষিপ্তভাবে দু’রাকআত ফজরের সুন্নাত সালাত আদায় করতেন।",
			"grades": [
				{
					"name": "Abu Ghuddah",
					"grade": "Sahih"
				},
				{
					"name": "Al-Albani",
					"grade": "Sahih"
				},
				{
					"name": "Zubair Ali Zai",
					"grade": "Hasan"
				}
			],
			"reference": {
				"book": 20,
				"hadith": 171
			}
		},
		{
			"hadithnumber": 1769,
			"arabicnumber": 1769,
			"text": "। ইসহাক ইবনু মানসুর (রহঃ) ... উমর (রাঃ) থেকে বর্ণিত যে, হাফসা (রাঃ) তাঁকে বর্ণনা করেছেন যে, রাসুলুল্লাহ সাল্লাল্লাহু আলাইহি ওয়াসাল্লাম ফজরের আযান এবং ইকামাতের মধ্যবর্তী সময়ে সংক্ষিপ্তভাবে দু’রাকআত ফজরের সুন্নাত আদায় করতেন।",
			"grades": [
				{
					"name": "Abu Ghuddah",
					"grade": "Sahih"
				},
				{
					"name": "Al-Albani",
					"grade": "Sahih"
				},
				{
					"name": "Zubair Ali Zai",
					"grade": "Hasan"
				}
			],
			"reference": {
				"book": 20,
				"hadith": 172
			}
		},
		{
			"hadithnumber": 1770,
			"arabicnumber": 1770,
			"text": "। ইয়াহইয়া ইবনু মুহাম্মাদ (রহঃ) ... ইবনু উমর (রাঃ) থেকে বর্ণিত। তিনি বলেন, হাফসা (রাঃ) আমাকে সংবাদ দিয়েছেন যে, রাসুলুল্লাহ সাল্লাল্লাহু আলাইহি ওয়াসাল্লাম ফজরের ফরয সালাতের পুর্বে দু’রাকআত সুন্নাত আদায় করতেন।",
			"grades": [
				{
					"name": "Abu Ghuddah",
					"grade": "Sahih"
				},
				{
					"name": "Al-Albani",
					"grade": "Sahih"
				},
				{
					"name": "Zubair Ali Zai",
					"grade": "Hasan"
				}
			],
			"reference": {
				"book": 20,
				"hadith": 173
			}
		},
		{
			"hadithnumber": 1771,
			"arabicnumber": 1771,
			"text": "। মুহাম্মাদ ইবনু আব্দুল্লাহ (রহঃ) ... ইবনু উমর (রাঃ) থেকে বর্ণিত যে, হাফসা (রাঃ) তাকে অবহিত করেছেন যে, রাসুলুল্লাহ সাল্লাল্লাহু আলাইহি ওয়াসাল্লাম যখন ফজরের সালাতের আযান দেয়া হত তখন ফরয সালাতের পূর্বে দু’রাকআত সুন্নাত আদায় করতেন।",
			"grades": [
				{
					"name": "Abu Ghuddah",
					"grade": "Sahih"
				},
				{
					"name": "Al-Albani",
					"grade": "Sahih"
				},
				{
					"name": "Zubair Ali Zai",
					"grade": "Hasan"
				}
			],
			"reference": {
				"book": 20,
				"hadith": 174
			}
		},
		{
			"hadithnumber": 1772,
			"arabicnumber": 1772,
			"text": "। আব্দুল্লাহ ইবনু ইসহাক (রহঃ) ... ইবনু উমর (রাঃ) থেকে বর্ণিত যে, উম্মুল মু'মিনীন হাফসা (রাঃ) তাকে সংবাদ দিয়েছেন রাসুলুল্লাহ সাল্লাল্লাহু আলাইহি ওয়াসাল্লাম মুয়ায্‌যিন চুপ হয়ে গেলে সংক্ষিপ্তভাবে দু’রাকআত ফজরের সুন্নাত আদায় করতেন।",
			"grades": [
				{
					"name": "Abu Ghuddah",
					"grade": "Sahih"
				},
				{
					"name": "Al-Albani",
					"grade": "Sahih"
				},
				{
					"name": "Zubair Ali Zai",
					"grade": "Hasan"
				}
			],
			"reference": {
				"book": 20,
				"hadith": 175
			}
		},
		{
			"hadithnumber": 1773,
			"arabicnumber": 1773,
			"text": "। মুহাম্মাদ ইবনু সালামা (রহঃ) ... আব্দুল্লাহ ইবনু উমর (রাঃ) থেকে বর্ণিত যে, উম্মুল মু'মিনীন হাফসা (রাঃ) তাকে সংবাদ দিয়েছেন যে, রাসুলুল্লাহ সাল্লাল্লাহু আলাইহি ওয়াসাল্লাম মুয়ায্‌যিন ফজরের সালাতের আযান থেকে অবসর হয়ে গেলে এবং সুবহে সাদিক প্রকাশিত হয়ে গেলে ফজরের ফরয সালাত শুরু হওয়ার পুর্বে সংক্ষিপ্তভাবে দু’রাকআত সুন্নাত আদায় করতেন।",
			"grades": [
				{
					"name": "Abu Ghuddah",
					"grade": "Sahih"
				},
				{
					"name": "Al-Albani",
					"grade": "Sahih"
				},
				{
					"name": "Zubair Ali Zai",
					"grade": "Hasan"
				}
			],
			"reference": {
				"book": 20,
				"hadith": 176
			}
		},
		{
			"hadithnumber": 1774,
			"arabicnumber": 1774,
			"text": "। ইসমাঈল ইবনু মাসউদ (রহঃ) ... আব্দুল্লাহ ইবনু উমর (রাঃ) থেকে বর্ণিত। তিনি বলেন, আমাকে আমার বোন হাফসা (রাঃ) বর্ণনা করেছেন যে, নবী সাল্লাল্লাহু আলাইহি ওয়াসাল্লাম ফজরের ফরয সালাতের পূর্বে সংক্ষিপ্তভাবে দু’রাকআত সুন্নাত আদায় করতেন।",
			"grades": [
				{
					"name": "Abu Ghuddah",
					"grade": "Sahih"
				},
				{
					"name": "Al-Albani",
					"grade": "Sahih"
				},
				{
					"name": "Zubair Ali Zai",
					"grade": "Hasan"
				}
			],
			"reference": {
				"book": 20,
				"hadith": 177
			}
		},
		{
			"hadithnumber": 1775,
			"arabicnumber": 1775,
			"text": "। মুহাম্মাদ ইবনু আব্দুল্লাহ (রহঃ) ... হাফসা (রাঃ) থেকে বর্ণিত যে, রাসুলুল্লাহ সাল্লাল্লাহু আলাইহি ওয়াসাল্লাম সুবহে সাদিক উদয় হওয়ার পর দু’রাকআত ফজরের সুন্নাত আদায় করতেন।",
			"grades": [
				{
					"name": "Abu Ghuddah",
					"grade": "Sahih"
				},
				{
					"name": "Al-Albani",
					"grade": "Sahih"
				},
				{
					"name": "Zubair Ali Zai",
					"grade": "Isnaad Sahih"
				}
			],
			"reference": {
				"book": 20,
				"hadith": 178
			}
		},
		{
			"hadithnumber": 1776,
			"arabicnumber": 1776,
			"text": "। আহমদ ইবনু আব্দুল্লাহ (রহঃ) ... হাফসা (রাঃ) থেকে বর্ণিত। তিনি বলেন, রাসুলুল্লাহ সাল্লাল্লাহু আলাইহি ওয়াসাল্লাম সুবহে সাদিক উদয় হওয়ার পর সংক্ষিপ্তভাবে ফজরের দু’রাকআত সুন্নাত ব্যতীত (ফরয সালাতের পূর্বে) অন্য কোন সালাত আদায় করতেন না।",
			"grades": [
				{
					"name": "Abu Ghuddah",
					"grade": "Sahih"
				},
				{
					"name": "Al-Albani",
					"grade": "Sahih"
				}
			],
			"reference": {
				"book": 20,
				"hadith": 179
			}
		},
		{
			"hadithnumber": 1777,
			"arabicnumber": 1777,
			"text": "। কুতায়বা ইবনু সাঈদ (রহঃ) ... হাফসা (রাঃ) সুত্রে রাসুলুল্লাহ সাল্লাল্লাহু আলাইহি ওয়াসাল্লাম থেকে বর্ণিত যে, তিনি ফজরের আযান দেওয়া হলে ফজরের ফরয সালাত আদায় করার জন্য মসজিদে যাওয়ার পূর্বে সংক্ষিপ্তভাবে দু’রাকআত সুন্নাত আদায় করতেন।",
			"grades": [
				{
					"name": "Abu Ghuddah",
					"grade": "Sahih"
				},
				{
					"name": "Al-Albani",
					"grade": "Sahih"
				},
				{
					"name": "Zubair Ali Zai",
					"grade": "Hasan"
				}
			],
			"reference": {
				"book": 20,
				"hadith": 180
			}
		},
		{
			"hadithnumber": 1778,
			"arabicnumber": 1778,
			"text": "। ইসহাক ইবনু ইবরাহীম (রহঃ) ... সালিম (রহঃ) থেকে বর্ণিত যে, ইবনু উমর (রাঃ) বলেছেনঃ হাফসা (রাঃ) আমাকে খবর দিয়েছেন যে, রাসুলুল্লাহ সাল্লাল্লাহু আলাইহি ওয়াসাল্লাম ফজরের (ফরয সালাতের) পুর্বে দু’রাকআত সুন্নাত আদায় করতেন এবং তা সুবহে সাদিক উদয় হওয়ার পরে আদায় করতেন।",
			"grades": [
				{
					"name": "Abu Ghuddah",
					"grade": "Sahih"
				},
				{
					"name": "Al-Albani",
					"grade": "Sahih"
				},
				{
					"name": "Zubair Ali Zai",
					"grade": "Hasan"
				}
			],
			"reference": {
				"book": 20,
				"hadith": 181
			}
		},
		{
			"hadithnumber": 1779,
			"arabicnumber": 1779,
			"text": "। হুসায়ন ইবনু ঈসা (রহঃ) ... ইবনু উমর (রাঃ) থেকে বর্ণিত। তিনি বলেন, হাফসা (রাঃ) আমাকে সংবাদ দিয়েছেন যে, রাসুলুল্লাহ সাল্লাল্লাহু আলাইহি ওয়াসাল্লাম সুবহে সাদিক প্রকাশিত হয়ে গেলে দু’রাকআত ফজরের সুন্নাত আদায় করতেন।",
			"grades": [
				{
					"name": "Abu Ghuddah",
					"grade": "Sahih"
				},
				{
					"name": "Al-Albani",
					"grade": "Sahih"
				},
				{
					"name": "Zubair Ali Zai",
					"grade": "Hasan"
				}
			],
			"reference": {
				"book": 20,
				"hadith": 182
			}
		},
		{
			"hadithnumber": 1780,
			"arabicnumber": 1780,
			"text": "। মাহমূদ ইবনু খালিদ (রহঃ) ... আয়িশা (রাঃ) থেকে বর্ণিত যে, রাসুলুল্লাহ সাল্লাল্লাহু আলাইহি ওয়াসাল্লাম ফজরের আযান এবং ইকামাতের মধ্যবর্তী সময়ে সংক্ষিপ্তভাবে দু’রাকআত সুন্নাত আদায় করতেন।",
			"grades": [
