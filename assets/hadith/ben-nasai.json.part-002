			}
		},
		{
			"hadithnumber": 1696,
			"arabicnumber": 1696,
			"text": "। ইসহাক ইবনু মানসূর (রহঃ) ... আয়িশা (রাঃ) থেকে বর্ণিত যে, নবী সাল্লাল্লাহু আলাইহি ওয়াসাল্লাম রাত্রে এগার রাকআত সালাত আদায় করতেন। (পূর্ববর্তী দু'টি রাকআতকে) একটি রাকআত দ্বারা বেজোড় বানিয়ে নিতেন। তারপর তার ডান পার্শ্বে শুয়ে পড়তেন।",
			"grades": [
				{
					"name": "Abu Ghuddah",
					"grade": "Shadh"
				},
				{
					"name": "Al-Albani",
					"grade": "Shadh"
				},
				{
					"name": "Zubair Ali Zai",
					"grade": "Sahih Muslim"
				}
			],
			"reference": {
				"book": 20,
				"hadith": 99
			}
		},
		{
			"hadithnumber": 1697,
			"arabicnumber": 1697,
			"text": "। মুহাম্মদ ইবনু সালামা এবং হারিছ ইবনু মিসকীন (রহঃ) ... আবূ সালামা ইবনু আব্দুর রহমান (রাঃ) থেকে বর্ণিত যে, তিনি আয়িশা (রাঃ) কে জিজ্ঞাসা করেনঃ রমযান মাসে রাসুলুল্লাহ সাল্লাল্লাহু আলাইহি ওয়াসাল্লাম এর (নফল) সালাত কি রকম ছিল? তিনি বলেন, রাসুলুল্লাহ সাল্লাল্লাহু আলাইহি ওয়াসাল্লাম রমযান অথবা অন্য সময়ে রাত্রে এগার রাকআতের বেশী সালাত আদায় করতেন না। তিনি চার রাকআত সালাত আদায় করতেন। (সালাত) তার একাগ্রতা এবং তার সালাত দীর্ঘায়িত করা সমন্ধে কোন প্রশ্ন করো না। তারপর আরও চার রাকআত সালাত দু’আদায় করতেন। তার এ একাগ্রতা এবং সালাত দীর্ঘায়িতকরণ সম্বন্ধে কোন প্রশ্ন করো না। তারপর (মাঝখানে সালাম না ফিরায়ে) আরো তিন রাকআত সালাত আদায় করতেন। আয়িশা (রাঃ) বলেন, আমি বললাম, ইয়া রাসুলাল্লাহ! আপনি কি বিতরের সালাত আদায় করার পূর্বেই নিদ্রা যান? তিনি বললেন, হে আয়িশা! আমার আখি যুগল তো নিদ্রা যায় কিন্তু আমার হদয় নিদ্রা যায় না।",
			"grades": [
				{
					"name": "Abu Ghuddah",
					"grade": "Sahih"
				},
				{
					"name": "Al-Albani",
					"grade": "Sahih"
				},
				{
					"name": "Zubair Ali Zai",
					"grade": "Sahih - Agreed Upon"
				}
			],
			"reference": {
				"book": 20,
				"hadith": 100
			}
		},
		{
			"hadithnumber": 1698,
			"arabicnumber": 1698,
			"text": "। ইসমাঈল ইবনু মাসউদ (রহঃ) ... সা’দ ইবনু হিশাম (রাঃ) থেকে বর্ণিত যে, আয়িশা (রাঃ) তার নিকট বর্ণনা করেছেন রাসুলুল্লাহ সাল্লাল্লাহু আলাইহি ওয়াসাল্লাম বিতরের সালাতে দু’রাকআতে সালাম ফিরাতেন না।",
			"grades": [
				{
					"name": "Abu Ghuddah",
					"grade": "Shadh"
				},
				{
					"name": "Al-Albani",
					"grade": "Shadh"
				},
				{
					"name": "Zubair Ali Zai",
					"grade": "Daif"
				}
			],
			"reference": {
				"book": 20,
				"hadith": 101
			}
		},
		{
			"hadithnumber": 1699,
			"arabicnumber": 1699,
			"text": "। আলী ইবনু মায়মূন (রহঃ) ... উবাই ইবনু কা'ব (রাঃ) থেকে বর্ণিত যে, রাসুলুল্লাহ সাল্লাল্লাহু আলাইহি ওয়াসাল্লাম বিতরের সালাত তিন রাকআত আদায় করতেন। প্রথম রাকআত “সাব্বিহিসমা রাব্বিকাল আলা” দ্বিতীয় রাকআতে “ইয়া আয়্যুহাল কাফিরুন” তৃতীয় রাকআতে “কুল হুওয়াল্লাহু আহাদ” পাঠ করতেন এবং রুকুতে যাওয়ার পুর্বে দোয়ায়ে কুনূত পড়তেন। যখন সালাত শেষ করতে যেতেন তখন তিনি শেষ পর্যন্ত তিনবারسُبْحَانَ الْمَلِكِ الْقُدُّوسِ পড়তেন।",
			"grades": [
				{
					"name": "Abu Ghuddah",
					"grade": "Sahih"
				},
				{
					"name": "Al-Albani",
					"grade": "Sahih"
				},
				{
					"name": "Zubair Ali Zai",
					"grade": "Sahih"
				}
			],
			"reference": {
				"book": 20,
				"hadith": 102
			}
		},
		{
			"hadithnumber": 1700,
			"arabicnumber": 1700,
			"text": "। ইসহাক ইবনু ইবরাহীম (রহঃ) ... উবাই ইবনু কা'ব (রাঃ) থেকে বর্ণিত। তিনি বলেন, রাসুলুল্লাহ সাল্লাল্লাহু আলাইহি ওয়াসাল্লাম বিতরের প্রথম রাকআতে “সাব্বিহিসমা রাব্বিকাল আলা” দ্বিতীয় রাকআতে “ইয়া আয়্যুহাল কাফিরুন” এবং তৃতীয় রাকআতে “কুল হুওয়াল্লাহু আহাদ” পাঠ করতেন।",
