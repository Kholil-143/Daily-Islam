			"reference": {
				"book": 22,
				"hadith": 146
			}
		},
		{
			"hadithnumber": 2236,
			"arabicnumber": 2236,
			"text": "। আলী ইবনু হুজর (রহঃ) ... সাহল ইবনু সা'দ (রাঃ) সূত্রে নবী সাল্লাল্লাহু আলাইহি ওয়াসাল্লাম থেকে বর্ণিত। তিনি বলেছেন যে, সাওম (রোযা/রোজা/সিয়াম/ছিয়াম) পালনকারীদের জন্য জান্নাতে একটি দরজা রয়েছে যাকে রাইয়ান বলা হয়, সে দরজা দিয়ে সাওম পালনকারীগণ ব্যতীত অন্য কেউ প্রবেশ করতে পারবে না। যখন তাদের শেষ ব্যক্তি প্রবেশ করে ফেলবে, সে দরজা বন্ধ করে দেওয়া হবে। যে ব্যক্তি সে দরজা দিযে প্রবেশ করবে সে পানি পান করবে আর যে পানি পান করবে সে কখনো ক্ষুধার্ত হবে না।",
			"grades": [
				{
					"name": "Abu Ghuddah",
					"grade": "Sahih"
				},
				{
					"name": "Al-Albani",
					"grade": "Sahih"
				},
				{
					"name": "Zubair Ali Zai",
					"grade": "Isnaad Sahih"
				}
			],
			"reference": {
				"book": 22,
				"hadith": 147
			}
		},
		{
			"hadithnumber": 2237,
			"arabicnumber": 2237,
			"text": "। কুতায়বা (রহঃ) ... আবূ হাকিম (রহঃ) থেকে বর্ণিত। তিনি বলেন, সাহল আমার কাছে বর্ণনা করেছেন যে, নিশ্চয়ই জান্নাতে একটি দরজা আছে যাকে রাইয়ান বলা হয়। কিমামতের দিন বলা হবে কোথায় সাওম (রোযা/রোজা/সিয়াম/ছিয়াম) পালনকারীরা? তোমরা কেন রাইয়ান এর দিকে আসছ না? যে ব্যক্তি সে দরজা দিয়ে প্রবেশ করবে সে কখনো তৃষ্ণার্ত হবে না। যখন সাওম পালনকারীরা প্রবেশ করে ফেলবে সে দরজা বন্ধ করে দেওয়া হবে। অতএব সে দরজা দিয়ে সাওম পালনকারীগণ ব্যতীত অন্য কেউ প্রবেশ করতে পারবে না।",
			"grades": [
				{
					"name": "Abu Ghuddah",
					"grade": "Sahih Isnaad Mauquf"
				},
				{
					"name": "Al-Albani",
					"grade": "Sahih Isnaad Mauquf"
				},
				{
					"name": "Zubair Ali Zai",
					"grade": "Hasan"
				}
