					"grade": "Hasan"
				}
			],
			"reference": {
				"book": 22,
				"hadith": 14
			}
		},
		{
			"hadithnumber": 2104,
			"arabicnumber": 2104,
			"text": "। আবূ বকর ইবনু আলী (রহঃ) ... আবূ হুরায়রা (রাঃ) থেকে বর্ণিত যে, নবী সাল্লাল্লাহু আলাইহি ওয়াসাল্লাম ফরয ব্যতীত রমযানের তারাবীহর সালাত আদায় করার জন্যও উৎসাহিত করতেন। তিনি বলতেন যে, যখন রমযান আগমন করে জান্নাতের দরজাসমূহ খূলে দেয়া হয়, জাহান্নামের দরজাসমূহ বন্ধ করে দেয়া হয় আর শয়তানদেরকে শৃঙ্খলাবদ্ধ করে রাখা হয়।",
			"grades": [
