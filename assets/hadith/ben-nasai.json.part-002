					"grade": "Hasan Sahih"
				},
				{
					"name": "Al-Albani",
					"grade": "Sahih"
				},
				{
					"name": "Zubair Ali Zai",
					"grade": "Hasan"
				}
			],
			"reference": {
				"book": 22,
				"hadith": 235
			}
		},
		{
			"hadithnumber": 2325,
			"arabicnumber": 2325,
			"text": "। আহমদ ইবনু হারব (রহঃ) ... উম্মুল মু'মিনীন আয়েশা (রাঃ) থেকে বর্ণিত। তিনি বলেন, রাসুলুল্লাহ সাল্লাল্লাহু আলাইহি ওয়াসাল্লাম একদিন আমাদের কাছে আসলেন তখন আমরা বললাম যে, আমাদেরকে কিছু হায়স উপহার দেওয়া ছিল। আমরা তার থেকে আপনার জন্য কিছু রেখে দিয়েছিলাম। তিনি বললেন যে, আমি তো সাওমের নিয়্যত করে ফেলেছিলাম অতঃপর তিনি সাওম ভঙ্গ করে ফেললেন।",
			"grades": [
				{
					"name": "Abu Ghuddah",
					"grade": "Hasan Sahih"
				},
				{
					"name": "Al-Albani",
					"grade": "Hasan Sahih"
				},
				{
					"name": "Zubair Ali Zai",
					"grade": "Sahih Muslim"
				}
			],
			"reference": {
				"book": 22,
				"hadith": 236
			}
		},
		{
			"hadithnumber": 2326,
			"arabicnumber": 2326,
			"text": "। আমর ইবনু আলী (রহঃ) ... উম্মুল মু'মিনীন আয়িশা (রাঃ) থেকে বর্ণিত যে, নবী সাল্লাল্লাহু আলাইহি ওয়াসাল্লাম একবার তার কাছে আসলেন তখন তিনি সাওম পালন করছিলেন। তিনি জিজ্ঞাসা করলেন, তোমাদের কাছে আহারের কিছু আছে কি যা আমাকে খাওয়াতে পার? আমরা বললাম, না; তখন রাসুলুল্লাহ সাল্লাল্লাহু আলাইহি ওয়াসাল্লাম বললেন, তাহলে আমি সাওমের নিয়্যত করে নিলাম। এরপর তিনি আয়িশা (রাঃ)-এর কাছে আবার আসলেন তখন আয়িশা (রাঃ) বললেন যে, আমাদেরকে কিছু উপহার দেওয়া হয়েছে তিনি জিজ্ঞাসা করলেন, কি? তিনি বললেন, হায়স, তখন রাসুলুল্লাহ সাল্লাল্লাহু আলাইহি ওয়াসাল্লাম বললেন, আমি তো সকালে সাওমের নিয়্যত করে ফেলেছিলাম, অতঃপর খেলেন।",
			"grades": [
				{
					"name": "Abu Ghuddah",
					"grade": "Hasan Sahih"
				},
				{
					"name": "Al-Albani",
					"grade": "Hasan Sahih"
				},
				{
					"name": "Zubair Ali Zai",
					"grade": "Hasan"
				}
			],
			"reference": {
				"book": 22,
				"hadith": 237
			}
		},
		{
			"hadithnumber": 2327,
			"arabicnumber": 2327,
			"text": "। ইসহাক ইবনু ইবরাহীম (রহঃ) ... উম্মুল মু'মিনীন আয়িশা (রাঃ) থেকে বর্ণিত। তিনি বলেন, একবার রাসুলুল্লাহ সাল্লাল্লাহু আলাইহি ওয়াসাল্লাম আমার কাছে এসে জিজ্ঞাসা করলেন তোমার কাছে আহারের কিছু আছে কি? আমি বললাম, না; তিনি বললেন, তাহলে আমি সাওমের নিয়তে করে ফেললাম।",
			"grades": [
				{
					"name": "Abu Ghuddah",
					"grade": "Hasan Sahih"
				},
				{
					"name": "Al-Albani",
					"grade": "Hasan Sahih"
				},
				{
					"name": "Zubair Ali Zai",
					"grade": "Hasan"
				}
			],
			"reference": {
				"book": 22,
				"hadith": 238
			}
		},
		{
			"hadithnumber": 2328,
			"arabicnumber": 2328,
			"text": "। আবূ বকর ইবনু আলী (রহঃ) ... আয়েশা বিনত তালহা এবং মুজাহিদ (রহঃ) সুত্রে আয়িশা (রাঃ) থেকে বর্ণিত যে, একবার রাসুলুল্লাহ সাল্লাল্লাহু আলাইহি ওয়াসাল্লাম তার কাছে এসে বললেন, তোমার কাছে আহারের কিছু আছে কি? আমি বললাম না; তিনি বললেন, তাহলে আমি সাওমের নিয়্যত করে ফেললাম। রাবী বলেন, তিনি আরেক দিন আসলেন তখন আয়িশা (রাঃ) বললেন, ইয়া রাসুলাল্লাহ! আমাকে কিছু হায়স উপহার দেওয়া হয়েছে। তিনি তা চেয়ে নিলেন এবং বললেন যে, আজকে সকালে তো আমি সাওমের নিয়্যত করে ফেলেছিলাম। অতঃপর তা খেলেন।",
			"grades": [
				{
					"name": "Abu Ghuddah",
					"grade": "Hasan Sahih"
				},
				{
					"name": "Al-Albani",
					"grade": "Hasan Sahih"
				},
				{
					"name": "Zubair Ali Zai",
					"grade": "Sahih"
				}
			],
			"reference": {
				"book": 22,
				"hadith": 239
			}
		},
		{
			"hadithnumber": 2329,
			"arabicnumber": 2329,
			"text": "। আমর ইবনু ইয়াহইয়া (রহঃ) ... মুজাহিদ এবং উম্মে কুলসূম (রাঃ) থেকে বর্ণিত যে, রাসুলুল্লাহ সাল্লাল্লাহু আলাইহি ওয়াসাল্লাম একবার আয়িশা (রাঃ)-এর কাছে গেলেন এবং জিজ্ঞাসা করলেন যে, তোমার কাছে আহারের কিছু আছে কি? রাবী পূর্বের বর্ণনার অনুরূপ বর্ণনা করেছেন।",
			"grades": [
				{
					"name": "Al-Albani",
					"grade": "Daif"
				},
				{
					"name": "Zubair Ali Zai",
					"grade": "Hasan"
				}
			],
			"reference": {
				"book": 22,
				"hadith": 240
			}
		},
		{
			"hadithnumber": 2330,
			"arabicnumber": 2330,
			"text": "। সাফওয়ান ইবনু আমর (রহঃ) ... উম্মুল মু'মিনীন আয়িশা (রাঃ) থেকে বর্ণিত। তিনি বলেন যে, রাসুলুল্লাহ সাল্লাল্লাহু আলাইহি ওয়াসাল্লাম একবার তাঁর কাছে আসলেন এবং জিজ্ঞাসা করলেন, তোমার কাছে আহারের কিছু আছে কি? আমি বললাম না; তখন তিনি বললেন, তাহলে আমি সাওমের নিয়ত করে ফেললাম। আযেশা (রাঃ) বলেন, তিনি আমার কাছে আরেকবার আসলেন, তখন আমি বললামঃ ইয়া রাসুলাল্লাহ! আমাকে কিছু হায়স উপহার দেওয়া হয়েছে। তিনি বললেন, তাহলে আজ আমি সাওম পালন করব না অথচ আমি সাওমের নিয়্যত করে ফেলেছিলাম।",
			"grades": [
				{
					"name": "Abu Ghuddah",
					"grade": "Sahih Lighairihi"
				},
				{
					"name": "Al-Albani",
					"grade": "Sahih"
				},
				{
					"name": "Zubair Ali Zai",
					"grade": "Sahih"
				}
			],
			"reference": {
				"book": 22,
				"hadith": 241
			}
		},
		{
			"hadithnumber": 2331,
			"arabicnumber": 2331,
			"text": "। কাসেম ইবনু যাকারিয়া (রহঃ) ... হাফসা (রাঃ) রাসুলুল্লাহ সাল্লাল্লাহু আলাইহি ওয়াসাল্লাম থেকে বর্ণিত। তিনি বলেনঃ যে ব্যক্তি (রমযানের সাওম ব্যতীত) রাত্রে সাওমের নিয়্যত না করে তার সাওম পালন করা হবে না।",
			"grades": [
				{
					"name": "Abu Ghuddah",
					"grade": "Sahih"
				},
				{
					"name": "Al-Albani",
					"grade": "Sahih"
				},
				{
					"name": "Zubair Ali Zai",
					"grade": "Daif"
				}
			],
			"reference": {
				"book": 22,
				"hadith": 242
			}
		},
		{
			"hadithnumber": 2332,
			"arabicnumber": 2332,
			"text": "। আব্দুল মালিক ইবনু শুআয়ব (রহঃ) ... হাফসা (রাঃ) সুত্রে নবী সাল্লাল্লাহু আলাইহি ওয়াসাল্লাম থেকে বর্ণিত। তিনি বলেন, যে ব্যক্তি রাত্রে ফজরের পূর্বেই সাওমের নিয়্যত (দূঢ় ইচ্ছা) না করে তার সাওম পালন হবে না।",
			"grades": [
				{
					"name": "Abu Ghuddah",
					"grade": "Sahih"
				},
				{
					"name": "Al-Albani",
					"grade": "Sahih"
				},
				{
					"name": "Zubair Ali Zai",
					"grade": "Daif"
				}
			],
			"reference": {
				"book": 22,
				"hadith": 243
			}
		},
		{
			"hadithnumber": 2333,
			"arabicnumber": 2333,
			"text": "। মুহাম্মাদ ইবনু আব্দুল্লাহ (রহঃ) ... হাফসা (রাঃ) সুত্রে নবী সাল্লাল্লাহু আলাইহি ওয়াসাল্লাম থেকে বর্ণিত। তিনি বলেন, যে ব্যক্তি ফজর উদয়ের পূর্বেই রাত্রে সাওমের নিয়ত না করে তার সাওম পালন হবে না।",
			"grades": [
				{
					"name": "Abu Ghuddah",
					"grade": "Sahih"
				},
				{
					"name": "Al-Albani",
					"grade": "Sahih"
				},
				{
					"name": "Zubair Ali Zai",
					"grade": "Daif"
				}
			],
			"reference": {
				"book": 22,
				"hadith": 244
			}
		},
		{
			"hadithnumber": 2334,
			"arabicnumber": 2334,
			"text": "। আহমদ ইবনু আযহার (রহঃ) ... হাফসা (রাঃ) থেকে বর্ণিত। যে ব্যক্তি রাত্রে সাওমের নিয়্যত না করে তার সাওম পালন হবে না।",
			"grades": [
				{
					"name": "Abu Ghuddah",
					"grade": "Sahih"
				},
				{
					"name": "Al-Albani",
					"grade": "Sahih"
				},
				{
					"name": "Zubair Ali Zai",
					"grade": "Daif"
				}
			],
			"reference": {
				"book": 22,
				"hadith": 245
			}
		},
		{
			"hadithnumber": 2335,
			"arabicnumber": 2335,
			"text": "। মুহাম্মদ ইবনু আব্দুল আলা (রহঃ) ... আব্দুল্লাহ (রাঃ) হাফসা (রাঃ) থেকে বর্ণিত। তিনি বলতেন, যে ব্যক্তি রাত্রে সাওমের নিয়্যত না করবে তার সাওম পালন হবে না।",
			"grades": [
				{
					"name": "Abu Ghuddah",
					"grade": "Sahih Muquf"
				},
				{
					"name": "Al-Albani",
					"grade": "Sahih Muquf"
				},
				{
					"name": "Zubair Ali Zai",
					"grade": "Daif"
				}
			],
			"reference": {
				"book": 22,
				"hadith": 246
			}
		},
		{
			"hadithnumber": 2336,
			"arabicnumber": 2336,
			"text": "। রবী ইবনু সুলায়মান (রহঃ) ... আব্দুল্লাহ ইবনু উমর (রাঃ) থেকে বর্ণিত যে, হাফসা (রাঃ) বলেছেনঃ যে ব্যক্তি ফজরের পূর্বেই রাত্রে সাওমের নিয়্যত না করে তার সাওম পালন হবে না।",
			"grades": [
				{
					"name": "Abu Ghuddah",
					"grade": "Sahih Muquf"
				},
				{
					"name": "Al-Albani",
					"grade": "Sahih Muquf"
				},
				{
					"name": "Zubair Ali Zai",
					"grade": "Isnaad Sahih"
				}
			],
			"reference": {
				"book": 22,
				"hadith": 247
			}
		},
		{
			"hadithnumber": 2337,
			"arabicnumber": 2337,
			"text": "। যাকারিয়া ইবনু ইয়াহইয়া (রহঃ) ... হাফসা (রাঃ) থেকে বর্ণিত। তিনি বলেন, যে ব্যক্তি ফজরের পূর্বে রাত্রে সাওমের নিয়্যত না করে তার সাওম পালন হবে না।",
			"grades": [
