			"reference": {
				"book": 20,
				"hadith": 109
			}
		},
		{
			"hadithnumber": 1707,
			"arabicnumber": 1707,
			"text": "। হারুন ইবনু আব্দুল্লাহ (রহঃ) ... ইবনু আব্বাস (রাঃ) থেকে বর্ণিত। তিনি বলেন, রাসুলুল্লাহ সাল্লাল্লাহু আলাইহি ওয়াসাল্লাম রাত্রে আট রাকআত (তাহাজ্জুদ) সালাত আদায় করতেন এবং তিন রাকআত বিতরের সালাত আদায় করতেন এবং ফজরের ফরয সালাতের পূর্বে দু’রাকআত (সুন্নাত) সালাত আদায় করতেন।",
			"grades": [
				{
					"name": "Abu Ghuddah",
					"grade": "Sahih Lighairihi"
				},
				{
					"name": "Al-Albani",
					"grade": "Sahih"
				},
				{
					"name": "Zubair Ali Zai",
					"grade": "Sahih"
				}
