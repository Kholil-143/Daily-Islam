				"hadith": 142
			}
		},
		{
			"hadithnumber": 1740,
			"arabicnumber": 1740,
			"text": "। মুহাম্মাদ ইবনু বাশশার (রহঃ) ... সাঈদ আব্দুর রহমান ইবনু আবযা (রাঃ) থেকে বর্ণিত যে, রাসুলুল্লাহ সাল্লাল্লাহু আলাইহি ওয়াসাল্লাম “সাব্বিহিস্‌মা রাব্বিকাল আলা” “কুল ইয়া আয়্যুহাল কাফিরুন” এবং “কুল হুওয়াল্লাহু আহাদ”। দ্বারা বিতরের সালাত আদায় করতেন। আর যখন (সালাত থেকে) অবসর হয়ে যেতেন তখন তিনবার سُبْحَانَ الْمَلِكِ الْقُدُّوسِ পড়তেন।",
			"grades": [
				{
					"name": "Abu Ghuddah",
					"grade": "Sahih"
				},
				{
					"name": "Al-Albani",
					"grade": "Sahih"
				},
				{
					"name": "Zubair Ali Zai",
					"grade": "Sahih"
				}
			],
			"reference": {
				"book": 20,
				"hadith": 143
			}
		},
		{
			"hadithnumber": 1741,
			"arabicnumber": 1741,
			"text": "। ইসহাক ইবনু মানসূর (রহঃ) ... আব্দুর রহমান ইবনু আবযা (রাঃ) থেকে বর্ণিত যে, রাসুলুল্লাহ সাল্লাল্লাহু আলাইহি ওয়াসাল্লাম ”সাব্বিহিস্‌মা রাব্বিকাল আলা” “কুল ইয়া আয়্যুহাল কাফিরুন” এবং “কুল হুওয়াল্লাহু আহাদ” দ্বারা বিতরের সালাত আদায় করতেন। যখন সালাত থেকে অবসর হয়ে যেতেন তিনবার سُبْحَانَ الْمَلِكِ الْقُدُّوسِ পড়তেন এবং তৃতীয়বারে দীর্ঘ করতেন।",
			"grades": [
				{
					"name": "Abu Ghuddah",
					"grade": "Sahih"
				},
				{
					"name": "Al-Albani",
					"grade": "Sahih"
				},
				{
					"name": "Zubair Ali Zai",
					"grade": "Sahih"
				}
			],
			"reference": {
				"book": 20,
				"hadith": 144
			}
		},
		{
			"hadithnumber": 1742,
			"arabicnumber": 1742,
			"text": "। মুহাম্মাদ ইবনু মুসান্না (রহঃ) ... আব্দুর ইবনু আবযা (রাঃ) থেকে বর্ণিত যে, রাসুলুল্লাহ সাল্লাল্লাহু আলাইহি ওয়াসাল্লাম “সাব্বিহিস্‌মা রাব্বিকাল আ’লা” দ্বারা বিতরের সালাত আদায় করতেন।",
			"grades": [
				{
					"name": "Abu Ghuddah",
					"grade": "Sahih Lighairihi"
				},
				{
					"name": "Al-Albani",
					"grade": "Sahih"
				},
				{
					"name": "Zubair Ali Zai",
					"grade": "Sahih"
				}
			],
			"reference": {
				"book": 20,
				"hadith": 145
			}
		},
		{
			"hadithnumber": 1743,
			"arabicnumber": 1743,
			"text": "। বিশর ইবনু খালিদ (রহঃ) ... ইমরান ইবনু হুসায়ন (রাঃ) থেকে বর্ণিত যে, নবী সাল্লাল্লাহু আলাইহি ওয়াসাল্লাম “সাব্বিহিস্‌মা রাব্বিকাল আলা” দ্বারা বিতরের সালাত আদায় করতেন।",
			"grades": [
				{
					"name": "Abu Ghuddah",
					"grade": "Sahih Lighairihi"
				},
				{
					"name": "Al-Albani",
					"grade": "Sahih"
				},
				{
					"name": "Zubair Ali Zai",
					"grade": "Sahih"
				}
			],
			"reference": {
				"book": 20,
				"hadith": 146
			}
		},
		{
			"hadithnumber": 1744,
			"arabicnumber": 1744,
			"text": "। মুহাম্মাদ ইবনু মুসান্না (রহঃ) ... ইমরান ইবনু হুসায়ন (রাঃ) থেকে বর্ণিত। তিনি বলেন, রাসুলুল্লাহ সাল্লাল্লাহু আলাইহি ওয়াসাল্লাম একবার জোহরের সালাত আদায় করছিলেন। তখন এক ব্যক্তি “সাব্বিহিস্‌মা রাব্বিকাল আ'লা” তিলাওয়াত করল। তিনি সালাত আদায় শেষে জিজ্ঞাসা করলেন, “সাব্বিহিস্‌মা রাব্বিকাল আলা” কে তিলাওয়াত করেছিল? এক ব্যক্তি বলল, আমি। তিনি বললেন, আমি বুঝতে পেরেছিলাম যে, তোমাদের কেউ সালাতে আমাকে বিরক্ত করেছিলে।",
			"grades": [
				{
					"name": "Abu Ghuddah",
					"grade": "Sahih"
				},
				{
					"name": "Al-Albani",
					"grade": "Sahih"
				},
				{
					"name": "Zubair Ali Zai",
					"grade": "Hasan"
				}
			],
			"reference": {
				"book": 20,
				"hadith": 147
			}
		},
		{
			"hadithnumber": 1745,
			"arabicnumber": 1745,
			"text": "। কুতায়বা (রহঃ) ... আবূল জাউযা (রহঃ) থেকে বর্ণিত। তিনি বলেন, হাসান (রাঃ) বলেছেনঃ রাসুলুল্লাহ সাল্লাল্লাহু আলাইহি ওয়াসাল্লাম আমাকে কিছু বাক্য শিক্ষা দিয়েছিলেন যেগুলো আমি বিতরের কুনূতে পড়ে থাকিঃ اللَّهُمَّ اهْدِنِي فِيمَنْ هَدَيْتَ وَعَافِنِي فِيمَنْ عَافَيْتَ وَتَوَلَّنِي فِيمَنْ تَوَلَّيْتَ وَبَارِكْ لِي فِيمَا أَعْطَيْتَ وَقِنِي شَرَّ مَا قَضَيْتَ إِنَّكَ تَقْضِي وَلاَ يُقْضَى عَلَيْكَ وَإِنَّهُ لاَ يَذِلُّ مَنْ وَالَيْتَ تَبَارَكْتَ رَبَّنَا وَتَعَالَيْتَ",
			"grades": [
				{
					"name": "Abu Ghuddah",
					"grade": "Sahih"
				},
				{
					"name": "Al-Albani",
					"grade": "Sahih"
				},
				{
					"name": "Zubair Ali Zai",
					"grade": "Sahih"
				}
			],
			"reference": {
				"book": 20,
				"hadith": 148
			}
		},
		{
			"hadithnumber": 1746,
			"arabicnumber": 1746,
			"text": "। মুহাম্মাদ ইবনু সালামা (রহঃ) ... হাসান ইবনু আলী (রাঃ) থেকে বর্ণিত। তিনি বলেন, রাসুল সাল্লাল্লাহু আলাইহি ওয়াসাল্লাম আমাকে এ বাক্যগুলো শিক্ষা দিয়েছেন বিতরের সালাতে (পড়বার জন্য) তিনি বলেছেন, তুমি বলঃ اللَّهُمَّ اهْدِنِي فِيمَنْ هَدَيْتَ وَبَارِكْ لِي فِيمَا أَعْطَيْتَ وَتَوَلَّنِي فِيمَنْ تَوَلَّيْتَ وَقِنِي شَرَّ مَا قَضَيْتَ فَإِنَّكَ تَقْضِي وَلاَ يُقْضَى عَلَيْكَ وَإِنَّهُ لاَ يَذِلُّ مَنْ وَالَيْتَ تَبَارَكْتَ رَبَّنَا وَتَعَالَيْتَ وَصَلَّى اللَّهُ عَلَى النَّبِيِّ مُحَمَّدٍ",
			"grades": [
				{
					"name": "Abu Ghuddah",
					"grade": "Daif"
				},
				{
					"name": "Al-Albani",
					"grade": "Daif"
				},
				{
					"name": "Zubair Ali Zai",
					"grade": "Daif"
				}
			],
			"reference": {
				"book": 20,
