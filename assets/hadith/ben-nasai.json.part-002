				"hadith": 110
			}
		},
		{
			"hadithnumber": 1708,
			"arabicnumber": 1708,
			"text": "। আহমদ ইবনু হারব (রহঃ) ... উম্মে সালামা (রাঃ) থেকে বর্ণিত। তিনি বলেন, রাসুলুল্লাহ সাল্লাল্লাহু আলাইহি ওয়াসাল্লাম রাত্রে তের রাকআত সালাত আদায় করতেন (বিতরের সালাতসহ)। যখন তিনি বৃদ্ধ হয়ে গেলেন এবং দূর্বলতা এসে গেল তখন তিনি নয় রাকআত সালাত আদায় করতেন।",
			"grades": [
				{
					"name": "Abu Ghuddah",
					"grade": "Sahih Isnaad"
				},
				{
					"name": "Al-Albani",
					"grade": "Sahih Isnaad"
				},
				{
					"name": "Zubair Ali Zai",
					"grade": "Sahih"
				}
			],
			"reference": {
				"book": 20,
				"hadith": 111
			}
		},
		{
			"hadithnumber": 1709,
			"arabicnumber": 1709,
			"text": "। আহমদ ইবনু সুলায়মান (রহঃ) ... আয়িশা (রাঃ) থেকে বর্ণিত। তিনি বলেন, রাসুলুল্লাহ সাল্লাল্লাহু আলাইহি ওয়াসাল্লাম রাত্রে নয় রাকআত সালাত আদায় করতেন। যখন তিনি বৃদ্ধ হয়ে গেলেন এবং শরীর ভারী হয়ে গেল, তখন তিনি সাত রাকআত সালাত আদায় করতেন।",
			"grades": [
				{
					"name": "Abu Ghuddah",
					"grade": "Sahih"
				},
				{
					"name": "Al-Albani",
					"grade": "Sahih"
				},
				{
					"name": "Zubair Ali Zai",
					"grade": "Sahih"
				}
			],
			"reference": {
				"book": 20,
				"hadith": 112
			}
		},
		{
			"hadithnumber": 1710,
			"arabicnumber": 1710,
			"text": "। আমর ইবনু উসমান (রহঃ) ... আবূ আইয়্যুব (রাঃ) থেকে বর্ণিত যে, নবী সাল্লাল্লাহু আলাইহি ওয়াসাল্লাম বলেছেন, বিতরের সালাত ওয়াজিব। অতএব, যার ইচ্ছা হয় সে সাত রাকআত দ্বারা বেজোড় করে দেবে, আর যে ইচ্ছা করে সে পাঁচ রাকআত দ্বারা বেজোড় করে দেবে। আর যে ইচ্ছা করে সে তিন রাকআত দ্বারা বেজোড় করে দেবে আর যে ইচ্ছা করে সে এক রাকআত দ্বারা বেজোড় করে দেবে।",
			"grades": [
				{
					"name": "Abu Ghuddah",
					"grade": "Sahih"
				},
				{
					"name": "Al-Albani",
					"grade": "Sahih"
				},
				{
					"name": "Zubair Ali Zai",
					"grade": "Sahih"
				}
			],
			"reference": {
				"book": 20,
				"hadith": 113
			}
		},
		{
			"hadithnumber": 1711,
			"arabicnumber": 1711,
			"text": "। আব্বাস ইবনু ওয়ালীদ (রহঃ) ... আবূ আইয়ুব (রাঃ) থেকে বর্ণিত যে, রাসুলুল্লাহ সাল্লাল্লাহু আলাইহি ওয়াসাল্লাম বলেছেন, বিতরের সালাত ওয়াজিব। অতএব, যে ইচ্ছা করে সে পাঁচ রাকআত দ্বারা বেজোড় করে দেবে আর যে ইচ্ছা করে সে তিন রাকআত দ্বারা বেজোড় করে দেবে আর যে ইচ্ছা করে সে এক রাকআত দ্বারা বেজোড় করে দেবে। [সহীহ। পূর্বোক্ত হাদীস দ্রষ্টব্য]",
			"grades": [
				{
					"name": "Abu Ghuddah",
					"grade": "Sahih"
				},
				{
					"name": "Al-Albani",
					"grade": "Sahih"
				},
				{
					"name": "Zubair Ali Zai",
					"grade": "Hasan"
				}
			],
			"reference": {
				"book": 20,
				"hadith": 114
			}
		},
		{
			"hadithnumber": 1712,
			"arabicnumber": 1712,
			"text": "। রবী ইবনু সুলায়মান (রহঃ) ... আতা ইবনু ইয়াযীদ (রাঃ) থেকে বর্ণিত যে, তিনি আবূ আইয়্যুব আনসারী (রাঃ) কে বলতে শুনেছেন যে, বিতরের সালাত ওয়াজিব। অতএব, যে ব্যক্তি পাঁচ রাকআত দ্বারা বেজোড় বানিয়ে দেয়া ভাল মনে করে সে যেন তাই করে। আর যে ব্যক্তি তিন রাকআত দ্বারা বেজোড় বানিয়ে দেয়া ভাল মনে করে, সে যেন তাই করে। আর যে ব্যক্তি এক রাকআত দ্বারা বেজোড় বানিয়ে দেয়া ভাল মনে করে, সে যেন তাই করে।",
			"grades": [
