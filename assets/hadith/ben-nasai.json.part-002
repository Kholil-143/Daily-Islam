					"name": "Abu Ghuddah",
					"grade": "Sahih"
				},
				{
					"name": "Al-Albani",
					"grade": "Sahih"
				},
				{
					"name": "Zubair Ali Zai",
					"grade": "Isnaad Sahih"
				}
			],
			"reference": {
				"book": 20,
				"hadith": 115
			}
		},
		{
			"hadithnumber": 1713,
			"arabicnumber": 1713,
			"text": "। হারিস ইবনু মিসকীন (রহঃ) ... আবূ আইয়্যুব (রাঃ) থেকে বর্ণিত। যে ব্যক্তি ইচ্ছা করে সে সাত রাকআত দ্বারা বেজোড় করে দেবে। আর যে ব্যক্তি ইচ্ছা করে সে পাঁচ রাকআত দ্বারা বেজোড় করে দেবে। আর যে ব্যক্তি ইচ্ছা করে সে তিন রাকআত দ্বারা বেজোড় করে দেবে। আর যে ব্যক্তি ইচ্ছা করে সে এক রাকআত দ্বারা বেজোড় করে দেবে, আর যে ব্যাক্তি ইচ্ছা করে সে ভালভাবে ইশারা করবে।",
			"grades": [
