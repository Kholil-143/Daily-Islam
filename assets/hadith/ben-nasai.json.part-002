					"grade": "Sahih"
				},
				{
					"name": "Al-Albani",
					"grade": "Sahih"
				},
				{
					"name": "Zubair Ali Zai",
					"grade": "Sahih"
				}
			],
			"reference": {
				"book": 20,
				"hadith": 140
			}
		},
		{
			"hadithnumber": 1738,
			"arabicnumber": 1738,
			"text": "। আহমদ ইবনু সুলায়মান (রহঃ) ... আবযা (রাঃ) তার পিতা থেকে অনুরূপ বর্ণনা করেছেন।",
			"grades": [
