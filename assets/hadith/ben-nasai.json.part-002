					"grade": "Sahih"
				},
				{
					"name": "Zubair Ali Zai",
					"grade": "Sahih Muslim"
				}
			],
			"reference": {
				"book": 20,
				"hadith": 77
			}
		},
		{
			"hadithnumber": 1675,
			"arabicnumber": 1675,
			"text": "। হান্নাদ ইবনু সারি (রহঃ) ... আলী (রাঃ) থেকে বর্ণিত। তিনি বলেন, রাসুলুল্লাহ সাল্লাল্লাহু আলাইহি ওয়াসাল্লাম একবার সালাত আদায় করলেন। অতঃপর বললেন, হে কুরআনধারীগণ! তোমরা বিতরের সালাত আদায় কর। কেননা আল্লাহ তাআলা স্বয়ং বেজোড় এবং তিনি বেজোড় পছন্দ করেন।",
			"grades": [
				{
					"name": "Abu Ghuddah",
					"grade": "Sahih"
				},
				{
					"name": "Al-Albani",
					"grade": "Sahih"
				},
				{
					"name": "Zubair Ali Zai",
					"grade": "Daif"
				}
			],
			"reference": {
				"book": 20,
				"hadith": 78
			}
		},
		{
			"hadithnumber": 1676,
			"arabicnumber": 1676,
			"text": "। মুহাম্মদ ইবনু ইসমাঈল (রহঃ) ... আলী (রাঃ) থেকে বর্ণিত। তিনি বলেন, বিতরের সালাত ফরয সালাতের ন্যায় অত্যাবশ্যকায় নয়। বরং তা ওয়াজিব, যা রাসুলুল্লাহ সাল্লাল্লাহু আলাইহি ওয়াসাল্লাম ওয়াজিব করে দিয়েছেন।",
			"grades": [
				{
					"name": "Abu Ghuddah",
					"grade": "Sahih"
				},
				{
					"name": "Al-Albani",
					"grade": "Sahih"
				},
				{
					"name": "Zubair Ali Zai",
					"grade": "Sahih"
				}
			],
			"reference": {
				"book": 20,
				"hadith": 79
			}
		},
		{
			"hadithnumber": 1677,
			"arabicnumber": 1677,
			"text": "। সুলায়মান ইবনু সালম এবং মুহাম্মাদ ইবনু আলী (রহঃ) ... আবূ হুরায়রা (রাঃ) থেকে বর্ণিত। তিনি বলেন, আমার অন্তরঙ্গ বন্ধু নবী সাল্লাল্লাহু আলাইহি ওয়াসাল্লাম আমাকে তিনটি কাজের ওসিয়্যত করে গেছেন। এক, (রাতে নিদ্রা থেকে জাগ্রত হওয়ার দৃঢ় বিশ্বাস না থাকলে) বিতরের সালাত আদায় করে নিদ্রা যাওয়া। দুই, দু’প্রত্যেক মাসে (আইয়্যামে বীযের) তিন দিন সাওম পালন করা। তিন, চাশতের (পূর্বাহ্নের) দুই রাকআত সালাত আদায় করা।",
			"grades": [
				{
					"name": "Abu Ghuddah",
					"grade": "Sahih"
				},
				{
					"name": "Al-Albani",
					"grade": "Sahih"
				},
				{
					"name": "Zubair Ali Zai",
					"grade": "Sahih - Agreed Upon"
				}
			],
			"reference": {
				"book": 20,
				"hadith": 80
			}
		},
		{
			"hadithnumber": 1678,
			"arabicnumber": 1678,
			"text": "। মুহাম্মাদ ইবনু বাশশার (রহঃ) ... আবূ হুরায়রা (রাঃ) থেকে বর্ণিত। তিনি বলেন, আমার অন্তরঙ্গ বন্ধু রাসুলুল্লাহ সাল্লাল্লাহু আলাইহি ওয়াসাল্লাম আমাকে তিনটি কাজের ওসিয়্যত করেছেন। এক, (রাত্রির শেষ ভাগে নিদ্রা থেকে জাগ্রত হওয়ার; দুঢ় বিশ্বাস না থাকলে) রাত্রির প্রথম ভাগেই বিতরের সালাত আদায় করে নেওয়া। দুই, ফজরের দুই রাকআত সুন্নাত সালাত আদায় করা। তিন, প্রত্যেক মাসে তিন দিন আইয়্যামে বীযের সাওম পালন করা।",
