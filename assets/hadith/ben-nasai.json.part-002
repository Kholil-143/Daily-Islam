					"grade": "Sahih"
				},
				{
					"name": "Al-Albani",
					"grade": "Sahih"
				},
				{
					"name": "Zubair Ali Zai",
					"grade": "Sahih - Agreed Upon"
				}
			],
			"reference": {
				"book": 19,
				"hadith": 38
			}
		},
		{
			"hadithnumber": 1594,
			"arabicnumber": 1594,
			"text": "। মুহাম্মাদ ইবনু আদম (রহঃ) ... আয়িশা (রাঃ) থেকে বর্ণিত। তিনি বলেন, কয়েকজন হাবশী এসে ঈদের দিনে নবী সাল্লাল্লাহু আলাইহি ওয়াসাল্লাম এর সম্মুখে খেলাধুলা করতে লাগল। তিনি আমাকে ডাকলেন। আমি নবী সাল্লাল্লাহু আলাইহি ওয়াসাল্লাম-এর কাঁধের দিয়ে তাদের দিকে দেখতে লাগলাম। আমি তাদের দিকে নিজে ফিরে না যাওয়া পর্যন্ত দেখতেই ছিলাম।",
			"grades": [
				{
					"name": "Abu Ghuddah",
					"grade": "Sahih"
				},
				{
					"name": "Al-Albani",
					"grade": "Sahih"
				},
				{
					"name": "Zubair Ali Zai",
					"grade": "Sahih - Agreed Upon"
				}
			],
			"reference": {
				"book": 19,
				"hadith": 39
			}
		},
		{
			"hadithnumber": 1595,
			"arabicnumber": 1595,
			"text": "। আলী ইবনু খাশরাম (রহঃ) ... আয়িশা (রাঃ) থেকে বর্ণিত। তিনি বলেন, আমি রাসুলুল্লাহ সাল্লাল্লাহু আলাইহি ওয়াসাল্লাম-কে দেখেছি তিনি আমাকে তার চাঁদর দ্বারা ঢেকে রাখতেন যখন আমি হাবশীদের (নিগ্রো) দিকে নিজে ক্লান্ত না হওয়া পর্যন্ত দেখতে থাকতাম। তারা মসজিদে খেলাধূলা করত। এখন তোমরা, রাসুলুল্লাহ সাল্লাল্লাহু আলাইহি ওয়াসাল্লাম-এর কাছে খেলাধূলায় আগ্রহী অল্প বয়স্কা বালিকাদের কতটুকু মর্যাদা ছিল তা আন্দাজ করতে পারো।",
			"grades": [
