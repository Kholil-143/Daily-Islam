					"grade": "Sahih"
				},
				{
					"name": "Zubair Ali Zai",
					"grade": "Sahih Muslim"
				}
			],
			"reference": {
				"book": 20,
				"hadith": 35
			}
		},
		{
			"hadithnumber": 1633,
			"arabicnumber": 1633,
			"text": "। আহমদ ইবনু সাঈদ (রহঃ) ... আনাস (রাঃ) থেকে বর্ণিত যে, নবী সাল্লাল্লাহু আলাইহি ওয়াসাল্লাম বলেছেন, আমি মুসা (আলাইহিস সালাম) এর কবরের পার্শ্বে গিয়েছিলাম, তিনি তখন নিজ কবরে সালাত আদায় করছিলেন।",
