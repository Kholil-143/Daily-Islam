					"grade": "Hasan"
				},
				{
					"name": "Zubair Ali Zai",
					"grade": "Sahih"
				}
			],
			"reference": {
				"book": 33,
				"hadith": 5
			}
		},
		{
			"hadithnumber": 4014,
			"arabicnumber": 4014,
			"text": "। যুর‘আহ ইবনু আব্দুর রাহমান ইবনু জারহাদ (রহঃ) থেকে তার পিতার সূত্রে বর্ণিত। তিনি বলেন, এই ‘জারহাদ’ আসহাবে সুফফার অন্যতম সদস্য ছিলেন। তিনি বলেন, একদা রাসূলুল্লাহ সাল্লাল্লাহু আলাইহি ওয়াসাল্লাম আমাদের নিকট বসলেন, তখন আমার উরুদেশ অনাবৃত ছিলো। তিনি বললেনঃ তুমি কি জানো না যে, উরুদেশ গোপন অঙ্গ?[1] সহীহ।",
