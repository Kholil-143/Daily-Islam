			}
		},
		{
			"hadithnumber": 4188,
			"arabicnumber": 4188,
			"text": "। ইবনু আব্বাস (রাঃ) সূত্রে বর্ণিত। তিনি বলেনঃ আহলে কিতাব তাদের মাথার চুল লম্বাভাবে ঝুলিয়ে দিতো। আর মুশরিকরা মাথায় সিঁথি করতো। রাসূলুল্লাহ সাল্লাল্লাহু আলাইহি ওয়াসাল্লাম-এর কাছে যে বিষয়ে আল্লাহর পক্ষ থেকে কোনো হুকুম ছিলো না, সেক্ষেত্রে তিনি আহলে কিতাবের নিয়ম পালন করতে ভালবাসতেন। তাই রাসূলুল্লাহ সাল্লাল্লাহু আলাইহি ওয়াসাল্লাম-ও তাঁর কপালের চুল লম্বাভাবে ঝুলিয়ে দেন। অতঃপর আবার সিঁথি করেন।[1] সহীহ।",
			"grades": [
				{
					"name": "Al-Albani",
					"grade": "Sahih"
				},
				{
					"name": "Muhammad Muhyi Al-Din Abdul Hamid",
					"grade": "Sahih"
				},
				{
					"name": "Shuaib Al Arnaut",
					"grade": "Sahih"
				},
				{
					"name": "Zubair Ali Zai",
					"grade": "Sahih Bukhari (5917) Sahih Muslim (2336)"
				}
			],
			"reference": {
				"book": 35,
				"hadith": 30
			}
		},
		{
			"hadithnumber": 4189,
			"arabicnumber": 4189,
			"text": "। আয়িশাহ (রাঃ) সূত্রে বর্ণিত। তিনি বলেন, আমি রাসূলুল্লাহ সাল্লাল্লাহু আলাইহি ওয়াসাল্লাম-এর মাথার চুলের সিঁথি করতে চাইলে মাথার মাঝ বরাবর দু’ ভাগ করে সিঁথি করতাম এবং তাঁর দু’ চোখের মাঝখান থেকে সোজা কপালের দু’ দিকে চুল ছেড়ে দিতাম।[1] সহীহ।",
			"grades": [
				{
					"name": "Al-Albani",
					"grade": "Hasan"
				},
				{
					"name": "Muhammad Muhyi Al-Din Abdul Hamid",
					"grade": "Hasan"
				},
				{
					"name": "Shuaib Al Arnaut",
					"grade": "Hasan"
				},
				{
					"name": "Zubair Ali Zai",
					"grade": "Isnaad Hasan"
				}
			],
			"reference": {
				"book": 35,
				"hadith": 31
			}
		},
		{
			"hadithnumber": 4190,
			"arabicnumber": 4190,
			"text": "। ওয়াইল ইবনু হুজর (রাঃ) সূত্রে বর্ণিত। তিনি বলেন, আমি নবী সাল্লাল্লাহু আলাইহি ওয়াসাল্লাম-এর নিকট আসতাম। আমার মাথায় লম্বা চুল ছিলো। রাসূলুল্লাহ সাল্লাল্লাহু আলাইহি ওয়াসাল্লাম আমাকে দেখে বললেনঃ মাছি, মাছি। তিনি বলেন, আমি ফিরে এসে চুল কেটে ফেললাম। পরদিন সকালে আমি তাঁর নিকট গেলে তিনি বললেনঃ আমি তো তোমাকে কষ্ট দেইনি। আর এরূপ (চুল) খুবই চমৎকার![1] সহীহ।",
			"grades": [
				{
					"name": "Al-Albani",
					"grade": "Sahih"
				},
				{
					"name": "Muhammad Muhyi Al-Din Abdul Hamid",
					"grade": "Sahih"
				},
				{
					"name": "Zubair Ali Zai",
					"grade": "Isnaad Hasan"
				}
			],
			"reference": {
				"book": 35,
				"hadith": 32
			}
		},
		{
			"hadithnumber": 4191,
			"arabicnumber": 4191,
			"text": "। মুহাজিদ (রহঃ) সূত্রে বর্ণিত। তিনি বলেন, উম্মু হানী (রাঃ) বলেছেন, নবী সাল্লাল্লাহু আলাইহি ওয়াসাল্লাম যখন মক্কা হয়ে আগমন করেন, তখন তাঁর মাথার চুলে চারটি গুচ্ছ ছিলো।[1] সহীহ।",
			"grades": [
				{
					"name": "Al-Albani",
					"grade": "Sahih"
				},
				{
					"name": "Muhammad Muhyi Al-Din Abdul Hamid",
					"grade": "Sahih"
				},
				{
					"name": "Zubair Ali Zai",
					"grade": "Daif"
				}
			],
			"reference": {
				"book": 35,
				"hadith": 33
			}
		},
		{
			"hadithnumber": 4192,
			"arabicnumber": 4192,
			"text": "। আব্দুল্লাহ ইবনু জা‘ফার (রাঃ) সূত্রে বর্ণিত। নবী সাল্লাল্লাহু আলাইহি ওয়াসাল্লাম জা‘ফার (রাঃ)-এর পরিবারকে তিনদিন শোক পালনের সুযোগ দিলেন। অতঃপর তিনি তাদের নিকট এসে বললেনঃ আজকের পর থেকে তোমরা তোমার ভাইয়ের জন্য আর কাঁদবে না। অতঃপর বললেনঃ আমার ভাইয়ের ছেলেদের নিয়ে এসো। অতঃপর আমাদেরকে তাঁর কাছে আনা হলো। আমরা যেন পাখীর বাচ্চার ন্যায় অসহায়। তিনি বললেনঃ আমার নিকট নাপিত ডেকে আনো। (নাপিত এলে) তিনি তাকে মাথা মুড়ানোর আদেশ দিলে সে আমাদের মাথা মুড়িয়ে দিলো।[1] সহীহ।",
			"grades": [
				{
					"name": "Al-Albani",
					"grade": "Sahih"
				},
				{
					"name": "Muhammad Muhyi Al-Din Abdul Hamid",
					"grade": "Sahih"
				},
				{
					"name": "Shuaib Al Arnaut",
					"grade": "Sahih"
				},
				{
					"name": "Zubair Ali Zai",
					"grade": "Isnaad Sahih"
				}
			],
			"reference": {
				"book": 35,
				"hadith": 34
			}
		},
		{
			"hadithnumber": 4193,
			"arabicnumber": 4193,
			"text": "। ইবনু উমার (রাঃ) সূত্রে বর্ণিত। তিনি বলেন, রাসূলুল্লাহ সাল্লাল্লাহু আলাইহি ওয়াসাল্লাম কাযা‘আ করতে বারণ করেছেন। কাযা‘আ হলো শিশুদের মাথায় কিছু চুল অবশিষ্ট রেখে কিছু চুল কমিয়ে ফেলা।[1] সহীহ।",
			"grades": [
				{
					"name": "Al-Albani",
					"grade": "Sahih"
				},
				{
					"name": "Muhammad Muhyi Al-Din Abdul Hamid",
					"grade": "Sahih"
				},
				{
					"name": "Zubair Ali Zai",
					"grade": "Sahih Bukhari (5920) Sahih Muslim (2120)"
				}
			],
			"reference": {
				"book": 35,
				"hadith": 35
			}
		},
		{
			"hadithnumber": 4194,
			"arabicnumber": 4194,
			"text": "। ইবনু উমার (রাঃ) সূত্রে বর্ণিত। নবী সাল্লাল্লাহু আলাইহি ওয়াসাল্লাম কাযা‘আ করতে নিষেধ করেছেন। তা হলো, শিশুদের মাথা কামিয়ে তাতে কিছু চুল অবশিষ্ট রাখা।[1] সহীহ।",
			"grades": [
				{
					"name": "Al-Albani",
					"grade": "Sahih"
				},
				{
					"name": "Muhammad Muhyi Al-Din Abdul Hamid",
					"grade": "Sahih"
				},
				{
					"name": "Zubair Ali Zai",
					"grade": "Isnaad Sahih"
				}
			],
			"reference": {
				"book": 35,
				"hadith": 36
			}
		},
		{
			"hadithnumber": 4195,
			"arabicnumber": 4195,
			"text": "। ইবনু উমার (রাঃ) সূত্রে বর্ণিত। একদা নবী সাল্লাল্লাহু আলাইহি ওয়াসাল্লাম দেখলেন যে, একটি শিশুর মাথার কিছু অংশ কামানো আর কিছুটা অবশিষ্ট রাখা আছে। তিনি তাদেরকে এরূপ করতে নিষেধ করলেন এবং বললেনঃ হয় সবটুকু কামিয়ে ফেলো নতুবা সবটুকু রেখে দাও।[1] সহীহ।",
			"grades": [
				{
					"name": "Al-Albani",
					"grade": "Sahih"
				},
				{
					"name": "Muhammad Muhyi Al-Din Abdul Hamid",
					"grade": "Sahih"
				},
