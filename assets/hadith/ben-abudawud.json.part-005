		{
			"hadithnumber": 4455,
			"arabicnumber": 4455,
			"text": "। জাবির ইবনু আব্দুল্লাহ (রাঃ) বলেন, একজোড়া ইয়াহুদী নারী-পুরুষ যেনা করলে নবী সাল্লাল্লাহু আলাইহি ওয়াসাল্লাম তাদের রজম করার নির্দেশ দেন।[1] সহীহ।",
			"grades": [
				{
					"name": "Al-Albani",
					"grade": "Sahih"
				},
				{
					"name": "Muhammad Muhyi Al-Din Abdul Hamid",
					"grade": "Sahih"
				},
				{
					"name": "Zubair Ali Zai",
					"grade": "Sahih Muslim (1701)"
