					"grade": "Sahih"
				},
				{
					"name": "Muhammad Muhyi Al-Din Abdul Hamid",
					"grade": "Sahih"
				},
				{
					"name": "Zubair Ali Zai",
					"grade": "Sahih Bukhari (5889) Sahih Muslim (257)"
				}
			],
			"reference": {
				"book": 35,
				"hadith": 40
			}
		},
		{
			"hadithnumber": 4199,
			"arabicnumber": 4199,
			"text": "। আব্দুল্লাহ ইবনু উমার (রাঃ) সূত্রে বর্ণিত। রাসূলুল্লাহ সাল্লাল্লাহু আলাইহি ওয়াসাল্লাম মোঁচ কাটতে এবং দাড়ি লম্বা করতে আদেশ দিয়েছেন।[1] সহীহ।",
			"grades": [
