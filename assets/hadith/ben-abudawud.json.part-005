			}
		},
		{
			"hadithnumber": 4004,
			"arabicnumber": 4004,
			"text": "। ইবনু মাসঊদ (রাঃ) সূত্রে বর্ণিত। তিনি এ আয়াতهَيْتَ لَكَ (তা'র উপর যবর দিয়ে) পড়েছেন। শাকীক (রহঃ) বললেন, আমরা তো এ আয়াত هِئْتُ لَكَ (‘হা’ তে যের ও ‘তা’-র উপর পেশ দিয়) পড়ে থাকি। ইবনু মাসঊদ (রাঃ) বললেন, আমাকে যে রীতিতে পড়া শিখানো হয়েছে, আমি সেভাবেই পড়তে ভালবাসি।[1] সহীহ।",
			"grades": [
				{
					"name": "Al-Albani",
					"grade": "Sahih"
				},
				{
					"name": "Muhammad Muhyi Al-Din Abdul Hamid",
					"grade": "Sahih"
				},
				{
					"name": "Shuaib Al Arnaut",
					"grade": "Sahih"
				},
				{
					"name": "Zubair Ali Zai",
					"grade": "Sahih Bukhari (4692)"
				}
			],
			"reference": {
