					"grade": "Isnaad Hasan"
				}
			],
			"reference": {
				"book": 43,
				"hadith": 44
			}
		},
		{
			"hadithnumber": 4817,
			"arabicnumber": 4817,
			"text": "। জারীর ইবনু হাযেম (রহঃ) সূত্রে বর্ণিত। তিনি বলেন, আমি উমার ইবনুল খাত্তাব (রাঃ)-কে নবী সাল্লাল্লাহু আলাইহি ওয়াসাল্লাম থেকে উল্লেখিত হাদীস বর্ণনা প্রসঙ্গে আরো বলতে শুনেছি, বিপদগ্রস্তকে সাহায্য করবে এবং পথহারাকে পথ দেখাবে।[1] সহীহ।",
			"grades": [
				{
					"name": "Al-Albani",
					"grade": "Sahih"
				},
				{
					"name": "Muhammad Muhyi Al-Din Abdul Hamid",
					"grade": "Sahih"
				},
				{
					"name": "Zubair Ali Zai",
					"grade": "Daif"
				}
			],
			"reference": {
				"book": 43,
				"hadith": 45
			}
		},
		{
			"hadithnumber": 4818,
			"arabicnumber": 4818,
			"text": "। আনাস (রাঃ) সূত্রে বর্ণিত। তিনি বলেন, এক মহিলা নবী সাল্লাল্লাহু আলাইহি ওয়াসাল্লাম-এর নিকট এসে বললেন, হে আল্লাহর রাসূল! আমি আপনার নিকট একটি প্রয়োজনে এসেছি। তিনি বললেন, হে অমুকের মা! তোমার সুবিধা মতো রাস্তার যে কোনো গলিপথে বসো এবং আমি তোমার নিকট বসে তোমার দরকার পূরণ করবো। বর্ণনাকারী বলেন, অতঃপর মহিলাটি বসলো এবং নবী সাল্লাল্লাহু আলাইহি ওয়াসাল্লামও বসে থাকলেন যাবত না তার প্রয়োজন পূরণ হলো।[1] সহীহ।",
			"grades": [
				{
					"name": "Al-Albani",
					"grade": "Sahih"
				},
				{
					"name": "Muhammad Muhyi Al-Din Abdul Hamid",
					"grade": "Sahih"
				},
				{
					"name": "Zubair Ali Zai",
					"grade": "Isnaad Sahih"
				}
			],
			"reference": {
				"book": 43,
				"hadith": 46
			}
		},
		{
			"hadithnumber": 4819,
			"arabicnumber": 4819,
			"text": "। আনাস (রাঃ) সূত্রে বর্ণিত। এক নারীর বুদ্ধিতে কিছুটা জড়তা ছিলো। অতঃপর পূর্বোক্ত হাদীসের অর্থানুরূপ বর্ণিত।[1] সহীহ।",
			"grades": [
				{
					"name": "Al-Albani",
					"grade": "Sahih"
				},
				{
					"name": "Muhammad Muhyi Al-Din Abdul Hamid",
					"grade": "Sahih"
				},
				{
					"name": "Shuaib Al Arnaut",
					"grade": "Sahih"
				},
				{
					"name": "Zubair Ali Zai",
