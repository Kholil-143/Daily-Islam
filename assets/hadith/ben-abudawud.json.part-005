					"grade": "Sahih"
				}
			],
			"reference": {
				"book": 34,
				"hadith": 57
			}
		},
		{
			"hadithnumber": 4077,
			"arabicnumber": 4077,
			"text": "। আমর ইবনুল হুরাইস (রাঃ) বলেন, আমি নবী সাল্লাল্লাহু আলাইহি ওয়াসাল্লাম-কে কালো পাগড়ি পরিহিত অবস্থায় মিম্বারে দাঁড়িয়ে ভাষণ দিতে দেখেছি, তাঁর পাগড়ির দু’ পাশ তাঁর কাঁধের উপর ঝুলছিল।[1] সহীহ।",
			"grades": [
