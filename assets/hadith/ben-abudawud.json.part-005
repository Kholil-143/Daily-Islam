					"name": "Al-Albani",
					"grade": "Sahih"
				},
				{
					"name": "Muhammad Muhyi Al-Din Abdul Hamid",
					"grade": "Sahih"
				},
				{
					"name": "Shuaib Al Arnaut",
					"grade": "Sahih"
				},
				{
					"name": "Zubair Ali Zai",
					"grade": "Sahih Bukhari (3371)"
				}
			],
			"reference": {
				"book": 42,
				"hadith": 142
			}
		},
		{
			"hadithnumber": 4738,
			"arabicnumber": 4738,
			"text": "। আব্দুল্লাহ (রাঃ) সূত্রে বর্ণিত। তিনি বলেন, রাসূলুল্লাহ সাল্লাল্লাহু আলাইহি ওয়াসাল্লাম বলেছেনঃ যখন মহান আল্লাহ ওহী প্রেরণের কথা বলেন, তখন এক আকাশের অধিবাসীগণ অন্য আকাশ থেকে সাফা পর্বতের উপর দিয়ে শিকল টানা শব্দের মতই শব্দ শুনতে পান। আর আওয়াজ শুনে তারা বেহুশ হয়ে যায় এবং জিবরীল (আঃ) তাদের নিকট উপস্থিত হলে তাদের অন্তর থেকে ভয় বিদূরীত হয়ে তারা হুশ ফিরে পায়। অতঃপর তারা বলে, হে জিবরীল! আপনার রব কি বলেছেন? তিনি বললেন, যা সত্য তাই বলেছেন। তখন তারা বলে, সত্যই বলেছেন, সত্যই বলেছেন।[1] সহীহ।",
			"grades": [
				{
					"name": "Al-Albani",
					"grade": "Sahih"
				},
				{
					"name": "Muhammad Muhyi Al-Din Abdul Hamid",
					"grade": "Sahih"
				},
				{
					"name": "Zubair Ali Zai",
					"grade": "Sahih"
				}
			],
			"reference": {
				"book": 42,
				"hadith": 143
			}
		},
		{
			"hadithnumber": 4739,
			"arabicnumber": 4739,
			"text": "। আনাস ইবনু মালিক (রাঃ) সূত্রে বর্ণিত। নবী সাল্লাল্লাহু আলাইহি ওয়াসাল্লাম বলেনঃ আমার উম্মাতের কাবীরাহ গুনাহগারদের জন্য আমার শাফা‘আত।[1] সহীহ।",
			"grades": [
				{
					"name": "Al-Albani",
					"grade": "Sahih"
				},
				{
					"name": "Muhammad Muhyi Al-Din Abdul Hamid",
					"grade": "Sahih"
				},
				{
					"name": "Shuaib Al Arnaut",
					"grade": "Sahih"
				},
				{
					"name": "Zubair Ali Zai",
					"grade": "Sahih"
				}
			],
			"reference": {
				"book": 42,
				"hadith": 144
			}
		},
		{
			"hadithnumber": 4740,
			"arabicnumber": 4740,
			"text": "। ইমরান ইবনু হুসাইন (রাঃ) সূত্রে বর্ণিত। নবী সাল্লাল্লাহু আলাইহি ওয়াসাল্লাম বলেনঃ আমার উম্মাতের একটি গোত্র আমার শাফা‘আত পেয়ে জাহান্নাম থেকে মুক্তি লাভ করে বেরিয়ে আসবে, অতঃপর তারা জান্নাতে প্রবেশ করবে, আর তাদেরকে জাহান্নামের অধিবাসী নামে আখ্যায়িত করা হবে।[1] সহীহ।",
			"grades": [
