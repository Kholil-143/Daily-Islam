		{
			"hadithnumber": 4497,
			"arabicnumber": 4497,
			"text": "। আনাস ইবনু মালিক (রাঃ) সূত্রে বর্ণিত। তিনি বলেন, আমি দেখেছি, রাসূলুল্লাহ সাল্লাল্লাহু আলাইহি ওয়াসাল্লাম-এর নিকট কোনো কিসাস জনিত বিবাদ পেশ করা হলে তিনি ক্ষমা করে দেয়ার জন্য নির্দেশ দিতেন।[1] সহীহ।",
			"grades": [
				{
					"name": "Al-Albani",
					"grade": "Sahih"
				},
				{
					"name": "Muhammad Muhyi Al-Din Abdul Hamid",
					"grade": "Sahih"
				},
				{
					"name": "Zubair Ali Zai",
					"grade": "Isnaad Sahih"
				}
			],
			"reference": {
