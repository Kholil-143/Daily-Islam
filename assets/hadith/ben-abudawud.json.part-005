			}
		},
		{
			"hadithnumber": 3956,
			"arabicnumber": 3956,
			"text": "। ‘আতা ইবনু আবূ রাবাহ (রহঃ) সূত্রে বর্ণিত। তিনি বলেন, জাবির ইবনু আব্দুল্লাহ (রাঃ) আমার নিকট উল্লেখিত হাদীস বর্ণনা করেছেন। তবে তাতে রয়েছেঃ তিনি অর্থাৎ নবী সাল্লাল্লাহু আলাইহি ওয়াসাল্লাম বললেনঃ তুমিই মুদাব্বার গোলামের মূল্যের পাওনাদার, আর আল্লাহ তা থেকে মুখাপেক্ষীহীন।[1] সহীহ।",
			"grades": [
				{
					"name": "Al-Albani",
					"grade": "Sahih Hadith"
				},
				{
					"name": "Muhammad Muhyi Al-Din Abdul Hamid",
					"grade": "Sahih"
				},
				{
					"name": "Zubair Ali Zai",
					"grade": "Isnaad Sahih"
				}
			],
			"reference": {
				"book": 31,
