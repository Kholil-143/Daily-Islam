					"grade": "Daif"
				}
			],
			"reference": {
				"book": 31,
				"hadith": 25
			}
		},
		{
			"hadithnumber": 3951,
			"arabicnumber": 3951,
			"text": "। কাতাদাহ (রহঃ) সূত্রে বর্ণিত। হাসান (রহঃ) বলেন, কোনো ব্যক্তি নিকট আত্মীয়ের মনিব হলে, সে সরাসরি মুক্ত।[1] সহীহ মাকতু।",
			"grades": [
