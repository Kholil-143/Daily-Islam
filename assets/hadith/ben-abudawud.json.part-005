					"grade": "Sahih"
				},
				{
					"name": "Zubair Ali Zai",
					"grade": "Sahih Bukhari (752) Sahih Muslim (556)"
				}
			],
			"reference": {
				"book": 34,
				"hadith": 34
			}
		},
		{
			"hadithnumber": 4054,
			"arabicnumber": 4054,
			"text": "। আসমা বিনতু আবূ বাকর (রাঃ)-এর আযাদকৃত গোলাম আব্দুল্লাহ আবূ উমার (রহঃ) সূত্রে বর্ণিত। তিনি বলেন, আমি ইবনু উমার (রাঃ)-কে বাজারে একটি সিরীয় পোশাক কিনতে দেখলাম। তিনি তাতে লাল রঙের সূতা দেখে ফেরত দিলেন। আমি আসমা (রাঃ)-এর নিকট এসে তা জানালাম। তিনি এক কৃতদাসীকে ডেকে বললেন, হে দাসী! রাসূলুল্লাহ সাল্লাল্লাহু আলাইহি ওয়াসাল্লাম-এর জুব্বাটা আমার কাছে নিয়ে এসো। অতঃপর সে কারুকার্য খচিত পকেটে, দু’ আস্তিনে ও আগে-পিছনে ফাড়া স্থানে রেশমী কাজ করা একটি জুব্বা বের করে আনলেন।[1] সহীহ।",
			"grades": [
				{
					"name": "Al-Albani",
					"grade": "Sahih"
				},
				{
					"name": "Muhammad Muhyi Al-Din Abdul Hamid",
					"grade": "Sahih"
				},
