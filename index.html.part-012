(function buildGrid(){
  var ilm = '', seba = '';
  FEATURES.forEach(function(f){
    var attr = f.sub ? 'data-sub="' + f.sub + '"' : 'data-goto="' + f.view + '"';
    var h = '<button class="htile" ' + attr + '><span class="hic c' + f.col + '">' + ICONS[f.ic] + '</span><span>' + f.t + '</span></button>';
    if (f.sec === 'ilm') ilm += h; else seba += h;
  });
  $('featureGridIlm').innerHTML = ilm;
  $('featureGridSeba').innerHTML = seba;
  document.querySelectorAll('[data-ic]').forEach(function(el){ el.innerHTML = ICONS[el.getAttribute('data-ic')] || ''; });
  document.addEventListener('click', function(e){
    var j = e.target.closest('[data-juz]'); if (j){ showView('quran'); switchQuranTab('juz'); }
  });
})();

/* ================= Prayer time engine ================= */
function dtr(d){ return d * Math.PI / 180; }
function rtd(r){ return r * 180 / Math.PI; }
function pSin(d){ return Math.sin(dtr(d)); }
function pCos(d){ return Math.cos(dtr(d)); }
function pTan(d){ return Math.tan(dtr(d)); }
function pAsin(x){ return rtd(Math.asin(x)); }
function pAcos(x){ return rtd(Math.acos(x)); }
function pAtan2(y, x){ return rtd(Math.atan2(y, x)); }
function pAcot(x){ return rtd(Math.atan(1 / x)); }
function fixA(a){ a = a - 360 * Math.floor(a / 360); return a < 0 ? a + 360 : a; }
function fixH(a){ a = a - 24 * Math.floor(a / 24); return a < 0 ? a + 24 : a; }
function julian(y, m, d){
  if (m <= 2){ y -= 1; m += 12; }
  var A = Math.floor(y / 100), B = 2 - A + Math.floor(A / 4);
  return Math.floor(365.25 * (y + 4716)) + Math.floor(30.6001 * (m + 1)) + d + B - 1524.5;
}
function sunPos(jd){
  var D = jd - 2451545.0;
  var g = fixA(357.529 + 0.98560028 * D);
  var q = fixA(280.459 + 0.98564736 * D);
  var L = fixA(q + 1.915 * pSin(g) + 0.020 * pSin(2 * g));
  var e = 23.439 - 0.00000036 * D;
  var RA = fixH(pAtan2(pCos(e) * pSin(L), pCos(L)) / 15);
  return { decl: pAsin(pSin(e) * pSin(L)), eq: q / 15 - RA };
}
function prayerTimes(date, lat, lng, tz){
  var jd = julian(date.getFullYear(), date.getMonth() + 1, date.getDate()) - lng / (15 * 24);
  function noon(t){ return fixH(12 - sunPos(jd + t).eq); }
  function angleTime(angle, t, ccw){
    var D = sunPos(jd + t).decl, Z = noon(t);
    var V = pAcos((-pSin(angle) - pSin(D) * pSin(lat)) / (pCos(D) * pCos(lat))) / 15;
    return Z + (ccw ? -V : V);
  }
  function asrTime(factor, t){
    var D = sunPos(jd + t).decl;
    var G = -pAcot(factor + pTan(Math.abs(lat - D)));
    return angleTime(G, t, false);
  }
  var t = {
    fajr: angleTime(18, 5/24, true),
    sunrise: angleTime(0.833, 6/24, true),
    dhuhr: noon(12/24),
    asr: asrTime(2, 13/24, false),
    maghrib: angleTime(0.833, 18/24, false),
    sunset: angleTime(0.833, 18/24, false),
    isha: angleTime(18, 18/24, false)
  };
  var ADJ = { fajr: 1/60, dhuhr: 3/60, maghrib: 3/60, isha: 1/60 };
  for (var k in t) t[k] = fixH(t[k] + tz - lng / 15 + (ADJ[k] || 0));
  return t;
}
