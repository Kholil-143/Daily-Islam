var PRAYERS = [
  ['fajr', 'ফজর'], ['sunrise', 'সূর্যোদয়'], ['dhuhr', 'যোহর'],
  ['asr', 'আসর'], ['maghrib', 'মাগরিব'], ['isha', 'এশা']
];
var PRAYER_ROWS = [
  ['fajr', 'ফজর'], ['sunrise', 'সূর্যোদয়'], ['dhuhr', 'যোহর'],
  ['asr', 'আসর'], ['sunset', 'সূর্যাস্ত'], ['maghrib', 'মাগরিব'], ['isha', 'এশা']
];
var cityIdx = 0;
var gpsLoc = null, useGps = false;
var customLoc = null, useCustom = false;
function curLoc(){
  if (useCustom && customLoc) return customLoc;
  if (useGps && gpsLoc) return gpsLoc;
  var c = CITIES[cityIdx];
  return { name: c[0], lat: c[1], lng: c[2], tz: 6 };
}
function tzForCoords(lat, lng){
  if (lat >= 20.5 && lat <= 26.7 && lng >= 88 && lng <= 92.7) return 6;
  var tz = Math.round(lng / 15);
  return Math.max(-12, Math.min(14, tz));
}
function nowInTz(tz){
  var d = new Date();
  var utc = d.getTime() + d.getTimezoneOffset() * 60000;
  return new Date(utc + tz * 3600000);
}
function nowFrame(){ return nowInTz(curLoc().tz); }
function setCustomLoc(name, lat, lng){
  customLoc = { name: name, lat: lat, lng: lng, tz: tzForCoords(lat, lng) };
  useCustom = true; useGps = false;
  syncLocSelects();
  refreshLocation();
}
function syncLocSelects(){
  var val, label;
  if (useCustom && customLoc){ val = '-2'; label = customLoc.name; }
  else if (useGps && gpsLoc){ val = '-1'; label = gpsLoc.name; }
  else { val = String(cityIdx); label = null; }
  ['citySel', 'homeCitySel', 'setCitySel'].forEach(function(id){
    var sel = $(id); if (!sel) return;
    var co = null;
    for (var i = 0; i < sel.options.length; i++) if (sel.options[i].value === '-2') co = sel.options[i];
    if (co && label && val === '-2') co.textContent = 'খোঁজা জায়গা: ' + label;
    sel.value = val;
  });
}
function onLocSelect(sel){
  if (sel.value === '-1'){ useCustom = false; requestGps(); return; }
  if (sel.value === '-2'){
    if (customLoc){ useCustom = true; useGps = false; syncLocSelects(); refreshLocation(); toast(customLoc.name + ' — এই জায়গার সময় দেখানো হচ্ছে'); }
    else { syncLocSelects(); toast('আগে "অন্য জায়গা খুঁজুন" দিয়ে যেকোনো জায়গার নাম লিখে খুঁজুন'); showView('prayer'); var ps = $('placeSearch'); if (ps) ps.focus(); }
    return;
  }
  useGps = false; useCustom = false; cityIdx = +sel.value;
  syncLocSelects();
  refreshLocation();
  toast(CITIES[cityIdx][0] + ' — এই জায়গার সময় দেখানো হচ্ছে');
}
function fmtTime(hoursFloat){
  var mins = Math.round(hoursFloat * 60);
  var h = Math.floor(mins / 60) % 24, m = mins % 60;
  var h12 = h % 12; if (h12 === 0) h12 = 12;
  return periodWord(h) + ' ' + bn(h12) + ':' + bn(pad2(m));
}
function timeToDate(base, hoursFloat){
  var mins = Math.round(hoursFloat * 60);
  var d = new Date(base.getFullYear(), base.getMonth(), base.getDate(), 0, mins);
  return d;
}
function nextEvent(now){
  var c = curLoc();
  var t = prayerTimes(now, c.lat, c.lng, c.tz);
  for (var i = 0; i < PRAYERS.length; i++){
    var dt = timeToDate(now, t[PRAYERS[i][0]]);
    if (dt > now) return { name: PRAYERS[i][1], at: dt, key: PRAYERS[i][0] };
  }
  var tom = new Date(now.getFullYear(), now.getMonth(), now.getDate() + 1);
  var t2 = prayerTimes(tom, c.lat, c.lng, c.tz);
  return { name: 'ফজর', at: timeToDate(tom, t2.fajr), key: 'fajr' };
}
function currentEventKey(now){
  var c = curLoc();
  var t = prayerTimes(now, c.lat, c.lng, c.tz);
  var key = 'isha';
  for (var i = 0; i < PRAYERS.length; i++){
    if (timeToDate(now, t[PRAYERS[i][0]]) <= now) key = PRAYERS[i][0];
  }
  return key;
}
function updateCountdown(now){
  now = nowFrame();
  var nx = nextEvent(now);
  var diff = Math.max(0, Math.floor((nx.at - now) / 1000));
  var h = Math.floor(diff / 3600), m = Math.floor((diff % 3600) / 60), s = diff % 60;
  $('nextPrayerName').textContent = nx.name + ' — ' + fmtTime(nx.at.getHours() + nx.at.getMinutes() / 60);
  $('nextPrayerCd').textContent = bn(pad2(h)) + ':' + bn(pad2(m)) + ':' + bn(pad2(s));
}
function renderPrayer(){
  var c = curLoc();
  var inp = $('prayerDate').value;
  var base = inp ? new Date(inp + 'T12:00:00') : nowFrame();
  var t = prayerTimes(base, c.lat, c.lng, c.tz);
  var today = nowFrame();
  var ls = $('locStatus'); if (ls) ls.textContent = 'সক্রিয় লোকেশন: ' + c.name;
  var isToday = base.getFullYear() === today.getFullYear() && base.getMonth() === today.getMonth() && base.getDate() === today.getDate();
  var curKey = isToday ? currentEventKey(today) : null;
  var nxKey = isToday ? nextEvent(today).key : null;
  var ends = { fajr: t.sunrise, sunrise: t.sunrise + 20/60, dhuhr: t.asr, asr: t.maghrib, sunset: t.maghrib, maghrib: t.isha, isha: t.fajr + 24 };
  var html = '';
  PRAYER_ROWS.forEach(function(p){
    var cls = (p[0] === curKey) ? ' class="now"' : '';
    var badge = (p[0] === nxKey) ? ' <span class="badge">পরবর্তী</span>' : (p[0] === curKey ? ' <span class="badge">চলমান ওয়াক্ত</span>' : '');
    var endLbl = p[0] === 'isha' ? ' <small>(পরদিন ফজর)</small>' : (p[0] === 'sunrise' ? ' <small>(ইশরাক শুরু)</small>' : '');
    var alarmCell = '';
    if (p[0] !== 'sunrise' && p[0] !== 'sunset'){
      var aOn = (typeof ALARMS !== 'undefined' && ALARMS[p[0]] && ALARMS[p[0]].on);
      alarmCell = '<button class="tk' + (aOn ? ' done' : '') + '" data-alarm="' + p[0] + '" aria-label="' + p[1] + ' অ্যালার্ম">' + (aOn ? '✓ অন' : 'অফ') + '</button>';
    }
    html += '<tr' + cls + '><td>' + p[1] + badge + '</td><td class="time">' + fmtTime(t[p[0]]) + '</td><td class="end">' + fmtTime(ends[p[0]]) + endLbl + '</td><td>' + alarmCell + '</td></tr>';
  });
  $('prayerBody').innerHTML = html;
  /* নফল নামাজের সময় */
  var tom2 = new Date(base.getFullYear(), base.getMonth(), base.getDate() + 1);
  var tTom = prayerTimes(tom2, c.lat, c.lng, c.tz);
  var nightSpan = (tTom.fajr + 24) - t.maghrib;
  var tahajjudStart = t.maghrib + nightSpan * 2 / 3;
  var nafal = [
    ['ইশরাক', t.sunrise + 20/60, t.sunrise + 45/60, 'সূর্য ভালোভাবে উঠলে ২/৪ রাকাত'],
    ['চাশত (দুহা)', t.sunrise + 1, t.dhuhr - 10/60, 'সকালের নফল নামাজ, ২–৮ রাকাত'],
    ['আওয়াবিন', t.maghrib, t.isha, 'মাগরিবের পর ৬ রাকাত'],
    ['তাহাজ্জুদ', tahajjudStart, tTom.fajr + 24, 'রাতের শেষ তৃতীয়াংশে, ২–৮ রাকাত']
  ];
  $('nafalBody').innerHTML = nafal.map(function(n){
    return '<tr><td><b>' + n[0] + '</b><br /><small style="color:var(--ink-2)">' + n[3] + '</small></td><td class="time">' + fmtTime(n[1]) + '</td><td class="end">' + fmtTime(n[2]) + ' পর্যন্ত</td></tr>';
  }).join('');
  /* নিষিদ্ধ সময় */
  var forb = [
    ['সূর্যোদয়ের সময়', t.sunrise, t.sunrise + 20/60],
    ['জাওয়াল (সূর্য মাথার ওপরে)', t.dhuhr - 10/60, t.dhuhr],
    ['সূর্যাস্তের সময়', t.maghrib - 20/60, t.maghrib]
  ];
  $('forbidBody').innerHTML = forb.map(function(f){
    return '<tr><td><b>' + f[0] + '</b></td><td class="time">' + fmtTime(f[1]) + '</td><td class="end">' + fmtTime(f[2]) + ' পর্যন্ত</td></tr>';
  }).join('');
  $('prayerNote').textContent = 'হিসাব পদ্ধতি: ফজর ও এশার জন্য সূর্যের ১৮° কোণ, আসর হানাফি মাযহাব (ছায়া দ্বিগুণ) অনুযায়ী। জুমার দিন যোহরের সময়েই জুমার নামাজ অনুষ্ঠিত হয়। স্থানীয় মসজিদের আজানের সময়ের সঙ্গে ২–৩ মিনিট পার্থক্য থাকতে পারে।';
  renderHomePrayer();
  updateCountdown();
}
function renderHomePrayer(){
  var c = curLoc();
  var now = nowFrame();
  var t = prayerTimes(now, c.lat, c.lng, c.tz);
  var curKey = currentEventKey(now), nxKey = nextEvent(now).key;
  $('homePrayerCity').textContent = 'আজকের সময়সূচি — ' + c.name;
  var html = '<table class="ptable"><tbody>';
  PRAYER_ROWS.forEach(function(p){
    var mark = p[0] === nxKey ? ' <span class="badge">পরবর্তী</span>' : (p[0] === curKey ? ' <span class="badge">চলমান</span>' : '');
    html += '<tr' + (p[0] === curKey ? ' class="now"' : '') + '><td>' + p[1] + mark + '</td><td class="time">' + fmtTime(t[p[0]]) + '</td></tr>';
  });
  $('homePrayerList').innerHTML = html + '</tbody></table>';
}
/* ---------- Waqt card (current period, arc, progress, countdown) ---------- */
function currentSegment(now){
  var c = curLoc();
  var t = prayerTimes(now, c.lat, c.lng, c.tz);
  var yest = new Date(now.getFullYear(), now.getMonth(), now.getDate() - 1);
  var tom = new Date(now.getFullYear(), now.getMonth(), now.getDate() + 1);
  var tY = prayerTimes(yest, c.lat, c.lng, c.tz);
  var tT = prayerTimes(tom, c.lat, c.lng, c.tz);
  var evs = [{ key:'isha', name:'এশা', at: timeToDate(yest, tY.isha) }];
  PRAYERS.forEach(function(p){ evs.push({ key: p[0], name: p[1], at: timeToDate(now, t[p[0]]) }); });
  evs.push({ key:'fajr', name:'ফজর', at: timeToDate(tom, tT.fajr) });
  var cur = evs[0], nxt = evs[evs.length - 1];
  for (var i = 0; i < evs.length; i++){
    if (evs[i].at <= now) cur = evs[i];
    if (evs[i].at > now){ nxt = evs[i]; break; }
  }
  var seg = { name: cur.name, key: cur.key, start: cur.at, end: nxt.at, nextName: nxt.name };
  /* তাহাজ্জুদ: রাতের শেষ তৃতীয়াংশ (মাগরিব থেকে পরের ফজর) */
  var nightStart, fajrNext;
  if (now >= timeToDate(now, t.maghrib)){ nightStart = timeToDate(now, t.maghrib); fajrNext = timeToDate(tom, tT.fajr); }
  else { nightStart = timeToDate(yest, tY.maghrib); fajrNext = timeToDate(now, t.fajr); }
  var tStart = new Date(nightStart.getTime() + (fajrNext - nightStart) * 2 / 3);
  if (now >= tStart && now < fajrNext){
    seg = { name: 'তাহাজ্জুদ', key: 'tahajjud', start: tStart, end: fajrNext, nextName: 'ফজর' };
  }
  seg.isDay = now >= timeToDate(now, t.sunrise) && now < timeToDate(now, t.maghrib);
  return seg;
}
function fmtClockOf(d){ return fmtTime(d.getHours() + d.getMinutes() / 60); }
function updateWaqtCard(){
  var nameEl = $('wqName'); if (!nameEl) return;
  var now = nowFrame();
  var seg = currentSegment(now);
  var total = seg.end - seg.start, done = now - seg.start;
  var frac = total > 0 ? Math.max(0, Math.min(1, done / total)) : 0;
  nameEl.textContent = seg.name;
  $('wqEnd').textContent = 'শেষ সময়: ' + fmtClockOf(seg.end);
  $('wqNext').innerHTML = 'পরের ওয়াক্ত: <b>' + seg.nextName + '</b> — ' + fmtClockOf(seg.end);
  var rem = Math.max(0, Math.floor((seg.end - now) / 1000));
  var rh = Math.floor(rem / 3600), rm = Math.floor((rem % 3600) / 60), rs = rem % 60;
  $('wqCd').textContent = bn(rh) + ' ঘণ্টা ' + bn(rm) + ' মিনিট ' + bn(rs) + ' সেকেন্ড বাকি';
  $('wqProg').style.width = (frac * 100).toFixed(1) + '%';
  var ang = Math.PI * (1 - frac);
  var x = 150 + 125 * Math.cos(ang), y = 122 - 125 * Math.sin(ang);
  var sun = $('arcSun'), moon = $('arcMoon');
  if (sun && moon){
    if (seg.isDay){
      sun.style.display = ''; moon.style.display = 'none';
      var sc = $('arcSunC'); sc.setAttribute('cx', x.toFixed(1)); sc.setAttribute('cy', y.toFixed(1));
      var rays = $('arcSunRays');
      rays.innerHTML =
        '<line x1="' + x.toFixed(1) + '" y1="' + (y - 22).toFixed(1) + '" x2="' + x.toFixed(1) + '" y2="' + (y - 17).toFixed(1) + '"/>' +
        '<line x1="' + (x - 22).toFixed(1) + '" y1="' + y.toFixed(1) + '" x2="' + (x - 17).toFixed(1) + '" y2="' + y.toFixed(1) + '"/>' +
        '<line x1="' + (x + 17).toFixed(1) + '" y1="' + y.toFixed(1) + '" x2="' + (x + 22).toFixed(1) + '" y2="' + y.toFixed(1) + '"/>' +
        '<line x1="' + (x - 15).toFixed(1) + '" y1="' + (y - 15).toFixed(1) + '" x2="' + (x - 11.5).toFixed(1) + '" y2="' + (y - 11.5).toFixed(1) + '"/>' +
        '<line x1="' + (x + 11.5).toFixed(1) + '" y1="' + (y - 11.5).toFixed(1) + '" x2="' + (x + 15).toFixed(1) + '" y2="' + (y - 15).toFixed(1) + '"/>';
    } else {
      sun.style.display = 'none'; moon.style.display = '';
      var mp = $('arcMoonP');
      mp.setAttribute('transform', 'translate(' + (x - 47).toFixed(1) + ' ' + (y - 115).toFixed(1) + ')');
    }
  }
}
function refreshLocation(){
  renderPrayer(); updateQiblaInfo(); if (typeof renderTracker === 'function') renderTracker(); if (typeof renderAmal === 'function') renderAmal(); tickRamadan();
}
function requestGps(){
  if (!navigator.geolocation){ toast('এই ডিভাইসে লোকেশন (GPS) সুবিধা নেই'); syncLocSelects(); return; }
  toast('লোকেশন খোঁজা হচ্ছে… অনুমতি দিন');
  navigator.geolocation.getCurrentPosition(function(pos){
    var la = pos.coords.latitude, ln = pos.coords.longitude;
    gpsLoc = { name: 'আমার বর্তমান অবস্থান', lat: la, lng: ln, tz: tzForCoords(la, ln) };
    useGps = true; useCustom = false;
    syncLocSelects();
    refreshLocation();
    toast('লোকেশন পাওয়া গেছে — আপনার এলাকার সময় দেখানো হচ্ছে');
  }, function(){
    toast('লোকেশন পাওয়া যায়নি — অনুমতি দিন অথবা তালিকা থেকে জেলা বেছে নিন');
    syncLocSelects();
  }, { timeout: 12000, maximumAge: 300000 });
}
function searchPlace(){
  var q = $('placeSearch').value.trim();
  var st = $('placeStatus');
  if (!q){ toast('আগে জায়গার নাম লিখুন'); $('placeSearch').focus(); return; }
  st.textContent = 'খোঁজা হচ্ছে…';
  fetch('https://nominatim.openstreetmap.org/search?format=jsonv2&limit=1&addressdetails=1&q=' + encodeURIComponent(q))
    .then(function(r){ return r.json(); })
    .then(function(res){
      if (!res || !res.length){ st.textContent = 'পাওয়া যায়নি — নামটি ইংরেজিতে লিখে আবার চেষ্টা করুন, অথবা নিচে অক্ষাংশ-দ্রাঘিমাংশ দিয়ে সেট করুন।'; return; }
      var p = res[0];
      var lat = parseFloat(p.lat), lng = parseFloat(p.lon);
      var nm = String(p.display_name || q).split(',').slice(0, 2).join(', ');
      st.textContent = '';
      setCustomLoc(nm, lat, lng);
      toast(nm + ' — এই জায়গার সময় দেখানো হচ্ছে');
    })
    .catch(function(){ st.textContent = 'খোঁজা যায়নি — ইন্টারনেট সংযোগ দেখুন, অথবা অক্ষাংশ-দ্রাঘিমাংশ দিয়ে সেট করুন।'; });
}
function buildLocSelect(sel){
  var og = document.createElement('option'); og.value = '-1'; og.textContent = 'আমার বর্তমান অবস্থান (GPS)'; sel.appendChild(og);
  var oc = document.createElement('option'); oc.value = '-2'; oc.textContent = 'খোঁজা জায়গা (নাম লিখে খুঁজুন)'; sel.appendChild(oc);
  CITIES.forEach(function(c, i){ var o = document.createElement('option'); o.value = i; o.textContent = c[0]; sel.appendChild(o); });
  sel.value = String(cityIdx);
  sel.addEventListener('change', function(){ onLocSelect(sel); });
}
(function initPrayer(){
  buildLocSelect($('citySel'));
  buildLocSelect($('homeCitySel'));
  buildLocSelect($('setCitySel'));
  $('gpsBtn').addEventListener('click', requestGps);
  $('homeGpsBtn').addEventListener('click', requestGps);
  $('homeSearchBtn').addEventListener('click', function(){
    showView('prayer');
    setTimeout(function(){ var ps = $('placeSearch'); if (ps){ ps.focus(); ps.scrollIntoView({ block: 'center' }); } }, 60);
  });
  $('placeSearchBtn').addEventListener('click', searchPlace);
  $('placeSearch').addEventListener('keydown', function(e){ if (e.key === 'Enter'){ e.preventDefault(); searchPlace(); } });
  $('customApply').addEventListener('click', function(){
    var lat = parseFloat($('customLat').value), lng = parseFloat($('customLng').value);
    if (isNaN(lat) || isNaN(lng) || lat < -90 || lat > 90 || lng < -180 || lng > 180){ toast('সঠিক অক্ষাংশ ও দ্রাঘিমাংশ লিখুন'); return; }
    var nm = $('customName').value.trim() || 'কাস্টম লোকেশন';
    setCustomLoc(nm, lat, lng);
    toast(nm + ' — এই জায়গার সময় দেখানো হচ্ছে');
  });
  var now = nowFrame();
  $('prayerDate').value = now.getFullYear() + '-' + pad2(now.getMonth() + 1) + '-' + pad2(now.getDate());
  $('prayerDate').addEventListener('change', renderPrayer);
  $('todayBtn').addEventListener('click', function(){
    var n = nowFrame();
    $('prayerDate').value = n.getFullYear() + '-' + pad2(n.getMonth() + 1) + '-' + pad2(n.getDate());
    renderPrayer();
  });
  renderPrayer();
})();
setInterval(updateClock, 1000);
updateClock();
setInterval(function(){ renderPrayer(); }, 60000);
</script>
<script>
