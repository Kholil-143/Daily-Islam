<div class="toast" id="toast" role="status"></div>
<audio id="player" preload="none"></audio>
<script>
/* ================= Helpers ================= */
var BN_D = ['০','১','২','৩','৪','৫','৬','৭','৮','৯'];
function bn(n){ return String(n).replace(/[0-9]/g, function(d){ return BN_D[+d]; }); }
function $(id){ return document.getElementById(id); }
function pad2(n){ return (n<10?'0':'')+n; }
function esc(s){ return String(s).replace(/&/g,'&amp;').replace(/</g,'&lt;'); }
var toastTimer = null;
function toast(msg){
  var t = $('toast'); t.textContent = msg; t.classList.add('show');
  clearTimeout(toastTimer); toastTimer = setTimeout(function(){ t.classList.remove('show'); }, 2600);
}
function dhakaNow(){ return new Date(new Date().toLocaleString('en-US', { timeZone:'Asia/Dhaka' })); }

/* ================= Bengali calendar (Bangladesh) ================= */
var BN_MONTHS = ['বৈশাখ','জ্যৈষ্ঠ','আষাঢ়','শ্রাবণ','ভাদ্র','আশ্বিন','কার্তিক','অগ্রহায়ণ','পৌষ','মাঘ','ফাল্গুন','চৈত্র'];
function bengaliDate(d){
  var y = d.getFullYear(), m = d.getMonth(), day = d.getDate();
  var startYear = (m > 3 || (m === 3 && day >= 14)) ? y : y - 1;
  var start = new Date(startYear, 3, 14);
  var offset = Math.round((new Date(y, m, day) - start) / 86400000);
  var febYear = startYear + 1;
  var leap = (febYear % 4 === 0 && febYear % 100 !== 0) || febYear % 400 === 0;
  var lens = [31,31,31,31,31,31,30,30,30,30, leap ? 30 : 29, 30];
  var mi = 0; while (offset >= lens[mi]){ offset -= lens[mi]; mi++; }
  return { day: offset + 1, month: BN_MONTHS[mi], year: startYear - 593 };
}

var EN_MONTHS_BN = ['জানুয়ারি','ফেব্রুয়ারি','মার্চ','এপ্রিল','মে','জুন','জুলাই','আগস্ট','সেপ্টেম্বর','অক্টোবর','নভেম্বর','ডিসেম্বর'];
var HIJRI_MONTHS_BD = ['মুহাররম','সফর','রবিউল আউয়াল','রবিউস সানি','জমাদিউল আউয়াল','জমাদিউস সানি','রজব','শাবান','রমজান','শাওয়াল','জিলকদ','জিলহজ'];
/* Hijri date by Bangladesh local moon sighting: Umm al-Qura minus one day (same method as his blog) */
function hijriBD(d){
  try {
    var prev = new Date(d.getTime() - 86400000);
    var parts = new Intl.DateTimeFormat('en-u-ca-islamic-umalqura', { day:'numeric', month:'numeric', year:'numeric' }).formatToParts(prev);
    var o = {}; parts.forEach(function(p){ o[p.type] = +p.value; });
    if (!o.month || o.month < 1 || o.month > 12) return null;
    return { day: o.day, month: HIJRI_MONTHS_BD[o.month - 1], monthNum: o.month, year: o.year };
  } catch(e){ return null; }
}

/* ================= Clock & dates ================= */
function periodWord(h){
  if (h < 4) return 'রাত';
  if (h < 6) return 'ভোর';
  if (h < 11) return 'সকাল';
  if (h < 15) return 'দুপুর';
  if (h < 17) return 'বিকেল';
  if (h < 19) return 'সন্ধ্যা';
  return 'রাত';
}
function fmtClock(d){
  var h = d.getHours(), m = d.getMinutes(), s = d.getSeconds();
  var h12 = h % 12; if (h12 === 0) h12 = 12;
  return bn(h12) + ':' + bn(pad2(m)) + ':' + bn(pad2(s)) + ' <small>' + periodWord(h) + '</small>';
}
function bnSeason(monthName){
  var map = { 'বৈশাখ':'গ্রীষ্মকাল', 'জ্যৈষ্ঠ':'গ্রীষ্মকাল', 'আষাঢ়':'বর্ষাকাল', 'শ্রাবণ':'বর্ষাকাল', 'ভাদ্র':'শরৎকাল', 'আশ্বিন':'শরৎকাল', 'কার্তিক':'হেমন্তকাল', 'অগ্রহায়ণ':'হেমন্তকাল', 'পৌষ':'শীতকাল', 'মাঘ':'শীতকাল', 'ফাল্গুন':'বসন্তকাল', 'চৈত্র':'বসন্তকাল' };
  return map[monthName] || '';
}
function updateClock(){
  var now = dhakaNow();
  var clockEl = $('clock'); if (clockEl) clockEl.innerHTML = fmtClock(now);
  var bd = bengaliDate(now);
  var wd = ['রবিবার','সোমবার','মঙ্গলবার','বুধবার','বৃহস্পতিবার','শুক্রবার','শনিবার'][now.getDay()];
  var chip = $('topDateChip');
  if (chip) chip.textContent = EN_MONTHS_BN[now.getMonth()] + ' ' + bn(now.getDate());
  var hb = $('hijriBig'), hs = $('hijriSub');
  var hj = hijriBD(now);
  if (hb) hb.textContent = hj ? (bn(hj.day) + ' ' + hj.month + ' ' + bn(hj.year) + ' হিজরি') : '';
  if (hs) hs.textContent = 'বাংলা: ' + bn(bd.day) + ' ' + bd.month + ' ' + bn(bd.year) + ' • ' + wd + ' • ' + bnSeason(bd.month) + ' • ইংরেজি: ' + bn(now.getDate()) + ' ' + EN_MONTHS_BN[now.getMonth()] + ' ' + bn(now.getFullYear());
  updateCountdown(now);
  if (typeof updateWaqtCard === 'function') updateWaqtCard();
}

/* ================= Navigation ================= */
var currentView = 'home';
/* v4 in-app back navigation: a view-history stack + history.pushState, so the
   Android back button steps back one screen at a time (option -> previous
   view -> home) and only leaves the app from Home. Capacitor's backButton
   event is hooked too when the native bridge is present. */
var navStack = ['home'];
var navFromBack = false;
function navPush(v){
  if (navFromBack) return;
  if (navStack[navStack.length - 1] !== v) navStack.push(v);
  try { history.pushState({ diView: v }, ''); } catch (e) {}
}
function applyView(v){
  currentView = v;
  var secs = document.querySelectorAll('main section.view');
  for (var i = 0; i < secs.length; i++) secs[i].classList.toggle('on', secs[i].id === 'view-' + v);
  var tabs = document.querySelectorAll('.bottomnav button');
  for (var j = 0; j < tabs.length; j++) tabs[j].setAttribute('aria-selected', tabs[j].getAttribute('data-view') === v ? 'true' : 'false');
  if (v !== 'quran'){ stopAudio(); $('readerWrap').classList.add('hidden'); $('quranListWrap').classList.remove('hidden'); }
  /* v4: waqt / prayer-time hero interface is Home-only */
  if (document.body) document.body.classList.toggle('not-home', v !== 'home');
  window.scrollTo({ top: 0 });
}
function showView(v){
  applyView(v);
  navPush(v);
}
function goBackOne(){
  /* A feature subview inside More open? Back first returns to the More menu. */
  if (currentView === 'more'){
    var subs = document.querySelectorAll('.subview');
    var anyOpen = false;
    for (var si = 0; si < subs.length; si++) if (!subs[si].classList.contains('hidden')) anyOpen = true;
    if (anyOpen){
      for (var sj = 0; sj < subs.length; sj++) subs[sj].classList.add('hidden');
      window.scrollTo({ top: 0 });
      return true;
    }
  }
  /* Quran reader open? Back first returns to the surah/juz list. */
  var rw = $('readerWrap');
  if (currentView === 'quran' && rw && !rw.classList.contains('hidden')){
    stopAudio(); rw.classList.add('hidden'); $('quranListWrap').classList.remove('hidden');
    return true;
  }
  if (navStack.length > 1){
    navStack.pop();
    navFromBack = true;
    applyView(navStack[navStack.length - 1]);
    navFromBack = false;
    return true;
  }
  if (currentView !== 'home'){
    navFromBack = true;
    applyView('home');
    navFromBack = false;
    navStack = ['home'];
    return true;
  }
  return false; /* already Home: let the system exit the app */
}
window.addEventListener('popstate', function(){
  if (goBackOne()){
    /* re-arm one history entry so the next back press is also delivered here */
    try { history.pushState({ diView: currentView }, ''); } catch (e) {}
  }
});
try { history.replaceState({ diView: 'home' }, ''); history.pushState({ diView: 'home' }, ''); } catch (e) {}
/* v2.1: real Android back handling via the Capacitor App plugin.
   With a backButton listener registered, Android does NOT close the app;
   goBackOne() decides each step, and the app exits only from Home. */
/* v2.2: this app ships without a JS bundler, and the injected Capacitor
   bridge here has NO registerPlugin / Capacitor.Plugins — plugin listeners
   must be registered through nativeCallback, which is exactly what the
   plugin JS itself does under the hood. */
try {
  if (window.Capacitor && Capacitor.nativeCallback){
    Capacitor.nativeCallback('App', 'addListener', { eventName: 'backButton' }, function(){
      if (!goBackOne()){
        try { Capacitor.nativePromise('App', 'exitApp', {}); } catch (e) {}
      }
    });
  }
} catch (e) {}
function openSub(name){
  showView('more');
  var subs = document.querySelectorAll('.subview');
  for (var i = 0; i < subs.length; i++) subs[i].classList.add('hidden');
  $('sub-' + name).classList.remove('hidden');
  setTimeout(function(){ var el = $('sub-' + name); if (el) el.scrollIntoView({ block:'start' }); }, 30);
}
document.querySelector('.bottomnav').addEventListener('click', function(e){
  var b = e.target.closest('button[data-view]'); if (!b) return;
  var v = b.getAttribute('data-view');
  showView(v);
  if (v === 'profile' && typeof renderProfile === 'function') renderProfile();
});
document.addEventListener('click', function(e){
  var g = e.target.closest('[data-goto]'); if (g){ showView(g.getAttribute('data-goto')); return; }
  var s = e.target.closest('[data-sub]'); if (s){ openSub(s.getAttribute('data-sub')); }
});

/* ================= Icons & feature grid ================= */
function svgIcon(paths){ return '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">' + paths + '</svg>'; }
var ICONS = {
  clock: svgIcon('<circle cx="12" cy="12" r="9"/><path d="M12 7v5l3.5 2"/>'),
  quran: svgIcon('<path d="M5 4.5A1.5 1.5 0 0 1 6.5 3H19v15H6.5A1.5 1.5 0 0 0 5 19.5z"/><path d="M5 19.5A1.5 1.5 0 0 0 6.5 21H19v-3"/><path d="M12 7l.9 1.8 2 .3-1.45 1.4.35 2L12 11.6l-1.8.95.35-2L9.1 9.1l2-.3z" fill="currentColor" stroke="none"/>'),
  hadith: svgIcon('<path d="M6 3h12a1 1 0 0 1 1 1v13a3 3 0 0 1-3 3H6z"/><path d="M6 3a1 1 0 0 0-1 1v16a1 1 0 0 0 1 1"/><path d="M9.5 8h6M9.5 11.5h6M9.5 15h3.5"/>'),
