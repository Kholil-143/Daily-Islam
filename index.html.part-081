 { t:'তাফসিরে উসমানি', a:'আল্লামা শাব্বির আহমদ উসমানি (রহ.)', d:'আল্লামা শাব্বির আহমদ উসমানি (রহ.)-এর তাফসির — শায়খুল হিন্দের অনুবাদের টীকা।' },
 { t:'ফতোয়ায়ে আলমগিরি', a:'বাদশাহ আওরঙ্গজেবের নির্দেশে সংকলিত', d:'হানাফি ফিকহের বিশাল ফতোয়া-সংকলন (ফতোয়ায়ে হিন্দিয়া)।' },
];
var KITAB_ALL = KITAB.concat(KITAB_EXTRA);
/* ----- Kitab library (v2.16): in-app reader + offline downloads -----
   archive.org does NOT send CORS headers for its PDF files, so the PDFs
   themselves cannot be fetched into the app. The reader therefore uses
   archive.org's BookReader page images (the same scans the PDFs were
   made from): page images load as plain <img> (no CORS needed) and, for
   offline use, are stored in Cache Storage ('di-kitab-v1') through
   no-cors fetches. A "ব্রাউজারে খুলুন" fallback remains for any volume
   whose page images archive.org does not provide. */
var KITAB_CACHE = 'di-kitab-v1';
var kitabTab = 'all', kitabAuthor = '';
var kitabDl = {}, kitabProg = {}, kitabBmk = {};
try { kitabBmk = JSON.parse(localStorage.getItem('di_kitab_bmk') || '{}'); } catch (e) { kitabBmk = {}; }
try { kitabDl = JSON.parse(localStorage.getItem('di_kitab_dl') || '{}'); } catch (e) { kitabDl = {}; }
function kitabSaveDl(){ try { localStorage.setItem('di_kitab_dl', JSON.stringify(kitabDl)); } catch (e) {} }
function kitabSaveBmk(){ try { localStorage.setItem('di_kitab_bmk', JSON.stringify(kitabBmk)); } catch (e) {} }
function kitabSrc(k){
  if (k.pdfs) return k.pdfs.slice();
  if (k.pdf) return [k.pdf];
  var p = KITAB_PDF[k.t];
  if (!p) return null;
  return p.pdfs ? p.pdfs.slice() : [p.pdf];
}
function kitabItemOf(url){ var m = /archive\.org\/download\/([^\/]+)\//.exec(url || ''); return m ? m[1] : null; }
function kitabStemOf(url){ var f = (url || '').split('/').pop(); try { f = decodeURIComponent(f); } catch (e) {} return f.replace(/\.pdf$/i, ''); }
function kitabMarker(idx){ return 'https://muslimpath.kitab/book-' + idx; }
var kitabMeta = {};
try { kitabMeta = JSON.parse(localStorage.getItem('di_kitab_meta') || '{}'); } catch (e) { kitabMeta = {}; }
function kitabGetMeta(item){
  if (kitabMeta[item] && kitabMeta[item].server) return Promise.resolve(kitabMeta[item]);
  return fetch('https://archive.org/metadata/' + item).then(function(r){ return r.json(); }).then(function(d){
    var m = { server: d.server, dir: d.dir };
    kitabMeta[item] = m;
    try { localStorage.setItem('di_kitab_meta', JSON.stringify(kitabMeta)); } catch (e) {}
    return m;
  });
}
function kitabPageUrl(meta, item, stem, leaf){
  var p = ('0000' + leaf).slice(-4);
  return 'https://' + meta.server + '/BookReader/BookReaderImages.php?zip=' + meta.dir + '/' + encodeURIComponent(stem) + '_jp2.zip&file=' + encodeURIComponent(stem) + '_jp2/' + encodeURIComponent(stem) + '_' + p + '.jp2&id=' + item + '&scale=4&rotate=0';
}
var kitabPages = {};
try { kitabPages = JSON.parse(localStorage.getItem('di_kitab_pages') || '{}'); } catch (e) { kitabPages = {}; }
function kitabLeafOk(url){ return fetch(url).then(function(r){ return r.ok; }).catch(function(){ return false; }); }
function kitabPageCount(item, stem){
  var key = item + '/' + stem;
  if (kitabPages[key]) return Promise.resolve(kitabPages[key]);
  return kitabGetMeta(item).then(function(meta){
    function url(l){ return kitabPageUrl(meta, item, stem, l); }
    return kitabLeafOk(url(0)).then(function(ok0){
      if (!ok0) { kitabPages[key] = 0; return 0; }
      var lo = 0, hi = 1;
      function grow(){
        return kitabLeafOk(url(hi)).then(function(ok){
          if (ok){ lo = hi; hi *= 2; if (hi > 8192) return lo + 1; return grow(); }
          return null;
        });
      }
      return grow().then(function(){
        function bs(){
          if (hi - lo <= 1) return lo + 1;
          var mid = Math.floor((lo + hi) / 2);
          return kitabLeafOk(url(mid)).then(function(ok){ if (ok) lo = mid; else hi = mid; return bs(); });
        }
        return bs();
      }).then(function(count){
        kitabPages[key] = count;
        try { localStorage.setItem('di_kitab_pages', JSON.stringify(kitabPages)); } catch (e) {}
        return count;
      });
    });
  });
}
function renderKitab(){
  var q = (($('kitabSearch') || {}).value || '').trim();
  var list = KITAB_ALL.map(function(k, i){ return { k: k, i: i }; }).filter(function(x){
    if (kitabTab === 'offline' && !kitabDl[x.i]) return false;
    if (kitabTab === 'bmk' && !kitabBmk[x.i]) return false;
    if (kitabAuthor && x.k.a !== kitabAuthor) return false;
    return !q || (x.k.t + ' ' + x.k.a).indexOf(q) > -1;
  });
  $('kitabList').innerHTML = list.length ? list.map(function(x){
    var k = x.k, i = x.i, srcs = kitabSrc(k);
    var cover = '';
    if (srcs){ var item = kitabItemOf(srcs[0]); if (item) cover = '<img class="kcover" src="https://archive.org/services/img/' + item + '" alt="" loading="lazy" onerror="this.style.display=\'none\'" />'; }
    var btn;
    if (!srcs) btn = '<span class="sub" style="white-space:nowrap">PDF পাওয়া যায়নি</span>';
    else if (kitabProg[i] != null) btn = '<button type="button" class="btn" disabled>⬇ ' + bn(kitabProg[i]) + '%</button>';
    else if (kitabDl[i]) btn = '<button type="button" class="btn gold" data-kread="' + i + '">পড়ুন</button>';
    else btn = '<button type="button" class="btn" data-kdl="' + i + '">⬇ ডাউনলোড</button>';
    return '<article class="hcard kcard" data-kopen="' + i + '">' + cover +
      '<div class="kinfo"><h3>' + k.t + ' <button type="button" class="kbmk" data-kbmk="' + i + '" aria-label="বুকমার্ক">' + (kitabBmk[i] ? '🔖' : '<span style="opacity:.35">🔖</span>') + '</button></h3>' +
      '<p style="color:var(--gold); font-weight:600; margin:0 0 6px">' + k.a + '</p><p class="kdesc" style="margin:0">' + k.d + '</p></div>' +
      '<div class="kaction">' + btn + '</div></article>';
  }).join('') : '<p class="loadmsg">' + (kitabTab === 'offline' ? 'এখনো কোনো বই ডাউনলোড করা হয়নি — "সকল" তালিকা থেকে ডাউনলোড করুন।' : (kitabTab === 'bmk' ? 'এখনো কোনো বই বুকমার্ক করা হয়নি।' : 'কিছু পাওয়া যায়নি।')) + '</p>';
}
$('kitabSearch').addEventListener('input', renderKitab);
document.querySelectorAll('[data-ktab]').forEach(function(b){ b.addEventListener('click', function(){
  kitabTab = b.getAttribute('data-ktab');
  document.querySelectorAll('[data-ktab]').forEach(function(x){ x.setAttribute('aria-pressed', x === b ? 'true' : 'false'); });
  renderKitab();
}); });
(function(){
  var sel = $('kitabAuthor'); if (!sel) return;
  var seen = {}, opts = '<option value="">সকল লেখক</option>';
  KITAB_ALL.forEach(function(k){ if (!seen[k.a]){ seen[k.a] = 1; opts += '<option value="' + esc(k.a) + '">' + esc(k.a) + '</option>'; } });
  sel.innerHTML = opts;
  sel.addEventListener('change', function(){ kitabAuthor = sel.value; renderKitab(); });
})();
$('kitabList').addEventListener('click', function(e){
  var bm = e.target.closest('[data-kbmk]');
  if (bm){ var bi = +bm.getAttribute('data-kbmk'); if (kitabBmk[bi]) delete kitabBmk[bi]; else kitabBmk[bi] = true; kitabSaveBmk(); renderKitab(); return; }
  var dl = e.target.closest('[data-kdl]'); if (dl){ kitabDownload(+dl.getAttribute('data-kdl')); return; }
  var rd = e.target.closest('[data-kread]'); if (rd){ openKitabReader(+rd.getAttribute('data-kread'), 0); return; }
  var card = e.target.closest('[data-kopen]');
  if (card){ var ci = +card.getAttribute('data-kopen'); if (kitabSrc(KITAB_ALL[ci])) openKitabReader(ci, 0); }
});
function kitabDownload(idx){
  var k = KITAB_ALL[idx]; var srcs = kitabSrc(k); if (!srcs) return;
  if (kitabProg[idx] != null || kitabDl[idx]) return;
  kitabProg[idx] = 0; renderKitab();
  var counts = [], totalPages = 0, donePages = 0;
  var chain = Promise.resolve();
  srcs.forEach(function(u, vi){
    chain = chain.then(function(){ return kitabPageCount(kitabItemOf(u), kitabStemOf(u)).then(function(c){ counts[vi] = c; totalPages += c; }); });
  });
  chain.then(function(){
    if (!totalPages){ delete kitabProg[idx]; renderKitab(); toast('এই বইয়ের পৃষ্ঠা পাওয়া যায়নি — কার্ডে চাপ দিয়ে ব্রাউজারে খুলে পড়ুন'); return null; }
    if (!confirm('"' + k.t + '" ডাউনলোড হবে — মোট ' + bn(totalPages) + ' পৃষ্ঠা। পৃষ্ঠার ছবি ডাউনলোড হওয়ায় আকার বড় হতে পারে। চালিয়ে যাবেন?')){ delete kitabProg[idx]; renderKitab(); return null; }
    return caches.open(KITAB_CACHE).then(function(cache){
      var seq = Promise.resolve();
      srcs.forEach(function(u, vi){
        if (!counts[vi]) return;
        var item = kitabItemOf(u), stem = kitabStemOf(u);
        seq = seq.then(function(){ return kitabGetMeta(item); }).then(function(meta){
          var pseq = Promise.resolve();
          for (var leaf = 0; leaf < counts[vi]; leaf++){
            (function(lf){
              pseq = pseq.then(function(){
                var pu = kitabPageUrl(meta, item, stem, lf);
                return cache.match(pu).then(function(hit){
                  if (hit){ donePages++; kitabProg[idx] = Math.floor(donePages * 100 / totalPages); return; }
                  return fetch(pu, { mode: 'no-cors' }).then(function(resp){ return cache.put(pu, resp); }).then(function(){
                    donePages++; kitabProg[idx] = Math.floor(donePages * 100 / totalPages);
                    if (donePages % 5 === 0 || donePages === totalPages) renderKitab();
                  });
                });
              });
            })(leaf);
          }
          return pseq;
        });
      });
      return seq.then(function(){ return cache.put(kitabMarker(idx), new Response('ok')); });
    }).then(function(){
      delete kitabProg[idx]; kitabDl[idx] = true; kitabSaveDl();
      toast('ডাউনলোড সম্পূর্ণ — এখন অফলাইনেও পড়া যাবে');
      renderKitab();
    });
  }).catch(function(){
    delete kitabProg[idx]; renderKitab();
    toast('ডাউনলোড ব্যর্থ হয়েছে — ইন্টারনেট সংযোগ দেখে আবার চেষ্টা করুন');
  });
}
/* ----- in-app reader ----- */
var kitabReader = null, kitabObjUrl = null;
window.kitabReaderOpen = false;
function openKitabReader(idx, vol){
  var k = KITAB_ALL[idx]; var srcs = kitabSrc(k); if (!srcs) return;
  vol = vol || 0;
  var item = kitabItemOf(srcs[vol]), stem = kitabStemOf(srcs[vol]);
  kitabReader = { idx: idx, vol: vol, page: 0, count: 0, item: item, stem: stem, meta: null };
  window.kitabReaderOpen = true;
  $('kitabListWrap').classList.add('hidden');
  $('kitabReader').classList.remove('hidden');
  window.scrollTo({ top: 0 });
  renderKitabReaderHead();
  $('kitabPageMsg').classList.remove('hidden');
  $('kitabPageImg').removeAttribute('src');
  kitabPageCount(item, stem).then(function(c){
    if (!kitabReader || kitabReader.idx !== idx || kitabReader.vol !== vol) return null;
    kitabReader.count = c;
    return kitabGetMeta(item);
  }).then(function(meta){
    if (!kitabReader) return;
    kitabReader.meta = meta;
    if (!kitabReader.count){ showKitabReaderFallback(); return; }
    try { var lp = JSON.parse(localStorage.getItem('di_kitab_last') || '{}'); if (lp.idx === idx && lp.vol === vol && lp.page > 0 && lp.page < kitabReader.count) kitabReader.page = lp.page; } catch (e) {}
    showKitabPage();
  }).catch(function(){ showKitabReaderFallback(); });
}
function renderKitabReaderHead(){
  var R = kitabReader; if (!R) return;
  var k = KITAB_ALL[R.idx]; var srcs = kitabSrc(k);
  $('kitabReaderTitle').textContent = k.t;
  $('kitabVolChips').innerHTML = srcs.length > 1 ? srcs.map(function(u, vi){ return '<button type="button" class="btn' + (vi === R.vol ? ' gold' : ' ghost') + '" data-kvol="' + vi + '">খণ্ড ' + bn(vi + 1) + '</button>'; }).join('') : '';
}
function showKitabPage(){
  var R = kitabReader; if (!R || !R.meta || !R.count) return;
  var url = kitabPageUrl(R.meta, R.item, R.stem, R.page);
  $('kitabPageInfo').textContent = 'পৃষ্ঠা ' + bn(R.page + 1) + ' / ' + bn(R.count);
  $('kitabPrevBtn').disabled = R.page <= 0;
  $('kitabNextBtn').disabled = R.page >= R.count - 1;
  $('kitabFallback').classList.add('hidden');
  var img = $('kitabPageImg'), msg = $('kitabPageMsg');
  msg.classList.remove('hidden'); img.style.opacity = '.35';
  try { localStorage.setItem('di_kitab_last', JSON.stringify({ idx: R.idx, vol: R.vol, page: R.page })); } catch (e) {}
  img.onload = function(){ msg.classList.add('hidden'); img.style.opacity = ''; };
  img.onerror = function(){ msg.classList.add('hidden'); img.style.opacity = ''; showKitabReaderFallback(); };
  if (kitabDl[R.idx] && 'caches' in window){
    caches.open(KITAB_CACHE).then(function(c){ return c.match(url); }).then(function(m){
      if (!kitabReader) return;
      if (m) m.blob().then(function(b){ if (!kitabReader) return; if (kitabObjUrl) URL.revokeObjectURL(kitabObjUrl); kitabObjUrl = URL.createObjectURL(b); img.src = kitabObjUrl; });
      else img.src = url;
    }).catch(function(){ img.src = url; });
  } else img.src = url;
}
function showKitabReaderFallback(){
  var fb = $('kitabFallback'); if (!fb) return;
  fb.classList.remove('hidden');
  $('kitabPageMsg').classList.add('hidden');
  var R = kitabReader;
  if (R){ var srcs = kitabSrc(KITAB_ALL[R.idx]); $('kitabExtLink').href = srcs[R.vol]; }
}
function closeKitabReader(){
  kitabReader = null; window.kitabReaderOpen = false;
  if (kitabObjUrl){ URL.revokeObjectURL(kitabObjUrl); kitabObjUrl = null; }
  $('kitabReader').classList.add('hidden');
  $('kitabListWrap').classList.remove('hidden');
  window.scrollTo({ top: 0 });
}
window.closeKitabReader = closeKitabReader;
$('kitabBackBtn').addEventListener('click', closeKitabReader);
$('kitabPrevBtn').addEventListener('click', function(){ if (kitabReader && kitabReader.page > 0){ kitabReader.page--; showKitabPage(); } });
$('kitabNextBtn').addEventListener('click', function(){ if (kitabReader && kitabReader.page < kitabReader.count - 1){ kitabReader.page++; showKitabPage(); } });
$('kitabVolChips').addEventListener('click', function(e){ var b = e.target.closest('[data-kvol]'); if (b && kitabReader) openKitabReader(kitabReader.idx, +b.getAttribute('data-kvol')); });
$('kitabJumpBtn').addEventListener('click', function(){
  if (!kitabReader) return;
  var v = parseInt($('kitabJump').value, 10);
  if (isNaN(v) || v < 1 || v > kitabReader.count){ toast('সঠিক পৃষ্ঠা নম্বর লিখুন (১ – ' + bn(kitabReader.count) + ')'); return; }
  kitabReader.page = v - 1; showKitabPage();
});
renderKitab();
/* Verify download markers against the real cache (cache is the truth). */
if ('caches' in window){
  caches.open(KITAB_CACHE).then(function(cache){
    return Promise.all(KITAB_ALL.map(function(k, i){
      if (!kitabSrc(k)) return null;
      return cache.match(kitabMarker(i)).then(function(m){ if (m) kitabDl[i] = true; else if (kitabDl[i]) delete kitabDl[i]; });
    }));
  }).then(function(){ kitabSaveDl(); renderKitab(); }).catch(function(){});
}


/* ----- Settings (v2.16): Arabic font size + clear downloads ----- */
function applyAfont(v){
  document.documentElement.setAttribute('data-afont', v);
  document.querySelectorAll('#afontPick [data-afont]').forEach(function(b){ b.setAttribute('aria-pressed', b.getAttribute('data-afont') === v ? 'true' : 'false'); });
}
(function(){
  var v = 'm';
  try { v = localStorage.getItem('di_afont') || 'm'; } catch (e) {}
  if (['s', 'm', 'l'].indexOf(v) < 0) v = 'm';
  applyAfont(v);
  var pk = $('afontPick');
  if (pk) pk.addEventListener('click', function(e){
    var b = e.target.closest('[data-afont]'); if (!b) return;
    var nv = b.getAttribute('data-afont');
    try { localStorage.setItem('di_afont', nv); } catch (e) {}
    applyAfont(nv);
    toast('আরবি হরফের আকার বদলানো হয়েছে');
  });
  var cb = $('clearDlBtn');
  if (cb) cb.addEventListener('click', function(){
    if (!confirm('ডাউনলোড করা সব অডিও ও কিতাবের পৃষ্ঠা মুছে ফেলবেন?')) return;
    var jobs = [];
    if ('caches' in window){
      jobs.push(caches.open(AUDIO_CACHE).then(function(c){ return c.keys(); }).then(function(ks){ var n = ks.length; return caches.delete(AUDIO_CACHE).then(function(){ return n; }); }).catch(function(){ return 0; }));
      jobs.push(caches.open(KITAB_CACHE).then(function(c){ return c.keys(); }).then(function(ks){ var n = ks.length; return caches.delete(KITAB_CACHE).then(function(){ return n; }); }).catch(function(){ return 0; }));
    }
    Promise.all(jobs).then(function(ns){
      var total = 0; ns.forEach(function(n){ total += n; });
      kitabDl = {}; kitabSaveDl();
      tilRefreshCache(function(){ if (currentView === 'tilawat') buildTilawat(); });
      renderKitab();
      toast(total > 0 ? bn(total) + 'টি ডাউনলোড করা ফাইল মোছা হয়েছে' : 'মোছা হয়েছে — কোনো ডাউনলোড করা ফাইল ছিল না');
    });
  });
})();

/* ---------- Articles ---------- */
var ARTICLES = [
 { t:'তাওহিদ: ঈমানের ভিত্তি', b:'তাওহিদ অর্থ আল্লাহকে তাঁর সত্তা, গুণাবলি, কাজ ও ইবাদতে এক ও অদ্বিতীয় মানা। সব নবী-রাসূলের দাওয়াতের মূল কথাই ছিল এটি: "তোমরা আল্লাহর ইবাদত করো, তিনি ছাড়া তোমাদের কোনো ইলাহ নেই।" (সূরা আল-আরাফ: ৫৯)\nতাওহিদ শুধু মুখের স্বীকৃতি নয় — ইবাদতের প্রতিটি কাজ (নামাজ, রোজা, দোয়া, কুরবানি, মানত) শুধু আল্লাহর জন্য নির্দিষ্ট করা এবং সাহায্য ও ভরসা একমাত্র তাঁর ওপর রাখাই এর প্রাণ। যে অন্তরে তাওহিদ প্রতিষ্ঠিত, সে অন্তরে সৃষ্টির ভয় ও লোভ জায়গা পায় না।' },
 { t:'নামাজ: মুমিনের মিরাজ', b:'পাঁচ ওয়াক্ত নামাজ ইসলামের দ্বিতীয় স্তম্ভ এবং মিরাজের রাতে উম্মতকে দেওয়া আল্লাহর বিশেষ উপহার। আল্লাহ বলেন, "নিশ্চয় নামাজ অশ্লীল ও মন্দ কাজ থেকে বিরত রাখে।" (সূরা আল-আনকাবুত: ৪৫)\nনামাজ শুধু একটি আচার নয় — এটি দিনে পাঁচবার আল্লাহর সামনে দাঁড়িয়ে নিজের হিসাব নেওয়ার সুযোগ। যে নামাজ খুশু-খুযুসহ আদায় করা হয়, তা মানুষের চরিত্র বদলে দেয়: সময়নিষ্ঠা, পবিত্রতা, ধৈর্য ও বিনয় — সব গুণই নামাজ থেকে জন্ম নেয়। তাই হাদিসে এসেছে, কিয়ামতের দিন সর্বপ্রথম নামাজের হিসাব নেওয়া হবে। (সুনানে তিরমিযি: ৪১৩)' },
 { t:'পিতামাতার হক ও খেদমত', b:'আল্লাহ তাঁর নিজের ইবাদতের নির্দেশের ঠিক পরেই পিতামাতার প্রতি সদ্ব্যবহারের নির্দেশ দিয়েছেন (সূরা আল-ইসরা: ২৩) — এ থেকেই বোঝা যায় এই হকের মর্যাদা কত উচ্চ। এমনকি তাঁদের কোনো কথায় "উফ" শব্দটুকুও বলতে নিষেধ করা হয়েছে।\nরাসূলুল্লাহ ﷺ বলেছেন, "পিতা-মাতার সন্তুষ্টিতেই আল্লাহর সন্তুষ্টি, আর তাঁদের অসন্তুষ্টিতে আল্লাহর অসন্তুষ্টি।" (সুনানে তিরমিযি: ১৮৯৯) বৃদ্ধ বয়সে তাঁদের খেদমত জান্নাত লাভের সবচেয়ে সহজ পথগুলোর একটি — যে পিতামাতা উভয়কে বা একজনকে বৃদ্ধ অবস্থায় পেয়েও জান্নাত অর্জন করতে পারল না, তার জন্য হাদিসে দুঃখ প্রকাশ করা হয়েছে। (সহিহ মুসলিম: ২৫৫১)' },
 { t:'সদকা: যে দানে সম্পদ বাড়ে', b:'সদকা শুধু টাকা দেওয়া নয় — প্রতিটি ভালো কাজই সদকা: মুখের হাসি, পথ থেকে কষ্টদায়ক জিনিস সরানো, ভালো কথা বলা — সবই সদকার অন্তর্ভুক্ত। (সহিহ মুসলিম: ১০০৯) আল্লাহ প্রতিশ্রুতি দিয়েছেন, সদকার বিনিময়ে তিনি বহুগুণ বাড়িয়ে দেবেন (সূরা আল-বাকারা: ২৬১)।\nরাসূলুল্লাহ ﷺ বলেছেন, "সদকা করলে সম্পদ কমে না।" (সহিহ মুসলিম: ২৫৮৮) গোপনে দান করা সর্বোত্তম, কারণ তা রিয়া থেকে মুক্ত; আর নিয়মিত ছোট দান আল্লাহর কাছে প্রিয় — "আল্লাহর কাছে সবচেয়ে প্রিয় আমল হলো যা নিয়মিত করা হয়, যদিও তা কম হয়।" (সহিহ বুখারি: ৬৪৬৪)' },
 { t:'রমজান: আত্মশুদ্ধির প্রশিক্ষণের মাস', b:'রমজান কেবল না-খেয়ে থাকার মাস নয় — এটি তাকওয়া অর্জনের প্রশিক্ষণকাল। আল্লাহ বলেন, "তোমাদের ওপর রোজা ফরজ করা হয়েছে, যেমন ফরজ করা হয়েছিল তোমাদের পূর্ববর্তীদের ওপর — যাতে তোমরা তাকওয়া অর্জন করতে পারো।" (সূরা আল-বাকারা: ১৮৩)\nএই মাসে কুরআন নাজিল হয়েছে, এই মাসেই লাইলাতুল কদর — হাজার মাসের চেয়ে উত্তম এক রাত। রোজাদারের জন্য জান্নাতে রয়েছে বিশেষ দরজা "রাইয়ান" (সহিহ বুখারি: ১৮৯৬)। রমজানকে কাজে লাগানোর উপায়: পাঁচ ওয়াক্ত নামাজ জামাতে, প্রতিদিন কুরআন তিলাওয়াত, তারাবি, শেষ দশকে ইতিকাফ ও কদর অন্বেষণ, বেশি বেশি দোয়া ও সদকা।' }
];
$('articleList').innerHTML = ARTICLES.map(function(a){
  var paras = a.b.split('\n').map(function(p){ return '<p>' + p + '</p>'; }).join('');
  return '<details class="acc"><summary>' + a.t + '</summary><div class="body">' + paras + '</div></details>';
}).join('');

/* ---------- Quran shikkha: letters ---------- */
var LETTERS = [['ا','আলিফ'],['ب','বা'],['ت','তা'],['ث','সা'],['ج','জিম'],['ح','হা'],['خ','খা'],['د','দাল'],['ذ','যাল'],['ر','রা'],['ز','যা'],['س','সিন'],['ش','শিন'],['ص','সাদ'],['ض','দাদ'],['ط','ত্বা'],['ظ','যোয়া'],['ع','আইন'],['غ','গাইন'],['ف','ফা'],['ق','ক্বাফ'],['ك','কাফ'],['ل','লাম'],['م','মিম'],['ن','নুন'],['ه','হা'],['و','ওয়াও'],['ي','ইয়া'],['ء','হামজা']];
$('letterGrid').innerHTML = LETTERS.map(function(L){
  return '<div style="border:1px solid var(--line); border-radius:12