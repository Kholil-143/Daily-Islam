imeFormat('bn-BD', { weekday:'short', day:'numeric', month:'short' }).format(d2) + '</td><td style="padding:7px 8px; border-bottom:1px solid var(--line)">' + fmtTime(tt.fajr - 10/60) + '</td><td style="padding:7px 8px; border-bottom:1px solid var(--line)">' + fmtTime(tt.maghrib) + '</td></tr>';
  }
  $('ramadanTable').innerHTML = '<h4 style="margin:4px 0 8px; text-align:center">রমজানের ৩০ দিনের সময়সূচি — ' + c.name + '</h4><div style="overflow-x:auto"><table style="width:100%; border-collapse:collapse; font-size:14.5px"><thead><tr><th style="text-align:left; padding:7px 8px; border-bottom:2px solid var(--gold)">রোজা</th><th style="text-align:left; padding:7px 8px; border-bottom:2px solid var(--gold)">তারিখ</th><th style="text-align:left; padding:7px 8px; border-bottom:2px solid var(--gold)">সেহরি শেষ</th><th style="text-align:left; padding:7px 8px; border-bottom:2px solid var(--gold)">ইফতার</th></tr></thead><tbody>' + rows + '</tbody></table></div><p class="sub" style="margin:8px 0 0">চাঁদ দেখার ওপর ভিত্তি করে রমজান এক দিন এদিক-সেদিক হতে পারে।</p>';
});

/* ---------- Dua bookmarks + profile open ---------- */
document.addEventListener('click', function(e){
  var db = e.target.closest('[data-bmd]');
  if (db){
    toggleBookmark({ key: 'dua:' + db.getAttribute('data-bmd'), type: 'dua', idx: 0, label: db.getAttribute('data-bmd'), sub: 'দোয়া' });
    renderDuas($('duaSearch').value.trim());
    return;
  }
  var ob = e.target.closest('[data-open-bmk]');
  if (ob){
    var b = BOOKMARKS[+ob.getAttribute('data-open-bmk')];
    if (b && b.type === 'dua'){ showView('dua'); $('duaSearch').value = b.label; renderDuas(b.label); }
  }
});

/* ---------- Last read ---------- */
var LASTREAD = null;
function setLastRead(mode, idx, si, ai){ LASTREAD = { mode: mode, idx: idx, si: si, ai: ai }; renderLastRead(); }
function renderLastRead(){
  var box = $('lastReadBox'); if (!box) return;
  if (!LASTREAD){ box.innerHTML = ''; return; }
  var label = LASTREAD.mode === 'surah' ? ('সূরা ' + SURA_BN[LASTREAD.idx]) : ('পারা ' + bn(LASTREAD.idx + 1) + ' — ' + JUZ_NAMES[LASTREAD.idx]);
  box.innerHTML = '<div class="card" style="margin-bottom:12px; display:flex; align-items:center; gap:12px; flex-wrap:wrap"><div style="flex:1; min-width:210px"><b>শেষ পড়া</b><br><span style="color:var(--ink-2)">' + label + ' — আয়াত ' + bn(LASTREAD.ai + 1) + ' পর্যন্ত পড়েছেন (এই সেশনে)</span></div><button class="btn gold" id="resumeBtn">পড়া চালিয়ে যান</button></div>';
  $('resumeBtn').addEventListener('click', function(){
    var lr = LASTREAD; showView('quran'); openReader(lr.mode, lr.idx);
    setTimeout(function(){
      var el = $('ayah-' + globalAyah(lr.si, lr.ai));
      if (el){ el.scrollIntoView({ block: 'center' }); el.style.outline = '2px solid var(--gold)'; setTimeout(function(){ el.style.outline = ''; }, 2600); }
    }, 800);
  });
}
$('readerBody').addEventListener('click', function(e){
  var b = e.target.closest('[data-lr]'); if (!b) return;
  var p = b.getAttribute('data-lr').split(':');
  setLastRead(readerState.mode, readerState.idx, +p[0], +p[1]);
  toast('থামার চিহ্ন রাখা হয়েছে — প্রোফাইলে পাবেন');
});

/* ---------- Hijri calendar ---------- */
(function renderHijriCal(){
  var box = $('hijriCal'); if (!box) return;
  var now = dhakaNow(); var today = new Date(now.getFullYear(), now.getMonth(), now.getDate());
  var h0 = hijriOf(today); if (!h0) return;
  var first = new Date(today.getFullYear(), today.getMonth(), today.getDate() - (h0.day - 1));
  for (var adj = -2; adj <= 2; adj++){
    var cand = new Date(first.getFullYear(), first.getMonth(), first.getDate() + adj);
    var hc = hijriOf(cand);
    if (hc && hc.day === 1 && hc.month === h0.month){ first = cand; break; }
  }
  $('hijriCalTitle').textContent = HIJRI_MONTHS_BD[h0.month - 1] + ' ' + bn(h0.year) + ' হিজরি';
  var wd = ['রবি','সোম','মঙ্গল','বুধ','বৃহস্পতি','শুক্র','শনি'];
  var cells = wd.map(function(w){ return '<div style="text-align:center; font-weight:700; font-size:12px; color:var(--gold); padding:4px 0">' + w + '</div>'; }).join('');
  for (var e = 0; e < first.getDay(); e++) cells += '<div></div>';
  for (var k = 0; k < 31; k++){
    var d = new Date(first.getFullYear(), first.getMonth(), first.getDate() + k);
    var hh = hijriOf(d); if (!hh || hh.month !== h0.month) break;
    var isToday = d.getTime() === today.getTime();
    var special = SPECIAL_DAYS.some(function(sd){ return sd.m === hh.month && sd.d === hh.day; });
    cells += '<div style="text-align:center; padding:6px 2px; border-radius:9px;' + (isToday ? 'background:var(--gold); color:#231a04; font-weight:700;' : '') + (special && !isToday ? 'border:1.5px solid var(--gold);' : '') + '"><div style="font-size:16px; line-height:1.15">' + bn(hh.day) + '</div><div style="font-size:10.5px; opacity:.75">' + bn(d.getDate()) + '</div></div>';
  }
  box.innerHTML = '<div style="display:grid; grid-template-columns:repeat(7,1fr); gap:4px">' + cells + '</div><p class="sub" style="margin:8px 0 0; text-align:center">সোনালি ঘের দেওয়া ঘর = বিশেষ দিবস • ছোট সংখ্যা = ইংরেজি তারিখ</p>';
})();

/* ---------- Fitra ---------- */
$('fCalc').addEventListener('click', function(){
  var per = parseFloat($('fPer').value) || 0, cnt = parseInt($('fCount').value, 10) || 0;
  var box = $('fResult'); box.classList.remove('hidden');
  if (per <= 0 || cnt <= 0){ box.innerHTML = 'সঠিক পরিমাণ ও সদস্য সংখ্যা লিখুন।'; return; }
  box.innerHTML = 'মোট ফিতরা: <b>৳ ' + bn(String(per * cnt)) + '</b> — ' + bn(cnt) + ' জন সদস্যের জন্য (জনপ্রতি ৳ ' + bn(String(per)) + ' করে)। ঈদের নামাজের আগেই গরিব-মিসকিনের কাছে পৌঁছে দিন।';
});

/* ---------- My mosque ---------- */
var MYMOSQUE = null;
function fmtClockVal(v){
  if (!v) return '—';
  var p = v.split(':'); var h = +p[0]; var h12 = h % 12; if (h12 === 0) h12 = 12;
  return periodWord(h) + ' ' + bn(h12) + ':' + bn(p[1]);
}
function renderMyMosque(){
  var box = $('mmDisplay'); if (!box) return;
  if (!MYMOSQUE){ box.innerHTML = ''; return; }
  var rows = '';
  for (var k in MYMOSQUE.times) rows += '<div class="tk-row"><span class="nm">' + k + ' জামাত</span><span class="tm">' + fmtClockVal(MYMOSQUE.times[k]) + '</span></div>';
  box.innerHTML = '<div class="card"><h3 style="margin-top:0">' + esc(MYMOSQUE.name) + '</h3>' + (MYMOSQUE.area ? '<p class="sub" style="margin-top:0">' + esc(MYMOSQUE.area) + '</p>' : '') + rows + '</div>';
}
$('mmSave').addEventListener('click', function(){
  var name = $('mmName').value.trim();
  if (!name){ toast('আগে মসজিদের নাম লিখুন'); $('mmName').focus(); return; }
  MYMOSQUE = { name: name, area: $('mmArea').value.trim(), times: { 'ফজর': $('mmFajr').value, 'যোহর': $('mmDhuhr').value, 'আসর': $('mmAsr').value, 'মাগরিব': $('mmMaghrib').value, 'এশা': $('mmIsha').value, 'জুমা': $('mmJumuah').value } };
  renderMyMosque();
  toast('মসজিদের তথ্য সংরক্ষণ করা হয়েছে');
});

/* ---------- Find mosque ---------- */
var FAMOUS = [
 { n:'বায়তুল মোকাররম জাতীয় মসজিদ', a:'পল্টন, ঢাকা', d:'বাংলাদেশের জাতীয় মসজিদ — কাবা শরিফের আকৃতির অনুকরণে নির্মিত বিশাল মসজিদ কমপ্লেক্স।' },
 { n:'তারা মসজিদ', a:'আরমানিটোলা, ঢাকা', d:'মোগল আমলের মসজিদ; দেয়ালে চিনি-টিকরি ও নীল তারার অলংকরণের জন্য বিখ্যাত।' },
 { n:'ষাট গম্বুজ মসজিদ', a:'বাগেরহাট', d:'খান জাহান আলী (রহ.) নির্মিত পঞ্চদশ শতকের মসজিদ; ইউনেস্কো বিশ্ব ঐতিহ্যের অংশ।' },
 { n:'ছোট সোনা মসজিদ', a:'শিবগঞ্জ, চাঁপাইনবাবগঞ্জ', d:'সুলতানি আমলের (আনুমানিক ১৪৯৩–১৫১৯ খ্রি.) মসজিদ; গম্বুজে একসময় সোনালি গিল্টি ছিল।' },
 { n:'কুসুম্বা মসজিদ', a:'মান্দা, নওগাঁ', d:'১৫৫৮–৫৯ খ্রিস্টাব্দে নির্মিত কালো পাথরের প্রাচীন মসজিদ, মান্দা দিঘির পাড়ে অবস্থিত।' },
 { n:'আতিয়া জামে মসজিদ', a:'দেলদুয়ার, টাঙ্গাইল', d:'১৬০৯ খ্রিস্টাব্দে নির্মিত মোগল স্থাপত্যের সুন্দর নিদর্শন।' }
];
$('famousMosques').innerHTML = FAMOUS.map(function(f){
  var link = 'https://www.google.com/maps/search/?api=1&query=' + encodeURIComponent(f.n + ' ' + f.a);
  return '<article class="hcard"><h3>' + f.n + '</h3><p style="margin:0 0 4px; color:var(--gold); font-weight:600">' + f.a + '</p><p style="margin:0 0 10px">' + f.d + '</p><a class="btn" target="_blank" rel="noopener" href="' + link + '" style="text-decoration:none">মানচিত্রে দেখুন</a></article>';
}).join('');
function openMosqueMap(lat, lng){ window.open('https://www.google.com/maps/search/?api=1&query=mosque+near+' + lat + ',' + lng, '_blank', 'noopener'); }
$('fmCityBtn').addEventListener('click', function(){ var c = curLoc(); openMosqueMap(c.lat, c.lng); });
$('fmGpsBtn').addEventListener('click', function(){
  if (!navigator.geolocation){ toast('এই ডিভাইসে GPS সুবিধা নেই — জেলাভিত্তিক খোঁজ ব্যবহার করুন'); return; }
  toast('লোকেশন নেওয়া হচ্ছে…');
  navigator.geolocation.getCurrentPosition(function(pos){ openMosqueMap(pos.coords.latitude.toFixed(5), pos.coords.longitude.toFixed(5)); }, function(){ toast('লোকেশন পাওয়া যায়নি — জেলাভিত্তিক খোঁজ ব্যবহার করুন'); }, { timeout: 10000 });
});

/* ---------- Bayan (verified YouTube links) ---------- */
var BAYAN = [
 { t:'মৃত্যুর পরের ভয়াবহ দৃশ্য — জান্নাত ও জাহান্নাম', sp:'ড. মিজানুর রহমান আজহারী', topic:'আখিরাত', url:'https://www.youtube.com/watch?v=C-2Pk4B2OCQ' },
 { t:'তওবা ও ক্ষমা — নবীজি ﷺ-এর শেষ উপদেশ', sp:'ড. মিজানুর রহমান আজহারী', topic:'তওবা', url:'https://www.youtube.com/watch?v=0olVRge0Cpk' },
 { t:'মা-বাবার মর্যাদা ও জুরাইজের ঘটনা', sp:'ড. মিজানুর রহমান আজহারী', topic:'পিতামাতা', url:'https://www.youtube.com/watch?v=T2Y2aK2bPrA' },
 { t:'যে মাহফিলে হুজুর নিজেই কান্নায় ভেঙে পড়লেন', sp:'মাওলানা মিজানুর রহমান আজহারী', topic:'আখিরাত', url:'https://www.youtube.com/watch?v=Vrv9rYS9LFQ' },
 { t:'যশোরের মাটিতে হৃদয়ছোঁয়া বয়ান', sp:'শায়খ আহমাদুল্লাহ', topic:'সাধারণ বয়ান', url:'https://www.youtube.com/watch?v=DmfRpzXWaa4' },
 { t:'দৈনন্দিন জীবনের দুটি বড় ভুল', sp:'শায়খ আহমাদুল্লাহ', topic:'দৈনন্দিন সুন্নাহ', url:'https://www.youtube.com/watch?v=fQ3iUhByQLM' },
 { t:'মহিলাদের মেহেদী দেওয়া প্রসঙ্গে প্রশ্নোত্তর', sp:'শায়খ আহমাদুল্লাহ', topic:'প্রশ্নোত্তর', url:'https://www.youtube.com/watch?v=IDNLo_jhzEw' },
 { t:'নবীজি ﷺ-এর জীবনী', sp:'ড. মিজানুর রহমান আজহারী', topic:'সীরাত', audio:'https://archive.org/download/mizanurrahmanazharimahfilaudiocollection1/Biography_of_Prophet_Muhammad_By_Mizanur_Rahman_Azhari.mp3' },
 { t:'কিয়ামতের ময়দান', sp:'ড. মিজানুর রহমান আজহারী', topic:'আখিরাত', audio:'https://archive.org/download/mizanurrahmanazharimahfilaudiocollection1/Kiyamoter_Moydan_By_Mizanur_Rahman_Azhari.mp3' },
 { t:'কুরআনের জন্য মরণ', sp:'ড. মিজানুর রহমান আজহারী', topic:'কুরআন', audio:'https://archive.org/download/mizanurrahmanazharimahfilaudiocollection1/Quraner_Jonno_Moron_By_Mizanur_Rahman_Azhari.mp3' },
 { t:'স্বামী-স্ত্রীর সম্পর্ক', sp:'ড. মিজানুর রহমান আজহারী', topic:'পরিবার', audio:'https://archive.org/download/mizanurrahmanazharimahfilaudiocollection1/Shami_Strir_Shomporke_By_Mizanur_Rahman_Azhari.mp3' },
 { t:'সূরা যিলযালের তাফসির', sp:'ড. মিজানুর রহমান আজহারী', topic:'তাফসির', audio:'https://archive.org/download/mizanurrahmanazharimahfilaudiocollection1/Tafsir_of_Surah_Zilzal_By_Mizanur_Rahman_Azhari.mp3' },
 { t:'আপনার রোজা হচ্ছে না — শুনুন কেন', sp:'শায়খ আহমাদুল্লাহ', topic:'রোজা', audio:'https://archive.org/download/BYSheikAhmadullah/%E0%A6%86%E0%A6%AA%E0%A6%A8%E0%A6%BE%E0%A6%B0%20%E0%A6%B0%E0%A7%8B%E0%A6%9C%E0%A6%BE%20%E0%A6%B9%E0%A6%9A%E0%A7%8D%E0%A6%9B%E0%A7%87%E0%A6%A8%E0%A6%BE%20%21%20%E0%A6%B6%E0%A7%81%E0%A6%A8%E0%A7%81%E0%A6%A8%20%E0%A6%95%E0%A7%87%E0%A6%A8%20...%20BY%20Sheik%20Ahmadullah.mp3' },
 { t:'মেঘদূত যুব সংঘ ওয়াজ মাহফিল ২০১৭', sp:'মুফতি কাজী মুহাম্মদ ইব্রাহিম', topic:'সাধারণ বয়ান', audio:'https://archive.org/download/429BanglaWazMeghdutJuboSonghoWajMahfil2017ByMuftiKaziMuhammadIbrahimwww.tawhidmedia.com/429%20Bangla%20Waz%20Meghdut%20Jubo%20Songho%20Waj%20Mahfil%202017%20by%20Mufti%20Kazi%20Muhammad%20Ibrahim%5Bwww.tawhidmedia.com%5D.mp3' },
 { t:'নেশাদার দ্রব্য (পর্ব ১)', sp:'আব্দুর রাজ্জাক বিন ইউসুফ', topic:'সমাজ', audio:'https://archive.org/download/BanglaWazNeshadarDrobboPart1ByAbdurRazzaqueBinYousufwww.tawhidmedia.com/Bangla%20Waz%20Neshadar%20Drobbo%20Part%201%20by%20Abdur%20Razzaque%20bin%20Yousuf%5Bwww.tawhidmedia.com%5D.mp3' },
 { t:'রমজানের গুরুত্ব ও তাৎপর্য', sp:'আব্দুর রাজ্জাক বিন ইউসুফ', topic:'রমজান', audio:'https://archive.org/download/464BanglaWazRamazanerGuruttoOTatporzowww.tawhidmedia.com/464%20Bangla%20Waz%20Ramazaner%20Gurutto%20O%20Tatporzo%5Bwww.tawhidmedia.com%5D.mp3' }
];
var boyanIdx = -1;
function renderBayan(){
  $('bayanList').innerHTML = BAYAN.map(function(b, i){
    var playing = boyanIdx === i && !player.paused;
    var audioBtn = b.audio ? '<button class="btn" data-bayan-play="' + i + '">' + (playing ? '⏸ চলছে…' : '▶ অডিও শুনুন') + '</button>' : '';
    var ytBtn = b.url ? '<a class="btn gold" target="_blank" rel="noopener" href="' + b.url + '" style="text-decoration:none">▶ YouTube-এ শুনুন</a>' : '';
    var btns = (audioBtn || ytBtn) ? '<p style="margin:0; display:flex; gap:8px; flex-wrap:wrap">' + audioBtn + ytBtn + '</p>' : '';
    return '<article class="hcard"><span class="cat">' + b.topic + '</span><h3>' + b.t + '</h3><p style="margin:0 0 10px; color:var(--ink-2)">বক্তা: ' + b.sp + '</p>' + btns + '</article>';
  }).join('');
}
renderBayan();
$('bayanList').addEventListener('click', function(e){
  var btn = e.target.closest('[data-bayan-play]'); if (!btn) return;
  var i = +btn.getAttribute('data-bayan-play');
  if (boyanIdx === i && !player.paused){ player.pause(); }
  else {
    stopAudio();
    if (tilSurah){ tilSurah = null; buildTilawat(); }
    boyanIdx = i;
    playAudioSmart(BAYAN[i].audio);
  }
  setTimeout(renderBayan, 80);
});
player.addEventListener('ended', function(){ if (boyanIdx >= 0){ boyanIdx = -1; renderBayan(); } });
player.addEventListener('pause', function(){ if (boyanIdx >= 0 && currentView === 'bayan') setTimeout(renderBayan, 80); });
</script>
<script>
/* ================= Prayer alarms & reminders ================= */
var ALARMS = { fajr:{on:false,before:0}, dhuhr:{on:false,before:0}, asr:{on:false,before:0}, maghrib:{on:false,before:0}, isha:{on:false,before:0}, sehri:{on:false,before:0}, iftar:{on:false,before:0} };
var ALARM_NAMES = { fajr:'ফজর', dhuhr:'যোহর', asr:'আসর', maghrib:'মাগরিব', isha:'এশা', sehri:'সেহরি', iftar:'ইফতার' };
function alarmName(k){ return (k === 'dhuhr' && nowFrame().getDay() === 5) ? 'জুমা' : ALARM_NAMES[k]; }
var alarmFired = {};
var actx = null, masterGain = null;
function ensureAudio(){
  if (!actx){
    try { actx = new (window.AudioContext || window.webkitAudioContext)(); masterGain = actx.createGain(); masterGain.connect(actx.destination); } catch(e){ actx = null; }
  }
  if (actx && actx.state === 'suspended') actx.resume();
  if (masterGain) masterGain.gain.value = ((+$('alarmVol').value) || 80) / 100;
}
function toneAt(freq, start, dur, peak){
  var o = actx.createOscillator(), g = actx.createGain();
  o.type = 'sine'; o.frequency.value = freq;
  g.gain.setValueAtTime(0.0001, start);
  g.gain.exponentialRampToValueAtTime(peak, start + 0.03);
  g.gain.exponentialRampToValueAtTime(0.0001, start + dur);
  o.connect(g); g.connect(masterGain);
  o.start(start); o.stop(start + dur + 0.05);
}
/* ---- Azan recordings (verified direct mp3 streams; cached after first play) ---- */
var AZAN_URLS = {
  'azan:makkah': 'https://archive.org/download/full-madinah.mp3/full-makkah.mp3.mp3',
  'azan:madinah': 'https://archive.org/download/full-madinah.mp3/full-madinah.mp3.mp3',
  'azan:alafasy': 'https://archive.org/download/Athan-AlafasyByDarifton/Athan-Alafasy1431.mp3',
  'azan:alafasyfajr': 'https://archive.org/download/adhan-call-to-prayer-mishary-rashid-alafasy-fajr-maqam-hijaz-hd-320-kbps-1/Adhan%20%28Call%20to%20prayer%29%20_%20Mishary%20Rashid%20Alafasy%20_%20Fajr%20_%20Maqam%20Hijaz%20%E1%B4%B4%E1%B4%B0%20%28320%20kbps%29%20%281%29.mp3',
  'azan:fakhry': 'https://upload.wikimedia.org/wikipedia/commons/2/27/Call_to_prayer_by_Sabah_Fakhry.mp3',
  'azan:aaqib': 'https://upload.wikimedia.org/wikipedia/commons/7/7d/The_Adhan_-_Muslim_Call_to_Prayer_-_Aaqib_Azeez.mp3'
};
var azanEl = null;
function stopAzan(){ if (azanEl){ try { azanEl.pause(); } catch(e){} } }
function playAzan(url){
  if (!url){ toast('আজানের অডিও পাওয়া যায়নি'); return; }
  stopAzan();
  if (!azanEl) azanEl = new Audio();
  azanEl.volume = ((+$('alarmVol').value) || 80) / 100;
  var go = function(){ var p = azanEl.play(); if (p && p.catch) p.catch(function(){ toast('আজান চালানো যায়নি — ইন্টারনেট সংযোগ দেখুন'); }); };
  if (!('caches' in window)){ azanEl.src = url; go(); return; }
  caches.open(AUDIO_CACHE).then(function(c){ return c.match(url); }).then(function(res){
    if (res){ res.blob().then(function(b){ azanEl.src = URL.createObjectURL(b); go(); }); }
    else { azanEl.src = url; go(); cacheAudio(url); }
  }).catch(function(){ azanEl.src = url; go(); });
}
function playAlarmSound(){
  var kind = $('alarmSound').value;
  if (kind.indexOf('azan:') === 0){ playAzan(AZAN_URLS[kind]); return; }
  stopAzan();
  ensureAudio();
  if (!actx){ toast('এই ব্রাউজারে শব্দ চালানো যাচ্ছে না'); return; }
  [0, 4.2].forEach(function(round){
    var t0 = actx.currentTime + 0.06 + round;
    if (kind === 'bell'){
      [0, 1.15].forEach(function(off){ toneAt(1318, t0 + off, 1.5, 0.5); toneAt(1975, t0 + off, 0.9, 0.16); toneAt(2637, t0 + off, 0.5, 0.07); });
    } else if (kind === 'melody'){
      [659, 784, 880, 988, 880, 784].forEach(function(f, i){ toneAt(f, t0 + i * 0.42, 0.55, 0.38); });
    } else {
      [0, 0.35, 0.7].forEach(function(off){ toneAt(880, t0 + off, 0.22, 0.42); });
    }
  });
}
function renderAlarmRows(){
  var order = ['fajr','dhuhr','asr','maghrib','isha','sehri','iftar'];
  $('alarmRows').innerHTML = order.map(function(k){
    var a = ALARMS[k];
    var opts = [0, 5, 10, 15].map(function(m){
      return '<option value="' + m + '"' + (a.before === m ? ' selected' : '') + '>' + (m === 0 ? 'ঠিক সময়ে' : bn(m) + ' মিনিট আগে') + '</option>';
    }).join('');
    return '<div class="tk-row"><span class="nm">' + alarmName(k) + '</span><span style="display:flex; gap:8px; align-items:center; flex-wrap:wrap"><select data-alarm-before="' + k + '" aria-label="' + alarmName(k) + ' অ্যালার্ম কখন বাজবে">' + opts + '</select><button class="tk' + (a.on ? ' done' : '') + '" data-alarm="' + k + '">' + (a.on ? '✓ অ্যালার্ম অন' : 'অ্যালার্ম অফ') + '</button></span></div>';
  }).join('');
}
/* v2.16: restore saved alarm settings so they survive restarts. */
try {
  var _sa = JSON.parse(localStorage.getItem('di_alarms') || 'null');
  if (_sa){
    if (_sa.alarms) Object.keys(ALARMS).forEach(function(k){ if (_sa.alarms[k]){ ALARMS[k].on = !!_sa.alarms[k].on; ALARMS[k].before = +_sa.alarms[k].before || 0; } });
    if (_sa.sound && $('alarmSound')) $('alarmSound').value = _sa.sound;
    if (_sa.vol != null && $('alarmVol')) $('alarmVol').value = _sa.vol;
  }
} catch (e) {}
function saveAlarms(){
  try {
    var o = { alarms: {}, sound: $('alarmSound') ? $('alarmSound').value : 'bell', vol: $('alarmVol') ? $('alarmVol').value : 80 };
    Object.keys(ALARMS).forEach(function(k){ o.alarms[k] = { on: ALARMS[k].on, before: ALARMS[k].before }; });
    localStorage.setItem('di_alarms', JSON.stringify(o));
  } catch (e) {}
}
var _asl = $('alarmSound'); if (_asl) _asl.addEventListener('change', saveAlarms);
renderAlarmRows();
document.addEventListener('click', function(e){
  var b = e.target.closest('[data-alarm]');
  if (!b) return;
  var k = b.getAttribute('data-alarm');
  ALARMS[k].on = !ALARMS[k].on;
  if (ALARMS[k].on) ensureAudio();
  renderAlarmRows(); renderPrayer(); saveAlarms();
  toast(alarmName(k) + 'র অ্যালার্ম ' + (ALARMS[k].on ? 'চালু' : 'বন্ধ') + ' করা হয়েছে');
});
document.addEventListener('change', function(e){
  var s = e.target.closest('[data-alarm-before]');
  if (s){ ALARMS[s.getAttribute('data-alarm-before')].before = +s.value; saveAlarms(); }
});
$('alarmVol').addEventListener('input', function(){ if (masterGain) masterGain.gain.value = ((+this.value) || 0) / 100; if (azanEl) azanEl.volume = ((+this.value) || 0) / 100; saveAlarms(); });
$('alarmTest').addEventListener('click', function(){ playAlarmSound(); $('alarmStop').disabled = false; toast('টেস্ট শব্দ বাজছে'); });
function hideAlarmBanner(){ stopAzan(); $('alarmBanner').classList.add('hidden'); $('alarmStop').disabled = true; }
$('alarmStop').addEventListener('click', hideAlarmBanner);
$('alarmBannerStop').addEventListener('click', hideAlarmBanner);
function fireAlarm(key, before){
  var msg;
  if (before > 0) msg = bn(before) + ' মিনিট পর ' + alarmName(key) + (key === 'sehri' ? 'র সময় শেষ হবে' : (key === 'iftar' ? 'র সময় হবে' : 'র ওয়াক্ত শুরু হবে'));
  else msg = key === 'sehri' ? 'সেহরির সময় শেষ হয়েছে' : (key === 'iftar' ? 'ইফতারের সময় হয়েছে' : alarmName(key) + 'র ওয়াক্ত শুরু হয়েছে');
  $('alarmBannerTxt').textContent = 'রিমাইন্ডার: ' + msg;
  $('alarmBanner').classList.remove('hidden');
  $('alarmStop').disabled = false;
  playAlarmSound();
  if (navigator.vibrate) navigator.vibrate([220, 110, 220]);
}
setInterval(function(){
  var now = nowFrame();
  var c = curLoc();
  var t = prayerTimes(now, c.lat, c.lng, c.tz);
  var targets = { fajr: t.fajr, dhuhr: t.dhuhr, asr: t.asr, maghrib: t.maghrib, isha: t.isha, sehri: t.fajr - 10/60, iftar: t.maghrib };
  for (var k in targets){
    var a = ALARMS[k]; if (!a || !a.on) continue;
    var target = new Date(timeToDate(now, targets[k]).getTime() - (a.before || 0) * 60000);
    var id = target.getFullYear() + '-' + target.getMonth() + '-' + target.getDate() + ':' + k + ':' + (a.before || 0);
    if (alarmFired[id]) continue;
    var diff = target - now;
    if (diff <= 0 && diff > -90000){ alarmFired[id] = true; fireAlarm(k, a.before || 0); }
  }
}, 1000);

/* ================= Global search ================= */
function gsNorm(s){ return String(s).replace(/রাহ/g, 'রহ').replace(/ী/g, 'ি').replace(/ূ/g, 'ু').replace(/[‌‍]/g, ''); }
function gsResults(q){
  q = gsNorm((q || '').trim());
  var box = $('globalResults');
  if (q.length < 2){ box.innerHTML = ''; return; }
  var out = [];
  SURA_BN.forEach(function(n, i){ if (gsNorm(n).indexOf(q) > -1 || String(i + 1) === q || bn(i + 1) === q) out.push({ t:'সূরা', l:'সূরা ' + n + ' (নম্বর ' + bn(i + 1) + ')', a:'surah', i:i }); });
  HADITHS.forEach(function(h, i){ if (gsNorm(h.t + h.bn + h.c).indexOf(q) > -1) out.push({ t:'হাদিস', l:h.t, a:'hadith', i:i }); });
  DUAS.forEach(function(d, i){ if (gsNorm(d.t + d.bn).indexOf(q) > -1) out.push({ t:'দোয়া', l:d.t, a:'dua', i:i }); });
  NAMES99.forEach(function(n, i){ if (gsNorm(n[1] + n[2] + n[0]).indexOf(q) > -1) out.push({ t:'আসমাউল হুসনা', l:n[1] + ' — ' + n[2], a:'names', i:i }); });
  BOY_NAMES.forEach(function(n, i){ if (gsNorm(n[0] + n[1]).indexOf(q) > -1) out.push({ t:'ছেলেদের নাম', l:n[0] + ' — ' + n[1], a:'boy', i:i }); });
  GIRL_NAMES.forEach(function(n, i){ if (gsNorm(n[0] + n[1]).indexOf(q) > -1) out.push({ t:'মেয়েদের নাম', l:n[0] + ' — ' + n[1], a:'girl', i:i }); });
  if (!out.length){ box.innerHTML = '<p class="sub" style="margin:10px 0 0">কিছু পাওয়া যায়নি — অন্য শব্দে খুঁজুন।</p>'; return; }
  box.innerHTML = '<div style="display:flex; flex-direction:column; gap:6px; margin-top:10px">' + out.slice(0, 16).map(function(r){
    return '<button class="bmk" data-gs="' + r.a + ':' + r.i + '"><span class="cat" style="margin:0">' + r.t + '</span><span>' + esc(r.l) + '</span></button>';
  }).join('') + (out.length > 16 ? '<p class="sub" style="margin:2px 0 0">আরও ' + bn(out.length - 16) + 'টি ফলাফল আছে — খোঁজ আরও নির্দিষ্ট করুন।</p>' : '') + '</div>';
}
$('globalSearch').addEventListener('input', function(){ gsResults(this.value); });
document.addEventListener('click', function(e){
  var g = e.target.closest('[data-gs]'); if (!g) return;
  var p = g.getAttribute('data-gs').split(':'); var act = p[0], idx = +p[1];
  if (act === 'surah'){ showView('quran'); openReader('surah', idx); }
  else if (act === 'hadith'){ showView('hadith'); $('hadithSearch').value = HADITHS[idx].t; renderHadiths(HADITHS[idx].t); }
  else if (act === 'dua'){ showView('dua'); $('duaSearch').value = DUAS[idx].t; renderDuas(DUAS[idx].t); }
  else if (act === 'names'){ openSub('names'); }
  else if (act === 'boy' || act === 'girl'){
    openSub('baby');
    babyGender = act;
    $('segBoy').setAttribute('aria-pressed', act === 'boy' ? 'true' : 'false');
    $('segGirl').setAttribute('aria-pressed', act === 'girl' ? 'true' : 'false');
    var nm = act === 'boy' ? BOY_NAMES[idx][0] : GIRL_NAMES[idx][0];
    $('babySearch').value = nm; renderBaby();
  }
});

/* ================= Shareable image cards ================= */
var cardLogoImg = new Image(); cardLogoImg.src = 'data:image/jpeg;base64,';
function wrapLines(ctx, text, maxW){
  var words = String(text).split(/\s+/), lines = [], cur = '';
  words.forEach(function(w){
    var test = cur ? cur + ' ' + w : w;
    if (ctx.measureText(test).width > maxW && cur){ lines.push(cur); cur = w; }
    else cur = test;
  });
  if (cur) lines.push(cur);
  return lines;
}
function makeCard(opts){
  var W = 1080, H = 1080;
  var cv = document.createElement('canvas'); cv.width = W; cv.height = H;
  var ctx = cv.getContext('2d');
  var grad = ctx.createLinearGradient(0, 0, W, H);
  grad.addColorStop(0, '#07301f'); grad.addColorStop(0.55, '#0b4a30'); grad.addColorStop(1, '#06231a');
  ctx.fillStyle = grad; ctx.fillRect(0, 0, W, H);
  ctx.strokeStyle = '#c9a24b'; ctx.lineWidth = 5; ctx.strokeRect(34, 34, W - 68, H - 68);
  ctx.lineWidth = 1.6; ctx.strokeRect(52, 52, W - 104, H - 104);
  ctx.textAlign = 'center';
  if (cardLogoImg.complete && cardLogoImg.naturalWidth){
    ctx.save();
    ctx.beginPath(); ctx.arc(W/2, 148, 62, 0, Math.PI * 2); ctx.clip();
    ctx.drawImage(cardLogoImg, W/2 - 62, 86, 124, 124);
    ctx.restore();
    ctx.strokeStyle = '#c9a24b'; ctx.lineWidth = 3;
    ctx.beginPath(); ctx.arc(W/2, 148, 62, 0, Math.PI * 2); ctx.stroke();
  }
  ctx.fillStyle = '#e3c878'; ctx.font = '700 36px "Hind Siliguri", sans-serif';
  ctx.fillText('Muslim Path', W/2, 268);
  var maxW = 880, arSize = 62, bnSize = 43, arLines = [], bnLines = [], total = 0;
  function measure(){
    ctx.font = arSize + 'px Amiri, serif'; arLines = wrapLines(ctx, opts.ar, maxW);
    ctx.font = bnSize + 'px "Hind Siliguri", sans-serif'; bnLines = wrapLines(ctx, opts.bnText, maxW);
    total = arLines.length * arSize * 1.95 + 34 + bnLines.length * bnSize * 1.62 + 30 + 40;
    return total;
  }
  measure();
  while (total > 560 && arSize > 28){ arSize -= 4; bnSize = Math.max(25, bnSize - 2); measure(); }
  var y = 330 + Math.max(0, (580 - total) / 2) + arSize;
  ctx.fillStyle = '#f7ead0'; ctx.font = arSize + 'px Amiri, serif';
  arLines.forEach(function(ln){ ctx.fillText(ln, W/2, y); y += arSize * 1.95; });
  y += 34 - arSize * 0.4;
  ctx.fillStyle = '#ffffff'; ctx.font = bnSize + 'px "Hind Siliguri", sans-serif';
  bnLines.forEach(function(ln){ ctx.fillText(ln, W/2, y); y += bnSize * 1.62; });
  y += 30;
  ctx.fillStyle = '#e3c878'; ctx.font = '600 33px "Hind Siliguri", sans-serif';
  ctx.fillText(opts.src, W/2, y);
  ctx.fillStyle = '#c9a24b'; ctx.font = '28px "Hind Siliguri", sans-serif';
  ctx.fillText('কুরআন ও সুন্নাহর আলোকে জীবন গড়ুন', W/2, 992);
  var url = cv.toDataURL('image/png');
  $('cardImg').src = url;
  $('cardDownload').href = url;
  $('cardModal').style.display = 'flex';
}
function openCard(opts){
  if (document.fonts && document.fonts.ready) document.fonts.ready.then(function(){ makeCard(opts); });
  else makeCard(opts);
}
$('cardClose').addEventListener('click', function(){ $('cardModal').style.display = 'none'; });
$('cardModal').addEventListener('click', function(e){ if (e.target === this) this.style.display = 'none'; });
document.addEventListener('click', function(e){
  var ca = e.target.closest('[data-card-ayah]');
  if (ca){
    var p = ca.getAttribute('data-card-ayah').split(':'); var si = +p[0], ai = +p[1];
    if (typeof QURAN === 'undefined' || !QURAN){ toast('কুরআন লোড হয়নি — আবার চেষ্টা করুন'); return; }
    var a = QURAN.surahs[si].a[ai];
    openCard({ ar: a[0], bnText: a[1], src: 'সূরা ' + SURA_BN[si] + ' — আয়াত ' + bn(ai + 1) });
    return;
  }
  var ch = e.target.closest('[data-card-hadith]');
  if (ch){
    var title = ch.getAttribute('data-card-hadith'), h = null;
    HADITHS.forEach(function(x){ if (x.t === title) h = x; });
    if (h) openCard({ ar: h.ar, bnText: h.bn, src: 'সূত্র: ' + h.s });
  }
});
</script>
<script>
/* ================= Widget refresh button ================= */
$('refreshBtn').addEventListener('click', function(){
  var btn = this;
  btn.classList.remove('spin'); void btn.offsetWidth; btn.classList.add('spin');
  updateClock();
  renderPrayer();
  if (typeof tickRoza === 'function') tickRoza();
  if (typeof tickRamadan === 'function') tickRamadan();
  toast('ঘড