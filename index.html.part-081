 { t:'শরহে বেকায়া', a:'ওবায়দুল্লাহ ইবনে মাসউদ (রহ.)', d:'হানাফি ফিকহের বিকায়া মতনের ব্যাখ্যাগ্রন্থ।' },
 { t:'ফিকহুল আকবার', a:'ইমাম আবু হানিফা (রহ.)', d:'ইমাম আবু হানিফা (রহ.)-এর প্রতি আরোপিত আকিদার মৌলিক রচনা।' },
 { t:'রওজাতুল আদব', a:'আরবি সাহিত্যের কিতাব', d:'আরবি সাহিত্য (আদব) শেখার প্রসিদ্ধ কিতাব — ব্যাখ্যাসহ।', pdf:'https://archive.org/download/Misbahilibrary_gmail_20180902/%D8%B1%D9%88%D8%B6%DB%83%20%D8%A7%D9%84%D8%A7%D8%AF%D8%A8%20%D8%A7%D9%88%D9%84%20%D8%B4%D8%B1%D8%AD%20%D9%81%DB%8C%D8%B6%20%D8%A7%D9%84%D8%A7%D8%AF%D8%A8%20%D8%A7%D9%88%D9%84.pdf' },
 { t:'সীরাতে খাতামুল আম্বিয়া', a:'মুফতি মুহাম্মদ শাফি (রহ.)', d:'মুফতি মুহাম্মদ শাফি (রহ.)-এর রচিত সংক্ষিপ্ত ও নির্ভরযোগ্য সীরাতগ্রন্থ।' },
 { t:'মাবাদিউল আরাবিয়া', a:'রশিদ আশ-শারতুনি', d:'আরবি ভাষা ও ব্যাকরণ শেখার ধারাবাহিক পাঠ্যবই।' },
 { t:'ইলমুস সরফ', a:'সরফের কিতাব', d:'সরফের বিস্তারিত কিতাব — শব্দরূপ ও ধাতু বিশ্লেষণ।', pdf:'https://archive.org/download/ilm_us_sarf_aakherain_al_bushra/ILM_US_SARF_AAKHERAIN_AL_BUSHRA.pdf' },
