 { t:'হায়াতুস সাহাবা', a:'মাওলানা মুহাম্মদ ইউসুফ কান্ধলভি (রহ.)', d:'সাহাবায়ে কেরামের জীবন ও ত্যাগের বিশাল সংকলন — ঈমানি জীবন গড়ার অনন্য উপকরণ।', pdfs:['https://archive.org/download/HaytusSahaba0305part/1.HayatusSahabah1stPartWithInteractiveLinkWww.eelm.weebly.com.pdf', 'https://archive.org/download/HaytusSahaba0305part/HayatusSahabah02.pdf', 'https://archive.org/download/HaytusSahaba0305part/Hayatus%20Sahabah%2003.pdf', 'https://archive.org/download/HaytusSahaba0305part/HayatusSahabah04.pdf', 'https://archive.org/download/HaytusSahaba0305part/Hayatus%20Sahabah%2005.pdf'] },
 { t:'মুনতাখাব হাদিস', a:'মাওলানা মুহাম্মদ ইউসুফ কান্ধলভি (রহ.)', d:'ঈমান, নামাজ, ইলম, যিকির, ইকরাম ও দাওয়াত — ছয় গুণের ওপর বাছাইকৃত হাদিসের সংকলন।', pdf:'https://archive.org/download/azharmea-www.eelm.weebly.com-skype-id-azharmea/Muntakhab%20Hadith.pdf' },
 { t:'কাসাসুন নাবিয়্যিন', a:'সাইয়েদ আবুল হাসান আলী নদভি (রহ.)', d:'নবীদের কাহিনি দিয়ে আরবি শেখার বিশ্ববিখ্যাত বই — শিশু ও শিক্ষার্থীদের জন্য।' },
 { t:'উসুলুশ শাশি', a:'নিযামুদ্দিন আশ-শাশি (রহ.)', d:'উসুলে ফিকহের প্রাথমিক ও প্রসিদ্ধ কিতাব।' },
