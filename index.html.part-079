var KITAB_ALL = KITAB.concat(KITAB_EXTRA);
function kitabLinks(k){
  var src = k.pdfs ? { pdfs: k.pdfs } : (k.pdf ? { pdf: k.pdf } : (KITAB_PDF[k.t] || null));
  if (!src) return '';
  var h = '<p style="margin:10px 0 0; display:flex; flex-wrap:wrap; gap:8px">';
  if (src.pdfs) src.pdfs.forEach(function(u, i){ h += '<a class="btn" href="' + u + '" target="_blank" rel="noopener">📖 পিডিএফ — খণ্ড ' + bn(i + 1) + '</a>'; });
  else h += '<a class="btn" href="' + src.pdf + '" target="_blank" rel="noopener">📖 পিডিএফ পড়ুন / ডাউনলোড</a>';
  return h + '</p>';
}
function renderKitab(){
  var q = (($('kitabSearch') || {}).value || '').trim();
  var list = KITAB_ALL.filter(function(k){ return !q || (k.t + ' ' + k.a).indexOf(q) > -1; });
  $('kitabList').innerHTML = list.length ? list.map(function(k){
    return '<article class="hcard"><span class="cat">ইসলামিক বই</span><h3>' + k.t + '</h3><p style="color:var(--gold); font-weight:600; margin:0 0 6px">' + k.a + '</p><p style="margin:0">' + k.d + '</p>' + kitabLinks(k) + '</article>';
  }).join('') : '<p class="loadmsg">কিছু পাওয়া যায়নি।</p>';
}
$('kitabSearch').addEventListener('input', renderKitab);
renderKitab();

/* ---------- Articles ---------- */
var ARTICLES = [
 { t:'তাওহিদ: ঈমানের ভিত্তি', b:'তাওহিদ অর্থ আল্লাহকে তাঁর সত্তা, গুণাবলি, কাজ ও ইবাদতে এক ও অদ্বিতীয় মানা। সব নবী-রাসূলের দাওয়াতের মূল কথাই ছিল এটি: "তোমরা আল্লাহর ইবাদত করো, তিনি ছাড়া তোমাদের কোনো ইলাহ নেই।" (সূরা আল-আরাফ: ৫৯)\nতাওহিদ শুধু মুখের স্বীকৃতি নয় — ইবাদতের প্রতিটি কাজ (নামাজ, রোজা, দোয়া, কুরবানি, মানত) শুধু আল্লাহর জন্য নির্দিষ্ট করা এবং সাহায্য ও ভরসা একমাত্র তাঁর ওপর রাখাই এর প্রাণ। যে অন্তরে তাওহিদ প্রতিষ্ঠিত, সে অন্তরে সৃষ্টির ভয় ও লোভ জায়গা পায় না।' },
 { t:'নামাজ: মুমিনের মিরাজ', b:'পাঁচ ওয়াক্ত নামাজ ইসলামের দ্বিতীয় স্তম্ভ এবং মিরাজের রাতে উম্মতকে দেওয়া আল্লাহর বিশেষ উপহার। আল্লাহ বলেন, "নিশ্চয় নামাজ অশ্লীল ও মন্দ কাজ থেকে বিরত রাখে।" (সূরা আল-আনকাবুত: ৪৫)\nনামাজ শুধু একটি আচার নয় — এটি দিনে পাঁচবার আল্লাহর সামনে দাঁড়িয়ে নিজের হিসাব নেওয়ার সুযোগ। যে নামাজ খুশু-খুযুসহ আদায় করা হয়, তা মানুষের চরিত্র বদলে দেয়: সময়নিষ্ঠা, পবিত্রতা, ধৈর্য ও বিনয় — সব গুণই নামাজ থেকে জন্ম নেয়। তাই হাদিসে এসেছে, কিয়ামতের দিন সর্বপ্রথম নামাজের হিসাব নেওয়া হবে। (সুনানে তিরমিযি: ৪১৩)' },
 { t:'পিতামাতার হক ও খেদমত', b:'আল্লাহ তাঁর নিজের ইবাদতের নির্দেশের ঠিক পরেই পিতামাতার প্রতি সদ্ব্যবহারের নির্দেশ দিয়েছেন (সূরা আল-ইসরা: ২৩) — এ থেকেই বোঝা যায় এই হকের মর্যাদা কত উচ্চ। এমনকি তাঁদের কোনো কথায় "উফ" শব্দটুকুও বলতে নিষেধ করা হয়েছে।\nরাসূলুল্লাহ ﷺ বলেছেন, "পিতা-মাতার সন্তুষ্টিতেই আল্লাহর সন্তুষ্টি, আর তাঁদের অসন্তুষ্টিতে আল্লাহর অসন্তুষ্টি।" (সুনানে তিরমিযি: ১৮৯৯) বৃদ্ধ বয়সে তাঁদের খেদমত জান্নাত লাভের সবচেয়ে সহজ পথগুলোর একটি — যে পিতামাতা উভয়কে বা একজনকে বৃদ্ধ অবস্থায় পেয়েও জান্নাত অর্জন করতে পারল না, তার জন্য হাদিসে দুঃখ প্রকাশ করা হয়েছে। (সহিহ মুসলিম: ২৫৫১)' },
 { t:'সদকা: যে দানে সম্পদ বাড়ে', b:'সদকা শুধু টাকা দেওয়া নয় — প্রতিটি ভালো কাজই সদকা: মুখের হাসি, পথ থেকে কষ্টদায়ক জিনিস সরানো, ভালো কথা বলা — সবই সদকার অন্তর্ভুক্ত। (সহিহ মুসলিম: ১০০৯) আল্লাহ প্রতিশ্রুতি দিয়েছেন, সদকার বিনিময়ে তিনি বহুগুণ বাড়িয়ে দেবেন (সূরা আল-বাকারা: ২৬১)।\nরাসূলুল্লাহ ﷺ বলেছেন, "সদকা করলে সম্পদ কমে না।" (সহিহ মুসলিম: ২৫৮৮) গোপনে দান করা সর্বোত্তম, কারণ তা রিয়া থেকে মুক্ত; আর নিয়মিত ছোট দান আল্লাহর কাছে প্রিয় — "আল্লাহর কাছে সবচেয়ে প্রিয় আমল হলো যা নিয়মিত করা হয়, যদিও তা কম হয়।" (সহিহ বুখারি: ৬৪৬৪)' },
 { t:'রমজান: আত্মশুদ্ধির প্রশিক্ষণের মাস', b:'রমজান কেবল না-খেয়ে থাকার মাস নয় — এটি তাকওয়া অর্জনের প্রশিক্ষণকাল। আল্লাহ বলেন, "তোমাদের ওপর রোজা ফরজ করা হয়েছে, যেমন ফরজ করা হয়েছিল তোমাদের পূর্ববর্তীদের ওপর — যাতে তোমরা তাকওয়া অর্জন করতে পারো।" (সূরা আল-বাকারা: ১৮৩)\nএই মাসে কুরআন নাজিল হয়েছে, এই মাসেই লাইলাতুল কদর — হাজার মাসের চেয়ে উত্তম এক রাত। রোজাদারের জন্য জান্নাতে রয়েছে বিশেষ দরজা "রাইয়ান" (সহিহ বুখারি: ১৮৯৬)। রমজানকে কাজে লাগানোর উপায়: পাঁচ ওয়াক্ত নামাজ জামাতে, প্রতিদিন কুরআন তিলাওয়াত, তারাবি, শেষ দশকে ইতিকাফ ও কদর অন্বেষণ, বেশি বেশি দোয়া ও সদকা।' }
];
$('articleList').innerHTML = ARTICLES.map(function(a){
  var paras = a.b.split('\n').map(function(p){ return '<p>' + p + '</p>'; }).join('');
  return '<details class="acc"><summary>' + a.t + '</summary><div class="body">' + paras + '</div></details>';
}).join('');

/* ---------- Quran shikkha: letters ---------- */
var LETTERS = [['ا','আলিফ'],['ب','বা'],['ت','তা'],['ث','সা'],['ج','জিম'],['ح','হা'],['خ','খা'],['د','দাল'],['ذ','যাল'],['ر','রা'],['ز','যা'],['س','সিন'],['ش','শিন'],['ص','সাদ'],['ض','দাদ'],['ط','ত্বা'],['ظ','যোয়া'],['ع','আইন'],['غ','গাইন'],['ف','ফা'],['ق','ক্বাফ'],['ك','কাফ'],['ل','লাম'],['م','মিম'],['ن','নুন'],['ه','হা'],['و','ওয়াও'],['ي','ইয়া'],['ء','হামজা']];
$('letterGrid').innerHTML = LETTERS.map(function(L){
  return '<div style="border:1px solid var(--line); border-radius:12px; padding:10px 4px; text-align:center; background:var(--card)"><div style="font-family:Amiri,serif; font-size:32px; line-height:1.3; color:var(--green-800)">' + L[0] + '</div><div style="font-size:14px; font-weight:600">' + L[1] + '</div></div>';
}).join('');

/* ---------- Taleem ---------- */
var TALEEM = [
 { t:'আজকের তালিম: নিয়তের গুরুত্ব', b:'সব আমলের ভিত্তি হলো নিয়ত। কোনো কাজ বাইরে থেকে যত বড়ই হোক, নিয়ত বিশুদ্ধ না হলে আল্লাহর কাছে তার মূল্য নেই। আবার ছোট্ট একটি কাজও খাঁটি নিয়তের কারণে পাহাড়সম সওয়াবের হয়। তাই প্রতিটি কাজের আগে নিজেকে প্রশ্ন করুন: আমি এটি কার জন্য করছি?', s:'সহিহ বুখারি: ১; সহিহ মুসলিম: ১৯০৭' },
 { t:'আজকের তালিম: সত্যবাদিতা', b:'সত্য মানুষকে পুণ্যের দিকে নিয়ে যায়, আর পুণ্য জান্নাতের দিকে। যে ব্যক্তি সত্য বলতে থাকে, আল্লাহর কাছে সে "সিদ্দিক" (পরম সত্যবাদী) হিসেবে লিখিত হয়। আর মিথ্যা পাপের দিকে নিয়ে যায়, পাপ জাহান্নামের দিকে।', s:'সহিহ বুখারি: ৬০৯৪; সহিহ মুসলিম: ২৬০৭' },
 { t:'আজকের তালিম: রাগ নিয়ন্ত্রণ', b:'প্রকৃত শক্তিশালী সে নয় যে কুস্তিতে হারাতে পারে; প্রকৃত শক্তিশালী সে, যে রাগের সময় নিজেকে নিয়ন্ত্রণ করতে পারে। রাগ এলে ওযু করুন, দাঁড়িয়ে থাকলে বসুন, বসে থাকলে শুয়ে পড়ুন — শয়তান আগুন থেকে সৃষ্টি, আর আগুন পানিতে নেভে।', s:'সহিহ বুখারি: ৬১১৪; সুনানে আবু দাউদ: ৪৭৮২' },
 { t:'আজকের তালিম: প্রতিবেশীর হক', b:'জিবরাইল (আ.) রাসূলুল্লাহ ﷺ-কে প্রতিবেশী সম্পর্কে এত বেশি উপদেশ দিতেন যে তিনি ভেবেছিলেন প্রতিবেশীকে উত্তরাধিকারী বানানো হবে। প্রতিবেশী ক্ষুধার্ত থাকতে নিজে পেট ভরে খাওয়া পূর্ণ ঈমানের পরিচয় নয়।', s:'সহিহ বুখারি: ৬০১৪; সহিহ মুসলিম: ৪৭' },
 { t:'আজকের তালিম: সময়ের মূল্য', b:'দুটি নেয়ামতের ব্যাপারে অধিকাংশ মানুষ প্রতারিত: সুস্থতা ও অবসর সময়। সময় একবার গেলে আর ফিরে আসে না। প্রতিদিন অন্তত কিছু সময় কুরআন, যিকির ও দ্বীন শেখার জন্য নির্দিষ্ট করুন — ছোট কিন্তু নিয়মিত আমলই আল্লাহর প্রিয়।', s:'সহিহ বুখারি: ৬৪১২, ৬৪৬৪' },
 { t:'আজকের তালিম: গীবত থেকে বাঁচা', b:'গীবত হলো ভাইয়ের এমন দোষ তার অনুপস্থিতিতে বলা, যা শুনলে সে কষ্ট পায় — তা সত্য হলেও গীবত; মিথ্যা হলে তা বুহতান (অপবাদ), আরও বড় গুনাহ। কুরআনে গীবতকে মৃত ভাইয়ের মাংস খাওয়ার সঙ্গে তুলনা করা হয়েছে।', s:'সহিহ মুসলিম: ২৫৮৯; সূরা আল-হুজুরাত: ১২' },
 { t:'আজকের তালিম: কৃতজ্ঞতা', b:'যে মানুষের প্রতি কৃতজ্ঞতা প্রকাশ করে না, সে আল্লাহর প্রতিও কৃতজ্ঞ হয় না। আল্লাহ প্রতিশ্রুতি দিয়েছেন: "তোমরা কৃতজ্ঞতা প্রকাশ করলে আমি অবশ্যই তোমাদের আরও বাড়িয়ে দেব।" প্রতিদিন ঘুমানোর আগে দিনের তিনটি নেয়ামতের কথা মনে করে শুকরিয়া আদায় করুন।', s:'সুনানে তিরমিযি: ১৯৫৪; সূরা ইবরাহিম: ৭' },
 { t:'আজকের তালিম: সদকা ও হাসিমুখ', b:'প্রতিটি ভালো কাজই সদকা। ভাইয়ের সঙ্গে হাসিমুখে সাক্ষাৎ করাও সদকা। পথ থেকে কষ্টদায়ক জিনিস সরিয়ে দেওয়াও সদকা। অর্থ না থাকলেও সদকার দরজা বন্ধ নয় — প্রতিদিন অন্তত একটি ভালো কাজ সদকার নিয়তে করুন।', s:'সহিহ মুসলিম: ১০০৯' }
];
(function renderTaleem(){
  var today = TALEEM[dayIndex() % TALEEM.length];
  $('taleemToday').innerHTML = '<article class="hcard" style="border-color:var(--gold)"><span class="cat">আজকের তালিম</span><h3>' + today.t.replace('আজকের তালিম: ', '') + '</h3><p>' + today.b + '</p><p class="src">সূত্র: ' + today.s + '</p></article>';
  $('taleemList').innerHTML = TALEEM.map(function(l){
    return '<article class="hcard"><h3>' + l.t.replace('আজকের তালিম: ', '') + '</h3><p>' + l.b + '</p><p class="src">সূত্র: ' + l.s + '</p></article>';
  }).join('');
})();

/* ---------- Sunnah ---------- */
var SUNNAH = [
 { t:'মিসওয়াক করা', d:'প্রতি নামাজের ওযুর সময় ও ঘুম থেকে উঠে মিসওয়াক করা সুন্নাত। রাসূলুল্লাহ ﷺ বলেছেন, উম্মতের ওপর কষ্টকর না হলে তিনি প্রতি নামাজের সময় মিসওয়াকের নির্দেশ দিতেন।', s:'সহিহ বুখারি: ৮৮৭; সহিহ মুসলিম: ২৫২' },
 { t:'ডান দিক থেকে শুরু করা', d:'জুতা পরা, চুল আঁচড়ানো, পবিত্রতা অর্জন ও সব ভালো কাজ ডান দিক থেকে শুরু করা সুন্নাত; আর বাম হাতে খাওয়া-পান করা নিষেধ।', s:'সহিহ বুখারি: ১৬৮; সহিহ মুসলিম: ২০২০' },
 { t:'খাবারের সুন্নাত', d:'খাবার আগে বিসমিল্লাহ বলা, ডান হাতে ও নিজের সামনে থেকে খাওয়া, আঙুল ও প্লেট চেটে খাওয়া এবং শেষে আলহামদুলিল্লাহ বলা। পেট ভরে না খেয়ে এক-তৃতীয়াংশ খাবার, এক-তৃতীয়াংশ পানি ও এক-তৃতীয়াংশ শ্বাসের জন্য রাখার উপদেশ রয়েছে।', s:'সহিহ মুসলিম: ২০২২; সুনানে তিরমিযি: ২৩৮০' },
 { t:'সালাম দেওয়া', d:'পরিচিত-অপরিচিত সবার সঙ্গে সালাম বিনিময় করা ও সালামের জবাব দেওয়া। সালাম ছড়িয়ে দেওয়া জান্নাতে প্রবেশের মাধ্যম।', s:'সহিহ মুসলিম: ৫৪' },
 { t:'ঘুমের সুন্নাত', d:'ওযু করে ঘুমানো, ডান কাতে শোয়া, আয়াতুল কুরসি ও তিন কুল পড়ে ফুঁ দেওয়া এবং ঘুমের দোয়া পড়া।', s:'সহিহ বুখারি: ২৪৭, ৫০১০' },
 { t:'জুমার দিনের সুন্নাত', d:'গোসল করা, পরিষ্কার পোশাক ও সুগন্ধি ব্যবহার, তাড়াতাড়ি মসজিদে যাওয়া, সূরা আল-কাহফ পড়া এবং বেশি বেশি দরুদ পাঠ করা।', s:'সহিহ বুখারি: ৮৭৭; সুনানে আবু দাউদ: ১০৪৭' },
 { t:'দরুদ পাঠ', d:'রাসূলুল্লাহ ﷺ-এর ওপর একবার দরুদ পড়লে আল্লাহ তার ওপর দশবার রহমত বর্ষণ করেন। জুমার দিন ও রাতে দরুদ বেশি পড়ার বিশেষ তাগিদ রয়েছে।', s:'সহিহ মুসলিম: ৪০৮' },
 { t:'রোগী দেখতে যাওয়া', d:'অসুস্থ মুসলিম ভাইকে দেখতে যাওয়া ও তার জন্য দোয়া করা সুন্নাত এবং জান্নাতের ফল আহরণের মতো সওয়াবের কাজ।', s:'সহিহ মুসলিম: ২৫৬৮' },
 { t:'হাঁচির জবাব', d:'হাঁচি দিয়ে "আলহামদুলিল্লাহ" বলা, শ্রোতা "ইয়ারহামুকাল্লাহ" বলবে, হাঁচিদাতা বলবে "ইয়াহদিকুমুল্লাহু ওয়া ইউসলিহু বালাকুম"।', s:'সহিহ বুখারি: ৬২২৪' },
 { t:'রাতে তাহাজ্জুদ ও বিতর', d:'রাতের শেষ তৃতীয়াংশে উঠে তাহাজ্জুদ পড়া ও বিতর দিয়ে রাত শেষ করা সুন্নাত। আল্লাহ রাতের শেষ অংশে দুনিয়ার আসমানে এসে দোয়া কবুলের ঘোষণা দেন।', s:'সহিহ বুখারি: ১১৪৫' },
 { t:'কথা কম ও ভালো কথা', d:'যে আল্লাহ ও আখিরাতের দিনে বিশ্বাস করে, সে যেন ভালো কথা বলে অথবা চুপ থাকে। অপ্রয়োজনীয় কথা থেকে বিরত থাকা ইসলামের সৌন্দর্য।', s:'সহিহ বুখারি: ৬০১৮; সুনানে তিরমিযি: ২৩১৭' },
 { t:'মসজিদে যাওয়ার আদব', d:'ধীরে-সুস্থে মসজিদে যাওয়া, প্রবেশের সময় ডান পা আগে দিয়ে দোয়া পড়া এবং দুই রাকাত তাহিয়্যাতুল মসজিদ পড়ে বসা।', s:'সহিহ বুখারি: ৬৩৫; সহিহ মুসলিম: ৭১৩' }
];
$('sunnahList').innerHTML = SUNNAH.map(function(x){
  return '<article class="hcard"><h3>' + x.t + '</h3><p>' + x.d + '</p><p class="src">সূত্র: ' + x.s + '</p></article>';
}).join('');

/* ---------- Amal tracker ---------- */
var amal = { roza: false, tahajjud: false, sadaka: false, quranMin: 0 };
function renderAmal(){
  var box = $('amalBody'); if (!box) return;
  var now = nowFrame(); var c = curLoc();
  var t = prayerTimes(now, c.lat, c.lng, c.tz);
  var list = [['fajr','ফজর'],['dhuhr','যোহর'],['asr','আসর'],['maghrib','মাগরিব'],['isha','এশা']];
  var done = 0, html = '<p style="margin-top:0"><b>' + new Intl.DateTimeFormat('bn-BD', { weekday:'long', day:'numeric', month:'long' }).format(now) + '</b> — পাঁচ ওয়াক্ত নামাজ</p>';
  list.forEach(function(p){
    if (tracker[p[0]]) done++;
    html += '<div class="tk-row"><span class="nm">' + p[1] + '</span><span class="tm">' + fmtTime(t[p[0]]) + '</span><button class="tk' + (tracker[p[0]] ? ' done' : '') + '" data-tk="' + p[0] + '">' + (tracker[p[0]] ? '✓ পড়েছি' : 'পড়া হয়নি') + '</button></div>';
  });
  var extras = [['roza','আজকের রোজা / নফল রোজা'],['tahajjud','তাহাজ্জুদ'],['sadaka','সদকা / দান']];
  html += '<p style="margin:16px 0 6px"><b>অন্যান্য আমল</b></p>';
  extras.forEach(function(x){
    if (amal[x[0]]) done++;
    html += '<div class="tk-row"><span class="nm">' + x[1] + '</span><button class="tk' + (amal[x[0]] ? ' done' : '') + '" data-amal="' + x[0] + '">' + (amal[x[0]] ? '✓ হয়েছে' : 'হয়নি') + '</button></div>';
  });
  if (amal.quranMin >= 10) done++;
  html += '<div class="tk-row"><span class="nm">কুরআন তিলাওয়াত (মিনিট)</span><span><input type="number" id="amalMin" min="0" value="' + amal.quranMin + '" style="width:80px" /> <button class="tk" id="amalMinSave">রাখুন</button></span></div>';
  html += '<div class="tk-row"><span class="nm">আজকের যিকির (তাসবিহ থেকে)</span><span class="tm">' + bn(tasbih.total) + ' বার</span></div>';
  var pct = Math.round(done / 9 * 100);
  html += '<div style="margin-top:16px"><div style="display:flex; justify-content:space-between; font-size:14px; color:var(--ink-2)"><span>আজকের আমলের অগ্রগতি</span><b>' + bn(pct) + '%</b></div><div style="height:12px; border-radius:8px; background:var(--line); overflow:hidden; margin-top:6px"><div style="height:100%; width:' + pct + '%; background:linear-gradient(90deg, var(--green-700), var(--gold)); border-radius:8px"></div></div><p class="sub" style="margin:8px 0 0">মোট ৯টি আমলের মধ্যে ' + bn(done) + 'টি সম্পন্ন। আল্লাহ আপনার আমল কবুল করুন।</p></div>';
  box.innerHTML = html;
}
$('amalBody').addEventListener('click', function(e){
  var tk = e.target.closest('[data-tk]');
  if (tk){ var k = tk.getAttribute('data-tk'); tracker[k] = !tracker[k]; renderAmal(); renderTracker(); return; }
  var am = e.target.closest('[data-amal]');
  if (am){ var k2 = am.getAttribute('data-amal'); amal[k2] = !amal[k2]; renderAmal(); return; }
  if (e.target.closest('#amalMinSave')){ amal.quranMin = Math.max(0, parseInt($('amalMin').value, 10) || 0); renderAmal(); toast('তিলাওয়াতের সময় রাখা হয়েছে'); }
});
document.addEventListener('click', function(e){ if (e.target.closest('[data-goto="amal"]')) setTimeout(renderAmal, 40); });
renderAmal();

/* ---------- Roza view ---------- */
$('rozaViewList').innerHTML = ROZA.map(function(r){
  return '<article class="hcard"><h3>' + r.t + '</h3><p>' + r.d + '</p><p class="src">সূত্র: ' + r.s + '</p></article>';
}).join('');
$('rozaDuas').innerHTML = DUAS.filter(function(d){ return d.t.indexOf('সেহরি') === 0 || d.t.indexOf('ইফতার') === 0; }).map(duaCard).join('');
function tickRoza(){
  var sEl = $('rozaSehri'); if (!sEl) return;
  var now = nowFrame(); var c = curLoc();
  var t = prayerTimes(now, c.lat, c.lng, c.tz);
  sEl.textContent = fmtTime(t.fajr - 10/60);
  $('rozaIftar').textContent = fmtTime(t.maghrib);
  var hp = (typeof hijriParts === 'function') ? hijriParts(now) : null;
  $('rozaNote').innerHTML = 'লোকেশন: ' + c.name + (hp ? ' • আজ হিজরি ' + hijriDateHTML(now) : '');
}
setInterval(tickRoza, 1000); tickRoza();
$('ramadanTableBtn').addEventListener('click', function(){
  var now = nowFrame(); var c = curLoc(); var start = null;
  for (var i = -40; i < 380 && !start; i++){
    var dt = new Date(now.getFullYear(), now.getMonth(), now.getDate() + i);
    var h = hijriOf(dt);
    if (h && h.month === 9 && h.day === 1) start = dt;
  }
  if (!start){ $('ramadanTable').innerHTML = '<p class="loadmsg">তারিখ হিসাব করা যায়নি।</p>'; return; }
  var rows = '';
  for (var k = 0; k < 30; k++){
    var d2 = new Date(start.getFullYear(), start.getMonth(), start.getDate() + k);
    var tt = prayerTimes(d2, c.lat, c.lng, c.tz);
    rows += '<tr><td style="padding:7px 8px; border-bottom:1px solid var(--line)">' + bn(k + 1) + '</td><td style="padding:7px 8px; border-bottom:1px solid var(--line)">' + new Intl.DateTimeFormat('bn-BD', { week