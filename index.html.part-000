<!doctype html>
<html lang="bn">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
<meta name="color-scheme" content="light dark" />
<link rel="icon" href="data:," />
<title>Muslim Path — কুরআন, হাদিস, নামাজের সময়, কিবলা ও তাসবিহ</title>
<link href="assets/fonts/fonts.css" rel="stylesheet" />
<script>try{var _th=localStorage.getItem('di_theme');if(_th==='light'||_th==='dark'||_th==='blue'){document.documentElement.setAttribute('data-theme',_th);}}catch(e){}</script>
<style>
  :root{
    color-scheme: light dark;
    --green-950:#100e0b; --green-900:#171410; --green-800:#221e18; --green-700:#2e2921;
    --green-600:#3d372c; --green-500:#554d3d;
    --gold:#c9a24b; --gold-2:#e3c878; --gold-soft:#f3e7c3;
    --bg:#ffffff; --surface:#ffffff; --surface-2:#ffffff;
    --ink:#1c2a22; --ink-2:#33463a; --line:#ddd3b8; --linkc:#8a6d1f;
    --card-shadow:0 2px 10px rgba(20,17,12,.08), 0 10px 30px rgba(20,17,12,.06);
    --danger:#b3372f; --ok:#12714e;
  }
  @media (prefers-color-scheme: dark){
    :root{
      --bg:#000000; --surface:#000000; --surface-2:#000000;
      --ink:#eef3ec; --ink-2:#b7c8ba; --line:#2f2f2f; --linkc:#e3c878;
      --card-shadow:0 2px 10px rgba(0,0,0,.35), 0 10px 30px rgba(0,0,0,.25);
      --danger:#e08079; --ok:#5fc493;
    }
  }
  *{ box-sizing:border-box; }
  html{ -webkit-text-size-adjust:100%; }
  body{
    margin:0; background:var(--bg); color:var(--ink);
    font-family:"Noto Sans Bengali","Hind Siliguri",system-ui,sans-serif;
    line-height:1.65; font-size:16px;
  }
  button,[role="button"],select,summary,input:not([type="checkbox"],[type="radio"]){ min-height:2.25rem; }
  button{ font-family:inherit; cursor:pointer; }
  .ar{ font-family:"Amiri",serif; direction:rtl; }
  .wrap{ max-width:1060px; margin:0 auto; padding:0 14px 90px; }

  /* ---------- Hero ---------- */
  .hero{
    position:relative; overflow:hidden; color:#fdf8ea;
    background:var(--bg);
    border-bottom:3px solid var(--gold);
  }
  
  
  .hero-in{ position:relative; max-width:1060px; margin:0 auto; padding:26px 16px 20px; text-align:center; }
  .applogo{
    width:92px; height:92px; border-radius:22px; object-fit:cover; display:block; margin:0 auto 10px;
    border:2px solid var(--gold); box-shadow:0 12px 30px rgba(0,0,0,.5), 0 0 0 5px rgba(201,162,75,.18);
  }
  .hero h1{
    margin:0; font-family:"Noto Sans Bengali","Hind Siliguri",sans-serif; font-weight:700;
    font-size:clamp(34px,7vw,52px); letter-spacing:.5px; color:#fdf6da;
    text-shadow:0 2px 14px rgba(0,0,0,.55);
  }
  .hero .tag{ margin:2px 0 0; color:var(--gold-2); font-size:15px; text-shadow:0 1px 8px rgba(0,0,0,.6); }
  .clock{
    margin-top:12px; font-size:clamp(30px,7vw,40px); font-weight:700; line-height:1.1;
    font-variant-numeric:tabular-nums; color:#fff; text-shadow:0 2px 16px rgba(0,0,0,.6);
  }
  .clock small{ font-size:.42em; font-weight:600; color:var(--gold-2); }
  .dates{ margin-top:6px; display:flex; flex-wrap:wrap; gap:6px 10px; justify-content:center; font-size:15px; }
  .dates span{ background:rgba(20,17,12,.55); border:1px solid rgba(201,162,75,.55); border-radius:999px; padding:3px 12px; backdrop-filter:blur(2px); }
  .nextp{
    margin:16px auto 4px; max-width:520px; background:rgba(20,17,12,.62);
    border:1px solid var(--gold); border-radius:14px; padding:10px 16px;
    display:flex; align-items:center; justify-content:space-between; gap:12px; backdrop-filter:blur(3px);
  }
  .nextp .lbl{ font-size:14px; color:var(--gold-2); }
  .nextp .nm{ font-size:24px; font-weight:700; color:#fff; line-height:1.2; }
  .nextp .cd{ font-size:clamp(28px,7vw,36px); font-weight:700; font-variant-numeric:tabular-nums; color:var(--gold-2); white-space:nowrap; }

  /* ---------- Hero prayer widget ---------- */
  .hero-prayer{
    position:relative;
    max-width:520px; margin:8px auto 0; text-align:left;
    background:rgba(10,9,7,.68); border:1px solid var(--gold); border-radius:16px;
    padding:13px 15px 9px; backdrop-filter:blur(3px);
  }
  .refresh-btn{
    position:absolute; top:10px; right:10px; width:38px; height:38px; border-radius:50%;
    border:1px solid var(--gold); background:rgba(20,17,12,.65); color:var(--gold-2);
    display:flex; align-items:center; justify-content:center; cursor:pointer; padding:0;
  }
  .refresh-btn svg{ width:19px; height:19px; transition:transform .6s ease; }
  .refresh-btn.spin svg{ transform:rotate(360deg); }
  .refresh-btn:hover{ background:rgba(201,162,75,.22); }
  .hero-prayer .hp-head{ display:flex; flex-wrap:wrap; justify-content:space-between; align-items:baseline; gap:6px; margin-bottom:4px; }
  .hero-prayer .hp-city{ font-size:14px; color:var(--gold-2); }
  .hero-prayer .hp-cur{ font-size:19px; font-weight:700; color:#fff; }
  .hero-prayer .hp-cur b{ color:var(--gold-2); }
  .hero-prayer .ptable{ border-radius:0; }
  .hero-prayer .ptable td{ padding:8px 6px; }
  .hero-prayer .ptable tbody tr{ background:transparent; border-top:1px solid rgba(201,162,75,.28); color:#fdf6da; }
  .hero-prayer .ptable tbody tr:first-child{ border-top:0; }
  .hero-prayer .ptable tbody tr.now{ background:rgba(201,162,75,.20); font-weight:700; }
  .hero-prayer .ptable tbody tr.now td:first-child{ box-shadow:inset 4px 0 0 var(--gold); padding-left:12px; }
  .hero-prayer .ptable td:first-child{ font-size:17.5px; }
  .hero-prayer .ptable td.time{ font-size:19px; color:#fff; }
  .hero-prayer .hp-foot{ text-align:center; margin:9px 0 3px; }
  .hero-prayer .hp-foot button{
    background:transparent; border:1px solid var(--gold); color:var(--gold-2);
    border-radius:999px; padding:6px 18px; font-weight:600; font-size:14.5px;
  }
  .hero-prayer .hp-loc{
    display:flex; flex-wrap:wrap; gap:8px; align-items:end;
    border-top:1px solid rgba(201,162,75,.28); margin-top:9px; padding-top:10px;
  }
  .hero-prayer .hp-loc label{
    flex:1 1 170px; display:flex; flex-direction:column; gap:4px;
    font-size:13.5px; font-weight:600; color:var(--gold-2);
  }
  .hero-prayer .hp-loc select{
    width:100%; font:inherit; font-size:15px; padding:8px 10px; min-height:2.5rem;
    border-radius:10px; border:1px solid var(--gold);
    background:var(--surface); color:var(--ink);
  }
  .hero-prayer .hp-loc button{
    border:1px solid var(--gold); background:rgba(201,162,75,.16); color:var(--gold-2);
    border-radius:10px; padding:8px 13px; font-weight:600; font-size:14.5px; white-space:nowrap;
  }
  .hero-prayer .hp-loc button:hover{ background:rgba(201,162,75,.3); }

  /* ---------- Nav ---------- */
  nav.tabs{
    position:sticky; top:0; z-index:40; background:var(--green-900);
    border-bottom:2px solid var(--gold);
    box-shadow:0 4px 14px rgba(0,0,0,.18);
  }
  nav.tabs .row{ max-width:1060px; margin:0 auto; display:flex; gap:2px; padding:6px 8px; overflow-x:auto; scrollbar-width:none; }
  nav.tabs .row::-webkit-scrollbar{ display:none; }
  nav.tabs button{
    flex:1 0 auto; border:1px solid transparent; background:transparent; color:#e9e2c8;
    font-size:15.5px; font-weight:600; padding:8px 13px; border-radius:10px; white-space:nowrap;
  }
  nav.tabs button[aria-selected="true"]{ background:var(--gold); color:#231a04; }
  nav.tabs button:focus-visible{ outline:2px solid #fff; outline-offset:2px; }

  main section.view{ display:none; padding-top:20px; }
  main section.view.on{ display:block; }
  h2.sec{
    font-family:"Noto Sans Bengali","Hind Siliguri",sans-serif; font-size:24px; margin:6px 0 4px; color:var(--green-800);
    display:flex; align-items:center; gap:10px;
  }
  @media (prefers-color-scheme: dark){ h2.sec{ color:var(--gold-2); } }
  h2.sec::after{ content:""; flex:1; height:2px; background:linear-gradient(90deg, var(--gold), transparent); border-radius:2px; }
  .sub{ color:var(--ink-2); margin:0 0 14px; font-size:15px; }

  /* ---------- Home grid ---------- */
  .grid{ display:grid; grid-template-columns:repeat(2,1fr); gap:12px; }
  @media (min-width:640px){ .grid{ grid-template-columns:repeat(3,1fr); } }
  @media (min-width:920px){ .grid{ grid-template-columns:repeat(5,1fr); } }
  .tile{
    background:var(--surface); border:1px solid var(--line); border-radius:16px;
    box-shadow:var(--card-shadow); padding:16px 12px 13px; text-align:center;
    display:flex; flex-direction:column; align-items:center; gap:7px; width:100%;
    color:var(--ink); font-size:16.5px; font-weight:600;
  }
  .tile:hover{ border-color:var(--gold); }
  .tile .ic{
    width:52px; height:52px; border-radius:50%; display:grid; place-items:center;
    background:radial-gradient(circle at 32% 28%, var(--green-600), var(--green-900));
    border:2px solid var(--gold); color:var(--gold-2);
  }
  .tile .ic svg{ width:27px; height:27px; }
  .tile small{ font-weight:400; color:var(--ink-2); font-size:13px; line-height:1.4; }

  .card{ background:var(--surface); border:1px solid var(--line); border-radius:16px; box-shadow:var(--card-shadow); padding:18px; }
  .daily{ margin-top:18px; display:grid; gap:12px; }
  @media (min-width:760px){ .daily{ grid-template-columns:1fr 1fr; } }
  .daily .card h3{ margin:0 0 8px; font-size:16px; color:var(--green-700); display:flex; gap:8px; align-items:center; }
  @media (prefers-color-scheme: dark){ .daily .card h3{ color:var(--gold-2); } }
  .daily .ar{ font-size:23px; line-height:2; text-align:right; }
  .daily .src{ color:var(--ink-2); font-size:13.5px; }

  /* ---------- Prayer ---------- */
  .ptable{ width:100%; border-collapse:collapse; overflow:hidden; border-radius:14px; }
  .ptable th,.ptable td{ padding:11px 14px; text-align:left; }
  .ptable thead th{ background:var(--green-800); color:#f7efcd; font-weight:600; }
  .ptable tbody tr{ border-top:1px solid var(--line); background:var(--surface); }
  .ptable tbody tr.now{ background:linear-gradient(90deg, rgba(201,162,75,.22), transparent); font-weight:700; }
  .ptable tbody tr.now td:first-child{ box-shadow:inset 4px 0 0 var(--gold); }
  .ptable td.time{ font-variant-numeric:tabular-nums; font-weight:600; white-space:nowrap; }
  .ptable .badge{ font-size:12px; background:var(--gold); color:#231a04; border-radius:999px; padding:1px 9px; font-weight:700; }
  .controls{ display:flex; flex-wrap:wrap; gap:10px; align-items:end; margin:0 0 14px; }
  .controls label{ display:flex; flex-direction:column; gap:4px; font-size:14px; font-weight:600; }
  select,input[type="date"],input[type="number"],input[type="text"]{
    font:inherit; padding:8px 10px; border-radius:10px; border:1px solid var(--line);
    background:var(--surface); color:var(--ink); min-height:2.5rem;
  }
  .btn{
    border:1px solid var(--green-800); background:var(--green-800); color:#fdf6da;
    border-radius:10px; padding:9px 18px; font-size:15.5px; font-weight:600;
  }
  .btn.gold{ background:var(--gold); border-color:var(--gold); color:#231a04; }
  .btn.ghost{ background:transparent; color:var(--green-800); }
  @media (prefers-color-scheme: dark){ .btn.ghost{ color:var(--gold-2); border-color:var(--gold); } }
  .btn:disabled{ opacity:.55; cursor:default; }

  /* ---------- Lists (surah / para / hadith / dua) ---------- */
  .seg{ display:inline-flex; background:var(--surface-2); border:1px solid var(--line); border-radius:12px; padding:3px; gap:3px; }
  .seg button{ border:0; background:transparent; padding:7px 18px; border-radius:9px; font-weight:600; color:var(--ink-2); font-size:15.5px; }
  .seg button[aria-pressed="true"]{ background:var(--green-800); color:#fdf6da; }
  .search{ width:100%; margin:12px 0; }
  .slist{ display:grid; gap:9px; }
  @media (min-width:760px){ .slist{ grid-template-columns:1fr 1fr; } }
  .sitem{
    display:flex; align-items:center; gap:12px; text-align:left; width:100%;
    background:var(--surface); border:1px solid var(--line); border-radius:13px; padding:11px 13px;
    box-shadow:var(--card-shadow); color:var(--ink);
  }
  .sitem:hover{ border-color:var(--gold); }
  .sitem .no{
    flex:0 0 auto; width:42px; height:42px; display:grid; place-items:center; font-weight:700;
    color:var(--green-900); background:var(--gold-soft); border:1px solid var(--gold);
    transform:rotate(45deg); border-radius:9px; font-size:15px;
  }
  .sitem .no i{ transform:rotate(-45deg); font-style:normal; }
  @media (prefers-color-scheme: dark){ .sitem .no{ color:#231a04; } }
  .sitem .tt{ flex:1; min-width:0; }
  .sitem .tt b{ font-size:16.5px; display:block; }
  .sitem .tt span{ font-size:13px; color:var(--ink-2); }
  .sitem .arn{ font-family:"Amiri",serif; font-size:21px; color:var(--green-700); white-space:nowrap; }
  @media (prefers-color-scheme: dark){ .sitem .arn{ color:var(--gold-2); } }

  /* ---------- Reader ---------- */
  .reader-head{ display:flex; flex-wrap:wrap; gap:10px; align-items:center; margin-bottom:6px; }
  .reader-head h3{ margin:0; font-family:"Noto Sans Bengali","Hind Siliguri",sans-serif; font-size:22px; flex:1; min-width:180px; }
  .bismillah{ text-align:center; font-family:"Amiri",serif; font-size:30px; padding:12px 0 2px; color:var(--green-800); }
  @media (prefers-color-scheme: dark){ .bismillah{ color:var(--gold-2); } }
  .ayah{ border-top:1px solid var(--line); padding:16px 2px 12px; }
  .ayah:first-of-type{ border-top:0; }
  .ayah .top{ display:flex; justify-content:space-between; align-items:center; gap:10px; }
  .ayah .ano{
    width:34px; height:34px; flex:0 0 auto; display:grid; place-items:center; border-radius:50%;
    border:1.5px solid var(--gold); background:var(--gold-soft); color:#4d3a08; font-weight:700; font-size:14px;
  }
  .ayah .play{
    border:1px solid var(--gold); background:transparent; color:var(--green-800); border-radius:999px;
    padding:5px 14px; font-size:14px; font-weight:600; display:inline-flex; gap:6px; align-items:center;
  }
  @media (prefers-color-scheme: dark){ .ayah .play{ color:var(--gold-2); } }
  .ayah .play.playing{ background:var(--gold); color:#231a04; }
  .ayah .arabic{ font-family:"Amiri",serif; direction:rtl; text-align:right; font-size:27px; line-height:2.15; margin:8px 0 6px; }
  .ayah .bangla{ font-size:16.5px; }
  .tfs{ margin-top:9px; border:1px dashed var(--gold); background:rgba(201,162,75,.09); border-radius:11px; padding:11px 14px; font-size:15.5px; line-height:1.75; }
  .tfs b{ color:var(--green-800); }
  @media (prefers-color-scheme: dark){ .tfs b{ color:var(--gold-2); } }
  :root[data-theme="dark"] .tfs b{ color:var(--gold-2); }
  .surah-end{ text-align:center; color:var(--ink-2); padding:14px 0 4px; font-family:"Amiri",serif; font-size:20px; }
  .loadmsg{ text-align:center; color:var(--ink-2); padding:26px 0; }

  /* ---------- Hadith / Dua cards ---------- */
  .hcard{ background:var(--surface); border:1px solid var(--line); border-radius:16px; box-shadow:var(--card-shadow); padding:18px; margin-bottom:12px; }
  .hcard .cat{ display:inline-block; font-size:12.5px; font-weight:700; background:var(--green-800); color:#f7efcd; padding:2px 11px; border-radius:999px; margin-bottom:8px; }
  .hcard h3{ margin:0 0 6px; font-size:18px; font-family:"Noto Sans Bengali","Hind Siliguri",sans-serif; }
  .hcard .ar{ font-size:22px; line-height:2.05; text-align:right; margin:6px 0; }
  .hcard .src{ color:var(--ink-2); font-size:13.5px; border-top:1px dashed var(--line); padding-top:8px; margin-top:10px; }
  .hcard .cnt{ display:inline-block; background:var(--gold-soft); border:1px solid var(--gold); color:#4d3a08; border-radius:999px; padding:1px 10px; font-size:13px; font-weight:700; }
  @media (prefers-color-scheme: dark){ .hcard .cnt{ color:#231a04; } }

  /* ---------- Qibla ---------- */
  .qibla-flex{ display:grid; gap:18px; align-items:start; }
  @media (min-width:760px){ .qibla-flex{ grid-template-columns:340px 1fr; } }
  .compass{ position:relative; width:min(320px,84vw); aspect-ratio:1; margin:0 auto; }
  .compass .ring{
    position:absolute; inset:0; border-radius:50%;
    background:radial-gradient(circle, var(--surface) 58%, var(--surface-2));
    border:3px solid var(--gold); box-shadow:var(--card-shadow);
  }
  .compass .dial{ position:absolute; inset:0; transition:transform .18s linear; }
  .compass .dial .dir{ position:absolute; left:50%; top:7px; transform:translateX(-50%); font-weight:700; font-size:17px; color:var(--danger); }
  .compass .dial .dir.e{ top:50%; left:auto; right:10px; transform:translateY(-50%); color:var(--ink-2); font-size:14px; }
  .compass .dial .dir.s{ top:auto; bottom:7px; color:var(--ink-2); font-size:14px; }
  .compass .dial .dir.w{ top:50%; left:10px; transform:translateY(-50%); color:var(--ink-2); font-size:14px; }
  .compass .kaaba{ position:absolute; left:50%; top:15%; transform:translate(-50%,-50%); font-size:30px; }
  .compass .needle{
    position:absolute; left:50%; top:50%; width:4px; height:41%; transform-origin:50% 100%;
    transform:translate(-50%,-100%); background:linear-gradient(var(--gold), var(--green-700)); border-radius:4px;
  }
  .compass .pin{ position:absolute; left:50%; top:50%; width:16px; height:16px; transform:translate(-50%,-50%); border-radius:50%; background:var(--green-800); border:2.5px solid var(--gold); }

  /* ---------- Tasbih ---------- */
  .tasbih{ text-align:center; }
  .tasbih .big{
    font-size:clamp(64px,18vw,96px); font-weight:700; line-height:1.1; font-variant-numeric:tabular-nums;
    color:var(--green-800);
  }
  @media (prefers-color-scheme: dark){ .tasbih .big{ color:var(--gold-2); } }
  .tasbih .dhikr-ar{ font-family:"Amiri",serif; font-size:34px; margin-top:4px; }
  .tapbtn{
    width:min(230px,64vw); aspect-ratio:1; border-radius:50%; margin:18px auto; display:block;
    background:radial-gradient(circle at 34% 28%, var(--green-500), var(--green-900));
    border:4px solid var(--gold); color:#fdf6da; font-size:21px; font-weight:700;
    box-shadow:0 12px 30px rgba(20,17,12,.35), inset 0 0 0 6px rgba(201,162,75,.25);
  }
  .tapbtn:active{ transform:scale(.975); }
  .chips{ display:flex; flex-wrap:wrap; gap:8px; justify-content:center; }
  .chips button{ border:1px solid var(--line); background:var(--surface); color:var(--ink); border-radius:999px; padding:6px 12px; font-weight:600; font-size:13.5px; }
  .chips button[aria-pressed="true"]{ background:var(--green-800); color:#fdf6da; border-color:var(--green-800); }

  /* ---------- Quiz ---------- */
  .quiz-opt{ display:block; width:100%; text-align:left; margin:8px 0; padding:12px 15px; border-radius:12px;
    border:1.5px solid var(--line); background:var(--surface); color:var(--ink); font-size:16.5px; font-weight:500; }
  .quiz-opt.right{ border-color:var(--gold); background:rgba(201,162,75,.16); font-weight:700; }
  .quiz-opt.wrong{ border-color:var(--danger); background:rgba(179,55,47,.10); }
  .quiz-exp{ border:1px dashed var(--gold); background:rgba(201,162,75,.10); border-radius:12px; padding:12px 15px; margin-top:12px; }
  .qmeta{ display:flex; justify-content:space-between; color:var(--ink-2); font-size:14px; margin-bottom:6px; }

  /* ---------- Names ---------- */
  .names{ display:grid; grid-template-columns:repeat(2,1fr); gap:10px; }
  @media (min-width:640px){ .names{ grid-template-columns:repeat(3,1fr); } }
  @media (min-width:920px){ .names{ grid-template-columns:repeat(4,1fr); } }
  .name-card{ background:var(--surface); border:1px solid var(--line); border-radius:14px; box-shadow:var(--card-shadow); padding:13px; text-align:center; }
  .name-card .n{ font-size:12.5px; color:var(--ink-2); }
  .name-card .a{ font-family:"Amiri",serif; font-size:26px; color:var(--green-800); line-height:1.7; }
  @media (prefers-color-scheme: dark){ .name-card .a{ color:var(--gold-2); } }
  .name-card .t{ font-weight:700; font-size:16px; }
  .name-card .m{ font-size:13.5px; color:var(--ink-2); line-height:1.5; }

  /* ---------- Zakat / forms ---------- */
  .zform{ display:grid; gap:12px; }
  @media (min-width:640px){ .zform{ grid-template-columns:1fr 1fr; } }
  .zform label{ display:flex; flex-direction:column; gap:4px; font-weight:600; font-size:15px; }
  .zform label small{ font-weight:400; color:var(--ink-2); }
  .zresult{ margin-top:16px; border:1.5px solid var(--gold); border-radius:14px; padding:16px; background:rgba(201,162,75,.09); font-size:16.5px; }
  .zresult .amt{ font-size:30px; font-weight:700; color:var(--green-800); }
  @media (prefers-color-scheme: dark){ .zresult .amt{ color:var(--gold-2); } }

  /* ---------- Shikkha ---------- */
  .steps{ counter-reset:st; padding:0; margin:0; list-style:none; display:grid; gap:9px; }
  .steps li{ background:var(--surface); border:1px solid var(--line); border-radius:12px; padding:11px 14px 11px 52px; position:relative; box-shadow:var(--card-shadow); }
  .steps li::before{
    counter-increment:st; content:counter(st); position:absolute; left:12px; top:11px;
    width:29px; height:29px; border-radius:50%; background:var(--green-800); color:#f7efcd;
    display:grid; place-items:center; font-weight:700; font-size:14.5px;
  }
  .rakat{ width:100%; border-collapse:collapse; }
  .rakat th,.rakat td{ border:1px solid var(--line); padding:8px 10px; text-align:center; font-size:15px; }
  .rakat thead th{ background:var(--green-800); color:#f7efcd; }
  .rakat tbody th{ background:var(--surface-2); text-align:left; }
  details.acc{ background:var(--surface); border:1px solid var(--line); border-radius:13px; margin-bottom:10px; box-shadow:var(--card-shadow); }
  details.acc summary{ padding:13px 16px; font-weight:700; font-size:16.5px; cursor:pointer; list-style:none; display:flex; justify-content:space-between; align-items:center; gap:10px; }
  details.acc summary::-webkit-details-marker{ display:none; }
  details.acc summary::after{ content:"＋"; color:var(--gold); font-weight:700; }
  details.acc[open ] summary::after{ content:"－"; }
  details.acc .body{ padding:0 16px 15px; }
  details.acc .ar{ font-size:21px; line-height:2.05; text-align:right; }

  footer{ border-top:2px solid var(--gold); background:var(--green-950); color:#e9e2c8; margin-top:34px; }
  footer .in{ max-width:1060px; margin:0 auto; padding:22px 16px 30px; text-align:center; }
  footer .ar{ font-size:22px; color:var(--gold-2); }
  footer p{ margin:6px 0; font-size:14.5px; color:#cdbf97; }
  .toast{
    position:fixed; left:50%; bottom:22px; transform:translate(-50%,80px); z-index:60;
    background:var(--green-900); color:#fdf6da; border:1px solid var(--gold); border-radius:999px;
    padding:9px 20px; font-weight:600; box-shadow:0 10px 30px rgba(0,0,0,.35); transition:transform .25s ease; max-width:92vw; text-align:center;
  }
  .toast.show{ transform:translate(-50%,0); }
  .hidden{ display:none !important; }

  /* ---------- Premium polish ---------- */
  body{
    background:
      radial-gradient(1100px 480px at 85% -60px, rgba(201,162,75,.10), transparent 60%),
      radial-gradient(900px 500px at -10% 30%, rgba(201,162,75,.05), transparent 55%),
      var(--bg);
  }
  
  .hero h1{ letter-spacing:1px; }
  .hero .tag{ letter-spacing:.4px; }
  .clock{ letter-spacing:1px; }
  .dates span{ box-shadow:inset 0 1px 0 rgba(227,200,120,.35); }
  .nextp, .hero-prayer{ box-shadow:0 14px 34px rgba(0,0,0,.35), inset 0 1px 0 rgba(227,200,120,.28); }
  nav.tabs{ background:linear-gradient(180deg, var(--green-800), var(--green-900)); }
  nav.tabs button{ transition:background .18s ease, color .18s ease; }
  nav.tabs button[aria-selected="true"]{ background:linear-gradient(180deg, var(--gold-2), var(--gold)); box-shadow:0 3px 10px rgba(0,0,0,.28); }
  h2.sec{ letter-spacing:.2px; }
  h2.sec::before{
    content:""; width:11px; height:11px; flex:0 0 auto; transform:rotate(45deg);
    background:linear-gradient(135deg, var(--gold-2), var(--gold));
    border:1px solid rgba(120,90,20,.45); border-radius:2.5px;
    box-shadow:0 2px 6px rgba(160,120,30,.35);
  }
  .card, .hcard, .sitem, .name-card, details.acc, .steps li{
    border-color:color-mix(in srgb, var(--gold) 34%, var(--line));
  }
  .tile{ transition:transform .18s ease, box-shadow .18s ease, border-color .18s ease; position:relative; overflow:hidden; }
  .tile::after{
    content:""; position:absolute; left:0; right:0; top:0; height:3px;
    background:linear-gradient(90deg, transparent, var(--gold), transparent); opacity:0; transition:opacity .18s ease;
  }
  .tile:hover{ transform:translateY(-3px); box-shadow:0 10px 26px rgba(20,17,12,.16); }
  .tile:hover::after{ opacity:1; }
  .tile .ic{ box-shadow:0 6px 16px rgba(20,17,12,.28), inset 0 1px 0 rgba(227,200,120,.4); }
  .sitem{ transition:transform .16s ease, border-color .16s ease, box-shadow .16s ease; }
  .sitem:hover{ transform:translateY(-2px); box-shadow:0 8px 22px rgba(20,17,12,.14); }
  .sitem .no{ background:linear-gradient(145deg, #f7ecc9, var(--gold-soft)); box-shadow:inset 0 1px 0 #fff8; }
  .btn{ background:linear-gradient(180deg, var(--green-700), var(--green-800)); box-shadow:0 4px 12px rgba(20,17,12,.22); transition:transform .15s ease, box-shadow .15s ease; }
  .btn:active{ transform:translateY(1px); }
  .btn.gold{ background:linear-gradient(180deg, var(--gold-2), var(--gold)); box-shadow:0 4px 12px rgba(140,105,25,.3); }
  .btn.ghost{ background:transparent; box-shadow:none; }
  .seg button[aria-pressed="true"]{ background:linear-gradient(180deg, var(--green-700), var(--green-800)); }
  .chips button[aria-pressed="true"]{ background:linear-gradient(180deg, var(--green-700), var(--green-800)); }
  .tapbtn{ transition:transform .1s ease; box-shadow:0 16px 36px rgba(20,17,12,.38), inset 0 2px 0 rgba(227,200,120,.45), inset 0 0 0 6px rgba(201,162,75,.25); }
  .hcard .cat{ background:linear-gradient(180deg, var(--green-700), var(--green-800)); letter-spacing:.3px; }
  .ptable thead th, .rakat thead th{ background:linear-gradient(180deg, var(--green-700), var(--green-800)); }
  .steps li::before{ background:linear-gradient(180deg, var(--green-600), var(--green-800)); box-shadow:0 3px 8px rgba(20,17,12,.25); }
  details.acc summary{ transition:background .15s ease; border-radius:13px; }
  details.acc summary:hover{ background:rgba(201,162,75,.08); }
  input:focus-visible, select:focus-visible, button:focus-visible{ outline:2px solid var(--gold); outline-offset:2px; }
  .quiz-opt{ transition:border-color .15s ease, background .15s ease; }
  .quiz-opt:hover{ border-color:var(--gold); }
  footer{ background:linear-gradient(180deg, var(--green-900), var(--green-950)); }
  @media (prefers-reduced-motion: reduce){
    .tile, .sitem, .btn, .tapbtn{ transition:none; }
    .tile:hover, .sitem:hover{ transform:none; }
  }

  /* ---------- Manual theme override ---------- */
  :root[data-theme="dark"]{
    color-scheme:dark;
    --bg:#000000; --surface:#000000; --surface-2:#000000;
    --ink:#eef3ec; --ink-2:#b7c8ba; --line:#2f2f2f; --linkc:#e3c878;
    --card-shadow:0 2px 10px rgba(0,0,0,.35), 0 10px 30px rgba(0,0,0,.25);
    --danger:#e08079; --ok:#5fc493;
  }
  :root[data-theme="light"]{
    color-scheme:light;
    --bg:#ffffff; --surface:#ffffff; --surface-2:#ffffff;
    --ink:#1c2a22; --ink-2:#33463a; --line:#ddd3b8; --linkc:#8a6d1f;
    --card-shadow:0 2px 10px rgba(20,17,12,.08), 0 10px 30px rgba(20,17,12,.06);
    --danger:#b3372f; --ok:#12714e;
  }
  /* Light theme clarity: the hero countdown card and prayer-schedule card
     sit on always-dark surfaces. On a white page their translucent dark
     background washed out to grey and muted theme tones (e.g. --ink-2 in
     the schedule's end-time column) turned hazy. In the light theme make
     those dark surfaces nearly opaque and keep their text in the same
     bright white / bright-gold colours the dark theme uses. */
  :root[data-theme="light"] .waqt-card,
  :root[data-theme="light"] .hero-prayer,
  :root[data-theme="light"] .nextp{ background:rgba(12,10,8,.95); }
  :root[data-theme="light"] .hero-prayer .ptable td.end{ color:var(--gold-2); }
  :root[data-theme="light"] .date-chip,
  :root[data-theme="light"] .dates span,
  :root[data-theme="light"] .profile-chip,
  :root[data-theme="light"] .loc-pill,
  :root[data-theme="light"] .theme-mini{ background:rgba(20,17,12,.92); }
  :root[data-theme="dark"] h2.sec,
  :root[data-theme="dark"] .daily .card h3,
  :root[data-theme="dark"] .sitem .arn,
  :root[data-theme="dark"] .ayah .play,
  :root[data-theme="dark"] .bismillah,
  :root[data-theme="dark"] .tasbih .big,
  :root[data-theme="dark"] .zresult .amt,
  :root[data-theme="dark"] .name-card .a,
  :root[data-theme="dark"] .btn.ghost{ color:var(--gold-2); }
  :root[data-theme="dark"] #ramadanCd{ color:var(--gold-2) !important; }
  :root[data-theme="dark"] .quiz-opt.right{ background:rgba(201,162,75,.24); }
  nav.tabs button#themeBtn{ color:var(--gold-2); border:1px solid rgba(201,162,75,.5); border-radius:10px; margin-left:4px; }
  :root[data-theme="dark"] nav.tabs button#themeBtn{ background:rgba(201,162,75,.16); }

  
  /* ---------- Theme picker ---------- */
  .themepick{ display:flex; gap:8px; }
  .themepick button{ flex:1; border:1.5px solid var(--line); background:var(--surface-2); color:var(--ink); border-radius:11px; padding:10px 4px; font:inherit; font-weight:700; font-size:15px; min-height:2.75rem; cursor:pointer; }
  .themepick button[aria-pressed="true"]{ background:linear-gradient(180deg, var(--gold-2), var(--gold)); color:#231a04; border-color:var(--gold); }
  /* ---------- রয়েল ব্লু theme ---------- */
  :root[data-theme="blue"]{
    color-scheme:dark;
    --bg:#0a2450; --surface:#0d2b5c; --surface-2:#123f7f;
    --ink:#ffffff; --ink-2:#c7d6f2; --line:#2c56a0; --linkc:#e3c878;
    --card-shadow:0 2px 10px rgba(0,0,0,.35), 0 10px 30px rgba(0,0,0,.25);
    --danger:#e08079; --ok:#5fc493;
  }
  :root[data-theme="blue"] .hero{ background:linear-gradient(160deg, #123f7f 0%, #0d2b5c 55%, #081c40 100%); }
  :root[data-theme="blue"] nav.tabs{ background:linear-gradient(180deg, #123f7f, #0d2b5c); }
  :root[data-theme="blue"] footer{ background:linear-gradient(180deg, #0d2b5c, #081c40); }
  :root[data-theme="blue"] .bottomnav{ background:linear-gradient(180deg, #0d2b5c, #081c40); }
  :root[data-theme="blue"] .htile{ background:linear-gradient(165deg, #123f7f, #0a2450); }
  :root[data-theme="blue"] .btn{ background:linear-gradient(180deg, #123f7f, #0d2b5c); }
  :root[data-theme="blue"] .ptable thead th, :root[data-theme="blue"] .rakat thead th{ background:linear-gradient(180deg, #123f7f, #0d2b5c); }
  :root[data-theme="blue"] .seg button[aria-pressed="true"]{ background:linear-gradient(180deg, #123f7f, #0d2b5c); }
  :root[data-theme="blue"] .chips button[aria-pressed="true"]{ background:linear-gradient(180deg, #123f7f, #0d2b5c); border-color:#123f7f; }
  :root[data-theme="blue"] .hcard .cat{ background:linear-gradient(180deg, #123f7f, #0d2b5c); }
  :root[data-theme="blue"] .steps li::before{ background:linear-gradient(180deg, #123f7f, #0d2b5c); }
  :root[data-theme="blue"] .tk.done{ background:linear-gradient(180deg, #123f7f, #0d2b5c); border-color:#123f7f; }

  :root[data-theme="blue"] .tfs b{ color:var(--gold-2); }


  /* ---------- রয়েল ব্লু gold accents ---------- */

  :root[data-theme="blue"] h2.sec,
  :root[data-theme="blue"] .daily .card h3,
  :root[data-theme="blue"] .sitem .arn,
  :root[data-theme="blue"] .ayah .play,
  :root[data-theme="blue"] .bismillah,
  :root[data-theme="blue"] .tasbih .big,
  :root[data-theme="blue"] .zresult .amt,
  :root[data-theme="blue"] .name-card .a,
  :root[data-theme="blue"] .btn.ghost{ color:var(--gold-2); }

  :root[data-theme="blue"] #ramadanCd{ color:var(--gold-2) !important; }

  :root[data-theme="blue"] .quiz-opt.right{ background:rgba(201,162,75,.24); }

  :root[data-theme="blue"] nav.tabs button#themeBtn{ background:rgba(201,162,75,.16); }

  :root[data-theme="blue"] .dayrow .away{ color:var(--gold-2); }

  :root[data-theme="blue"] .pstats .st b{ color:var(--gold-2); }

  :root[data-theme="blue"] .hcard .bmkbtn{ color:var(--gold-2); }

  :root[data-theme="blue"] .hsec{ color:var(--gold-2); }
  /* ---------- Tracker ---------- */
  .tk-row{ display:flex; align-items:center; gap:10px; padding:9px 0; border-top:1px solid var(--line); }
  .tk-row:first-of-type{ border-top:0; }
  .tk-row .nm{ flex:1; font-weight:600; font-size:16.5px; }
  .tk-row .tm{ color:var(--ink-2); font-size:14px; font-variant-numeric:tabular-nums; }
  .tk{
    min-width:104px; border-radius:999px; border:1.5px solid var(--line); background:var(--surface);
    color:var(--ink-2); font-weight:700; padding:8px 14px; font-size:14.5px;
  }
  .tk.done{ background:linear-gradient(180deg, var(--green-600), var(--green-800)); color:#fdf6da; border-color:var(--green-800); }
  .tk-bar{ height:12px; border-radius:99px; background:var(--surface-2); overflow:hidden; border:1px solid var(--line); }
  .tk-bar i{ display:block; height:100%; background:linear-gradient(90deg, var(--gold), var(--green-500)); transition:width .3s ease; }
  .ptable td.end{ color:var(--ink-2); font-variant-numeric:tabular-nums; white-space:nowrap; }
  .dayrow{ display:flex; gap:12px; align-items:center; background:var(--surface); border:1px solid var(--line); border-radius:13px; box-shadow:var(--card-shadow); padding:12px 15px; margin-bottom:9px; }
  .dayrow .dt{ flex:0 0 auto; text-align:center; background:var(--gold-soft); border:1px solid var(--gold); border-radius:11px; padding:6px 10px; min-width:74px; color:#4d3a08; }
  .dayrow .dt b{ display:block; font-size:17px; line-height:1.25; }
  .dayrow .dt span{ font-size:12px; }
  .dayrow .inf{ flex:1; }
  .dayrow .inf b{ font-size:16.5px; }
  .dayrow .inf span{ display:block; color:var(--ink-2); font-size:13.5px; }
  .dayrow .away{ font-weight:700; color:var(--green-700); white-space:nowrap; font-size:14.5px; }
  @media (prefers-color-scheme: dark){ .dayrow .away{ color:var(--gold-2); } }
  :root[data-theme="dark"] .dayrow .away{ color:var(--gold-2); }

  /* ---------- Profile ---------- */
  .profile-chip{
    background:rgba(20,17,12,.55); border:1px solid rgba(201,162,75,.6); color:#fdf6da;
    border-radius:999px; padding:7px 16px; font-weight:600; font-size:14.5px; backdrop-filter:blur(2px);
  }
  .gbtn{
    display:flex; align-items:center; justify-content:center; gap:11px; width:100%;
    background:#fff; color:#2b2b2b; border:1px solid #d8d8d8; border-radius:12px;
    padding:12px 18px; font-size:16.5px; font-weight:600; box-shadow:0 3px 10px rgba(0,0,0,.12);
  }
  .gbtn svg{ width:21px; height:21px; flex:0 0 auto; }
  .avatar{
    width:84px; height:84px; border-radius:50%; margin:0 auto; display:grid; place-items:center;
    background:radial-gradient(circle at 32% 28%, var(--green-500), var(--green-900));
    border:3px solid var(--gold); color:#fdf6da; font-size:36px; font-weight:700;
    box-shadow:0 10px 24px rgba(20,17,12,.3); overflow:hidden;
  }
  .avatar img{ width:100%; height:100%; object-fit:cover; }
  .pstats{ display:grid; grid-template-columns:repeat(3,1fr); gap:10px; margin-top:14px; }
  .pstats .st{ border:1px solid var(--line); border-radius:13px; padding:11px 6px; text-align:center; background:var(--surface-2); }
  .pstats .st b{ display:block; font-size:21px; color:var(--green-800); }
  @media (prefers-color-scheme: dark){ .pstats .st b{ color:var(--gold-2); } }
  :root[data-theme="dark"] .pstats .st b{ color:var(--gold-2); }
  .pstats .st span{ font-size:12.5px; color:var(--ink-2); }
  .bmk{ display:flex; align-items:center; gap:10px; width:100%; text-align:left; background:var(--surface); border:1px solid var(--line); border-radius:12px; padding:10px 13px; margin-bottom:8px; color:var(--ink); font-weight:600; }
  .bmk small{ color:var(--ink-2); font-weight:400; display:block; }
  .bmk .del{ margin-left:auto; color:var(--danger); font-weight:700; padding:4px 8px; }
  .hcard .bmkbtn{ float:right; border:1px solid var(--gold); background:transparent; border-radius:999px; padding:3px 12px; font-size:13px; font-weight:600; color:var(--green-800); }
  @media (prefers-color-scheme: dark){ .hcard .bmkbtn{ color:var(--gold-2); } }
  :root[data-theme="dark"] .hcard .bmkbtn{ color:var(--gold-2); }

  /* ---------- New home layout (top bar / hijri banner / waqt card) ---------- */
  .topbar{ display:flex; align-items:center; justify-content:space-between; gap:10px; text-align:left; }
  .date-chip{
    background:rgba(20,17,12,.55); border:1px solid rgba(201,162,75,.55); border-radius:999px;
    padding:5px 14px; font-weight:600; font-size:14.5px; color:#fdf6da; white-space:nowrap;
  }
  .top-right{ display:flex; align-items:center; gap:8px; }
  .theme-mini{
    width:38px; height:38px; min-height:38px; border-radius:50%; flex:0 0 auto;
    border:1px solid rgba(201,162,75,.6); background:rgba(20,17,12,.55); color:var(--gold-2);
    display:grid; place-items:center; padding:0;
  }
  .theme-mini svg{ width:19px; height:19px; }
  .loc-pill{
    display:flex; align-items:center; gap:6px; background:rgba(20,17,12,.6);
    border:1px solid var(--gold); color:var(--gold-2); border-radius:999px; padding:3px 10px 3px 12px;
  }
  .loc-pill svg{ width:17px; height:17px; flex:0 0 auto; }
  .loc-pill select{
    background:transparent; border:0; color:#fdf6da; font:inherit; font-weight:700; font-size:14.5px;
    max-width:40vw; min-height:2rem; appearance:none; -webkit-appearance:none; cursor:pointer; padding:2px 0;
  }
  .loc-pill select option{ color:#1c2a22; background:#fffdf6; }
  .hijri-banner{ text-align:center; margin-top:18px; border:1.5px solid var(--gold); border-radius:16px; padding:14px 12px; }
  .hb-main{
    font-family:"Noto Sans Bengali","Hind Siliguri",sans-serif; font-size:clamp(25px,6.4vw,36px); font-weight:700;
    color:#8a6d1f; text-shadow:none; line-height:1.35;
  }
  .hb-sub{ color:#8a6d1f; font-size:14.5px; margin-top:3px; text-shadow:none; }
  /* Dark/blue themes keep the pale banner colours (light theme uses the deep gold above) */
  @media (prefers-color-scheme: dark){ .hb-main{ color:#fdf6da; text-shadow:0 2px 14px rgba(0,0,0,.55); } .hb-sub{ color:var(--gold-2); text-shadow:0 1px 8px rgba(0,0,0,.6); } }
  :root[data-theme="dark"] .hb-main, :root[data-theme="blue"] .hb-main{ color:#fdf6da; text-shadow:0 2px 14px rgba(0,0,0,.55); }
  :root[data-theme="dark"] .hb-sub, :root[data-theme="blue"] .hb-sub{ color:var(--gold-2); text-shadow:0 1px 8px rgba(0,0,0,.6); }
  :root[data-theme="light"] .hb-main{ color:#8a6d1f; text-shadow:none; }
  :root[data-theme="light"] .hb-sub{ color:#8a6d1f; text-shadow:none; }
  .hijri-banner .profile-chip{ margin-top:10px; }

  /* ---------- Waqt card ---------- */
  .waqt-card{
    max-width:520px; margin:8px auto 0; text-align:center;
    background:rgba(10,9,7,.68); border:1px solid var(--gold); border-radius:16px;
    padding:6px 10px 7px; backdrop-filter:blur(3px);
    box-shadow:0 14px 34px rgba(0,0,0,.35), inset 0 1px 0 rgba(227,200,120,.28);
  }
  .wq-top{ display:flex; justify-content:space-between; align-items:center; gap:10px; }
  .wq-live{
    display:inline-flex; align-items:center; gap:7px; font-size:13.5px; font-weight:700; color:#231a04;
    background:linear-gradient(180deg, var(--gold-2), var(--gold)); border-radius:999px; padding:3px 12px;
  }
  .wq-live .dot{ width:8px; height:8px; border-radius:50%; background:#0b4630; animation:wqpulse 1.6s ease-in-out infinite; }
  @keyframes wqpulse{ 0%,100%{ opacity:1; } 50%{ opacity:.35; } }
  @media (prefers-reduced-motion: reduce){ .wq-live .dot{ animation:none; } }
  .wq-clock{ font-variant-numeric:tabular-nums; font-weight:700; color:#fff; font-size:22px; line-height:1.15; letter-spacing:.5px; white-space:nowrap; }
  .wq-clock small{ color:var(--gold-2); font-size:.66em; font-weight:600; }
  .arcwrap{ max-width:200px; margin:0 auto; }
  .arcwrap svg{ width:100%; height:auto; display:block; }
  .wq-name{ font-family:"Noto Sans Bengali","Hind Siliguri",sans-serif; font-size:clamp(18px,4.6vw,21px); font-weight:700; color:#fff; line-height:1.2; margin-top:-4px; }
  .wq-end{ color:var(--gold-2); font-size:13.5px; }
  .wq-bar{ height:6px; border-radius:99px; background:rgba(255,255,255,.16); overflow:hidden; margin:7px 0 6px; }
  .wq-bar i{ display:block; height:100%; width:0; background:linear-gradient(90deg, var(--gold), var(--green-500)); border-radius:99px; transition:width .5s linear; }
  .wq-next{ color:#fdf6da; font-size:13.5px; }
  .wq-next b{ color:var(--gold-2); }
  .wq-cd{ color:var(--gold-2); font-weight:700; font-size:14px; font-variant-numeric:tabular-nums; margin-top:0; }

  /* ---------- Home tile grids (vertical wrap, 4 per row) ---------- */
  .hsec{
    font-family:"Noto Sans Bengali","Hind Siliguri",sans-serif; font-size:21px; margin:20px 0 10px; color:var(--green-800);
    display:flex; align-items:center; gap:10px;
  }
  @media (prefers-color-scheme: dark){ .hsec{ color:var(--gold-2); } }
  :root[data-theme="dark"] .hsec{ color:var(--gold-2); }
  .hsec::before{
    content:""; width:10px; height:10px; flex:0 0 auto; transform:rotate(45deg);
    background:linear-gradient(135deg, var(--gold-2), var(--gold)); border-radius:2.5px;
  }
  .hsec::after{ content:""; flex:1; height:2px; background:linear-gradient(90deg, var(--gold), transparent); border-radius:2px; }
  .hgrid{ display:grid; grid-template-columns:repeat(4,1fr); gap:10px; }
  @media (max-width:400px){ .hgrid{ gap:7px; } }
  @media (min-width:760px){ .hgrid{ gap:12px; } }
  .htile{
    background:linear-gradient(165deg, var(--green-800), var(--green-950));
    border:1px solid rgba(201,162,75,.38); border-radius:16px;
    padding:13px 3px 11px; width:100%; min-height:0;
    display:flex; flex-direction:column; align-items:center; gap:8px;
    color:#fdf6da; font-size:13px; font-weight:600; line-height:1.3; text-align:center;
    box-shadow:0 4px 12px rgba(20,17,12,.20);
  }
  .htile:active{ transform:scale(.97); }
  @media (min-width:760px){ .htile{ font-size:14.5px; padding:16px 6px 14px; } }
  .htile .hic{ width:44px; height:44px; border-radius:50%; display:grid; place-items:center; color:#fff; flex:0 0 auto; box-shadow:inset 0 1px 0 rgba(255,255,255,.35), 0 4px 10px rgba(0,0,0,.3); }
  .htile .hic svg{ width:24px; height:24px; }
  .hic.c1{ background:#94701f; } .hic.c2{ background:#b8892a; } .hic.c3{ background:#2e6da4; }
  .hic.c4{ background:#b3546e; } .hic.c5{ background:#3d6fb4; } .hic.c6{ background:#a06a2c; }
  .hic.c7{ background:#6d4a8a; } .hic.c8{ background:#7a4a2b; }

  /* ---------- Bottom navigation ---------- */
  .bottomnav{
    position:fixed; left:0; right:0; bottom:0; z-index:55; display:flex;
    background:linear-gradient(180deg, var(--green-900), var(--green-950));
    border-top:2px solid var(--gold); box-shadow:0 -6px 18px rgba(0,0,0,.28);
    padding-bottom:env(safe-area-inset-bottom);
  }
  .bottomnav button{
    flex:1; background:transparent; border:0; color:#cfc49a; min-height:3.6rem;
    display:flex; flex-direction:column; align-items:center; justify-content:center; gap:2px;
    padding:7px 4px 6px; font-size:13px; font-weight:600;
  }
  .bottomnav button svg{ width:23px; height:23px; }
  .bottomnav button[aria-selected="true"]{ color:var(--gold-2); background:rgba(201,162,75,.15); }
  footer{ padding-bottom:70px; }
  .bottomnav .bn-pic{ width:26px; height:26px; border-radius:50%; display:grid; place-items:center; }
  .bottomnav .bn-pic svg{ width:23px; height:23px; }
  .bottomnav .bn-pic .bn-ini{
    width:26px; height:26px; border-radius:50%; display:grid; place-items:center;
    background:radial-gradient(circle at 32% 28%, var(--green-500), var(--green-800));
    border:1.5px solid var(--gold); color:#fdf6da; font-size:14px; font-weight:700; line-height:1;
  }
/* v4: prayer-time / waqt interface belongs to Home only */
  body.not-home .waqt-card, body.not-home .hero-prayer{ display:none !important; }
  /* v4: straight uniform Bengali text — no slanted/italic styling anywhere */
  html *{ font-style:normal !important; }
  body, h1, h2, h3, h4, button, input, select, textarea{ font-family:"Noto Sans Bengali","Hind Siliguri",system-ui,sans-serif; }
  .ar, .bismillah{ font-family:"Amiri",serif; font-style:normal !important; }

  /* ===== v2.16 additions ===== */
  :root[data-afont="s"] .ayah .arabic{ font-size:22px }
  :root[data-afont="s"] .daily.ar{ font-size:19px }
  :root[data-afont="l"] .ayah .arabic{ font-size:33px }
  :root[data-afont="l"] .daily.ar{ font-size:28px }
  .owner-name{ font-family:"Noto Serif Bengali","Noto Sans Bengali",serif; font-weight:700; font-size:24px; line-height:1.4; background:linear-gradient(92deg,#8a6d1f,#c9a24b 40%,#8a6d1f 72%,#a8852f); -webkit-background-clip:text; background-clip:text; -webkit-text-fill-color:transparent; color:transparent }
  :root[data-theme="dark"] .owner-name, :root[data-theme="blue"] .owner-name{ background:linear-gradient(92deg,#e3c878,#fdf6da 45%,#e3c878 75%,#c9a24b); -webkit-background-clip:text; background-clip:text }
  @supports not (-webkit-background-clip:text){ .owner-name{ color:#c9a24b; -webkit-text-fill-color:currentColor } }
  .owner-btns{ display:flex; gap:10px; justify-content:center; flex-wrap:wrap }
  .wq-ends{ display:flex; justify-content:space-between; font-size:12.5px; color:#e9e2c8; margin-top:2px }
  .wq-ends b{ color:#e3c878 }
  .wq-nafl{ margin-top:8px; font-size:13px; color:#e3c878; text-align:center }
  .qshort{ display:grid; grid-template-columns:repeat(4,1fr); gap:8px; margin:12px 0 4px }
  .qshort button{ background:var(--card); border:1px solid var(--line); border-radius:14px; padding:10px 4px; font:inherit; font-weight:700; color:var(--ink); cursor:pointer; display:flex; flex-direction:column; align-items:center; gap:4px }
  .qshort button span{ font-size:20px }
  .qchips{ display:flex; gap:8px; flex-wrap:wrap; margin-bottom:6px }
  .qchips button{ border:1px solid var(--gold); background:rgba(201,162,75,.1); color:var(--ink); border-radius:999px; padding:7px 14px; font:inherit; font-weight:700; cursor:pointer }
  .kcard{ display:flex; gap:12px; align-items:flex-start }
  .kcover{ width:64px; height:88px; object-fit:cover; border-radius:8px; border:1px solid var(--line); background:var(--card); flex-shrink:0 }
  .kinfo{ flex:1; min-width:0 }
  .kinfo h3{ margin-top:0 }
  .kdesc{ display:-webkit-box; -webkit-line-clamp:3; -webkit-box-orient:vertical; overflow:hidden }
  .kaction{ flex-shrink:0 }
  .kbmk{ background:none; border:none; font-size:17px; cursor:pointer; padding:2px 4px }
  .ramtable td, .ramtable th{ white-space:nowrap }
  .rtog{ border:1px solid var(--line); background:var(--card); color:var(--ink); border-radius:999px; padding:5px 10px; font:inherit; font-size:13.5px; font-weight:700; cursor:pointer }
  .rtog.on{ background:var(--gold); color:#241a05; border-color:var(--gold) }
  tr.ramtoday td{ background:rgba(201,162,75,.14) }
</style>
</head>
<body>

<header class="hero">
  <div class="hero-in">
    <div class="topbar">
      <span class="date-chip" id="topDateChip">…</span>
      <span class="top-right">
        <button id="themeBtn" class="theme-mini" aria-label="থিম বদলান" title="থিম: সাদা / কালো / রয়েল ব্লু"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 13.2A8.2 8.2 0 1 1 10.8 4a6.6 6.6 0 0 0 9.2 9.2z"/></svg></button>
        <span class="loc-pill">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 21s-6.5-5.4-6.5-10.2A6.5 6.5 0 0 1 12 4a6.5 6.5 0 0 1 6.5 6.8C18.5 15.6 12 21 12 21z"/><circle cx="12" cy="10.6" r="2.3"/></svg>
          <select id="homeCitySel" aria-label="লোকেশন বেছে নিন — জায়গা বদলালে সময়সূচি বদলে যাবে"></select>
        </span>
      </span>
    </div>
    <div class="hijri-banner">
      <div class="hb-main" id="hijriBig">…</div>
      <div class="hb-sub" id="hijriSub">…</div>
      <p style="margin:0"><button id="profileChip" class="profile-chip">গেস্ট হিসেবে আছেন — প্রোফাইল দেখুন</button></p>
    </div>
    <div class="waqt-card">
      <div class="wq-top">
        <span class="wq-live"><span class="dot"></span>চলমান</span>
        <span class="wq-clock" id="clock">--:--:--</span>
      </div>
      <div class="arcwrap" aria-hidden="true">
        <svg viewBox="0 0 300 132">
          <path d="M25 122 A 125 125 0 0 1 275 122" fill="none" stroke="rgba(201,162,75,.35)" stroke-width="2.5" stroke-dasharray="5 6" stroke-linecap="round"/>
          <line x1="8" y1="122" x2="292" y2="122" stroke="rgba(201,162,75,.5)" stroke-width="2" stroke-linecap="round"/>
          <g id="arcSun">
            <circle id="arcSunC" cx="45" cy="122" r="13" fill="#e3c878" stroke="#c9a24b" stroke-width="2"/>
            <g id="arcSunRays" stroke="#e3c878" stroke-width="2.4" stroke-linecap="round">
              <line x1="45" y1="100" x2="45" y2="93"/><line x1="45" y1="151" x2="45" y2="144" transform="rotate(180 45 122)"/>
            </g>
          </g>
          <g id="arcMoon" style="display:none">
            <path id="arcMoonP" d="M52 108 a15 15 0 1 0 10 22 a11.5 11.5 0 1 1 -10 -22z" fill="#fdf6da" stroke="#c9a24b" stroke-width="1.6"/>
          </g>
        </svg>
      </div>
      <div class="wq-ends"><span>সূর্যোদয় <b id="arcSunrise">—</b></span><span>সূর্যাস্ত <b id="arcSunset">—</b></span></div>
      <div class="wq-name" id="wqName">—</div>
      <div class="wq-end" id="wqEnd"></div>
      <div class="wq-bar"><i id="wqProg"></i></div>
      <div class="wq-next" id="wqNext"></div>
      <div class="wq-nafl" id="wqNafl"></div>
      <div class="wq-cd" id="wqCd">--:--:--</div>
      <span id="nextPrayerName" hidden></span><span id="nextPrayerCd" hidden></span>
    </div>
    <div class="hero-prayer">
      <button class="refresh-btn" id="refreshBtn" aria-label="সময় ও তারিখ রিফ্রেশ করুন" title="রিফ্রেশ করুন"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12a9 9 0 1 1-2.64-6.36"/><path d="M21 3v6h-6"/></svg></button>
      <div class="hp-head" style="padding-right:44px">
        <span class="hp-city" id="homePrayerCity"></span>
      </div>
      <div id="homePrayerList"></div>
      <div class="hp-loc">
        <button type="button" id="homeGpsBtn">GPS দিয়ে আমার লোকেশন নিন</button>
        <button type="button" id="homeSearchBtn">অন্য জায়গা খুঁজুন</button>
      </div>
      <p class="hp-foot"><button data-goto="prayer">তারিখ অনুযায়ী পূর্ণ সময়সূচি →</button></p>
    </div>
  </div>
</header>



<main class="wrap">

  <!-- ================= HOME ================= -->
  <section class="view on" id="view-home">
    <div class="card" style="padding:14px 16px; margin-bottom:14px">
      <input class="search" type="text" id="globalSearch" placeholder="সব জায়গায় খুঁজুন — সূরা, হাদিস, দোয়া, আল্লাহর নাম, শিশুর নাম…" aria-label="সব জায়গায় খুঁজুন" style="margin:0" />
      <div id="globalResults"></div>
    </div>
    <h2 class="hsec" style="margin-top:2px">ইলম ও আমল</h2>
    <div class="hgrid" id="featureGridIlm"></div>
    <h2 class="hsec">সেবা</h2>
    <div class="hgrid" id="featureGridSeba"></div>

    <div class="daily">
      <div class="card">
        <h3>আজকের আয়াত</h3>
        <p class="ar" id="dailyAyahAr">…</p>
        <p id="dailyAyahBn"></p>
        <p class="src" id="dailyAyahSrc"></p>
      </div>
      <div class="card">
        <h3>আজকের হাদিস</h3>
        <p class="ar" id="dailyHadithAr">…</p>
        <p id="dailyHadithBn"></p>
        <p class="src" id="dailyHadithSrc"></p>
      </div>
    </div>

  </section>

  <!-- ================= PRAYER ================= -->
  <section class="view" id="view-prayer">
    <h2 class="sec">নামাজের সময়সূচি</h2>
    <p class="sub">ডিফল্ট লোকেশন <b>ভাঙা, ফরিদপুর</b> — তবে লোকেশন যেকোনো সময় বদলানো যায়। তালিকা থেকে যেকোনো জেলা বেছে নিন, "আমার লোকেশন (GPS)" চাপ দিয়ে নিজের অবস্থান নিন, অথবা নিচের খোঁজার ঘরে <b>যেকোনো জায়গার নাম</b> (গ্রাম, থানা, শহর বা দেশ — বাংলা বা ইংরেজিতে) লিখলেই সেই জায়গার সময়সূচি হয়ে যাবে। বেছে নেওয়া লোকেশন এই সেশনে সব জায়গায় (হোম, কাউন্টডাউন, সেহরি-ইফতার, কিবলা) প্রযোজ্য থাকবে। তারিখ বদলে যেকোনো দিনের সময় দেখা যায়। (আসর: হানাফি মাযহাব অনুযায়ী।)</p>
    <div class="controls">
      <label>জেলা / শহর
        <select id="citySel"></select>
      </label>
      <label>তারিখ
        <input type="date" id="prayerDate" />
      </label>
      <button class="btn" id="todayBtn">আজকের তারিখ</button>
      <button class="btn gold" id="gpsBtn" type="button">আমার লোকেশন (GPS)</button>
      <span id="locStatus" style="font-weight:600; align-self:center"></span>
    </div>
    <div class="controls" style="margin-top:2px">
      <label style="flex:1 1 240px">যেকোনো জায়গা খুঁজুন — শুধু নাম লিখলেই ওই জায়গার সময়
        <input type="text" id="placeSearch" placeholder="যেমন: ভাঙা, নগরকান্দা, কুমিল্লা, Makkah, Dubai…" aria-label="যেকোনো জায়গার নাম লিখে খুঁজুন" />
      </label>
      <button class="btn gold" id="placeSearchBtn" type="button">এই জায়গার সময় দেখুন</button>
      <span id="placeStatus" style="font-weight:600; align-self:center"></span>
    </div>
    <details style="margin:0 0 14px">
      <summary style="font-weight:600; cursor:pointer">জায়গা খুঁজে না পেলে — অক্ষাংশ / দ্রাঘিমাংশ দিয়ে সেট করুন</summary>
      <div class="controls" style="margin-top:10px">
        <label>জায়গার নাম
          <input type="text" id="customName" placeholder="যেমন: আমার গ্রাম" />
        </label>
        <label>অক্ষাংশ (Latitude)
          <input type="number" step="any" id="customLat" placeholder="যেমন: 23.3736" />
        </label>
        <label>দ্রাঘিমাংশ (Longitude)
          <input type="number" step="any" id="customLng" placeholder="যেমন: 90.0272" />
        </label>
        <button class="btn" id="customApply" type="button">এই লোকেশন ব্যবহার করুন</button>
      </div>
      <p class="sub" style="margin:0">Google Maps-এ জায়গাটিতে চাপ দিয়ে ধরে রাখলেই নিচে অক্ষাংশ-দ্রাঘিমাংশ দেখা যায়।</p>
    </details>
    <div class="card" style="padding:6px 0; overflow:hidden">
      <table class="ptable">
        <thead><tr><th>নামাজ</th><th>শুরু</th><th>শেষ</th><th>অ্যালার্ম</th></tr></thead>
        <tbody id="prayerBody"></tbody>
      </table>
    </div>
    <div class="card" style="padding:14px 16px; margin-top:14px">
      <h3 style="margin:0 0 8px">নফল নামাজের সময়</h3>
      <table class="ptable"><tbody id="nafalBody"></tbody></table>
    </div>
    <div class="card" style="padding:14px 16px; margin-top:12px; border-color:var(--danger)">
      <h3 style="margin:0 0 6px; color:var(--danger)">⚠ নামাজের নিষিদ্ধ সময়</h3>
      <p class="sub" style="margin:0 0 8px">এই সময়গুলোতে নামাজ পড়া নিষিদ্ধ/মাকরুহে তাহরিমি — সূর্যোদয়ের সময়, সূর্য ঠিক মাথার ওপরে থাকার সময় (জাওয়াল) এবং সূর্যাস্তের সময়। (সহিহ মুসলিম: ৮৩১)</p>
      <table class="ptable"><tbody id="forbidBody"></tbody></table>
    </div>
    <div class="card" style="padding:14px 16px; margin-top:12px" id="alarmCard">
      <h3 style="margin:0 0 6px">নামাজের অ্যালার্ম ও রিমাইন্ডার</h3>
      <p class="sub" style="margin:0 0 10px">প্রতিটি ওয়াক্তের অ্যালার্ম অন করলে ওয়াক্ত শুরু হলে (বা পছন্দমতো কয়েক মিনিট আগে) শব্দ বাজিয়ে রিমাইন্ডার দেওয়া হবে। সেহরি ও ইফতারের জন্যও আলাদা অ্যালার্ম আছে। অ্যালার্ম বাজে অ্যাপটি খোলা থাকলে; তবে আপনার অ্যালার্ম সেটিংস সংরক্ষিত থাকে — অ্যাপ আবার খুললেও সেটিংস থেকে যাবে। শব্দ ঠিকমতো বাজে কিনা "টেস্ট শুনুন" দিয়ে যাচাই করে নিন।</p>
      <div id="alarmRows"></div>
      <div class="zform" style="margin-top:14px">
        <label>রিমাইন্ডারের শব্দ
          <select id="alarmSound">
            <option value="bell">মধুর ঘণ্টা ধ্বনি</option>
            <option value="melody">নরম সুর</option>
            <option value="beep">সতর্ক বিপ</option>
            <option value="azan:makkah">আজান — মক্কা (হারাম শরীফ)</option>
            <option value="azan:madinah">আজান — মদিনা (মসজিদে নববী)</option>
            <option value="azan:alafasy">আজান — মিশারি রাশিদ আল-আফাসি</option>
            <option value="azan:alafasyfajr">আজান — ফজরের আজান (আল-আফাসি)</option>
            <option value="azan:fakhry">আজান — সাবাহ ফাখরি (সিরীয় সুর)</option>
            <option value="azan:aaqib">আজান — আকিব আজিজ</option>
          </select>
        </label>
        <label>ভলিউম
          <input type="range" id="alarmVol" min="0" max="100" value="80" />
        </label>
      </div>
      <p style="margin:14px 0 0; display:flex; gap:10px; flex-wrap:wrap"><button class="btn gold" id="alarmTest">টেস্ট শুনুন</button><button class="btn" id="alarmStop" disabled>বন্ধ করুন</button></p>
    </div>
    <p class="sub" style="margin-top:12px" id="prayerNote"></p>
  </section>

  <!-- ================= QURAN ================= -->
  <section class="view" id="view-quran">
    <div id="quranListWrap">
      <h2 class="sec">পবিত্র কুরআন</h2>
      <p class="sub">সম্পূর্ণ ১১৪ সূরা — আরবি পাঠ, বাংলা অর্থ (অনুবাদ: মুহিউদ্দীন খান) ও প্রতি আয়াতের তিলাওয়াত অডিও (ক্বারী বাছাইয়ের সুবিধাসহ)। "পারা অনুযায়ী" চাপ দিলে ১–৩০ পারার আলাদা তালিকা পাবেন — যেকোনো পারা বেছে পড়া যাবে। যেসব আয়াতের তাফসির সংকলিত আছে, সেগুলোর অর্থের নিচে <b>"তাফসির দেখুন"</b> বোতাম পাবেন।</p>
      <div class="qshort" role="group" aria-label="শর্টকাট">
        <button type="button" data-qsc="tilawat"><span>🔊</span>তিলাওয়াত</button>
        <button type="button" data-qsc="tafsir"><span>📖</span>তাফসীর</button>
        <button type="button" data-qsc="search"><span>🔍</span>অনুসন্ধান</button>
        <button type="button" data-qsc="bookmark"><span>🔖</span>বুকমার্ক</button>
      </div>
      <p style="margin:10px 0 4px; font-weight:700; color:var(--gold)">কুইক লিংক</p>
      <div class="qchips">
        <button type="button" data-qchip="kursi">আয়াতুল কুরসী</button>
        <button type="button" data-qchip="yasin">সূরা ইয়াসীন</button>
        <button type="button" data-qchip="kahf">সূরা আল-কাহফ</button>
        <button type="button" data-qchip="rahman">সূরা আর-রাহমান</button>
        <button type="button" data-qchip="waqiah">সূরা আল-ওয়াকিয়া</button>
        <button type="button" data-qchip="mulk">সূরা আল-মুলক</button>
        <button type="button" data-qchip="dukhan">সূরা আদ-দুখান</button>
        <button type="button" data-qchip="sajdah">সূরা আস-সাজদাহ</button>
      </div>
      <div class="seg" role="group" aria-label="তালিকার ধরন">
        <button id="segSurah" aria-pressed="true">সূরা অনুযায়ী</button>
        <button id="segJuz" aria-pressed="false" title="কুরআনের ভিতরেই ৩০ পারার তালিকা">পারা অনুযায়ী (৩০ পারা)</button>
      </div>
      <input class="search" type="text" id="surahSearch" placeholder="সূরা খুঁজুন — নাম বা নম্বর লিখুন…" aria-label="সূরা খুঁজুন" />
      <div class="slist" id="surahList"><p class="loadmsg">কুরআনের তথ্য লোড হচ্ছে…</p></div>
      <div class="slist hidden" id="juzList"></div>
    </div>
    <div id="readerWrap" class="hidden">
