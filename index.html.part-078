/* ================= Kalima ================= */
var KALIMAS = [
 { t:'প্রথম কালিমা — তাইয়্যিবা', ar:'لَا إِلَٰهَ إِلَّا اللَّهُ مُحَمَّدٌ رَسُولُ اللَّهِ', bn:'আল্লাহ ছাড়া কোনো ইলাহ (উপাস্য) নেই; মুহাম্মদ ﷺ আল্লাহর রাসূল।' },
 { t:'দ্বিতীয় কালিমা — শাহাদাত', ar:'أَشْهَدُ أَنْ لَا إِلَٰهَ إِلَّا اللَّهُ وَحْدَهُ لَا شَرِيكَ لَهُ، وَأَشْهَدُ أَنَّ مُحَمَّدًا عَبْدُهُ وَرَسُولُهُ', bn:'আমি সাক্ষ্য দিচ্ছি যে, আল্লাহ ছাড়া কোনো ইলাহ নেই; তিনি এক, তাঁর কোনো শরিক নেই। আর আমি সাক্ষ্য দিচ্ছি যে, মুহাম্মদ ﷺ তাঁর বান্দা ও রাসূল।' },
 { t:'তৃতীয় কালিমা — তামজিদ', ar:'سُبْحَانَ اللَّهِ وَالْحَمْدُ لِلَّهِ وَلَا إِلَٰهَ إِلَّا اللَّهُ وَاللَّهُ أَكْبَرُ، وَلَا حَوْلَ وَلَا قُوَّةَ إِلَّا بِاللَّهِ الْعَلِيِّ الْعَظِيمِ', bn:'আল্লাহ পবিত্র, সব প্রশংসা আল্লাহর, আল্লাহ ছাড়া কোনো ইলাহ নেই, আল্লাহ সবচেয়ে বড়। মহান ও সুমহান আল্লাহর সাহায্য ছাড়া কোনো শক্তি ও সামর্থ্য নেই।' },
 { t:'চতুর্থ কালিমা — তাওহিদ', ar:'لَا إِلَٰهَ إِلَّا اللَّهُ وَحْدَهُ لَا شَرِيكَ لَهُ، لَهُ الْمُلْكُ وَلَهُ الْحَمْدُ، يُحْيِي وَيُمِيتُ، وَهُوَ حَيٌّ لَا يَمُوتُ أَبَدًا أَبَدًا، ذُو الْجَلَالِ وَالْإِكْرَامِ، بِيَدِهِ الْخَيْرُ، وَهُوَ عَلَىٰ كُلِّ شَيْءٍ قَدِيرٌ', bn:'আল্লাহ ছাড়া কোনো ইলাহ নেই; তিনি এক, তাঁর কোনো শরিক নেই। সব রাজত্ব তাঁরই, সব প্রশংসা তাঁরই। তিনি জীবন দেন ও মৃত্যু দেন; তিনি চিরঞ্জীব, কখনো মরবেন না। তিনি মহিমা ও সম্মানের অধিকারী; সব কল্যাণ তাঁর হাতে; তিনি সবকিছুর ওপর ক্ষমতাবান।' },
 { t:'পঞ্চম কালিমা — আস্তাগফার', ar:'أَسْتَغْفِرُ اللَّهَ رَبِّي مِنْ كُلِّ ذَنْبٍ أَذْنَبْتُهُ عَمَدًا أَوْ خَطَأً، سِرًّا أَوْ عَلَانِيَةً، وَأَتُوبُ إِلَيْهِ مِنَ الذَّنْبِ الَّذِي أَعْلَمُ وَمِنَ الذَّنْبِ الَّذِي لَا أَعْلَمُ، إِنَّكَ أَنْتَ عَلَّامُ الْغُيُوبِ وَسَتَّارُ الْعُيُوبِ وَغَفَّارُ الذُّنُوبِ، وَلَا حَوْلَ وَلَا قُوَّةَ إِلَّا بِاللَّهِ الْعَلِيِّ الْعَظِيمِ', bn:'আমি আমার রব আল্লাহর কাছে ক্ষমা চাই প্রতিটি গুনাহ থেকে — যা আমি ইচ্ছাকৃত বা ভুলে, গোপনে বা প্রকাশ্যে করেছি। আমি তাওবা করছি সেই গুনাহ থেকে যা আমি জানি এবং যা জানি না। নিশ্চয় আপনিই অদৃশ্যের মহাজ্ঞানী, দোষ-ত্রুটি গোপনকারী ও গুনাহ ক্ষমাকারী। মহান আল্লাহর সাহায্য ছাড়া কোনো শক্তি ও সামর্থ্য নেই।' },
 { t:'ষষ্ঠ কালিমা — রাদ্দে কুফর', ar:'اللَّهُمَّ إِنِّي أَعُوذُ بِكَ مِنْ أَنْ أُشْرِكَ بِكَ شَيْئًا وَأَنَا أَعْلَمُ بِهِ، وَأَسْتَغْفِرُكَ لِمَا لَا أَعْلَمُ بِهِ، تُبْتُ عَنْهُ، وَتَبَرَّأْتُ مِنَ الْكُفْرِ وَالشِّرْكِ وَالْكَذِبِ وَالْغِيبَةِ وَالْبِدْعَةِ وَالنَّمِيمَةِ وَالْفَوَاحِشِ وَالْبُهْتَانِ وَالْمَعَاصِي كُلِّهَا، وَأَسْلَمْتُ، وَأَقُولُ لَا إِلَٰهَ إِلَّا اللَّهُ مُحَمَّدٌ رَسُولُ اللَّهِ', bn:'হে আল্লাহ! আমি আপনার কাছে আশ্রয় চাই এ থেকে যে, জেনে-শুনে আপনার সঙ্গে কিছু শরিক করি; আর যা আমি জানি না, তার জন্য আপনার কাছে ক্ষমা চাই। আমি তা থেকে তাওবা করলাম; কুফর, শিরক, মিথ্যা, গিবত, বিদআত, চুগলখোরি, অশ্লীলতা, অপবাদ ও সব ধরনের গুনাহ থেকে নিজেকে মুক্ত ঘোষণা করলাম। আমি ইসলাম গ্রহণ করলাম এবং বলছি: আল্লাহ ছাড়া কোনো ইলাহ নেই; মুহাম্মদ ﷺ আল্লাহর রাসূল।' }
];
$('kalimaList').innerHTML = KALIMAS.map(function(k){
  return '<article class="hcard"><h3>' + k.t + '</h3><p class="ar">' + k.ar + '</p><p>' + k.bn + '</p></article>';
}).join('');

/* ================= Namaz Shikkha ================= */
var SHIKKHA = '' +
 '<details class="acc" open><summary>ওযু করার নিয়ম (ধারাবাহিক ধাপ)</summary><div class="body">' +
 '<p>নিয়ত করে "বিসমিল্লাহ" বলে শুরু করুন। ওযুর ফরজ চারটি: পুরো মুখ ধোয়া, কনুইসহ দুই হাত ধোয়া, মাথার চারভাগের একভাগ মাসেহ করা এবং টাখনুসহ দুই পা ধোয়া। সুন্নাত তরিকা অনুযায়ী ধাপগুলো:</p>' +
 '<ol class="steps">' +
 '<li>দুই হাত কব্জি পর্যন্ত তিনবার ধুয়ে নিন।</li>' +
 '<li>তিনবার কুলি করুন ও নাকে পানি দিয়ে তিনবার ঝাড়ুন।</li>' +
 '<li>পুরো মুখ (কপালের চুলের গোড়া থেকে থুতনি, এক কান থেকে অপর কান) তিনবার ধুয়ে নিন।</li>' +
 '<li>প্রথমে ডান হাত, পরে বাম হাত কনুইসহ তিনবার ধুয়ে নিন।</li>' +
 '<li>ভেজা হাতে পুরো মাথা একবার মাসেহ করুন; কান ও ঘাড়ও মাসেহ করুন।</li>' +
 '<li>প্রথমে ডান পা, পরে বাম পা টাখনুসহ তিনবার ধুয়ে নিন।</li>' +
 '</ol>' +
 '<p class="ar">أَشْهَدُ أَنْ لَا إِلَٰهَ إِلَّا اللَّهُ وَحْدَهُ لَا شَرِيكَ لَهُ، وَأَشْهَدُ أَنَّ مُحَمَّدًا عَبْدُهُ وَرَسُولُهُ، اللَّهُمَّ اجْعَلْنِي مِنَ التَّوَّابِينَ وَاجْعَلْنِي مِنَ الْمُتَطَهِّرِينَ</p>' +
 '<p>ওযুর পরের এই দোয়া পড়া সুন্নাত (সহিহ মুসলিম: ২৩৪; সুনানে তিরমিযি: ৫৫)।</p></div></details>' +

 '<details class="acc"><summary>পাঁচ ওয়াক্ত নামাজের রাকাত সংখ্যা</summary><div class="body">' +
 '<table class="rakat"><thead><tr><th>ওয়াক্ত</th><th>সুন্নাত (আগে)</th><th>ফরজ</th><th>সুন্নাত (পরে)</th><th>নফল/বিতর</th></tr></thead><tbody>' +
 '<tr><th>ফজর</th><td>২</td><td>২</td><td>—</td><td>—</td></tr>' +
 '<tr><th>যোহর</th><td>৪</td><td>৪</td><td>২</td><td>২ নফল</td></tr>' +
 '<tr><th>আসর</th><td>৪ (গায়রে মুয়াক্কাদা)</td><td>৪</td><td>—</td><td>—</td></tr>' +
 '<tr><th>মাগরিব</th><td>—</td><td>৩</td><td>২</td><td>২ নফল</td></tr>' +
 '<tr><th>এশা</th><td>৪ (গায়রে মুয়াক্কাদা)</td><td>৪</td><td>২</td><td>২ নফল + ৩ বিতর (ওয়াজিব)</td></tr>' +
 '<tr><th>জুমা (শুক্রবার)</th><td>৪</td><td>২</td><td>৪ + ২</td><td>—</td></tr>' +
 '</tbody></table>' +
 '<p>দৈনিক ফরজ মোট ১৭ রাকাত। বিতর নামাজ হানাফি মাযহাবে ওয়াজিব।</p></div></details>' +

 '<details class="acc"><summary>নামাজ পড়ার ধারাবাহিক ধাপ (এক রাকাতের বিবরণ)</summary><div class="body">' +
 '<ol class="steps">' +
 '<li><b>নিয়ত ও তাকবিরে তাহরিমা:</b> কিবলামুখী হয়ে দাঁড়িয়ে নিয়ত করুন; দুই হাত কান/কাঁধ পর্যন্ত উঠিয়ে "আল্লাহু আকবার" বলে নামাজ শুরু করুন।</li>' +
 '<li><b>কিয়াম:</b> হাত বেঁধে সানা পড়ুন — <span class="ar" style="display:block">سُبْحَانَكَ اللَّهُمَّ وَبِحَمْدِكَ، وَتَبَارَكَ اسْمُكَ، وَتَعَالَىٰ جَدُّكَ، وَلَا إِلَٰهَ غَيْرُكَ</span>এরপর আউযুবিল্লাহ ও বিসমিল্লাহ পড়ে সূরা আল-ফাতিহা এবং অন্য একটি সূরা/আয়াত পড়ুন।</li>' +
 '<li><b>রুকু:</b> "আল্লাহু আকবার" বলে রুকুতে যান; কমপক্ষে তিনবার বলুন — <span class="ar" style="display:block">سُبْحَانَ رَبِّيَ الْعَظِيمِ</span></li>' +
 '<li><b>কওমা:</b> "সামিআল্লাহু লিমান হামিদাহ" বলে সোজা হয়ে দাঁড়ান এবং বলুন — <span class="ar" style="display:block">رَبَّنَا لَكَ الْحَمْدُ</span></li>' +
 '<li><b>সিজদা:</b> "আল্লাহু আকবার" বলে দুটি সিজদা করুন; প্রতিটিতে কমপক্ষে তিনবার বলুন — <span class="ar" style="display:block">سُبْحَانَ رَبِّيَ الْأَعْلَىٰ</span>দুই সিজদার মাঝে কিছুক্ষণ বসুন।</li>' +
 '<li><b>দ্বিতীয় রাকাত:</b> একইভাবে দ্বিতীয় রাকাত আদায় করুন।</li>' +
 '<li><b>তাশাহহুদ:</b> দ্বিতীয় রাকাতে বসে আত্তাহিয়্যাতু পড়ুন — <span class="ar" style="display:block">التَّحِيَّاتُ لِلَّهِ وَالصَّلَوَاتُ وَالطَّيِّبَاتُ، السَّلَامُ عَلَيْكَ أَيُّهَا النَّبِيُّ وَرَحْمَةُ اللَّهِ وَبَرَكَاتُهُ، السَّلَامُ عَلَيْنَا وَعَلَىٰ عِبَادِ اللَّهِ الصَّالِحِينَ، أَشْهَدُ أَنْ لَا إِلَٰهَ إِلَّا اللَّهُ وَأَشْهَدُ أَنَّ مُحَمَّدًا عَبْدُهُ وَرَسُولُهُ</span></li>' +
 '<li><b>দরুদ ও দোয়া মাসুরা (শেষ বৈঠকে):</b> দরুদে ইবরাহিম পড়ুন — <span class="ar" style="display:block">اللَّهُمَّ صَلِّ عَلَىٰ مُحَمَّدٍ وَعَلَىٰ آلِ مُحَمَّدٍ، كَمَا صَلَّيْتَ عَلَىٰ إِبْرَاهِيمَ وَعَلَىٰ آلِ إِبْرَاهِيمَ، إِنَّكَ حَمِيدٌ مَجِيدٌ، اللَّهُمَّ بَارِكْ عَلَىٰ مُحَمَّدٍ وَعَلَىٰ آلِ مُحَمَّدٍ، كَمَا بَارَكْتَ عَلَىٰ إِبْرَاهِيمَ وَعَلَىٰ آلِ إِبْرَاهِيمَ، إِنَّكَ حَمِيدٌ مَجِيدٌ</span>এরপর দোয়া মাসুরা: <span class="ar" style="display:block">اللَّهُمَّ إِنِّي ظَلَمْتُ نَفْسِي ظُلْمًا كَثِيرًا، وَلَا يَغْفِرُ الذُّنُوبَ إِلَّا أَنْتَ، فَاغْفِرْ لِي مَغْفِرَةً مِنْ عِنْدِكَ وَارْحَمْنِي، إِنَّكَ أَنْتَ الْغَفُورُ الرَّحِيمُ</span></li>' +
 '<li><b>সালাম:</b> ডানে ও বামে "আসসালামু আলাইকুম ওয়া রাহমাতুল্লাহ" বলে নামাজ শেষ করুন।</li>' +
 '</ol>' +
 '<p>তিন ও চার রাকাতবিশিষ্ট নামাজে মাঝের বৈঠকে শুধু তাশাহহুদ পড়ে উঠে যান এবং শেষ বৈঠকে তাশাহহুদ, দরুদ ও দোয়া মাসুরা পড়ে সালাম ফেরান। বিস্তারিত শেখার জন্য নির্ভরযোগ্য আলেম বা সহিহ নামাজ শিক্ষার বই অনুসরণ করুন।</p></div></details>' +

 '<details class="acc"><summary>নামাজের ফরজ, ওয়াজিব ও কিছু জরুরি মাসআলা</summary><div class="body">' +
 '<p><b>নামাজের বাইরে ফরজ (শর্ত) ৭টি:</b> শরীর পবিত্র হওয়া, পোশাক পবিত্র হওয়া, নামাজের জায়গা পবিত্র হওয়া, সতর ঢাকা, কিবলামুখী হওয়া, ওয়াক্ত হওয়া ও নিয়ত করা।</p>' +
 '<p><b>নামাজের ভেতরে ফরজ (রুকন) ৬টি:</b> তাকবিরে তাহরিমা, কিয়াম (দাঁড়ানো), কিরাত (কুরআন পড়া), রুকু, দুই সিজদা ও শেষ বৈঠকে তাশাহহুদ পরিমাণ বসা।</p>' +
 '<p>ফরজ ছুটে গেলে নামাজ হবে না; ওয়াজিব ছুটে গেলে সাহু সিজদা দিতে হয়। মহিলাদের সতর: মুখ, হাত ও পা ছাড়া পুরো শরীর; পুরুষদের সতর: নাভি থেকে হাঁটু পর্যন্ত।</p></div></details>' +
 '<details class="acc"><summary>' + "ওজুর ফরজ, সুন্নাত, মাকরূহ ও ওজু ভঙ্গের কারণ" + '</summary><div class="body">' + "<p><b>ওজুর ফরজ ৪টি:</b></p><ol class=\"steps\"><li>সমস্ত মুখ একবার ধোয়া — কপালের চুলের গোড়া থেকে থুতনির নিচ ও এক কানের লতি থেকে অপর কান পর্যন্ত।</li><li>দুই হাত কনুইসহ একবার ধোয়া।</li><li>মাথার চার ভাগের এক ভাগ মাসেহ করা।</li><li>দুই পা টাখনুসহ একবার ধোয়া।</li></ol><p><b>প্রধান সুন্নাতসমূহ:</b> নিয়ত করা, বিসমিল্লাহ পড়া, কব্জি পর্যন্ত দুই হাত তিনবার ধোয়া, মিসওয়াক করা, তিনবার কুলি করা, তিনবার নাকে পানি দেওয়া, দাড়ি ও হাত-পায়ের আঙুল খিলাল করা, প্রত্যেক অঙ্গ তিনবার ধোয়া, একবার সমস্ত মাথা মাসেহ করা, কান মাসেহ করা, তারতিব রক্ষা করা ও বিরতি না দিয়ে ধারাবাহিকভাবে ওজু করা।</p><p><b>মাকরূহসমূহ:</b> প্রয়োজনের অতিরিক্ত পানি খরচ করা বা খুব কম পানি ব্যবহার করা, মুখে জোরে পানির ঝাপটা মারা, ওজুর সময় অপ্রয়োজনীয় দুনিয়াবি কথা বলা, অন্যের সাহায্য নেওয়া (অপারগতা ছাড়া)।</p><p><b>ওজু ভঙ্গের কারণসমূহ:</b></p><ul><li>পেশাব-পায়খানা বা বায়ু বের হওয়া।</li><li>শরীর থেকে রক্ত, পুঁজ বের হয়ে জায়গা ছেড়ে গড়িয়ে যাওয়া।</li><li>মুখ ভরে বমি করা।</li><li>চিত-কাত হয়ে বা হেলান দিয়ে ঘুমানো।</li><li>অজ্ঞান, পাগলামি বা নেশাগ্রস্ত হওয়া।</li><li>রুকু-সিজদাওয়ালা নামাজে অট্টহাসি দেওয়া।</li></ul>" + '</div></details>' +
 '<details class="acc"><summary>' + "তায়াম্মুম: কখন ও কিভাবে" + '</summary><div class="body">' + "<p>পবিত্র মাটি দিয়ে পবিত্রতা অর্জনের বিশেষ পদ্ধতির নাম তায়াম্মুম। পানি না পাওয়া গেলে বা পানি ব্যবহারে অক্ষম হলে এটি ওজু ও গোসলের বিকল্প।</p><p><b>কোন অবস্থায় জায়েজ:</b></p><ul><li>প্রায় এক মাইলের মধ্যে পানি না পাওয়া গেলে।</li><li>অসুস্থতার কারণে পানি ব্যবহারে রোগ বৃদ্ধি বা আরোগ্য বিলম্বের আশঙ্কা থাকলে।</li><li>পানি থাকলেও তা পান করা বা জরুরি প্রয়োজনের জন্য সংরক্ষণ করতে হলে।</li><li>শত্রু, হিংস্র প্রাণী বা অন্য বিপদের কারণে পানির কাছে যাওয়া সম্ভব না হলে।</li></ul><p><b>ধাপে ধাপে নিয়ম:</b></p><ol class=\"steps\"><li>তায়াম্মুমের নিয়ত করা ও বিসমিল্লাহ পড়া।</li><li>দুই হাতের তালু পবিত্র মাটি, মাটির ঢিলা বা ধুলাবালিযুক্ত জিনিসে মেরে ঝেড়ে নেওয়া।</li><li>দুই হাত দিয়ে সমস্ত মুখ মাসেহ করা।</li><li>পুনরায় মাটিতে হাত মেরে প্রথমে ডান হাত, তারপর বাম হাত কনুইসহ মাসেহ করা।</li></ol><p><b>তায়াম্মুম ভঙ্গের কারণ:</b> যেসব কারণে ওজু ভেঙে যায় সেসব কারণে তায়াম্মুমও ভেঙে যায়। এছাড়া পানি পাওয়া গেলে এবং পানি ব্যবহারের অক্ষমতা দূর হলে তায়াম্মুম ভেঙে যায়।</p>" + '</div></details>' +
 '<details class="acc"><summary>' + "গোসল: ফরজ হওয়ার কারণ ও নিয়ম" + '</summary><div class="body">' + "<p><b>গোসল ফরজ হওয়ার প্রধান কারণসমূহ:</b></p><ul><li>স্বপ্নদোষ বা অন্য কোনোভাবে উত্তেজনার সাথে বীর্যপাত হওয়া।</li><li>স্বামী-স্ত্রীর মিলন হওয়া (বীর্যপাত হোক বা না হোক)।</li><li>নারীদের হায়েজ (মাসিক) শেষ হওয়া।</li><li>নারীদের নিফাস (সন্তান প্রসবের পরের রক্ত) শেষ হওয়া।</li></ul><p>এছাড়া মৃত মুসলিমকে গোসল দেওয়া ফরজে কিফায়া এবং নও-মুসলিমের জন্য গোসল করা মুস্তাহাব। জুমা, দুই ঈদ ও হজের বিশেষ দিনগুলোতে গোসল করা সুন্নাত।</p><p><b>গোসলের ফরজ ৩টি:</b></p><ol class=\"steps\"><li>গড়গড়াসহ ভালোভাবে কুলি করা।</li><li>নাকের নরম অংশ পর্যন্ত পানি পৌঁছানো।</li><li>সমস্ত শরীরে পানি পৌঁছানো — শরীরের কোনো স্থান শুকনো না থাকা।</li></ol><p><b>সুন্নাত তরিকা সংক্ষেপে:</b> বিসমিল্লাহ পড়ে প্রথমে দুই হাত ধোয়া, লজ্জাস্থান ধুয়ে নেওয়া, শরীরে নাপাকি থাকলে তা দূর করা, তারপর পূর্ণ ওজু করা, এরপর মাথায় তিনবার পানি ঢালা এবং পর্যায়ক্রমে ডান কাঁধ ও বাম কাঁধে পানি ঢেলে সমস্ত শরীর ভালোভাবে ঘষে ধোয়া।</p>" + '</div></details>' +
 '<details class="acc"><summary>' + "আজান ও ইকামত" + '</summary><div class="body">' + "<p>নামাজের সময় হওয়ার ঘোষণাকে আজান এবং জামাত শুরুর ঠিক আগের ঘোষণাকে ইকামত বলে। আজানের বাক্যসমূহ:</p><p class=\"ar\">اللَّهُ أَكْبَرُ، اللَّهُ أَكْبَرُ — اللَّهُ أَكْبَرُ، اللَّهُ أَكْبَرُ</p><p>অর্থ: আল্লাহ সবচেয়ে বড় (৪ বার)।</p><p class=\"ar\">أَشْهَدُ أَنْ لَا إِلَهَ إِلَّا اللَّهُ</p><p>অর্থ: আমি সাক্ষ্য দিচ্ছি, আল্লাহ ছাড়া কোনো মাবুদ নেই (২ বার)।</p><p class=\"ar\">أَشْهَدُ أَنَّ مُحَمَّدًا رَسُولُ اللَّهِ</p><p>অর্থ: আমি সাক্ষ্য দিচ্ছি, মুহাম্মদ (সা.) আল্লাহর রাসূল (২ বার)।</p><p class=\"ar\">حَيَّ عَلَى الصَّلَاةِ — حَيَّ عَلَى الْفَلَاحِ</p><p>অর্থ: নামাজের দিকে এসো — কল্যাণের দিকে এসো (প্রতিটি ২ বার)।</p><p><b>ফজরের আজানে অতিরিক্ত:</b> ‘হাইয়া আলাল ফালাহ’-এর পর দুইবার বলা হয় —</p><p class=\"ar\">الصَّلَاةُ خَيْرٌ مِنَ النَّوْمِ</p><p>অর্থ: ঘুমের চেয়ে নামাজ উত্তম।</p><p>শেষে একবার ‘আল্লাহু আকবার, আল্লাহু আকবার’ এবং একবার ‘লা ইলাহা ইল্লাল্লাহ’।</p><p><b>আজানের জবাব:</b> মুয়াজ্জিন যা বলেন শ্রোতাও তাই বলবেন; তবে ‘হাইয়া আলাস সালাহ’ ও ‘হাইয়া আলাল ফালাহ’ শুনে বলবেন — <span class=\"ar\">لَا حَوْلَ وَلَا قُوَّةَ إِلَّا بِاللَّهِ</span> আজান শেষে দরুদ ও আজানের দোয়া পড়া সুন্নাত।</p><p><b>ইকামতের পার্থক্য:</b> বাক্যগুলো আজানের মতোই, তবে দ্রুত ও অনুচ্চ স্বরে বলা হয় এবং ‘হাইয়া আলাল ফালাহ’-এর পর দুইবার যোগ করা হয় — <span class=\"ar\">قَدْ قَامَتِ الصَّلَاةُ</span> অর্থ: নামাজ দাঁড়িয়ে গেছে।</p>" + '</div></details>' +
 '<details class="acc"><summary>' + "নামাজের ওয়াজিবসমূহ" + '</summary><div class="body">' + "<p>ওয়াজিব ছুটে গেলে সাহু সিজদা দিতে হয়; ইচ্ছাকৃতভাবে ছাড়লে নামাজ পুনরায় পড়া ওয়াজিব। প্রধান ওয়াজিবসমূহ:</p><ul><li>প্রত্যেক রাকাতে সূরা ফাতিহা পড়া।</li><li>ফরজ নামাজের প্রথম দুই রাকাতে এবং সুন্নাত, নফল ও বিতরের সব রাকাতে ফাতিহার সাথে অন্য সূরা বা আয়াত মিলানো।</li><li>ফাতিহা সূরার আগে পড়া এবং কিরাত, রুকু, সিজদার ধারাবাহিকতা (তারতিব) রক্ষা করা।</li><li>রুকু থেকে সোজা হয়ে দাঁড়ানো (কওমা) ও দুই সিজদার মাঝে সোজা হয়ে বসায় (জলসা) স্থিরতা অবলম্বন করা এবং প্রতিটি রুকনে অন্তত এক তাসবিহ পরিমাণ স্থির থাকা।</li><li>তিন ও চার রাকাতবিশিষ্ট নামাজে প্রথম বৈঠক করা এবং সেখানে তাশাহহুদ পড়া।</li><li>প্রত্যেক বৈঠকে তাশাহহুদ পড়া।</li><li>‘আসসালামু আলাইকুম ওয়া রাহমাতুল্লাহ’ বলে নামাজ শেষ করা।</li><li>বিতর নামাজে দোয়া কুনুত পড়া ও অতিরিক্ত তাকবির দেওয়া।</li><li>দুই ঈদের নামাজে অতিরিক্ত তাকবিরসমূহ।</li><li>জেহরি নামাজে (ফজর, মাগরিব, এশা, জুমা ইত্যাদি) ইমামের উচ্চস্বরে এবং সিররি নামাজে (যোহর, আসর) অনুচ্চ স্বরে কিরাত পড়া।</li><li>সিজদার আয়াত তিলাওয়াত হলে সিজদা করা।</li></ul>" + '</div></details>' +
 '<details class="acc"><summary>' + "নামাজের সুন্নাতসমূহ (সংক্ষেপে)" + '</summary><div class="body">' + "<p>নামাজের প্রধান সুন্নাতসমূহের সংক্ষিপ্ত তালিকা:</p><ul><li>তাকবিরে তাহরিমার সময় দুই হাত কান পর্যন্ত ওঠানো (পুরুষের জন্য)।</li><li>নাভির নিচে ডান হাত বাম হাতের উপর রেখে হাত বাঁধা।</li><li>সানা, আউযুবিল্লাহ ও বিসমিল্লাহ অনুচ্চ স্বরে পড়া।</li><li>সূরা ফাতিহা শেষে অনুচ্চ স্বরে ‘আমিন’ বলা।</li><li>রুকুতে যাওয়া ও রুকু থেকে ওঠার সময়, সিজদায় যাওয়ার সময় ‘আল্লাহু আকবার’ বলা এবং রুকু থেকে ওঠার সময় ‘সামিআল্লাহু লিমান হামিদাহ’ ও ‘রাব্বানা লাকাল হামদ’ বলা।</li><li>রুকু ও সিজদায় কমপক্ষে তিনবার তাসবিহ পড়া।</li><li>রুকুতে দুই হাত দিয়ে হাঁটু ধরা, পিঠ সমান রাখা; সিজদায় নির্ধারিত তরিকায় সাত হাড়ের উপর সিজদা করা।</li><li>জলসা ও বৈঠকে সুন্নাত তরিকায় বসা এবং দৃষ্টি নির্দিষ্ট স্থানে (দাঁড়ানো অবস্থায় সিজদার জায়গায়, রুকুতে পায়ের দিকে, বৈঠকে কোলের দিকে) রাখা।</li><li>শেষ বৈঠকে তাশাহহুদের পর দরুদ শরীফ ও দোয়া মাসুরা পড়া।</li><li>ডান ও বাম — দুই দিকেই সালাম ফেরানো।</li><li>ইমামের জন্য তাকবিরসমূহ উচ্চস্বরে বলা।</li></ul><p>সুন্নাত ছুটে গেলে সাহু সিজদা লাগে না, তবে ইচ্ছাকৃতভাবে সুন্নাত ত্যাগ করা অনুচিত।</p>" + '</div></details>' +
 '<details class="acc"><summary>' + "নামাজ ভঙ্গের কারণসমূহ" + '</summary><div class="body">' + "<p>নিম্নোক্ত কারণগুলোর কোনোটি ঘটলে নামাজ ভেঙে যায় এবং নতুন করে নামাজ পড়তে হয়:</p><ul><li>নামাজের মধ্যে কথা বলা — ইচ্ছাকৃত হোক বা ভুলে হোক, কম হোক বা বেশি।</li><li>কাউকে সালাম দেওয়া বা সালামের জবাব দেওয়া।</li><li>ব্যথা-বেদনায় ‘উহ্-আহ্’ শব্দ করা বা বিপদে চিৎকার করা।</li><li>কুরআন দেখে দেখে পড়া, বা এমন ভুল পড়া যাতে অর্থ বিকৃত হয়ে যায়।</li><li>নামাজের মধ্যে কিছু খাওয়া বা পান করা।</li><li>আমলে কাসির — এমন বেশি নড়াচড়া করা, যা দেখে মনে হয় ব্যক্তি নামাজে নেই।</li><li>কিবলা থেকে সিনা ঘুরে যাওয়া।</li><li>সতর খুলে যাওয়া বা শরীরে নাপাকি লাগা অবস্থায় নামাজ চলতে থাকা।</li><li>ওজু ভেঙে যাওয়া।</li><li>নামাজের কোনো ফরজ ছুটে যাওয়া।</li><li>সময় শেষ হয়ে যাওয়া (যেমন সূর্য উঠে যাওয়ায় ফজরের নামাজ) বা অজ্ঞান হয়ে যাওয়া।</li></ul>" + '</div></details>' +
 '<details class="acc"><summary>' + "নামাজের মাকরূহ বিষয়সমূহ" + '</summary><div class="body">' + "<p>মাকরূহ কাজে নামাজ ভাঙে না, তবে নামাজের পূর্ণতা ও সওয়াব কমে যায়। প্রধান মাকরূহ বিষয়সমূহ:</p><ul><li>কাপড়, দাড়ি বা শরীর নিয়ে খেলা করা এবং অযথা নড়াচড়া করা।</li><li>আঙুল ফোটানো বা হাতের আঙুল একে অপরের মধ্যে ঢোকানো।</li><li>এদিক-ওদিক মুখ ফিরিয়ে তাকানো, আকাশের দিকে তাকানো।</li><li>কোমরে হাত রেখে দাঁড়ানো।</li><li>ছবিযুক্ত কাপড় পরে বা ছবির দিকে মুখ করে নামাজ পড়া।</li><li>পেশাব-পায়খানার চাপ নিয়ে নামাজ পড়া।</li><li>সিজদায় দুই বাহু মাটিতে বিছিয়ে দেওয়া (কুকুরের বসার মতো)।</li><li>রুকু-সিজদায় তাসবিহ তিনবারের কম পড়া, তাড়াহুড়া করে নামাজ পড়া।</li><li>চোখ বন্ধ করে নামাজ পড়া (মনোযোগের প্রয়োজনে হলে ভিন্ন কথা)।</li><li>খাবার উপস্থিত থাকা অবস্থায় সেদিকে মন টানলে আগে না খেয়ে নামাজে দাঁড়ানো।</li><li>নিষিদ্ধ সময়ে (সূর্যোদয়, সূর্যাস্ত ও ঠিক দ্বিপ্রহরে) নফল নামাজ পড়া — এটি মাকরূহে তাহরিমি।</li></ul>" + '</div></details>' +
 '<details class="acc"><summary>' + "সাহু সিজদা: কখন ও কিভাবে" + '</summary><div class="body">' + "<p>‘সাহু’ অর্থ ভুল। নামাজে ওয়াজিব সংক্রান্ত ভুল হলে তা পূরণের জন্য যে অতিরিক্ত দুই সিজদা দেওয়া হয়, তাকে সাহু সিজদা বলে।</p><p><b>কোন ভুলে লাগে:</b></p><ul><li>কোনো ওয়াজিব ছুটে গেলে — যেমন প্রথম বৈঠক ভুলে দাঁড়িয়ে যাওয়া, তাশাহহুদ ছুটে যাওয়া।</li><li>ওয়াজিব আদায়ে বিলম্ব হলে — যেমন সিজদায় বা বৈঠকে ভাবতে ভাবতে এক রুকন পরিমাণ দেরি করা।</li><li>সূরা ফাতিহা দুইবার পড়া বা ফাতিহার পর সূরা মিলাতে দেরি করা।</li><li>কিরাতে ভুলবশত পরিবর্তন আনা বা জেহরি-সিররি কিরাতে ভুল করা (ইমামের ক্ষেত্রে)।</li></ul><p><b>হানাফি পদ্ধতি:</b></p><ol class=\"steps\"><li>শেষ বৈঠকে তাশাহহুদ পড়া (দরুদ ও দোয়া না পড়ে)।</li><li>শুধু ডান দিকে একবার সালাম ফেরানো।</li><li>‘আল্লাহু আকবার’ বলে দুইটি সিজদা করা — প্রতিটি সিজদায় যথারীতি তাসবিহ পড়া।</li><li>এরপর আবার বৈঠকে বসে তাশাহহুদ, দরুদ শরীফ ও দোয়া মাসুরা পড়ে দুই দিকে সালাম ফিরিয়ে নামাজ শেষ করা।</li></ol><p>উল্লেখ্য: ফরজ ছুটে গেলে সাহু সিজদায় তা পূরণ হয় না — নামাজ পুনরায় পড়তে হয়। ইচ্ছাকৃতভাবে ওয়াজিব ছাড়লেও সাহু সিজদা যথেষ্ট নয়; নামাজ পুনরায় পড়া ওয়াজিব।</p>" + '</div></details>' +
 '<details class="acc"><summary>' + "জানাজার নামাজের নিয়ম" + '</summary><div class="body">' + "<p>মৃত মুসলিমের জন্য দোয়ার উদ্দেশ্যে পড়া এই নামাজ ফরজে কিফায়া — কিছু মুসলিম আদায় করলে সবার পক্ষ থেকে আদায় হয়ে যায়। এতে রুকু-সিজদা নেই; চার তাকবিরে দাঁড়িয়ে আদায় করা হয়।</p><p><b>ধাপে ধাপে নিয়ম:</b></p><ol class=\"steps\"><li>মৃতের খাট সামনে রেখে কাতারবদ্ধ হয়ে দাঁড়ানো এবং জানাজার নামাজের নিয়ত করা।</li><li><b>প্রথম তাকবির:</b> ‘আল্লাহু আকবার’ বলে হাত বেঁধে সানা পড়া (জানাজার সানায় ‘ওয়া জাল্লা সানাউকা’ অতিরিক্ত পড়া হয়)।</li><li><b>দ্বিতীয় তাকবির:</b> হাত না উঠিয়ে ‘আল্লাহু আকবার’ বলে দরুদে ইবরাহিম পড়া।</li><li><b>তৃতীয় তাকবির:</b> ‘আল্লাহু আকবার’ বলে মৃতের জন্য দোয়া করা। প্রাপ্তবয়স্ক মৃতের জন্য মাসনুন দোয়া:</li></ol><p class=\"ar\">اللَّهُمَّ اغْفِرْ لِحَيِّنَا وَمَيِّتِنَا، وَشَاهِدِنَا وَغَائِبِنَا، وَصَغِيرِنَا وَكَبِيرِنَا، وَذَكَرِنَا وَأُنْثَانَا، اللَّهُمَّ مَنْ أَحْيَيْتَهُ مِنَّا فَأَحْيِهِ عَلَى الْإِسْلَامِ، وَمَنْ تَوَفَّيْتَهُ مِنَّا فَتَوَفَّهُ عَلَى الْإِيمَانِ</p><p>অর্থ: হে আল্লাহ! আমাদের জীবিত ও মৃত, উপস্থিত ও অনুপস্থিত, ছোট ও বড়, পুরুষ ও নারী সবাইকে ক্ষমা করুন। হে আল্লাহ! আমাদের মধ্যে যাকে জীবিত রাখেন, ইসলামের উপর রাখুন; যাকে মৃত্যু দেন, ইমানের উপর মৃত্যু দিন। (সহিহ মুসলিম: ৯৬৩)</p><ol class=\"steps\"><li><b>চতুর্থ তাকবির:</b> ‘আল্লাহু আকবার’ বলে ডানে ও বামে সালাম ফিরিয়ে নামাজ শেষ করা।</li></ol><p>মৃত নাবালক হলে তৃতীয় তাকবিরের পর তার জন্য পৃথক মাসনুন দোয়া পড়া হয়। ইমাম পুরুষ মৃতের মাথা বরাবর এবং নারী মৃতের মাঝ বরাবর দাঁড়াবেন।</p>" + '</div></details>' +
 '<details class="acc"><summary>' + "ঈদের নামাজের নিয়ম (সংক্ষেপে)" + '</summary><div class="body">' + "<p>ঈদুল ফিতর ও ঈদুল আজহার নামাজ ওয়াজিব। দুই রাকাত নামাজে মোট ছয়টি অতিরিক্ত তাকবির দেওয়া হয় — এটিই হানাফি পদ্ধতি।</p><p><b>প্রথম রাকাত:</b></p><ol class=\"steps\"><li>নিয়ত করে তাকবিরে তাহরিমা বলে হাত বাঁধা ও সানা পড়া।</li><li>হাত কান পর্যন্ত উঠিয়ে তিনবার অতিরিক্ত তাকবির বলা — প্রতিবার হাত ছেড়ে দেওয়া, তৃতীয় তাকবিরের পর হাত বাঁধা।</li><li>এরপর আউযুবিল্লাহ-বিসমিল্লাহ পড়ে সূরা ফাতিহা ও অন্য সূরা পড়ে যথারী