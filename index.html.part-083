var boyanIdx = -1;
function renderBayan(){
  $('bayanList').innerHTML = BAYAN.map(function(b, i){
    var playing = boyanIdx === i && !player.paused;
    var audioBtn = b.audio ? '<button class="btn" data-bayan-play="' + i + '">' + (playing ? '⏸ চলছে…' : '▶ অডিও শুনুন') + '</button>' : '';
    var ytBtn = b.url ? '<a class="btn gold" target="_blank" rel="noopener" href="' + b.url + '" style="text-decoration:none">▶ YouTube-এ শুনুন</a>' : '';
    var btns = (audioBtn || ytBtn) ? '<p style="margin:0; display:flex; gap:8px; flex-wrap:wrap">' + audioBtn + ytBtn + '</p>' : '';
    return '<article class="hcard"><span class="cat">' + b.topic + '</span><h3>' + b.t + '</h3><p style="margin:0 0 10px; color:var(--ink-2)">বক্তা: ' + b.sp + '</p>' + btns + '</article>';
  }).join('');
}
renderBayan();
$('bayanList').addEventListener('click', function(e){
  var btn = e.target.closest('[data-bayan-play]'); if (!btn) return;
  var i = +btn.getAttribute('data-bayan-play');
  if (boyanIdx === i && !player.paused){ player.pause(); }
  else {
    stopAudio();
    if (tilSurah){ tilSurah = null; buildTilawat(); }
    boyanIdx = i;
    playAudioSmart(BAYAN[i].audio);
  }
  setTimeout(renderBayan, 80);
});
player.addEventListener('ended', function(){ if (boyanIdx >= 0){ boyanIdx = -1; renderBayan(); } });
player.addEventListener('pause', function(){ if (boyanIdx >= 0 && currentView === 'bayan') setTimeout(renderBayan, 80); });
/* ---------- Written boyans (v2.18): 52 weekly, Hijri month -> week ---------- */
var HIJRI_MONTHS_B = ['মহররম','সফর','রবিউল আউয়াল','রবিউস সানি','জমাদিউল আউয়াল','জমাদিউস সানি','রজব','শা\'বান','রমজান','শাওয়াল','জিলকদ','জিলহজ'];
var WRITTEN_BOYANS = [
 { m:0, w:1, t:"হিজরি নববর্ষ: আত্মপর্যালোচনা ও নতুন সংকল্প", b:"ভূমিকা — আলহামদুলিল্লাহ, মহান আল্লাহ তাআলা আমাদেরকে আরেকটি হিজরি নববর্ষে পৌঁছে দিয়েছেন। সময় আল্লাহর এক মহান নেয়ামত, আর বছর ঘুরে নতুন বছরের আগমন মানে আমাদের হায়াতের খাতা থেকে আরও একটি বছর ঝরে গেল। মুহাররম মাস দিয়ে হিজরি বছরের সূচনা হয়; এটি সেই চারটি সম্মানিত মাসের একটি, যেগুলোকে আল্লাহ তাআলা বিশেষ মর্যাদা দিয়েছেন। নতুন বছরের এই মুহূর্তে আনন্দ-উল্লাসের চেয়ে বেশি জরুরি হলো থমকে দাঁড়িয়ে নিজের জীবনের হিসাব মেলানো — গত বছর আমি আল্লাহর কতটা কাছাকাছি গেলাম, আর কতটা দূরে সরে গেলাম। আজকের বয়ানে আমরা আত্মপর্যালোচনা ও নতুন সংকল্পের গুরুত্ব নিয়ে আলোচনা করব ইনশাআল্লাহ।\nমূল আলোচনা — আল্লাহ তাআলা বলেন, মাসের সংখ্যা আল্লাহর কাছে বারোটি, যার মধ্যে চারটি সম্মানিত মাস (সূরা আত-তাওবা: ৩৬)। মুহাররম সেই সম্মানিত মাসগুলোর অন্যতম। আবার আল্লাহ তাআলা মুমিনদেরকে আত্মপর্যালোচনার নির্দেশ দিয়ে বলেন, হে মুমিনগণ, তোমরা আল্লাহকে ভয় করো এবং প্রত্যেকেই যেন লক্ষ্য করে, আগামীকাল অর্থাৎ পরকালের জন্য সে কী অগ্রিম পাঠিয়েছে (সূরা আল-হাশর: ১৮)। এই আয়াত আমাদের শেখায়, প্রতিটি নতুন বছর, প্রতিটি নতুন দিন হলো নিজের আমলের হিসাব নেওয়ার সুযোগ। হযরত উমর রাদিয়াল্লাহু আনহু বলতেন, তোমাদের হিসাব নেওয়ার আগেই তোমরা নিজেদের হিসাব নাও। এই বাণীটি তিরমিজিসহ হাদিসের কিতাবগুলোতে বর্ণিত হয়েছে। যে ব্যক্তি নিজে হিসাব নেয়, কিয়ামতের দিন তার হিসাব সহজ হয়।\nগত বছরের দিকে ফিরে তাকালে আমরা দেখতে পাই, কত নামাজ কাজা হয়েছে, কতদিন কুরআন খোলা হয়নি, কত মানুষের হক নষ্ট হয়েছে, কত গুনাহ চোখ, কান ও জিহ্বা দিয়ে হয়েছে। আত্মপর্যালোচনা মানে শুধু অনুশোচনায় ডুবে যাওয়া নয়; বরং ভুল চিহ্নিত করে তা শোধরানোর পরিকল্পনা করা। একজন ব্যবসায়ী বছরের শেষে লাভ-ক্ষতির হিসাব মেলান, একজন ছাত্র পরীক্ষার আগে নিজের প্রস্তুতি যাচাই করে। তাহলে আখিরাতের চিরস্থায়ী জীবনের জন্য আমরা কেন হিসাব মেলাব না? রাসূলুল্লাহ সাল্লাল্লাহু আলাইহি ওয়াসাল্লাম বলেছেন, বুদ্ধিমান সেই ব্যক্তি যে নিজের নফসের হিসাব নেয় এবং মৃত্যুর পরের জীবনের জন্য আমল করে (সুনানে তিরমিজি)।\nনতুন বছরের সংকল্প হতে হবে সুনির্দিষ্ট ও বাস্তবসম্মত। যেমন — পাঁচ ওয়াক্ত নামাজ জামাতে আদায় করব, প্রতিদিন অন্তত এক পৃষ্ঠা কুরআন অর্থসহ পড়ব, মা-বাবার খেদমত করব, হারাম উপার্জন থেকে দূরে থাকব, জিহ্বাকে গীবত ও মিথ্যা থেকে বাঁচাব। বড় বড় অস্পষ্ট সংকল্পের বদলে ছোট ছোট ধারাবাহিক আমল আল্লাহর কাছে বেশি প্রিয়। রাসূলুল্লাহ সাল্লাল্লাহু আলাইহি ওয়াসাল্লাম বলেছেন, আল্লাহর কাছে সবচেয়ে প্রিয় আমল হলো যা নিয়মিত করা হয়, যদিও তা কম হয় (সহিহ বুখারি)। তাই সংকল্প লিখে রাখুন, পরিবারকে জানান এবং প্রতি মাসে নিজের অগ্রগতি যাচাই করুন।\nহিজরি সনের সূচনা হযরত মুহাম্মদ সাল্লাল্লাহু আলাইহি ওয়াসাল্লামের হিজরতের মহান স্মৃতির সঙ্গে জড়িত। হিজরত শেখায়, আল্লাহর সন্তুষ্টির জন্য ত্যাগ স্বীকার করতে হয়, পুরোনো গুনাহের পরিবেশ ছেড়ে নতুন জীবনের দিকে পা বাড়াতে হয়। আমরাও এই নববর্ষে গুনাহ থেকে তাওবার দিকে, অলসতা থেকে ইবাদতের দিকে, উদাসীনতা থেকে আল্লাহর স্মরণের দিকে হিজরত করার সংকল্প করি। মনে রাখবেন, ক্যালেন্ডারের পাতা বদলালেই জীবন বদলায় না; জীবন বদলায় সিদ্ধান্ত ও আমল বদলালে। আজকের এই মুহূর্তটাই হোক আমাদের পরিবর্তনের সূচনা।\nউপসংহার ও দোয়া — পরিশেষে বলব, নতুন বছর আমাদের জন্য রহমত হবে নাকি আফসোসের কারণ হবে, তা নির্ভর করছে আজকের সংকল্প ও আমলের ওপর। আসুন, আমরা অতীতের গুনাহের জন্য খাঁটি তাওবা করি এবং আগামী দিনগুলোকে নেক আমলে সাজানোর দৃঢ় প্রতিজ্ঞা করি। হে আল্লাহ, বিগত বছরের আমাদের সব গুনাহ মাফ করে দিন, নতুন বছরটি আমাদের জন্য ঈমান, আমল, সুস্থতা ও রিজিকে বরকতময় করুন। আমাদেরকে নিজেদের হিসাব নেওয়ার এবং মৃত্যুর জন্য প্রস্তুতি নেওয়ার তাওফিক দিন। আমিন, ইয়া রাব্বাল আলামিন।" },
 { m:0, w:2, t:"আশুরার ফজিলত ও রোজা", b:"ভূমিকা — 