<script>
/* ================= Helpers ================= */
var BN_D = ['০','১','২','৩','৪','৫','৬','৭','৮','৯'];
function bn(n){ return String(n).replace(/[0-9]/g, function(d){ return BN_D[+d]; }); }
function $(id){ return document.getElementById(id); }
function pad2(n){ return (n<10?'0':'')+n; }
function esc(s){ return String(s).replace(/&/g,'&amp;').replace(/</g,'&lt;'); }
var toastTimer = null;
function toast(msg){
  var t = $('toast'); t.textContent = msg; t.classList.add('show');
  clearTimeout(toastTimer); toastTimer = setTimeout(function(){ t.classList.remove('show'); }, 2600);
}
function dhakaNow(){ return new Date(new Date().toLocaleString('en-US', { timeZone:'Asia/Dhaka' })); }

/* ================= Bengali calendar (Bangladesh) ================= */
var BN_MONTHS = ['বৈশাখ','জ্যৈষ্ঠ','আষাঢ়','শ্রাবণ','ভাদ্র','আশ্বিন','কার্তিক','অগ্রহায়ণ','পৌষ','মাঘ','ফাল্গুন','চৈত্র'];
function bengaliDate(d){
  var y = d.getFullYear(), m = d.getMonth(), day = d.getDate();
  var startYear = (m > 3 || (m === 3 && day >= 14)) ? y : y - 1;
  var start = new Date(startYear, 3, 14);
  var offset = Math.round((new Date(y, m, day) - start) / 86400000);
  var febYear = startYear + 1;
  var leap = (febYear % 4 === 0 && febYear % 100 !== 0) || febYear % 400 === 0;
  var lens = [31,31,31,31,31,30,30,30,30,30, leap ? 30 : 29, 30];
  var mi = 0; while (offset >= lens[mi]){ offset -= lens[mi]; mi++; }
  return { day: offset + 1, month: BN_MONTHS[mi], year: startYear - 593 };
}

/* ================= Clock & dates ================= */
function periodWord(h){
  if (h < 4) return 'রাত';
  if (h < 6) return 'ভোর';
  if (h < 11) return 'সকাল';
  if (h < 15) return 'দুপুর';
  if (h < 17) return 'বিকেল';
  if (h < 19) return 'সন্ধ্যা';
  return 'রাত';
}
function fmtClock(d){
  var h = d.getHours(), m = d.getMinutes(), s = d.getSeconds();
  var h12 = h % 12; if (h12 === 0) h12 = 12;
  return bn(h12) + ':' + bn(pad2(m)) + ':' + bn(pad2(s)) + ' <small>' + periodWord(h) + '</small>';
}
function updateClock(){
  var now = dhakaNow();
  $('clock').innerHTML = fmtClock(now);
  var wcEl = $('widgetClock'); if (wcEl) wcEl.innerHTML = fmtClock(now);
  var bd = bengaliDate(now);
  var wd = new Intl.DateTimeFormat('bn-BD', { weekday:'long' }).format(now);
  $('dateBn').textContent = 'বাংলা: ' + wd + ', ' + bn(bd.day) + ' ' + bd.month + ' ' + bn(bd.year);
  try {
    var parts = new Intl.DateTimeFormat('bn-BD-u-ca-islamic', { day:'numeric', month:'long', year:'numeric' }).formatToParts(now);
    var hv = {};
    parts.forEach(function(p){ hv[p.type] = p.value; });
    $('dateHijri').textContent = 'হিজরি: ' + hv.day + ' ' + hv.month + ' ' + hv.year + ' হিজরি';
  } catch(e){ $('dateHijri').textContent = ''; }
  $('dateEn').textContent = 'ইংরেজি: ' + wd + ', ' + new Intl.DateTimeFormat('bn-BD', { day:'numeric', month:'long', year:'numeric' }).format(now);
  updateCountdown(now);
}

/* ================= Navigation ================= */
var currentView = 'home';
function showView(v){
  currentView = v;
  var secs = document.querySelectorAll('main section.view');
  for (var i = 0; i < secs.length; i++) secs[i].classList.toggle('on', secs[i].id === 'view-' + v);
  var tabs = document.querySelectorAll('nav.tabs button');
  for (var j = 0; j < tabs.length; j++) tabs[j].setAttribute('aria-selected', tabs[j].getAttribute('data-view') === v ? 'true' : 'false');
  if (v !== 'quran'){ stopAudio(); $('readerWrap').classList.add('hidden'); $('quranListWrap').classList.remove('hidden'); }
  window.scrollTo({ top: 0 });
}
function openSub(name){
  showView('more');
  var subs = document.querySelectorAll('.subview');
  for (var i = 0; i < subs.length; i++) subs[i].classList.add('hidden');
  $('sub-' + name).classList.remove('hidden');
  setTimeout(function(){ var el = $('sub-' + name); if (el) el.scrollIntoView({ block:'start' }); }, 30);
}
document.querySelector('nav.tabs .row').addEventListener('click', function(e){
  var b = e.target.closest('button[data-view]'); if (b) showView(b.getAttribute('data-view'));
});
document.addEventListener('click', function(e){
  var g = e.target.closest('[data-goto]'); if (g){ showView(g.getAttribute('data-goto')); return; }
  var s = e.target.closest('[data-sub]'); if (s){ openSub(s.getAttribute('data-sub')); }
});

/* ================= Icons & feature grid ================= */
function svgIcon(paths){ return '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">' + paths + '</svg>'; }
var ICONS = {
  clock: svgIcon('<circle cx="12" cy="12" r="9"/><path d="M12 7v5l3.5 2"/>'),
  quran: svgIcon('<path d="M5 4.5A1.5 1.5 0 0 1 6.5 3H19v15H6.5A1.5 1.5 0 0 0 5 19.5z"/><path d="M5 19.5A1.5 1.5 0 0 0 6.5 21H19v-3"/><path d="M12 7l.9 1.8 2 .3-1.45 1.4.35 2L12 11.6l-1.8.95.35-2L9.1 9.1l2-.3z" fill="currentColor" stroke="none"/>'),
  hadith: svgIcon('<path d="M6 3h12a1 1 0 0 1 1 1v13a3 3 0 0 1-3 3H6z"/><path d="M6 3a1 1 0 0 0-1 1v16a1 1 0 0 0 1 1"/><path d="M9.5 8h6M9.5 11.5h6M9.5 15h3.5"/>'),
  dua: svgIcon('<path d="M12 20.5c-4.5-1.2-7.5-4-7.5-8.2 0-1 .8-1.6 1.6-1.3 1.5.6 2.4 2 2.9 3.5V6.8c0-1 .7-1.8 1.5-1.8.4 0 .8.2 1 .5.2-.3.6-.5 1-.5.8 0 1.5.8 1.5 1.8v7.7c.5-1.5 1.4-2.9 2.9-3.5.8-.3 1.6.3 1.6 1.3 0 4.2-3 7-7.5 8.2z"/>'),
  qibla: svgIcon('<circle cx="12" cy="12" r="9"/><path d="M15.5 8.5l-2 5-5 2 2-5z" fill="currentColor" stroke="none"/><circle cx="12" cy="12" r=".6" fill="currentColor"/>'),
  tasbih: svgIcon('<circle cx="12" cy="10" r="7.5"/><circle cx="12" cy="2.8" r="1.3" fill="currentColor" stroke="none"/><circle cx="18.8" cy="6.5" r="1.3" fill="currentColor" stroke="none"/><circle cx="18.8" cy="13.5" r="1.3" fill="currentColor" stroke="none"/><circle cx="5.2" cy="6.5" r="1.3" fill="currentColor" stroke="none"/><circle cx="5.2" cy="13.5" r="1.3" fill="currentColor" stroke="none"/><path d="M12 17.5v2l-1.2 2h2.4L12 19.5"/>'),
  quiz: svgIcon('<circle cx="12" cy="12" r="9"/><path d="M9.6 9.2A2.6 2.6 0 1 1 12 12.4c-.9.35-1 .9-1 1.9"/><circle cx="11.2" cy="17" r=".4" fill="currentColor"/>'),
  names: svgIcon('<path d="M12 3.5l2.5 5.6 6 .6-4.5 4.1 1.3 5.9L12 16.7l-5.3 3-1.3-5.9L1 9.7l6-.6z" transform="scale(.92) translate(1 1)"/>'),
  zakat: svgIcon('<rect x="5" y="3.5" width="14" height="17" rx="2"/><path d="M8.5 7.5h7"/><circle cx="9" cy="12" r=".5" fill="currentColor"/><circle cx="12" cy="12" r=".5" fill="currentColor"/><circle cx="15" cy="12" r=".5" fill="currentColor"/><circle cx="9" cy="15.5" r=".5" fill="currentColor"/><circle cx="12" cy="15.5" r=".5" fill="currentColor"/><circle cx="15" cy="15.5" r=".5" fill="currentColor"/>'),
  kalima: svgIcon('<path d="M4 20V5.5C4 4.7 4.7 4 5.5 4H20v11H9l-5 4z"/><path d="M8 8.5h8M8 11.5h5"/>'),
  book: svgIcon('<path d="M12 6c-1.7-1.5-3.8-2-7-2v14c3.2 0 5.3.5 7 2 1.7-1.5 3.8-2 7-2V4c-3.2 0-5.3.5-7 2z"/><path d="M12 6v14"/>'),
  moon: svgIcon('<path d="M20 13.2A8.2 8.2 0 1 1 10.8 4a6.6 6.6 0 0 0 9.2 9.2z"/>'),
  play: svgIcon('<circle cx="12" cy="12" r="9"/><path d="M10 8.2l6 3.8-6 3.8z" fill="currentColor" stroke="none"/>'),
  check: svgIcon('<rect x="4" y="4" width="16" height="16" rx="3"/><path d="M8.5 12.5l2.5 2.5 4.5-5"/>'),
  mic: svgIcon('<rect x="9" y="3" width="6" height="11" rx="3"/><path d="M5.5 11.5a6.5 6.5 0 0 0 13 0M12 18v3"/>'),
  pin: svgIcon('<path d="M12 21s-6.5-5.4-6.5-10.2A6.5 6.5 0 0 1 12 4a6.5 6.5 0 0 1 6.5 6.8C18.5 15.6 12 21 12 21z"/><circle cx="12" cy="10.6" r="2.3"/>'),
  help: svgIcon('<circle cx="12" cy="12" r="9"/><path d="M9.7 9.4A2.5 2.5 0 1 1 12 12.3c-.8.3-1 .9-1 1.8"/><circle cx="11.2" cy="17" r=".4" fill="currentColor"/>')
};
var FEATURES = [
  { view:'prayer', ic:'clock', t:'নামাজের সময়', d:'পাঁচ ওয়াক্ত ও সূর্যোদয়, কাউন্টডাউনসহ' },
  { view:'quran', ic:'quran', t:'পবিত্র কুরআন', d:'১১৪ সূরা, বাংলা অর্থ ও অডিও' },
  { view:'quran-juz', ic:'book', t:'৩০ পারা', d:'পারা অনুযায়ী পূর্ণ কুরআন পাঠ' },
  { view:'tilawat', ic:'play', t:'তিলাওয়াত', d:'বিখ্যাত ক্বারীদের পূর্ণ সূরার অডিও' },
  { view:'hadith', ic:'hadith', t:'হাদিস ভান্ডার', d:'সহিহ হাদিস, অর্থ ও সূত্রসহ' },
  { view:'kitab', ic:'book', t:'কিতাব', d:'প্রসিদ্ধ ইসলামিক বইয়ের পরিচিতি' },
  { view:'probondho', ic:'kalima', t:'প্রবন্ধ', d:'ঈমান, আমল ও চরিত্র নিয়ে রচনা' },
  { view:'qshikkha', ic:'book', t:'কুরআন শিক্ষা', d:'আরবি হরফ, মাখরাজ ও তাজউইদ' },
  { view:'dua', ic:'dua', t:'দোয়া', d:'দৈনন্দিন ও মাসনুন দোয়া' },
  { view:'taleem', ic:'hadith', t:'তালিম', d:'প্রতিদিনের দ্বীনি পাঠ' },
  { view:'quiz', ic:'quiz', t:'ইসলামিক কুইজ', d:'প্রশ্ন, ব্যাখ্যা ও সূত্রসহ' },
  { view:'amal', ic:'check', t:'আমল ট্র্যাকার', d:'নামাজ, রোজা, তিলাওয়াত ও যিকির' },
  { sub:'masala', ic:'quiz', t:'দ্বীনি জিজ্ঞাসা', d:'দৈনন্দিন মাসআলা প্রশ্নোত্তর' },
  { sub:'zakat', ic:'zakat', t:'যাকাত-ফিতরা-সাদাকা', d:'যাকাত ও ফিতরার হিসাব' },
  { sub:'hajj', ic:'qibla', t:'হজ ও ওমরা গাইড', d:'ধাপে ধাপে নিয়ম ও দোয়া' },
  { view:'qibla', ic:'qibla', t:'কিবলা কম্পাস', d:'কম্পাসসহ কাবার দিক' },
  { view:'tasbih', ic:'tasbih', t:'তাসবিহ', d:'ডিজিটাল যিকির কাউন্টার ও কাস্টম যিকির' },
